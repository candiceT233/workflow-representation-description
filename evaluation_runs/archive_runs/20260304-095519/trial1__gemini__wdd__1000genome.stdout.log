is\"\n    name: \"Analysis\"\n    order: 3\n    description: \"Measures the overlap in mutations among individuals and populations, and calculates the frequency of overlapping mutations.\"\n    tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n\ntasks:\n  - task_id: \"task:individuals\"\n    name: \"Individuals\"\n    stage: \"stage:individuals_processing\"\n    executable: \"individuals.py\"\n    description: \"This task fetches and parses the Phase3 data from the 1000 genomes project by chromosome. These files list all of Single nucleotide polymorphisms (SNPs) variants in that chromosome and which individuals have each one. An individual task creates output files for each individual of rs numbers where individuals have mutations on both alleles.\"\n    behavioral_notes: \"Reads large VCF files in chunks; writes multiple compressed tar.gz archives incrementally.\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: \"Multiple instances run in parallel, each processing a segment of a chromosome's data. Controlled by '--individuals-jobs' parameter in daxgen.py.\"\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:1k_genome_vcf\"\n      - \"data:column_mapping\"\n    outputs:\n      - \"data:individual_chunks_tar\"\n\n  - task_id: \"task:individuals_merge\"\n    name: \"Individuals Merge\"\n    stage: \"stage:individuals_processing\"\n    executable: \"individuals_merge.py\"\n    description: \"Merges the individual processed chunks of a chromosome's data into a single archived file, effectively gathering results from multiple parallel 'individuals' tasks for a given chromosome.\"\n    behavioral_notes: \"Reads multiple compressed tar.gz archives; combines their contents and writes a single compressed tar.gz archive.\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: \"Multiple instances run in parallel, each merging chunks for a different chromosome. Each individual merge operation is serial.\"\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:individual_chunks_tar\"\n    outputs:\n      - \"data:merged_individuals_tar\"\n\n  - task_id: \"task:sifting\"\n    name: \"Sifting\"\n    stage: \"stage:sifting\"\n    executable: \"sifting.py\"\n    description: \"Computes the SIFT scores of all of the SNPs variants, as computed by the Variant Effect Predictor (VEP). For each chromosome the sifting task processes the corresponding VEP, and selects only the SNPs variants that has a SIFT score, recording in a file (per chromosome) the SIFT score and the SNPs variants ids.\"\n    behavioral_notes: \"Reads a large VCF annotation file; extracts specific data, processes it, and writes a text file.\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: \"Multiple instances run in parallel, each processing the VEP data for a different chromosome independently.\"\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:sifting_vcf\"\n    outputs:\n      - \"data:sifted_snp_scores\"\n\n  - task_id: \"task:mutation_overlap\"\n    name: \"Mutation Overlap\"\n    stage: \"stage