import hashlib
import json
import yaml

# Load the YAML file
with open('/mnt/common/mtang11/scripts/workflow-representation-description/workflow_wdd/1000genome-wdd-opencode-trial3.yaml', 'r') as f:
    wdd = yaml.safe_load(f)

# Extract pc_edges for hashing
pc_edges = wdd.get('pc_edges', [])

# Create a canonical representation
edges_data = []
for edge in pc_edges:
    edge_info = {
        'edge_id': edge.get('edge_id'),
        'producer': edge.get('producer'),
        'consumer': edge.get('consumer'),
        'data_objects': sorted(edge.get('data_objects', [])),
        'pc_pattern': edge.get('pc_pattern'),
        'coupling': edge.get('coupling'),
        'communication_pattern': edge.get('communication_pattern'),
        'data_volume_class': edge.get('data_volume_class')
    }
    edges_data.append(edge_info)

# Sort by edge_id for consistency
edges_data = sorted(edges_data, key=lambda x: x['edge_id'])

# Compute SHA-256 hash
hash_input = json.dumps(edges_data, sort_keys=True)
hash_value = hashlib.sha256(hash_input.encode()).hexdigest()
print(hash_value)
"
