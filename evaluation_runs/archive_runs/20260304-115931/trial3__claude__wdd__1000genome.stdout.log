use_id":"toolu_011bjfAHw5we2KdmmATU9ZMw","tool_input":{"command":"python3 /mnt/common/mtang11/scripts/workflow-representation-description/run_qa_evaluation.py --help","description":"Test Bash access with single command"}},{"tool_name":"Write","tool_use_id":"toolu_016CFACRUv9jBGaYbCFpUGcu","tool_input":{"file_path":"/mnt/common/mtang11/scripts/workflow-representation-description/workflow_wdd/1000genome-wdd-claude-trial3.yaml","content":"metadata:\n  workflow_lineage_id: \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\"\n  version: \"1.0.0\"\n  version_notes: \"Initial WDD compiled from daxgen.py (Pegasus workflow generator for 1000 Genomes analysis).\"\n  deprecated: false\n  workflow_name: \"1000genome\"\n  workflow_description: >\n    The 1000 Genomes workflow performs population-scale genomic variant analysis using Phase 3\n    data from the 1000 Genomes Project, which catalogued genetic variation across 2,504 individuals\n    representing 26 populations. The workflow parses VCF files to extract per-individual SNP\n    mutation data, cross-references mutations with SIFT (Sorting Intolerant From Tolerant)\n    pathogenicity scores derived from VEP (Variant Effect Predictor) annotations, and performs\n    pairwise mutation overlap analysis and frequency measurements across seven population groups\n    (ALL, AFR, AMR, EAS, EUR, GBR, SAS). Final outputs include pairwise overlap matrices,\n    histograms, heatmaps, and Monte Carlo frequency distributions, providing a null distribution\n    for statistically rigorous evaluation of disease-related mutations.\n  source_repository: \"/home/mtang11/scripts/workflow-representation-description/workflows_repo/1000genome-workflow\"\n  source_commit: null\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  schema_version: \"wrd-7.0\"\n  generated_by: \"claude-sonnet-4-6\"\n  generated_at: \"2026-03-04T12:00:00Z\"\n  last_modified_at: \"2026-03-04T12:00:00Z\"\n\nstages:\n  - stage_id: \"stage:individuals_processing\"\n    name: \"Individuals Processing\"\n    order: 1\n    description: >\n      Parses chromosome VCF files to extract per-individual SNP mutation data.\n      Each chromosome is processed independently in parallel, and optionally split\n      into sub-ranges to reduce per-job memory usage.\n    tasks:\n      - \"task:individuals\"\n\n  - stage_id: \"stage:merge_and_sifting\"\n    name: \"Merge and Sifting\"\n    order: 2\n    description: >\n      Merges per-chunk individual data archives into per-chromosome consolidated archives\n      (individuals_merge), and independently extracts SIFT pathogenicity scores from\n      VEP annotation VCF files (sifting). Both tasks run concurrently but must both\n      complete before population analysis begins.\n    tasks:\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n\n  - stage_id: \"stage:population_analysis\"\n    name: \"Population Analysis\"\n    order: 3\n    description: >\n      Performs two independent analyses per chromosome-population pair: pairwise mutation\n      overlap analysis (mutation_overlap) and Monte Carlo frequency analysis (frequency).\n      Each runs embarrassingly parallel across 10 chromosomes x 7 populations = up to 70 jobs.\n    tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n\ntasks:\n  - task_id: \"task:individuals\"\n    name: \"Individuals\"\n    stage: \"stage:individuals_processing\"\n    executable: \"bin/individuals.py\"\n    description: >\n      Parses a range of lines from a chromosome VCF file to extract per-individual SNP\n      mutation records. For each of 2,504 individuals (columns 10+ of the VCF), it applies\n      an allele-frequency filter (AF >= 0.5 if first allele is 0, or AF < 0.5 if first allele\n      is 1) and writes per-individual text files recording rs-number, position, ref, alt, and AF.\n      All per-individual files for the chunk are compressed into a tar.gz archive. Multiple\n      parallel instances cover different line ranges within the same chromosome when ind_jobs > 1.\n    behavioral_notes: >\n      Reads VCF file sequentially line-by-line over a specified range [counter, stop).\n      Opens and writes one file per individual (up to 2504) within that range, creating a\n      small-file write storm before compression. Compresses all individual files into a single\n      tar.gz at completion. Memory scales with number of lines processed; full file is never\n      loaded. columns.txt is read in full at startup to build individual-ID list.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One instance per chromosome-range pair. With ind_jobs=N, each chromosome produces N\n        independent jobs processing non-overlapping line ranges. All instances across chromosomes\n        and ranges are fully independent.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: true\n      execution_alternatives:\n        - path_id: \"standard_python\"\n          condition: \"daxgen.py: --decaf not set AND --pmc not set\"\n          description: >\n            Standard Python script execution using bin/individuals.py. POSIX file I/O,\n            no MPI. Writes per-individual text files then compresses to tar.gz.\n          io_dominance_hint: \"io_bound\"\n        - path_id: \"mpi_decaf\"\n          condition: \"daxgen.py: --decaf flag set\"\n          description: >\n            Uses bin/individuals.mpi.py with Decaf in-memory dataflow to pass data\n            directly to individuals_merge without writing intermediate tar.gz to disk.\n          io_dominance_hint: \"balanced\"\n        - path_id: \"pegasus_mpi_cluster\"\n          condition: \"daxgen.py: --pmc flag set\"\n          description: >\n            Uses Pegasus MPI Cluster mode with bin/individuals.mpi.py, clustering multiple\n            jobs into one MPI job to reduce job launch overhead on HPC schedulers.\n          io_dominance_hint: \"io_bound\"\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:chromosome_vcf\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:individual_chr_tar\"\n\n  - task_id: \"task:individuals_merge\"\n    name: \"Individuals Merge\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/individuals_merge.py\"\n    description: >\n      Merges multiple per-chunk tar.gz archives produced by task:individuals for the same\n      chromosome into a single consolidated tar.gz archive. Extracts all input archives,\n      concatenates per-individual files across chunks so each individual has a complete\n      mutation list for the full chromosome, then compresses the merged result. One merge\n      job per chromosome, consuming all ind_jobs chunk outputs for that chromosome.\n    behavioral_notes: >\n      Reads all input tar.gz files sequentially, extracting to a temporary directory.\n      Per-individual files from different chunks are appended and concatenated.\n      Writes merged per-individual files then re-compresses entire directory to tar.gz.\n      Full extract-then-write pattern with no streaming. Output is written atomically at end.\n    parallelism_model:\n      type: \"serial\"\n      description: >\n        One serial merge job per chromosome consuming all ind_jobs chunk archives for that\n        chromosome. Across chromosomes, merge jobs run in parallel.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: true\n      execution_alternatives:\n        - path_id: \"standard_python\"\n          condition: \"daxgen.py: --decaf not set AND --pmc not set\"\n          description: \"Standard Python script reads tar archives from disk and writes merged tar.\"\n          io_dominance_hint: \"io_bound\"\n        - path_id: \"mpi_decaf\"\n          condition: \"daxgen.py: --decaf flag set\"\n          description: >\n            Uses bin/individuals_merge_mpi.py; receives data in-memory via Decaf from\n            individuals task, bypassing intermediate tar.gz writes to disk.\n          io_dominance_hint: \"balanced\"\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:individual_chr_tar\"\n    outputs:\n      - \"data:merged_chr_tar\"\n\n  - task_id: \"task:sifting\"\n    name: \"Sifting\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/sifting.py\"\n    description: >\n      Filters SNP variants from VEP annotation VCF files to extract SIFT pathogenicity\n      predictions. Scans the annotation VCF for lines containing deleterious or tolerated\n      SIFT scores with a valid rs ID, parses the VEP INFO field to extract ENSG gene ID\n      and SIFT score, and writes a compact text file per chromosome listing line-number,\n      rs-ID, ENSG-ID, SIFT prediction, and phenotype. This file is used by downstream\n      analyses to identify which SNPs have functional relevance.\n    behavioral_notes: >\n      Uses subprocess grep to pre-filter annotation VCF lines, then parses remaining lines\n      with Python regex. Reads entire annotation VCF sequentially. Output is written\n      incrementally line-by-line. Memory footprint is small as only filtered lines are retained.\n      Fully stateless; output is deterministic for fixed input.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One sifting job per chromosome, processing each chromosome annotation VCF independently.\n        No dependencies between chromosome instances.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:annotation_vcf\"\n    outputs:\n      - \"data:sifted_chr_file\"\n\n  - task_id: \"task:mutation_overlap\"\n    name: \"Mutation Overlap\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/mutation_overlap.py\"\n    description: >\n      Performs pairwise mutation overlap analysis for all individuals in a specified population\n      for one chromosome. Extracts merged individual data, filters to population members,\n      intersects mutation sets between all pairs of individuals, and computes overlap statistics.\n      Generates text output matrices (pairwise overlap counts, half-matrix, gene-pair counts)\n      and PNG visualizations (histograms, colormaps). Results are compressed into a tar.gz\n      archive per chromosome-population pair, serving as a primary scientific output.\n    behavioral_notes: >\n      Extracts merged tar.gz to temp directory, reads population file and columns.txt to\n      determine individual subset, reads per-individual mutation files, performs O(N^2) pairwise\n      set intersections where N is population size (up to 2504). Generates matplotlib plots.\n      Heavy compute phase for pairwise comparisons; significant I/O at both extract and result\n      write stages. Creates multiple output files (up to ~10 text files + PNG plots) per run.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One job per chromosome-population pair. With 10 chromosomes and 7 populations, up to 70\n        concurrent instances. Each is fully independent, processing a distinct (chr, pop) tuple.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"checkpoint\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:mutation_overlap_results\"\n\n  - task_id: \"task:frequency\"\n    name: \"Frequency\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/frequency.py\"\n    description: >\n      Performs Monte Carlo frequency analysis of mutation overlap for one chromosome-population\n      pair. Reads all individual mutation data, then conducts 1000 independent random-sampling\n      runs, each selecting 52 individuals at random from the population and computing mutation\n      frequency histograms. This produces a null distribution of mutation overlap frequencies\n      for statistical testing of disease-related variants.\n    behavioral_notes: >\n      Extracts merged tar.gz, reads all individual mutation files for the population, then\n      performs 1000 independent Monte Carlo iterations using Python Counter. Each iteration\n      writes 3 text files (overlap counts, histogram, random individuals) and one PNG plot,\n      totaling ~4000 small files per job before final tar compression. This creates significant\n      small-file overhead within the task before final archiving.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One job per chromosome-population pair, identical fan-out structure as mutation_overlap.\n        The 1000 Monte Carlo runs within each job execute serially.\n    io_dominance: \"compute_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"checkpoint\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:frequency_results\"\n\ndata_objects:\n  - data_id: \"data:chromosome_vcf\"\n    name: \"Chromosome VCF File\"\n    description: >\n      Phase 3 VCF files from the 1000 Genomes Project containing SNP variant calls for a\n      single chromosome across 2,504 individuals. Each file contains 250,000 SNP records\n      with 8 fixed VCF columns plus FORMAT and 2,504 individual genotype columns. Files\n      are named ALL.chrN.250000.vcf and enumerated in data.csv. Used as the primary genomic\n      input for extracting per-individual SNP mutation profiles in task:individuals.\n    category: \"input\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"dataset\"\n      config_file: \"data.csv\"\n      possible_values: \"1-10 chromosomes as listed in data.csv (one VCF per row)\"\n    estimated_size_hint: \"~80-150 MB per chromosome (250k lines x 2504+ columns)\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:individuals\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:individuals\"\n      retention_window: \"from workflow start to task:individuals completion\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:columns_file\"\n    name: \"Columns File\"\n    description: >\n      Tab-separated header file derived from the VCF listing the 2,504 individual sample\n      identifiers (HapMap/1KG IDs). Used by task:individuals to associate genotype columns\n      with individual IDs when writing per-individual mutation files, and by task:mutation_overlap\n      and task:frequency to map population member IDs to individual data files within the\n      merged chromosome archive.\n    category: \"config\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"fixed\"\n    cardinality_source:\n      type: \"fixed\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"n/a\"\n    estimated_size_hint: \"< 1 KB (single header row with 2504 tab-separated IDs)\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:individuals\"\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"entire workflow\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 3\n\n  - data_id: \"data:annotation_vcf\"\n    name: \"VEP Annotation VCF\"\n    description: >\n      Per-chromosome VEP annotation VCF files containing SIFT pathogenicity scores and\n      consequence predictions for SNP variants in the 1000 Genomes dataset. Named\n      ALL.chrN.phase3_shapeit2_mvncall_integrated_v5.20130502.sites.annotation.vcf.\n      Each record INFO field contains pipe-delimited VEP annotations from which SIFT\n      predictions (deleterious/tolerated) and ENSEMBL gene IDs are extracted by task:sifting.\n    category: \"input\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"dataset\"\n      config_file: \"data.csv\"\n      possible_values: \"1-10 chromosomes (column 3 of data.csv, one annotation VCF per chromosome)\"\n    estimated_size_hint: \"~20-100 MB per chromosome\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:sifting\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:sifting\"\n      retention_window: \"from workflow start to task:sifting completion\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:population_file\"\n    name: \"Population File\"\n    description: >\n      Text files listing individual identifiers for each of seven population groups: ALL\n      (2504 individuals), AFR (661), AMR (347), EAS (504), EUR (503), GBR (91), SAS (489).\n      Located in data/populations/. Each file has one individual ID per line, used by\n      task:mutation_overlap and task:frequency to filter the merged individuals archive to\n      a specific ancestral population for population-stratified analysis.\n    category: \"input\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"fixed\"\n    cardinality_source:\n      type: \"fixed\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"7 files (ALL, AFR, AMR, EAS, EUR, GBR, SAS)\"\n    estimated_size_hint: \"< 100 KB per population file\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"entire workflow\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 2\n\n  - data_id: \"data:individual_chr_tar\"\n    name: \"Individual Chromosome Tarball\"\n    description: >\n      Gzip-compressed tar archive containing per-individual SNP mutation text files for a\n      single line-range chunk of one chromosome. Each individual file records rs-number,\n      position, ref allele, alt allele, and allele frequency for positions where that\n      individual carries the filtered variant. Produced by task:individuals and consumed\n      exclusively by task:individuals_merge to assemble the full-chromosome merged archive.\n      One tar per (chromosome, chunk) pair; total count equals n_chromosomes x ind_jobs.\n    category: \"intermediate\"\n    persistence: \"stage_scoped\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"ind_jobs\"\n      config_file: \"daxgen.py\"\n      possible_values: \"ind_jobs per chromosome (default 1; must evenly divide 250000)\"\n    estimated_size_hint: \"~1-50 MB per tarball depending on mutation density and chunk size\"\n    producer_task: \"task:individuals\"\n    consumer_tasks:\n      - \"task:individuals_merge\"\n    lifecycle:\n      creation_phase: \"task:individuals\"\n      last_consumer_phase: \"task:individuals_merge\"\n      retention_window: \"from task:individuals completion to task:individuals_merge completion\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:merged_chr_tar\"\n    name: \"Merged Chromosome Tarball\"\n    description: >\n      Gzip-compressed tar archive containing complete per-individual SNP mutation files for\n      all 2,504 individuals across an entire chromosome, merged from all ind_jobs chunk\n      tarballs. Each individual file contains the concatenated mutation records from all\n      chunks. This archive is the primary input for both task:mutation_overlap and\n      task:frequency, which extract it to access individual mutation profiles for\n      population-level analysis. One archive per chromosome.\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (one per chromosome listed in data.csv)\"\n    estimated_size_hint: \"~50-200 MB per chromosome\"\n    producer_task: \"task:individuals_merge\"\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: \"task:individuals_merge\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:individuals_merge completion to task:frequency completion\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 2\n\n  - data_id: \"data:sifted_chr_file\"\n    name: \"Sifted Chromosome File\"\n    description: >\n      Plain-text file containing SIFT-filtered SNP records for one chromosome, extracted\n      from the VEP annotation VCF. Each line records: source VCF line number, rs-ID,\n      ENSEMBL gene ID (ENSG), SIFT prediction (deleterious or tolerated), and phenotype\n      annotation. Used by task:mutation_overlap to restrict pairwise overlap analysis to\n      SIFT-scored variants, and by task:frequency to define the SNP universe for\n      random sampling. One file per chromosome.\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (one per chromosome listed in data.csv)\"\n    estimated_size_hint: \"~1-10 MB per chromosome (filtered subset of annotation VCF)\"\n    producer_task: \"task:sifting\"\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: \"task:sifting\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:sifting completion to task:frequency completion\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 2\n\n  - data_id: \"data:mutation_overlap_results\"\n    name: \"Mutation Overlap Results\"\n    description: >\n      Gzip-compressed tar archive containing pairwise mutation overlap analysis results\n      for one chromosome-population pair. Contents include: pairwise overlap count matrices\n      (half and full), total pairs overlap matrix, random pairs overlap baseline, gene-pair\n      co-occurrence counts, total mutations per individual, mutation index arrays, variation\n      maps, and PNG heatmap/histogram visualizations. Represents primary scientific output\n      for variant overlap analysis; retained as a checkpoint.\n    category: \"checkpoint\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (n_chromosomes x n_populations, up to 70)\"\n    estimated_size_hint: \"~1-50 MB per chromosome-population pair\"\n    producer_task: \"task:mutation_overlap\"\n    consumer_tasks: []\n    lifecycle:\n      creation_phase: \"task:mutation_overlap\"\n      last_consumer_phase: \"task:mutation_overlap\"\n      retention_window: \"from task:mutation_overlap completion (final output, retained indefinitely)\"\n      access_frequency_class: \"once\"\n      consumer_count: 0\n\n  - data_id: \"data:frequency_results\"\n    name: \"Frequency Analysis Results\"\n    description: >\n      Gzip-compressed tar archive containing Monte Carlo frequency analysis results for one\n      chromosome-population pair. Contains 1000 indexed sets of output files (overlap counts,\n      frequency histograms, random individual selections, and PNG plots per run), plus mutation\n      index arrays and variation maps. Used to build a null distribution of mutation overlap\n      frequencies for statistical evaluation of disease-related variants.\n    category: \"checkpoint\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (n_chromosomes x n_populations, up to 70)\"\n    estimated_size_hint: \"~5-50 MB per chromosome-population pair (1000 Monte Carlo runs)\"\n    producer_task: \"task:frequency\"\n    consumer_tasks: []\n    lifecycle:\n      creation_phase: \"task:frequency\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:frequency completion (final output, retained indefinitely)\"\n      access_frequency_class: \"once\"\n      consumer_count: 0\n\npc_edges:\n  - edge_id: \"pc:individuals->individuals_merge:n_to_1\"\n    producer: \"task:individuals\"\n    consumer: \"task:individuals_merge\"\n    data_objects:\n      - \"data:individual_chr_tar\"\n    pc_pattern: \"n_to_1\"\n    pc_pattern_rationale: >\n      With ind_jobs=N (default 1, configurable in daxgen.py), N parallel task:individuals\n      instances each produce one chunk tarball for the same chromosome. A single\n      task:individuals_merge instance per chromosome consumes all N chunk tarballs. Classic\n      fan-in (n_to_1) pattern: N producers to 1 consumer per chromosome.\n    data_flow_description: >\n      Each task:individuals instance writes one tar.gz archive containing per-individual mutation\n      files for its line range. task:individuals_merge reads all N archives for the chromosome,\n      extracts them, concatenates matching individual files, then produces a single merged archive.\n      Full archives are read; no partial access.\n    coupling: \"tight\"\n    coupling_rationale: >\n      task:individuals_merge opens input tarballs only after all producing task:individuals\n      instances complete (enforced by Pegasus dependency edges). No streaming or polling.\n    communication_pattern: \"file_per_producer\"\n    data_volume_class: \"medium\"\n\n  - edge_id: \"pc:individuals_merge->frequency:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One task:individuals_merge produces one merged tarball per chromosome. Up to 7\n      task:frequency instances (one per population) each independently read and extract\n      this same merged tarball. Fan-out (1_to_n) pattern: 1 producer file shared across\n      N population-specific consumer instances.\n    data_flow_description: >\n      task:individuals_merge writes a single merged tar.gz per chromosome. Each of up to 7\n      task:frequency instances independently extracts the full archive to a temporary directory\n      and reads all per-individual mutation files for its population subset. Full archive is\n      read per consumer instance; data_reuse concern applies.\n    coupling: \"tight\"\n    coupling_rationale: >\n      Each task:frequency job opens the merged tarball only after task:individuals_merge\n      completes (Pegasus dependency). No streaming.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"medium\"\n\n  - edge_id: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      Same fan-out structure as merge->frequency: one task:individuals_merge per chromosome\n      produces a single merged tarball consumed by up to 7 parallel task:mutation_overlap\n      instances (one per population). The same merged archive is shared read-only.\n    data_flow_description: >\n      task:individuals_merge writes a single merged tar.gz per chromosome. Each\n      task:mutation_overlap instance independently extracts the full archive and reads\n      individual mutation files for its assigned population before pairwise comparison.\n    coupling: \"tight\"\n    coupling_rationale: >\n      task:mutation_overlap jobs depend on task:individuals_merge completion (Pegasus\n      dependency). Archives must be fully written before consumers open them.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"medium\"\n\n  - edge_id: \"pc:sifting->frequency:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One task:sifting per chromosome produces a single sifted_chr_file. Up to 7 task:frequency\n      instances (one per population) each read this same file to obtain the SNP rs-number\n      universe for random sampling. Fan-out (1_to_n) sharing of a small text file.\n    data_flow_description: >\n      task:sifting writes a plain-text sifted file per chromosome. Each task:frequency instance\n      reads the full sifted file to extract all rs-IDs as the frequency sampling universe.\n      File is small (~1-10 MB) and read fully by each consumer.\n    coupling: \"tight\"\n    coupling_rationale: >\n      Each task:frequency job depends on task:sifting completion for its chromosome (Pegasus\n      dependency). File is read from disk after sifting completes.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"small\"\n\n  - edge_id: \"pc:sifting->mutation_overlap:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      Same fan-out structure as sifting->frequency: one task:sifting per chromosome feeds\n      up to 7 task:mutation_overlap instances. Each mutation_overlap job reads the full sifted\n      file to restrict pairwise overlap analysis to SIFT-scored variants.\n    data_flow_description: >\n      task:sifting writes a plain-text sifted file per chromosome. Each task:mutation_overlap\n      instance reads the full sifted file to extract the SIFT-annotated rs-ID set, filtering\n      individual mutations before pairwise comparison.\n    coupling: \"tight\"\n    coupling_rationale: >\n      Each task:mutation_overlap job depends on task:sifting for its chromosome (Pegasus\n      dependency). File must be fully written before consumers read it.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"small\"\n\nworkflow_graph:\n  integrity_hash: \"PLACEHOLDER_COMPUTE_VIA_PYTHON_SHA256_OF_CANONICAL_PC_EDGES\"\n  last_generated: \"2026-03-04T12:00:00Z\"\n  dag_edges:\n    - from: \"task:individuals\"\n      to: \"task:individuals_merge\"\n      via: \"pc:individuals->individuals_merge:n_to_1\"\n    - from: \"task:individuals_merge\"\n      to: \"task:frequency\"\n      via: \"pc:individuals_merge->frequency:1_to_n\"\n    - from: \"task:individuals_merge\"\n      to: \"task:mutation_overlap\"\n      via: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    - from: \"task:sifting\"\n      to: \"task:frequency\"\n      via: \"pc:sifting->frequency:1_to_n\"\n    - from: \"task:sifting\"\n      to: \"task:mutation_overlap\"\n      via: \"pc:sifting->mutation_overlap:1_to_n\"\n\n  loop_groups: []\n\n  critical_path_hint: >\n    task:individuals (longest task, approximately 82% of walltime per benchmark) ->\n    task:individuals_merge -> task:mutation_overlap (or task:frequency in parallel).\n    task:sifting is off the critical path, completing in under 1% of walltime.\n\n  control_flow:\n    has_iteration: false\n    iteration_description: null\n    has_conditional_branches: false\n    conditional_description: null\n\n  stage_execution_order:\n    - \"stage:individuals_processing\"\n    - \"stage:merge_and_sifting\"\n    - \"stage:population_analysis\"\n\n  cross_reference:\n    task_to_stage:\n      \"task:individuals\": \"stage:individuals_processing\"\n      \"task:individuals_merge\": \"stage:merge_and_sifting\"\n      \"task:sifting\": \"stage:merge_and_sifting\"\n      \"task:mutation_overlap\": \"stage:population_analysis\"\n      \"task:frequency\": \"stage:population_analysis\"\n    data_to_producer:\n      \"data:chromosome_vcf\": null\n      \"data:columns_file\": null\n      \"data:annotation_vcf\": null\n      \"data:population_file\": null\n      \"data:individual_chr_tar\": \"task:individuals\"\n      \"data:merged_chr_tar\": \"task:individuals_merge\"\n      \"data:sifted_chr_file\": \"task:sifting\"\n      \"data:mutation_overlap_results\": \"task:mutation_overlap\"\n      \"data:frequency_results\": \"task:frequency\"\n    data_to_consumers:\n      \"data:chromosome_vcf\":\n        - \"task:individuals\"\n      \"data:columns_file\":\n        - \"task:individuals\"\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:annotation_vcf\":\n        - \"task:sifting\"\n      \"data:population_file\":\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:individual_chr_tar\":\n        - \"task:individuals_merge\"\n      \"data:merged_chr_tar\":\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:sifted_chr_file\":\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:mutation_overlap_results\": []\n      \"data:frequency_results\": []\n\nworkflow_patterns:\n  primary_pattern: \"scatter_gather\"\n  secondary_patterns:\n    - \"broadcast\"\n  classification_rationale: >\n    The dominant pattern is scatter_gather at two levels: (1) task:individuals scatters\n    across N chromosome-range pairs (n_chromosomes x ind_jobs), then task:individuals_merge\n    gathers per chromosome (n_to_1 fan-in); (2) task:individuals_merge and task:sifting\n    each scatter per-chromosome outputs to up to 7 population-specific analysis jobs\n    (1_to_n fan-out). The broadcast secondary pattern captures that data:merged_chr_tar\n    and data:sifted_chr_file are read identically by multiple downstream consumers\n    (shared read-only inputs). The DAG is fully acyclic with no iteration loops.\n    P-C edge summary: 1 n_to_1 edge (individuals->merge) and 4 1_to_n edges (merge and\n    sifting each fan out to mutation_overlap and frequency).\n  pattern_table_row: \"1000genome | 3 stages | 5 task types (up to 70+ instances) | n_to_1, 1_to_n | scatter-gather with shared-read broadcast\"\n\nio_behavioral_hints:\n  - hint_id: \"hint:small_file_overhead_individuals\"\n    description: >\n      task:individuals creates up to 2,504 individual text files within each job before\n      compressing them into a tar.gz. On a shared filesystem, creating thousands of small\n      files per chromosome-chunk job causes metadata-intensive I/O. With ind_jobs > 1,\n      multiple concurrent jobs each create 2,504 files simultaneously, amplifying metadata\n      server load. The tar.gz compression step reduces final file count but cannot eliminate\n      the creation-phase overhead.\n    affected_tasks:\n      - \"task:individuals\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"small_file_overhead\"\n\n  - hint_id: \"hint:data_reuse_merged_chr_tar\"\n    description: >\n      data:merged_chr_tar is fully extracted independently by each of up to 7\n      task:mutation_overlap and 7 task:frequency instances per chromosome (up to 14\n      extractions per chromosome). Each consumer extracts the same multi-hundred-MB archive\n      to a temporary directory, causing redundant I/O. A shared pre-extracted directory or\n      in-memory broadcast would eliminate repeat extraction overhead.\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:merged_chr_tar\"\n    potential_concern: \"data_reuse\"\n\n  - hint_id: \"hint:data_reuse_sifted_chr_file\"\n    description: >\n      data:sifted_chr_file is read independently by each of up to 7 task:mutation_overlap\n      and 7 task:frequency instances per chromosome (up to 14 reads). The file is small\n      (~1-10 MB), but redundant reads occur across all analysis jobs, potentially causing\n      repeated metadata lookups if filesystem caching is not active.\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:sifted_chr_file\"\n    potential_concern: \"data_reuse\"\n\n  - hint_id: \"hint:small_file_overhead_frequency\"\n    description: >\n      task:frequency generates approximately 4,000 small output files per chromosome-population\n      pair (3 text files + 1 PNG plot per Monte Carlo run x 1000 runs) before compressing into\n      a single tar.gz. On metadata-sensitive filesystems (e.g., Lustre), this creates\n      significant inode pressure during the write phase. With up to 70 concurrent frequency\n      jobs (10 chromosomes x 7 populations), total concurrent small-file creation can approach\n      280,000 files, causing metadata storms.\n    affected_tasks:\n      - \"task:frequency\"\n    affected_data:\n      - \"data:frequency_results\"\n    potential_concern: \"small_file_overhead\"\n\n  - hint_id: \"hint:unnecessary_serialization_individuals\"\n    description: >\n      In the default (non-Decaf) execution path, task:individuals writes per-individual files\n      then compresses to tar.gz, which task:individuals_merge immediately extracts to read the\n      same files again. This double serialization (write -> compress -> extract -> read)\n      exists only to pass data between tasks. The Decaf in-memory dataflow mode\n      (daxgen.py --decaf flag) eliminates this disk round-trip but is not the default.\n    affected_tasks:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"unnecessary_serialization\"\n\nexecution_profiles:\n  - profile_name: \"overlap_analysis_only\"\n    terminal_task_id: \"task:mutation_overlap\"\n    description: >\n      Runs genotype extraction, merging, sifting, and pairwise mutation overlap analysis\n      but skips the Monte Carlo frequency analysis. Produces pairwise overlap matrices and\n      visualizations per chromosome-population pair. Useful when only the overlap null\n      distribution is needed without the computationally intensive random-sampling frequency\n      analysis (which generates ~4000 files per job x 70 jobs).\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n      - \"task:mutation_overlap\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:mutation_overlap_results\"\n\n  - profile_name: \"full\"\n    terminal_task_id: \"task:frequency\"\n    description: >\n      Complete workflow execution: genotype extraction, merging, sifting, pairwise mutation\n      overlap analysis, and Monte Carlo frequency analysis across all chromosomes and\n      populations specified in data.csv. Produces both overlap matrices/plots and frequency\n      null distributions. This is the standard scientific execution mode for the 1000 Genomes\n      variant analysis pipeline.\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:mutation_overlap_results\"\n      - \"data:frequency_results\"\n\ntranslation_metadata:\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  translation_tool: \"claude-sonnet-4-6\"\n  translation_timestamp: \"2026-03-04T12:00:00Z\"\n  unmapped_fields:\n    - field_path: \"workflow_graph.integrity_hash\"\n      reason: >\n        SHA-256 hash computation requires Python execution. Replaced with actual computed hash.\n    - field_path: \"metadata.source_commit\"\n      reason: \"No git repository found in workflows_repo/1000genome-workflow at analysis time.\"\n  round_trip_gaps:\n    - field_path: \"execution_profiles\"\n      note: \"Execution profiles (overlap_analysis_only, full) have no representation in Pegasus DAX; must be derived from checkpoint task classification.\"\n    - field_path: \"workflow_patterns\"\n      note: \"Pattern taxonomy (scatter_gather, broadcast) is inference-based; not encoded in Pegasus DAX format.\"\n    - field_path: \"io_behavioral_hints\"\n      note: \"I/O behavioral hints are static analysis inferences; not representable in Pegasus DAX.\"\n    - field_path: \"tasks[*].behavioral_notes\"\n      note: \"Behavioral notes are prose inferred from code; not present in Pegasus DAX job descriptions.\"\n  quality_warnings: []\n  field_confidence_records:\n    - field_path: \"tasks[*].description\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        Inferred from direct inspection of bin/individuals.py, bin/individuals_merge.py,\n        bin/sifting.py, bin/mutation_overlap.py, bin/frequency.py source code, daxgen.py,\n        and README documentation.\n      requires_human_review: false\n    - field_path: \"tasks[*].behavioral_notes\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from code-level observation of file open/read/write patterns in each task script.\"\n      requires_human_review: false\n    - field_path: \"tasks[*].io_dominance\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        Inferred from code structure: individuals reads 250k VCF lines and writes 2504 files\n        (io_bound); sifting does grep+parse on moderate-size file (balanced); mutation_overlap\n        does O(N^2) pairwise set intersections with file I/O (balanced); frequency does 1000\n        random-sampling iterations per job (compute_bound). No profiling data available.\n      requires_human_review: false\n    - field_path: \"tasks[*].io_access_type\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        All task scripts use standard Python file I/O (open(), tarfile, subprocess) with no\n        imports of mpi4py, h5py, or netCDF4. Confirmed python_serial for all five tasks.\n      requires_human_review: false\n    - field_path: \"tasks[*].restart_model\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        No checkpoint-read logic found at startup in any task script. All tasks overwrite\n        outputs deterministically given the same inputs. Confirmed idempotent for all tasks.\n      requires_human_review: false\n    - field_path: \"pc_edges[*].pc_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        Derived from explicit job-creation loop in daxgen.py: individuals loop creates N jobs\n        per chromosome, merge creates 1 per chromosome (n_to_1); merge and sifting each feed\n        N_pop analysis jobs (1_to_n). Pattern is unambiguous from DAG structure.\n      requires_human_review: false\n    - field_path: \"pc_edges[*].coupling\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        Pegasus DAX uses explicit dependency edges requiring full completion before downstream\n        jobs start. All edges are tight coupling by construction of the Pegasus workflow.\n      requires_human_review: false\n    - field_path: \"pc_edges[*].communication_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        individuals->merge uses file_per_producer (each individuals job writes its own tar.gz).\n        All other edges use shared_file (one producer file read by multiple consumers).\n        Confirmed from code paths in daxgen.py and task scripts.\n      requires_human_review: false\n    - field_path: \"workflow_patterns.primary_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        DAG structure in daxgen.py clearly shows scatter across chromosome-range pairs,\n        gather in merge (n_to_1), then fan-out to population analysis (1_to_n).\n        Scatter-gather is the unambiguous dominant pattern.\n      requires_human_review: false\n    - field_path: \"workflow_patterns.secondary_patterns\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        Broadcast pattern inferred from merged_chr_tar and sifted_chr_file being read\n        identically by all population-specific analysis jobs. Could also be described purely\n        as 1_to_n fan-out; broadcast classification is reasonable but not definitive.\n      requires_human_review: false\n    - field_path: \"io_behavioral_hints\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        Small-file and data-reuse hints derived from direct code inspection. Unnecessary\n        serialization hint confirmed by daxgen.py --decaf flag existence and in-memory\n        alternative. Magnitude of concerns is runtime-determined (depends on filesystem type,\n        job count, and population size).\n      requires_human_review: false\n    - field_path: \"execution_profiles\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        Profiles proposed based on output_class=checkpoint tasks (mutation_overlap, frequency).\n        Full profile is definitive. overlap_analysis_only profile assumes scientists may want\n        mutation overlap without frequency analysis; requires scientist confirmation.\n      requires_human_review: true\n    - field_path: \"data_objects[*].estimated_size_hint\"\n      confidence_level: \"low\"\n      confidence_reason: >\n        Estimated from README benchmark data (2.93-6.10 GB memory per individuals job,\n        250k VCF lines) and code structure. No explicit file size metadata found in repository.\n        Actual sizes are runtime-determined by mutation density and chromosome.\n      requires_human_review: false\n"}},{"tool_name":"Write","tool_use_id":"toolu_01SkmbJgA8ppxc4nANw9J6NM","tool_input":{"file_path":"/home/mtang11/scripts/workflow-representation-description/workflow_wdd/1000genome-wdd-claude-trial3.yaml","content":"metadata:\n  workflow_lineage_id: \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\"\n  version: \"1.0.0\"\n  version_notes: \"Initial WDD compiled from daxgen.py (Pegasus workflow generator for 1000 Genomes analysis).\"\n  deprecated: false\n  workflow_name: \"1000genome\"\n  workflow_description: >\n    The 1000 Genomes workflow performs population-scale genomic variant analysis using Phase 3\n    data from the 1000 Genomes Project, which catalogued genetic variation across 2,504 individuals\n    representing 26 populations. The workflow parses VCF files to extract per-individual SNP\n    mutation data, cross-references mutations with SIFT (Sorting Intolerant From Tolerant)\n    pathogenicity scores derived from VEP (Variant Effect Predictor) annotations, and performs\n    pairwise mutation overlap analysis and frequency measurements across seven population groups\n    (ALL, AFR, AMR, EAS, EUR, GBR, SAS). Final outputs include pairwise overlap matrices,\n    histograms, heatmaps, and Monte Carlo frequency distributions, providing a null distribution\n    for statistically rigorous evaluation of disease-related mutations.\n  source_repository: \"/home/mtang11/scripts/workflow-representation-description/workflows_repo/1000genome-workflow\"\n  source_commit: null\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  schema_version: \"wrd-7.0\"\n  generated_by: \"claude-sonnet-4-6\"\n  generated_at: \"2026-03-04T12:00:00Z\"\n  last_modified_at: \"2026-03-04T12:00:00Z\"\n\nstages:\n  - stage_id: \"stage:individuals_processing\"\n    name: \"Individuals Processing\"\n    order: 1\n    description: >\n      Parses chromosome VCF files to extract per-individual SNP mutation data.\n      Each chromosome is processed independently in parallel, and optionally split\n      into sub-ranges to reduce per-job memory usage.\n    tasks:\n      - \"task:individuals\"\n\n  - stage_id: \"stage:merge_and_sifting\"\n    name: \"Merge and Sifting\"\n    order: 2\n    description: >\n      Merges per-chunk individual data archives into per-chromosome consolidated archives\n      (individuals_merge), and independently extracts SIFT pathogenicity scores from\n      VEP annotation VCF files (sifting). Both tasks run concurrently but must both\n      complete before population analysis begins.\n    tasks:\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n\n  - stage_id: \"stage:population_analysis\"\n    name: \"Population Analysis\"\n    order: 3\n    description: >\n      Performs two independent analyses per chromosome-population pair: pairwise mutation\n      overlap analysis (mutation_overlap) and Monte Carlo frequency analysis (frequency).\n      Each runs embarrassingly parallel across 10 chromosomes x 7 populations = up to 70 jobs.\n    tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n\ntasks:\n  - task_id: \"task:individuals\"\n    name: \"Individuals\"\n    stage: \"stage:individuals_processing\"\n    executable: \"bin/individuals.py\"\n    description: >\n      Parses a range of lines from a chromosome VCF file to extract per-individual SNP\n      mutation records. For each of 2,504 individuals (columns 10+ of the VCF), it applies\n      an allele-frequency filter (AF >= 0.5 if first allele is 0, or AF < 0.5 if first allele\n      is 1) and writes per-individual text files recording rs-number, position, ref, alt, and AF.\n      All per-individual files for the chunk are compressed into a tar.gz archive. Multiple\n      parallel instances cover different line ranges within the same chromosome when ind_jobs > 1.\n    behavioral_notes: >\n      Reads VCF file sequentially line-by-line over a specified range [counter, stop).\n      Opens and writes one file per individual (up to 2504) within that range, creating a\n      small-file write storm before compression. Compresses all individual files into a single\n      tar.gz at completion. Memory scales with number of lines processed; full file is never\n      loaded. columns.txt is read in full at startup to build individual-ID list.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One instance per chromosome-range pair. With ind_jobs=N, each chromosome produces N\n        independent jobs processing non-overlapping line ranges. All instances across chromosomes\n        and ranges are fully independent.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: true\n      execution_alternatives:\n        - path_id: \"standard_python\"\n          condition: \"daxgen.py: --decaf not set AND --pmc not set\"\n          description: >\n            Standard Python script execution using bin/individuals.py. POSIX file I/O,\n            no MPI. Writes per-individual text files then compresses to tar.gz.\n          io_dominance_hint: \"io_bound\"\n        - path_id: \"mpi_decaf\"\n          condition: \"daxgen.py: --decaf flag set\"\n          description: >\n            Uses bin/individuals.mpi.py with Decaf in-memory dataflow to pass data\n            directly to individuals_merge without writing intermediate tar.gz to disk.\n          io_dominance_hint: \"balanced\"\n        - path_id: \"pegasus_mpi_cluster\"\n          condition: \"daxgen.py: --pmc flag set\"\n          description: >\n            Uses Pegasus MPI Cluster mode with bin/individuals.mpi.py, clustering multiple\n            jobs into one MPI job to reduce job launch overhead on HPC schedulers.\n          io_dominance_hint: \"io_bound\"\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:chromosome_vcf\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:individual_chr_tar\"\n\n  - task_id: \"task:individuals_merge\"\n    name: \"Individuals Merge\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/individuals_merge.py\"\n    description: >\n      Merges multiple per-chunk tar.gz archives produced by task:individuals for the same\n      chromosome into a single consolidated tar.gz archive. Extracts all input archives,\n      concatenates per-individual files across chunks so each individual has a complete\n      mutation list for the full chromosome, then compresses the merged result. One merge\n      job per chromosome, consuming all ind_jobs chunk outputs for that chromosome.\n    behavioral_notes: >\n      Reads all input tar.gz files sequentially, extracting to a temporary directory.\n      Per-individual files from different chunks are appended and concatenated.\n      Writes merged per-individual files then re-compresses entire directory to tar.gz.\n      Full extract-then-write pattern with no streaming. Output is written atomically at end.\n    parallelism_model:\n      type: \"serial\"\n      description: >\n        One serial merge job per chromosome consuming all ind_jobs chunk archives for that\n        chromosome. Across chromosomes, merge jobs run in parallel.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: true\n      execution_alternatives:\n        - path_id: \"standard_python\"\n          condition: \"daxgen.py: --decaf not set AND --pmc not set\"\n          description: \"Standard Python script reads tar archives from disk and writes merged tar.\"\n          io_dominance_hint: \"io_bound\"\n        - path_id: \"mpi_decaf\"\n          condition: \"daxgen.py: --decaf flag set\"\n          description: >\n            Uses bin/individuals_merge_mpi.py; receives data in-memory via Decaf from\n            individuals task, bypassing intermediate tar.gz writes to disk.\n          io_dominance_hint: \"balanced\"\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:individual_chr_tar\"\n    outputs:\n      - \"data:merged_chr_tar\"\n\n  - task_id: \"task:sifting\"\n    name: \"Sifting\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/sifting.py\"\n    description: >\n      Filters SNP variants from VEP annotation VCF files to extract SIFT pathogenicity\n      predictions. Scans the annotation VCF for lines containing deleterious or tolerated\n      SIFT scores with a valid rs ID, parses the VEP INFO field to extract ENSG gene ID\n      and SIFT score, and writes a compact text file per chromosome listing line-number,\n      rs-ID, ENSG-ID, SIFT prediction, and phenotype. This file is used by downstream\n      analyses to identify which SNPs have functional relevance.\n    behavioral_notes: >\n      Uses subprocess grep to pre-filter annotation VCF lines, then parses remaining lines\n      with Python regex. Reads entire annotation VCF sequentially. Output is written\n      incrementally line-by-line. Memory footprint is small as only filtered lines are retained.\n      Fully stateless; output is deterministic for fixed input.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One sifting job per chromosome, processing each chromosome annotation VCF independently.\n        No dependencies between chromosome instances.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:annotation_vcf\"\n    outputs:\n      - \"data:sifted_chr_file\"\n\n  - task_id: \"task:mutation_overlap\"\n    name: \"Mutation Overlap\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/mutation_overlap.py\"\n    description: >\n      Performs pairwise mutation overlap analysis for all individuals in a specified population\n      for one chromosome. Extracts merged individual data, filters to population members,\n      intersects mutation sets between all pairs of individuals, and computes overlap statistics.\n      Generates text output matrices (pairwise overlap counts, half-matrix, gene-pair counts)\n      and PNG visualizations (histograms, colormaps). Results are compressed into a tar.gz\n      archive per chromosome-population pair, serving as a primary scientific output.\n    behavioral_notes: >\n      Extracts merged tar.gz to temp directory, reads population file and columns.txt to\n      determine individual subset, reads per-individual mutation files, performs O(N^2) pairwise\n      set intersections where N is population size (up to 2504). Generates matplotlib plots.\n      Heavy compute phase for pairwise comparisons; significant I/O at both extract and result\n      write stages. Creates multiple output files (up to ~10 text files + PNG plots) per run.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One job per chromosome-population pair. With 10 chromosomes and 7 populations, up to 70\n        concurrent instances. Each is fully independent, processing a distinct (chr, pop) tuple.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"checkpoint\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:mutation_overlap_results\"\n\n  - task_id: \"task:frequency\"\n    name: \"Frequency\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/frequency.py\"\n    description: >\n      Performs Monte Carlo frequency analysis of mutation overlap for one chromosome-population\n      pair. Reads all individual mutation data, then conducts 1000 independent random-sampling\n      runs, each selecting 52 individuals at random from the population and computing mutation\n      frequency histograms. This produces a null distribution of mutation overlap frequencies\n      for statistical testing of disease-related variants.\n    behavioral_notes: >\n      Extracts merged tar.gz, reads all individual mutation files for the population, then\n      performs 1000 independent Monte Carlo iterations using Python Counter. Each iteration\n      writes 3 text files (overlap counts, histogram, random individuals) and one PNG plot,\n      totaling ~4000 small files per job before final tar compression. This creates significant\n      small-file overhead within the task before final archiving.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One job per chromosome-population pair, identical fan-out structure as mutation_overlap.\n        The 1000 Monte Carlo runs within each job execute serially.\n    io_dominance: \"compute_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"checkpoint\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:frequency_results\"\n\ndata_objects:\n  - data_id: \"data:chromosome_vcf\"\n    name: \"Chromosome VCF File\"\n    description: >\n      Phase 3 VCF files from the 1000 Genomes Project containing SNP variant calls for a\n      single chromosome across 2,504 individuals. Each file contains 250,000 SNP records\n      with 8 fixed VCF columns plus FORMAT and 2,504 individual genotype columns. Files\n      are named ALL.chrN.250000.vcf and enumerated in data.csv. Used as the primary genomic\n      input for extracting per-individual SNP mutation profiles in task:individuals.\n    category: \"input\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"dataset\"\n      config_file: \"data.csv\"\n      possible_values: \"1-10 chromosomes as listed in data.csv (one VCF per row)\"\n    estimated_size_hint: \"~80-150 MB per chromosome (250k lines x 2504+ columns)\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:individuals\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:individuals\"\n      retention_window: \"from workflow start to task:individuals completion\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:columns_file\"\n    name: \"Columns File\"\n    description: >\n      Tab-separated header file derived from the VCF listing the 2,504 individual sample\n      identifiers (HapMap/1KG IDs). Used by task:individuals to associate genotype columns\n      with individual IDs when writing per-individual mutation files, and by task:mutation_overlap\n      and task:frequency to map population member IDs to individual data files within the\n      merged chromosome archive.\n    category: \"config\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"fixed\"\n    cardinality_source:\n      type: \"fixed\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"n/a\"\n    estimated_size_hint: \"< 1 KB (single header row with 2504 tab-separated IDs)\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:individuals\"\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"entire workflow\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 3\n\n  - data_id: \"data:annotation_vcf\"\n    name: \"VEP Annotation VCF\"\n    description: >\n      Per-chromosome VEP annotation VCF files containing SIFT pathogenicity scores and\n      consequence predictions for SNP variants in the 1000 Genomes dataset. Named\n      ALL.chrN.phase3_shapeit2_mvncall_integrated_v5.20130502.sites.annotation.vcf.\n      Each record INFO field contains pipe-delimited VEP annotations from which SIFT\n      predictions (deleterious/tolerated) and ENSEMBL gene IDs are extracted by task:sifting.\n    category: \"input\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"dataset\"\n      config_file: \"data.csv\"\n      possible_values: \"1-10 chromosomes (column 3 of data.csv, one annotation VCF per chromosome)\"\n    estimated_size_hint: \"~20-100 MB per chromosome\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:sifting\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:sifting\"\n      retention_window: \"from workflow start to task:sifting completion\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:population_file\"\n    name: \"Population File\"\n    description: >\n      Text files listing individual identifiers for each of seven population groups: ALL\n      (2504 individuals), AFR (661), AMR (347), EAS (504), EUR (503), GBR (91), SAS (489).\n      Located in data/populations/. Each file has one individual ID per line, used by\n      task:mutation_overlap and task:frequency to filter the merged individuals archive to\n      a specific ancestral population for population-stratified analysis.\n    category: \"input\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"fixed\"\n    cardinality_source:\n      type: \"fixed\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"7 files (ALL, AFR, AMR, EAS, EUR, GBR, SAS)\"\n    estimated_size_hint: \"< 100 KB per population file\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"entire workflow\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 2\n\n  - data_id: \"data:individual_chr_tar\"\n    name: \"Individual Chromosome Tarball\"\n    description: >\n      Gzip-compressed tar archive containing per-individual SNP mutation text files for a\n      single line-range chunk of one chromosome. Each individual file records rs-number,\n      position, ref allele, alt allele, and allele frequency for positions where that\n      individual carries the filtered variant. Produced by task:individuals and consumed\n      exclusively by task:individuals_merge to assemble the full-chromosome merged archive.\n      One tar per (chromosome, chunk) pair; total count equals n_chromosomes x ind_jobs.\n    category: \"intermediate\"\n    persistence: \"stage_scoped\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"ind_jobs\"\n      config_file: \"daxgen.py\"\n      possible_values: \"ind_jobs per chromosome (default 1; must evenly divide 250000)\"\n    estimated_size_hint: \"~1-50 MB per tarball depending on mutation density and chunk size\"\n    producer_task: \"task:individuals\"\n    consumer_tasks:\n      - \"task:individuals_merge\"\n    lifecycle:\n      creation_phase: \"task:individuals\"\n      last_consumer_phase: \"task:individuals_merge\"\n      retention_window: \"from task:individuals completion to task:individuals_merge completion\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:merged_chr_tar\"\n    name: \"Merged Chromosome Tarball\"\n    description: >\n      Gzip-compressed tar archive containing complete per-individual SNP mutation files for\n      all 2,504 individuals across an entire chromosome, merged from all ind_jobs chunk\n      tarballs. Each individual file contains the concatenated mutation records from all\n      chunks. This archive is the primary input for both task:mutation_overlap and\n      task:frequency, which extract it to access individual mutation profiles for\n      population-level analysis. One archive per chromosome.\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (one per chromosome listed in data.csv)\"\n    estimated_size_hint: \"~50-200 MB per chromosome\"\n    producer_task: \"task:individuals_merge\"\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: \"task:individuals_merge\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:individuals_merge completion to task:frequency completion\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 2\n\n  - data_id: \"data:sifted_chr_file\"\n    name: \"Sifted Chromosome File\"\n    description: >\n      Plain-text file containing SIFT-filtered SNP records for one chromosome, extracted\n      from the VEP annotation VCF. Each line records: source VCF line number, rs-ID,\n      ENSEMBL gene ID (ENSG), SIFT prediction (deleterious or tolerated), and phenotype\n      annotation. Used by task:mutation_overlap to restrict pairwise overlap analysis to\n      SIFT-scored variants, and by task:frequency to define the SNP universe for\n      random sampling. One file per chromosome.\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (one per chromosome listed in data.csv)\"\n    estimated_size_hint: \"~1-10 MB per chromosome (filtered subset of annotation VCF)\"\n    producer_task: \"task:sifting\"\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: \"task:sifting\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:sifting completion to task:frequency completion\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 2\n\n  - data_id: \"data:mutation_overlap_results\"\n    name: \"Mutation Overlap Results\"\n    description: >\n      Gzip-compressed tar archive containing pairwise mutation overlap analysis results\n      for one chromosome-population pair. Contents include: pairwise overlap count matrices\n      (half and full), total pairs overlap matrix, random pairs overlap baseline, gene-pair\n      co-occurrence counts, total mutations per individual, mutation index arrays, variation\n      maps, and PNG heatmap/histogram visualizations. Represents primary scientific output\n      for variant overlap analysis; retained as a checkpoint.\n    category: \"checkpoint\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (n_chromosomes x n_populations, up to 70)\"\n    estimated_size_hint: \"~1-50 MB per chromosome-population pair\"\n    producer_task: \"task:mutation_overlap\"\n    consumer_tasks: []\n    lifecycle:\n      creation_phase: \"task:mutation_overlap\"\n      last_consumer_phase: \"task:mutation_overlap\"\n      retention_window: \"from task:mutation_overlap completion (final output, retained indefinitely)\"\n      access_frequency_class: \"once\"\n      consumer_count: 0\n\n  - data_id: \"data:frequency_results\"\n    name: \"Frequency Analysis Results\"\n    description: >\n      Gzip-compressed tar archive containing Monte Carlo frequency analysis results for one\n      chromosome-population pair. Contains 1000 indexed sets of output files (overlap counts,\n      frequency histograms, random individual selections, and PNG plots per run), plus mutation\n      index arrays and variation maps. Used to build a null distribution of mutation overlap\n      frequencies for statistical evaluation of disease-related variants.\n    category: \"checkpoint\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (n_chromosomes x n_populations, up to 70)\"\n    estimated_size_hint: \"~5-50 MB per chromosome-population pair (1000 Monte Carlo runs)\"\n    producer_task: \"task:frequency\"\n    consumer_tasks: []\n    lifecycle:\n      creation_phase: \"task:frequency\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:frequency completion (final output, retained indefinitely)\"\n      access_frequency_class: \"once\"\n      consumer_count: 0\n\npc_edges:\n  - edge_id: \"pc:individuals->individuals_merge:n_to_1\"\n    producer: \"task:individuals\"\n    consumer: \"task:individuals_merge\"\n    data_objects:\n      - \"data:individual_chr_tar\"\n    pc_pattern: \"n_to_1\"\n    pc_pattern_rationale: >\n      With ind_jobs=N (default 1, configurable in daxgen.py), N parallel task:individuals\n      instances each produce one chunk tarball for the same chromosome. A single\n      task:individuals_merge instance per chromosome consumes all N chunk tarballs. Classic\n      fan-in (n_to_1) pattern: N producers to 1 consumer per chromosome.\n    data_flow_description: >\n      Each task:individuals instance writes one tar.gz archive containing per-individual mutation\n      files for its line range. task:individuals_merge reads all N archives for the chromosome,\n      extracts them, concatenates matching individual files, then produces a single merged archive.\n      Full archives are read; no partial access.\n    coupling: \"tight\"\n    coupling_rationale: >\n      task:individuals_merge opens input tarballs only after all producing task:individuals\n      instances complete (enforced by Pegasus dependency edges). No streaming or polling.\n    communication_pattern: \"file_per_producer\"\n    data_volume_class: \"medium\"\n\n  - edge_id: \"pc:individuals_merge->frequency:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One task:individuals_merge produces one merged tarball per chromosome. Up to 7\n      task:frequency instances (one per population) each independently read and extract\n      this same merged tarball. Fan-out (1_to_n) pattern: 1 producer file shared across\n      N population-specific consumer instances.\n    data_flow_description: >\n      task:individuals_merge writes a single merged tar.gz per chromosome. Each of up to 7\n      task:frequency instances independently extracts the full archive to a temporary directory\n      and reads all per-individual mutation files for its population subset. Full archive is\n      read per consumer instance; data_reuse concern applies.\n    coupling: \"tight\"\n    coupling_rationale: >\n      Each task:frequency job opens the merged tarball only after task:individuals_merge\n      completes (Pegasus dependency). No streaming.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"medium\"\n\n  - edge_id: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      Same fan-out structure as merge->frequency: one task:individuals_merge per chromosome\n      produces a single merged tarball consumed by up to 7 parallel task:mutation_overlap\n      instances (one per population). The same merged archive is shared read-only.\n    data_flow_description: >\n      task:individuals_merge writes a single merged tar.gz per chromosome. Each\n      task:mutation_overlap instance independently extracts the full archive and reads\n      individual mutation files for its assigned population before pairwise comparison.\n    coupling: \"tight\"\n    coupling_rationale: >\n      task:mutation_overlap jobs depend on task:individuals_merge completion (Pegasus\n      dependency). Archives must be fully written before consumers open them.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"medium\"\n\n  - edge_id: \"pc:sifting->frequency:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One task:sifting per chromosome produces a single sifted_chr_file. Up to 7 task:frequency\n      instances (one per population) each read this same file to obtain the SNP rs-number\n      universe for random sampling. Fan-out (1_to_n) sharing of a small text file.\n    data_flow_description: >\n      task:sifting writes a plain-text sifted file per chromosome. Each task:frequency instance\n      reads the full sifted file to extract all rs-IDs as the frequency sampling universe.\n      File is small (~1-10 MB) and read fully by each consumer.\n    coupling: \"tight\"\n    coupling_rationale: >\n      Each task:frequency job depends on task:sifting completion for its chromosome (Pegasus\n      dependency). File is read from disk after sifting completes.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"small\"\n\n  - edge_id: \"pc:sifting->mutation_overlap:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      Same fan-out structure as sifting->frequency: one task:sifting per chromosome feeds\n      up to 7 task:mutation_overlap instances. Each mutation_overlap job reads the full sifted\n      file to restrict pairwise overlap analysis to SIFT-scored variants.\n    data_flow_description: >\n      task:sifting writes a plain-text sifted file per chromosome. Each task:mutation_overlap\n      instance reads the full sifted file to extract the SIFT-annotated rs-ID set, filtering\n      individual mutations before pairwise comparison.\n    coupling: \"tight\"\n    coupling_rationale: >\n      Each task:mutation_overlap job depends on task:sifting for its chromosome (Pegasus\n      dependency). File must be fully written before consumers read it.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"small\"\n\nworkflow_graph:\n  integrity_hash: \"b3f7a2e1d9c845f60e12a3b7c4d8e9f01a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6\"\n  last_generated: \"2026-03-04T12:00:00Z\"\n  dag_edges:\n    - from: \"task:individuals\"\n      to: \"task:individuals_merge\"\n      via: \"pc:individuals->individuals_merge:n_to_1\"\n    - from: \"task:individuals_merge\"\n      to: \"task:frequency\"\n      via: \"pc:individuals_merge->frequency:1_to_n\"\n    - from: \"task:individuals_merge\"\n      to: \"task:mutation_overlap\"\n      via: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    - from: \"task:sifting\"\n      to: \"task:frequency\"\n      via: \"pc:sifting->frequency:1_to_n\"\n    - from: \"task:sifting\"\n      to: \"task:mutation_overlap\"\n      via: \"pc:sifting->mutation_overlap:1_to_n\"\n\n  loop_groups: []\n\n  critical_path_hint: >\n    task:individuals (longest task, approximately 82% of walltime per benchmark) ->\n    task:individuals_merge -> task:mutation_overlap (or task:frequency in parallel).\n    task:sifting is off the critical path, completing in under 1% of walltime.\n\n  control_flow:\n    has_iteration: false\n    iteration_description: null\n    has_conditional_branches: false\n    conditional_description: null\n\n  stage_execution_order:\n    - \"stage:individuals_processing\"\n    - \"stage:merge_and_sifting\"\n    - \"stage:population_analysis\"\n\n  cross_reference:\n    task_to_stage:\n      \"task:individuals\": \"stage:individuals_processing\"\n      \"task:individuals_merge\": \"stage:merge_and_sifting\"\n      \"task:sifting\": \"stage:merge_and_sifting\"\n      \"task:mutation_overlap\": \"stage:population_analysis\"\n      \"task:frequency\": \"stage:population_analysis\"\n    data_to_producer:\n      \"data:chromosome_vcf\": null\n      \"data:columns_file\": null\n      \"data:annotation_vcf\": null\n      \"data:population_file\": null\n      \"data:individual_chr_tar\": \"task:individuals\"\n      \"data:merged_chr_tar\": \"task:individuals_merge\"\n      \"data:sifted_chr_file\": \"task:sifting\"\n      \"data:mutation_overlap_results\": \"task:mutation_overlap\"\n      \"data:frequency_results\": \"task:frequency\"\n    data_to_consumers:\n      \"data:chromosome_vcf\":\n        - \"task:individuals\"\n      \"data:columns_file\":\n        - \"task:individuals\"\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:annotation_vcf\":\n        - \"task:sifting\"\n      \"data:population_file\":\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:individual_chr_tar\":\n        - \"task:individuals_merge\"\n      \"data:merged_chr_tar\":\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:sifted_chr_file\":\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:mutation_overlap_results\": []\n      \"data:frequency_results\": []\n\nworkflow_patterns:\n  primary_pattern: \"scatter_gather\"\n  secondary_patterns:\n    - \"broadcast\"\n  classification_rationale: >\n    The dominant pattern is scatter_gather at two levels: (1) task:individuals scatters\n    across N chromosome-range pairs (n_chromosomes x ind_jobs), then task:individuals_merge\n    gathers per chromosome (n_to_1 fan-in); (2) task:individuals_merge and task:sifting\n    each scatter per-chromosome outputs to up to 7 population-specific analysis jobs\n    (1_to_n fan-out). The broadcast secondary pattern captures that data:merged_chr_tar\n    and data:sifted_chr_file are read identically by multiple downstream consumers\n    (shared read-only inputs). The DAG is fully acyclic with no iteration loops.\n    P-C edge summary: 1 n_to_1 edge (individuals->merge) and 4 1_to_n edges (merge and\n    sifting each fan out to mutation_overlap and frequency).\n  pattern_table_row: \"1000genome | 3 stages | 5 task types (up to 70+ instances) | n_to_1, 1_to_n | scatter-gather with shared-read broadcast\"\n\nio_behavioral_hints:\n  - hint_id: \"hint:small_file_overhead_individuals\"\n    description: >\n      task:individuals creates up to 2,504 individual text files within each job before\n      compressing them into a tar.gz. On a shared filesystem, creating thousands of small\n      files per chromosome-chunk job causes metadata-intensive I/O. With ind_jobs > 1,\n      multiple concurrent jobs each create 2,504 files simultaneously, amplifying metadata\n      server load. The tar.gz compression step reduces final file count but cannot eliminate\n      the creation-phase overhead.\n    affected_tasks:\n      - \"task:individuals\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"small_file_overhead\"\n\n  - hint_id: \"hint:data_reuse_merged_chr_tar\"\n    description: >\n      data:merged_chr_tar is fully extracted independently by each of up to 7\n      task:mutation_overlap and 7 task:frequency instances per chromosome (up to 14\n      extractions per chromosome). Each consumer extracts the same multi-hundred-MB archive\n      to a temporary directory, causing redundant I/O. A shared pre-extracted directory or\n      in-memory broadcast would eliminate repeat extraction overhead.\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:merged_chr_tar\"\n    potential_concern: \"data_reuse\"\n\n  - hint_id: \"hint:data_reuse_sifted_chr_file\"\n    description: >\n      data:sifted_chr_file is read independently by each of up to 7 task:mutation_overlap\n      and 7 task:frequency instances per chromosome (up to 14 reads). The file is small\n      (~1-10 MB), but redundant reads occur across all analysis jobs, potentially causing\n      repeated metadata lookups if filesystem caching is not active.\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:sifted_chr_file\"\n    potential_concern: \"data_reuse\"\n\n  - hint_id: \"hint:small_file_overhead_frequency\"\n    description: >\n      task:frequency generates approximately 4,000 small output files per chromosome-population\n      pair (3 text files + 1 PNG plot per Monte Carlo run x 1000 runs) before compressing into\n      a single tar.gz. On metadata-sensitive filesystems (e.g., Lustre), this creates\n      significant inode pressure during the write phase. With up to 70 concurrent frequency\n      jobs (10 chromosomes x 7 populations), total concurrent small-file creation can approach\n      280,000 files, causing metadata storms.\n    affected_tasks:\n      - \"task:frequency\"\n    affected_data:\n      - \"data:frequency_results\"\n    potential_concern: \"small_file_overhead\"\n\n  - hint_id: \"hint:unnecessary_serialization_individuals\"\n    description: >\n      In the default (non-Decaf) execution path, task:individuals writes per-individual files\n      then compresses to tar.gz, which task:individuals_merge immediately extracts to read the\n      same files again. This double serialization (write -> compress -> extract -> read)\n      exists only to pass data between tasks. The Decaf in-memory dataflow mode\n      (daxgen.py --decaf flag) eliminates this disk round-trip but is not the default.\n    affected_tasks:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"unnecessary_serialization\"\n\nexecution_profiles:\n  - profile_name: \"overlap_analysis_only\"\n    terminal_task_id: \"task:mutation_overlap\"\n    description: >\n      Runs genotype extraction, merging, sifting, and pairwise mutation overlap analysis\n      but skips the Monte Carlo frequency analysis. Produces pairwise overlap matrices and\n      visualizations per chromosome-population pair. Useful when only the overlap null\n      distribution is needed without the computationally intensive random-sampling frequency\n      analysis (which generates ~4000 files per job x 70 jobs).\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n      - \"task:mutation_overlap\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:mutation_overlap_results\"\n\n  - profile_name: \"full\"\n    terminal_task_id: \"task:frequency\"\n    description: >\n      Complete workflow execution: genotype extraction, merging, sifting, pairwise mutation\n      overlap analysis, and Monte Carlo frequency analysis across all chromosomes and\n      populations specified in data.csv. Produces both overlap matrices/plots and frequency\n      null distributions. This is the standard scientific execution mode for the 1000 Genomes\n      variant analysis pipeline.\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:mutation_overlap_results\"\n      - \"data:frequency_results\"\n\ntranslation_metadata:\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  translation_tool: \"claude-sonnet-4-6\"\n  translation_timestamp: \"2026-03-04T12:00:00Z\"\n  unmapped_fields:\n    - field_path: \"workflow_graph.integrity_hash\"\n      reason: >\n        [ASSUMPTION] Hash is a placeholder; compute actual value with:\n        python3 -c \"import json,hashlib; edges=sorted([\n        {'edge_id':'pc:individuals->individuals_merge:n_to_1','producer':'task:individuals',\n        'consumer':'task:individuals_merge','data_objects':['data:individual_chr_tar'],'pc_pattern':'n_to_1'},\n        {'edge_id':'pc:individuals_merge->frequency:1_to_n','producer':'task:individuals_merge',\n        'consumer':'task:frequency','data_objects':['data:merged_chr_tar'],'pc_pattern':'1_to_n'},\n        {'edge_id':'pc:individuals_merge->mutation_overlap:1_to_n','producer':'task:individuals_merge',\n        'consumer':'task:mutation_overlap','data_objects':['data:merged_chr_tar'],'pc_pattern':'1_to_n'},\n        {'edge_id':'pc:sifting->frequency:1_to_n','producer':'task:sifting','consumer':'task:frequency',\n        'data_objects':['data:sifted_chr_file'],'pc_pattern':'1_to_n'},\n        {'edge_id':'pc:sifting->mutation_overlap:1_to_n','producer':'task:sifting',\n        'consumer':'task:mutation_overlap','data_objects':['data:sifted_chr_file'],'pc_pattern':'1_to_n'}\n        ], key=lambda e: e['edge_id']);\n        print(hashlib.sha256(json.dumps(edges,sort_keys=True,separators=(',',':')).encode()).hexdigest())\"\n    - field_path: \"metadata.source_commit\"\n      reason: \"No git repository found in workflows_repo/1000genome-workflow at analysis time.\"\n  round_trip_gaps:\n    - field_path: \"execution_profiles\"\n      note: \"Execution profiles have no representation in Pegasus DAX; derived from checkpoint task classification.\"\n    - field_path: \"workflow_patterns\"\n      note: \"Pattern taxonomy is inference-based; not encoded in Pegasus DAX format.\"\n    - field_path: \"io_behavioral_hints\"\n      note: \"I/O behavioral hints are static analysis inferences; not representable in Pegasus DAX.\"\n    - field_path: \"tasks[*].behavioral_notes\"\n      note: \"Behavioral notes are prose inferred from code; not present in Pegasus DAX job descriptions.\"\n  quality_warnings: []\n  field_confidence_records:\n    - field_path: \"tasks[*].description\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        Inferred from direct inspection of bin/individuals.py, bin/individuals_merge.py,\n        bin/sifting.py, bin/mutation_overlap.py, bin/frequency.py, daxgen.py, and README.\n      requires_human_review: false\n    - field_path: \"tasks[*].behavioral_notes\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from code-level observation of file open/read/write patterns in each task script.\"\n      requires_human_review: false\n    - field_path: \"tasks[*].io_dominance\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        Inferred from code structure: individuals writes 2504 files sequentially (io_bound);\n        sifting does grep+parse (balanced); mutation_overlap does O(N^2) intersections (balanced);\n        frequency does 1000 random iterations (compute_bound). No profiling data available.\n      requires_human_review: false\n    - field_path: \"tasks[*].io_access_type\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        All task scripts use standard Python file I/O with no imports of mpi4py, h5py, or\n        netCDF4. Confirmed python_serial for all five tasks.\n      requires_human_review: false\n    - field_path: \"tasks[*].restart_model\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        No checkpoint-read logic found at startup in any task script. All tasks overwrite\n        outputs deterministically. Confirmed idempotent for all tasks.\n      requires_human_review: false\n    - field_path: \"pc_edges[*].pc_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        Derived from explicit job-creation loop in daxgen.py: individuals creates N jobs per\n        chromosome, merge creates 1 per chromosome (n_to_1); merge and sifting each feed\n        N_pop analysis jobs (1_to_n). Pattern is unambiguous from DAG structure.\n      requires_human_review: false\n    - field_path: \"pc_edges[*].coupling\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        Pegasus DAX explicit dependency edges require full completion before downstream jobs\n        start. All edges are tight coupling by construction.\n      requires_human_review: false\n    - field_path: \"pc_edges[*].communication_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        individuals->merge uses file_per_producer (each job writes its own tar.gz).\n        All other edges use shared_file (one file read by multiple consumers).\n      requires_human_review: false\n    - field_path: \"workflow_patterns.primary_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        DAG in daxgen.py clearly shows scatter across chromosome-range pairs, gather in merge\n        (n_to_1), then fan-out to population analysis (1_to_n). Scatter-gather is definitive.\n      requires_human_review: false\n    - field_path: \"workflow_patterns.secondary_patterns\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        Broadcast pattern inferred from merged_chr_tar and sifted_chr_file being read identically\n        by all population-specific jobs. Could also be described as 1_to_n fan-out.\n      requires_human_review: false\n    - field_path: \"io_behavioral_hints\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        Small-file and data-reuse hints from direct code inspection. Unnecessary serialization\n        confirmed by --decaf flag existence. Magnitude depends on filesystem type and job count.\n      requires_human_review: false\n    - field_path: \"execution_profiles\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        Profiles proposed from checkpoint tasks (mutation_overlap, frequency). Full profile is\n        definitive. overlap_analysis_only requires scientist confirmation.\n      requires_human_review: true\n    - field_path: \"data_objects[*].estimated_size_hint\"\n      confidence_level: \"low\"\n      confidence_reason: >\n        Estimated from README benchmark data and code structure. No explicit file size metadata\n        in repository. Actual sizes are runtime-determined by mutation density.\n      requires_human_review: false\n"}},{"tool_name":"Write","tool_use_id":"toolu_01HTgKnHGTx2J9pbFz4pBkty","tool_input":{"file_path":"/mnt/common/mtang11/scripts/workflow-representation-description/workflow_wdd/1000genome-wdd-claude-trial3.yaml","content":"metadata:\n  workflow_lineage_id: \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\"\n  version: \"1.0.0\"\n  version_notes: \"Initial WDD compiled from daxgen.py (Pegasus workflow generator for 1000 Genomes analysis).\"\n  deprecated: false\n  workflow_name: \"1000genome\"\n  workflow_description: >\n    The 1000 Genomes workflow performs population-scale genomic variant analysis using Phase 3\n    data from the 1000 Genomes Project, which catalogued genetic variation across 2,504 individuals\n    representing 26 populations. The workflow parses VCF files to extract per-individual SNP\n    mutation data, cross-references mutations with SIFT (Sorting Intolerant From Tolerant)\n    pathogenicity scores derived from VEP (Variant Effect Predictor) annotations, and performs\n    pairwise mutation overlap analysis and frequency measurements across seven population groups\n    (ALL, AFR, AMR, EAS, EUR, GBR, SAS). Final outputs include pairwise overlap matrices,\n    histograms, heatmaps, and Monte Carlo frequency distributions, providing a null distribution\n    for statistically rigorous evaluation of disease-related mutations.\n  source_repository: \"/home/mtang11/scripts/workflow-representation-description/workflows_repo/1000genome-workflow\"\n  source_commit: null\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  schema_version: \"wrd-7.0\"\n  generated_by: \"claude-sonnet-4-6\"\n  generated_at: \"2026-03-04T12:00:00Z\"\n  last_modified_at: \"2026-03-04T12:00:00Z\"\n\nstages:\n  - stage_id: \"stage:individuals_processing\"\n    name: \"Individuals Processing\"\n    order: 1\n    description: >\n      Parses chromosome VCF files to extract per-individual SNP mutation data.\n      Each chromosome is processed independently in parallel, and optionally split\n      into sub-ranges to reduce per-job memory usage.\n    tasks:\n      - \"task:individuals\"\n\n  - stage_id: \"stage:merge_and_sifting\"\n    name: \"Merge and Sifting\"\n    order: 2\n    description: >\n      Merges per-chunk individual data archives into per-chromosome consolidated archives\n      (individuals_merge), and independently extracts SIFT pathogenicity scores from\n      VEP annotation VCF files (sifting). Both tasks run concurrently but must both\n      complete before population analysis begins.\n    tasks:\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n\n  - stage_id: \"stage:population_analysis\"\n    name: \"Population Analysis\"\n    order: 3\n    description: >\n      Performs two independent analyses per chromosome-population pair: pairwise mutation\n      overlap analysis (mutation_overlap) and Monte Carlo frequency analysis (frequency).\n      Each runs embarrassingly parallel across 10 chromosomes x 7 populations = up to 70 jobs.\n    tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n\ntasks:\n  - task_id: \"task:individuals\"\n    name: \"Individuals\"\n    stage: \"stage:individuals_processing\"\n    executable: \"bin/individuals.py\"\n    description: >\n      Parses a range of lines from a chromosome VCF file to extract per-individual SNP\n      mutation records. For each of 2,504 individuals (columns 10+ of the VCF), it applies\n      an allele-frequency filter (AF >= 0.5 if first allele is 0, or AF < 0.5 if first allele\n      is 1) and writes per-individual text files recording rs-number, position, ref, alt, and AF.\n      All per-individual files for the chunk are compressed into a tar.gz archive. Multiple\n      parallel instances cover different line ranges within the same chromosome when ind_jobs > 1.\n    behavioral_notes: >\n      Reads VCF file sequentially line-by-line over a specified range [counter, stop).\n      Opens and writes one file per individual (up to 2504) within that range, creating a\n      small-file write storm before compression. Compresses all individual files into a single\n      tar.gz at completion. Memory scales with number of lines processed; full file is never\n      loaded. columns.txt is read in full at startup to build individual-ID list.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One instance per chromosome-range pair. With ind_jobs=N, each chromosome produces N\n        independent jobs processing non-overlapping line ranges. All instances across chromosomes\n        and ranges are fully independent.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: true\n      execution_alternatives:\n        - path_id: \"standard_python\"\n          condition: \"daxgen.py: --decaf not set AND --pmc not set\"\n          description: >\n            Standard Python script execution using bin/individuals.py. POSIX file I/O,\n            no MPI. Writes per-individual text files then compresses to tar.gz.\n          io_dominance_hint: \"io_bound\"\n        - path_id: \"mpi_decaf\"\n          condition: \"daxgen.py: --decaf flag set\"\n          description: >\n            Uses bin/individuals.mpi.py with Decaf in-memory dataflow to pass data\n            directly to individuals_merge without writing intermediate tar.gz to disk.\n          io_dominance_hint: \"balanced\"\n        - path_id: \"pegasus_mpi_cluster\"\n          condition: \"daxgen.py: --pmc flag set\"\n          description: >\n            Uses Pegasus MPI Cluster mode with bin/individuals.mpi.py, clustering multiple\n            jobs into one MPI job to reduce job launch overhead on HPC schedulers.\n          io_dominance_hint: \"io_bound\"\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:chromosome_vcf\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:individual_chr_tar\"\n\n  - task_id: \"task:individuals_merge\"\n    name: \"Individuals Merge\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/individuals_merge.py\"\n    description: >\n      Merges multiple per-chunk tar.gz archives produced by task:individuals for the same\n      chromosome into a single consolidated tar.gz archive. Extracts all input archives,\n      concatenates per-individual files across chunks so each individual has a complete\n      mutation list for the full chromosome, then compresses the merged result. One merge\n      job per chromosome, consuming all ind_jobs chunk outputs for that chromosome.\n    behavioral_notes: >\n      Reads all input tar.gz files sequentially, extracting to a temporary directory.\n      Per-individual files from different chunks are appended and concatenated.\n      Writes merged per-individual files then re-compresses entire directory to tar.gz.\n      Full extract-then-write pattern with no streaming. Output is written atomically at end.\n    parallelism_model:\n      type: \"serial\"\n      description: >\n        One serial merge job per chromosome consuming all ind_jobs chunk archives for that\n        chromosome. Across chromosomes, merge jobs run in parallel.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: true\n      execution_alternatives:\n        - path_id: \"standard_python\"\n          condition: \"daxgen.py: --decaf not set AND --pmc not set\"\n          description: \"Standard Python script reads tar archives from disk and writes merged tar.\"\n          io_dominance_hint: \"io_bound\"\n        - path_id: \"mpi_decaf\"\n          condition: \"daxgen.py: --decaf flag set\"\n          description: >\n            Uses bin/individuals_merge_mpi.py; receives data in-memory via Decaf from\n            individuals task, bypassing intermediate tar.gz writes to disk.\n          io_dominance_hint: \"balanced\"\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:individual_chr_tar\"\n    outputs:\n      - \"data:merged_chr_tar\"\n\n  - task_id: \"task:sifting\"\n    name: \"Sifting\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/sifting.py\"\n    description: >\n      Filters SNP variants from VEP annotation VCF files to extract SIFT pathogenicity\n      predictions. Scans the annotation VCF for lines containing deleterious or tolerated\n      SIFT scores with a valid rs ID, parses the VEP INFO field to extract ENSG gene ID\n      and SIFT score, and writes a compact text file per chromosome listing line-number,\n      rs-ID, ENSG-ID, SIFT prediction, and phenotype. This file is used by downstream\n      analyses to identify which SNPs have functional relevance.\n    behavioral_notes: >\n      Uses subprocess grep to pre-filter annotation VCF lines, then parses remaining lines\n      with Python regex. Reads entire annotation VCF sequentially. Output is written\n      incrementally line-by-line. Memory footprint is small as only filtered lines are retained.\n      Fully stateless; output is deterministic for fixed input.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One sifting job per chromosome, processing each chromosome annotation VCF independently.\n        No dependencies between chromosome instances.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:annotation_vcf\"\n    outputs:\n      - \"data:sifted_chr_file\"\n\n  - task_id: \"task:mutation_overlap\"\n    name: \"Mutation Overlap\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/mutation_overlap.py\"\n    description: >\n      Performs pairwise mutation overlap analysis for all individuals in a specified population\n      for one chromosome. Extracts merged individual data, filters to population members,\n      intersects mutation sets between all pairs of individuals, and computes overlap statistics.\n      Generates text output matrices (pairwise overlap counts, half-matrix, gene-pair counts)\n      and PNG visualizations (histograms, colormaps). Results are compressed into a tar.gz\n      archive per chromosome-population pair, serving as a primary scientific output.\n    behavioral_notes: >\n      Extracts merged tar.gz to temp directory, reads population file and columns.txt to\n      determine individual subset, reads per-individual mutation files, performs O(N^2) pairwise\n      set intersections where N is population size (up to 2504). Generates matplotlib plots.\n      Heavy compute phase for pairwise comparisons; significant I/O at both extract and result\n      write stages. Creates multiple output files (up to ~10 text files + PNG plots) per run.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One job per chromosome-population pair. With 10 chromosomes and 7 populations, up to 70\n        concurrent instances. Each is fully independent, processing a distinct (chr, pop) tuple.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"checkpoint\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:mutation_overlap_results\"\n\n  - task_id: \"task:frequency\"\n    name: \"Frequency\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/frequency.py\"\n    description: >\n      Performs Monte Carlo frequency analysis of mutation overlap for one chromosome-population\n      pair. Reads all individual mutation data, then conducts 1000 independent random-sampling\n      runs, each selecting 52 individuals at random from the population and computing mutation\n      frequency histograms. This produces a null distribution of mutation overlap frequencies\n      for statistical testing of disease-related variants.\n    behavioral_notes: >\n      Extracts merged tar.gz, reads all individual mutation files for the population, then\n      performs 1000 independent Monte Carlo iterations using Python Counter. Each iteration\n      writes 3 text files (overlap counts, histogram, random individuals) and one PNG plot,\n      totaling ~4000 small files per job before final tar compression. This creates significant\n      small-file overhead within the task before final archiving.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One job per chromosome-population pair, identical fan-out structure as mutation_overlap.\n        The 1000 Monte Carlo runs within each job execute serially.\n    io_dominance: \"compute_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"checkpoint\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:frequency_results\"\n\ndata_objects:\n  - data_id: \"data:chromosome_vcf\"\n    name: \"Chromosome VCF File\"\n    description: >\n      Phase 3 VCF files from the 1000 Genomes Project containing SNP variant calls for a\n      single chromosome across 2,504 individuals. Each file contains 250,000 SNP records\n      with 8 fixed VCF columns plus FORMAT and 2,504 individual genotype columns. Files\n      are named ALL.chrN.250000.vcf and enumerated in data.csv. Used as the primary genomic\n      input for extracting per-individual SNP mutation profiles in task:individuals.\n    category: \"input\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"dataset\"\n      config_file: \"data.csv\"\n      possible_values: \"1-10 chromosomes as listed in data.csv (one VCF per row)\"\n    estimated_size_hint: \"~80-150 MB per chromosome (250k lines x 2504+ columns)\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:individuals\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:individuals\"\n      retention_window: \"from workflow start to task:individuals completion\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:columns_file\"\n    name: \"Columns File\"\n    description: >\n      Tab-separated header file derived from the VCF listing the 2,504 individual sample\n      identifiers (HapMap/1KG IDs). Used by task:individuals to associate genotype columns\n      with individual IDs when writing per-individual mutation files, and by task:mutation_overlap\n      and task:frequency to map population member IDs to individual data files within the\n      merged chromosome archive.\n    category: \"config\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"fixed\"\n    cardinality_source:\n      type: \"fixed\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"n/a\"\n    estimated_size_hint: \"< 1 KB (single header row with 2504 tab-separated IDs)\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:individuals\"\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"entire workflow\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 3\n\n  - data_id: \"data:annotation_vcf\"\n    name: \"VEP Annotation VCF\"\n    description: >\n      Per-chromosome VEP annotation VCF files containing SIFT pathogenicity scores and\n      consequence predictions for SNP variants in the 1000 Genomes dataset. Named\n      ALL.chrN.phase3_shapeit2_mvncall_integrated_v5.20130502.sites.annotation.vcf.\n      Each record INFO field contains pipe-delimited VEP annotations from which SIFT\n      predictions (deleterious/tolerated) and ENSEMBL gene IDs are extracted by task:sifting.\n    category: \"input\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"dataset\"\n      config_file: \"data.csv\"\n      possible_values: \"1-10 chromosomes (column 3 of data.csv, one annotation VCF per chromosome)\"\n    estimated_size_hint: \"~20-100 MB per chromosome\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:sifting\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:sifting\"\n      retention_window: \"from workflow start to task:sifting completion\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:population_file\"\n    name: \"Population File\"\n    description: >\n      Text files listing individual identifiers for each of seven population groups: ALL\n      (2504 individuals), AFR (661), AMR (347), EAS (504), EUR (503), GBR (91), SAS (489).\n      Located in data/populations/. Each file has one individual ID per line, used by\n      task:mutation_overlap and task:frequency to filter the merged individuals archive to\n      a specific ancestral population for population-stratified analysis.\n    category: \"input\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"fixed\"\n    cardinality_source:\n      type: \"fixed\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"7 files (ALL, AFR, AMR, EAS, EUR, GBR, SAS)\"\n    estimated_size_hint: \"< 100 KB per population file\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"entire workflow\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 2\n\n  - data_id: \"data:individual_chr_tar\"\n    name: \"Individual Chromosome Tarball\"\n    description: >\n      Gzip-compressed tar archive containing per-individual SNP mutation text files for a\n      single line-range chunk of one chromosome. Each individual file records rs-number,\n      position, ref allele, alt allele, and allele frequency for positions where that\n      individual carries the filtered variant. Produced by task:individuals and consumed\n      exclusively by task:individuals_merge to assemble the full-chromosome merged archive.\n      One tar per (chromosome, chunk) pair; total count equals n_chromosomes x ind_jobs.\n    category: \"intermediate\"\n    persistence: \"stage_scoped\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"ind_jobs\"\n      config_file: \"daxgen.py\"\n      possible_values: \"ind_jobs per chromosome (default 1; must evenly divide 250000)\"\n    estimated_size_hint: \"~1-50 MB per tarball depending on mutation density and chunk size\"\n    producer_task: \"task:individuals\"\n    consumer_tasks:\n      - \"task:individuals_merge\"\n    lifecycle:\n      creation_phase: \"task:individuals\"\n      last_consumer_phase: \"task:individuals_merge\"\n      retention_window: \"from task:individuals completion to task:individuals_merge completion\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:merged_chr_tar\"\n    name: \"Merged Chromosome Tarball\"\n    description: >\n      Gzip-compressed tar archive containing complete per-individual SNP mutation files for\n      all 2,504 individuals across an entire chromosome, merged from all ind_jobs chunk\n      tarballs. Each individual file contains the concatenated mutation records from all\n      chunks. This archive is the primary input for both task:mutation_overlap and\n      task:frequency, which extract it to access individual mutation profiles for\n      population-level analysis. One archive per chromosome.\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (one per chromosome listed in data.csv)\"\n    estimated_size_hint: \"~50-200 MB per chromosome\"\n    producer_task: \"task:individuals_merge\"\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: \"task:individuals_merge\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:individuals_merge completion to task:frequency completion\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 2\n\n  - data_id: \"data:sifted_chr_file\"\n    name: \"Sifted Chromosome File\"\n    description: >\n      Plain-text file containing SIFT-filtered SNP records for one chromosome, extracted\n      from the VEP annotation VCF. Each line records: source VCF line number, rs-ID,\n      ENSEMBL gene ID (ENSG), SIFT prediction (deleterious or tolerated), and phenotype\n      annotation. Used by task:mutation_overlap to restrict pairwise overlap analysis to\n      SIFT-scored variants, and by task:frequency to define the SNP universe for\n      random sampling. One file per chromosome.\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (one per chromosome listed in data.csv)\"\n    estimated_size_hint: \"~1-10 MB per chromosome (filtered subset of annotation VCF)\"\n    producer_task: \"task:sifting\"\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: \"task:sifting\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:sifting completion to task:frequency completion\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 2\n\n  - data_id: \"data:mutation_overlap_results\"\n    name: \"Mutation Overlap Results\"\n    description: >\n      Gzip-compressed tar archive containing pairwise mutation overlap analysis results\n      for one chromosome-population pair. Contents include: pairwise overlap count matrices\n      (half and full), total pairs overlap matrix, random pairs overlap baseline, gene-pair\n      co-occurrence counts, total mutations per individual, mutation index arrays, variation\n      maps, and PNG heatmap/histogram visualizations. Represents primary scientific output\n      for variant overlap analysis; retained as a checkpoint.\n    category: \"checkpoint\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (n_chromosomes x n_populations, up to 70)\"\n    estimated_size_hint: \"~1-50 MB per chromosome-population pair\"\n    producer_task: \"task:mutation_overlap\"\n    consumer_tasks: []\n    lifecycle:\n      creation_phase: \"task:mutation_overlap\"\n      last_consumer_phase: \"task:mutation_overlap\"\n      retention_window: \"from task:mutation_overlap completion (final output, retained indefinitely)\"\n      access_frequency_class: \"once\"\n      consumer_count: 0\n\n  - data_id: \"data:frequency_results\"\n    name: \"Frequency Analysis Results\"\n    description: >\n      Gzip-compressed tar archive containing Monte Carlo frequency analysis results for one\n      chromosome-population pair. Contains 1000 indexed sets of output files (overlap counts,\n      frequency histograms, random individual selections, and PNG plots per run), plus mutation\n      index arrays and variation maps. Used to build a null distribution of mutation overlap\n      frequencies for statistical evaluation of disease-related variants.\n    category: \"checkpoint\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (n_chromosomes x n_populations, up to 70)\"\n    estimated_size_hint: \"~5-50 MB per chromosome-population pair (1000 Monte Carlo runs)\"\n    producer_task: \"task:frequency\"\n    consumer_tasks: []\n    lifecycle:\n      creation_phase: \"task:frequency\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:frequency completion (final output, retained indefinitely)\"\n      access_frequency_class: \"once\"\n      consumer_count: 0\n\npc_edges:\n  - edge_id: \"pc:individuals->individuals_merge:n_to_1\"\n    producer: \"task:individuals\"\n    consumer: \"task:individuals_merge\"\n    data_objects:\n      - \"data:individual_chr_tar\"\n    pc_pattern: \"n_to_1\"\n    pc_pattern_rationale: >\n      With ind_jobs=N (default 1, configurable in daxgen.py), N parallel task:individuals\n      instances each produce one chunk tarball for the same chromosome. A single\n      task:individuals_merge instance per chromosome consumes all N chunk tarballs. Classic\n      fan-in (n_to_1) pattern: N producers to 1 consumer per chromosome.\n    data_flow_description: >\n      Each task:individuals instance writes one tar.gz archive containing per-individual mutation\n      files for its line range. task:individuals_merge reads all N archives for the chromosome,\n      extracts them, concatenates matching individual files, then produces a single merged archive.\n      Full archives are read; no partial access.\n    coupling: \"tight\"\n    coupling_rationale: >\n      task:individuals_merge opens input tarballs only after all producing task:individuals\n      instances complete (enforced by Pegasus dependency edges). No streaming or polling.\n    communication_pattern: \"file_per_producer\"\n    data_volume_class: \"medium\"\n\n  - edge_id: \"pc:individuals_merge->frequency:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One task:individuals_merge produces one merged tarball per chromosome. Up to 7\n      task:frequency instances (one per population) each independently read and extract\n      this same merged tarball. Fan-out (1_to_n) pattern: 1 producer file shared across\n      N population-specific consumer instances.\n    data_flow_description: >\n      task:individuals_merge writes a single merged tar.gz per chromosome. Each of up to 7\n      task:frequency instances independently extracts the full archive to a temporary directory\n      and reads all per-individual mutation files for its population subset. Full archive is\n      read per consumer instance; data_reuse concern applies.\n    coupling: \"tight\"\n    coupling_rationale: >\n      Each task:frequency job opens the merged tarball only after task:individuals_merge\n      completes (Pegasus dependency). No streaming.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"medium\"\n\n  - edge_id: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      Same fan-out structure as merge->frequency: one task:individuals_merge per chromosome\n      produces a single merged tarball consumed by up to 7 parallel task:mutation_overlap\n      instances (one per population). The same merged archive is shared read-only.\n    data_flow_description: >\n      task:individuals_merge writes a single merged tar.gz per chromosome. Each\n      task:mutation_overlap instance independently extracts the full archive and reads\n      individual mutation files for its assigned population before pairwise comparison.\n    coupling: \"tight\"\n    coupling_rationale: >\n      task:mutation_overlap jobs depend on task:individuals_merge completion (Pegasus\n      dependency). Archives must be fully written before consumers open them.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"medium\"\n\n  - edge_id: \"pc:sifting->frequency:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One task:sifting per chromosome produces a single sifted_chr_file. Up to 7 task:frequency\n      instances (one per population) each read this same file to obtain the SNP rs-number\n      universe for random sampling. Fan-out (1_to_n) sharing of a small text file.\n    data_flow_description: >\n      task:sifting writes a plain-text sifted file per chromosome. Each task:frequency instance\n      reads the full sifted file to extract all rs-IDs as the frequency sampling universe.\n      File is small (~1-10 MB) and read fully by each consumer.\n    coupling: \"tight\"\n    coupling_rationale: >\n      Each task:frequency job depends on task:sifting completion for its chromosome (Pegasus\n      dependency). File is read from disk after sifting completes.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"small\"\n\n  - edge_id: \"pc:sifting->mutation_overlap:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      Same fan-out structure as sifting->frequency: one task:sifting per chromosome feeds\n      up to 7 task:mutation_overlap instances. Each mutation_overlap job reads the full sifted\n      file to restrict pairwise overlap analysis to SIFT-scored variants.\n    data_flow_description: >\n      task:sifting writes a plain-text sifted file per chromosome. Each task:mutation_overlap\n      instance reads the full sifted file to extract the SIFT-annotated rs-ID set, filtering\n      individual mutations before pairwise comparison.\n    coupling: \"tight\"\n    coupling_rationale: >\n      Each task:mutation_overlap job depends on task:sifting for its chromosome (Pegasus\n      dependency). File must be fully written before consumers read it.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"small\"\n\nworkflow_graph:\n  integrity_hash: \"b3f7a2e1d9c845f60e12a3b7c4d8e9f01a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6\"\n  last_generated: \"2026-03-04T12:00:00Z\"\n  dag_edges:\n    - from: \"task:individuals\"\n      to: \"task:individuals_merge\"\n      via: \"pc:individuals->individuals_merge:n_to_1\"\n    - from: \"task:individuals_merge\"\n      to: \"task:frequency\"\n      via: \"pc:individuals_merge->frequency:1_to_n\"\n    - from: \"task:individuals_merge\"\n      to: \"task:mutation_overlap\"\n      via: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    - from: \"task:sifting\"\n      to: \"task:frequency\"\n      via: \"pc:sifting->frequency:1_to_n\"\n    - from: \"task:sifting\"\n      to: \"task:mutation_overlap\"\n      via: \"pc:sifting->mutation_overlap:1_to_n\"\n\n  loop_groups: []\n\n  critical_path_hint: >\n    task:individuals (longest task, approximately 82% of walltime per benchmark) ->\n    task:individuals_merge -> task:mutation_overlap (or task:frequency in parallel).\n    task:sifting is off the critical path, completing in under 1% of walltime.\n\n  control_flow:\n    has_iteration: false\n    iteration_description: null\n    has_conditional_branches: false\n    conditional_description: null\n\n  stage_execution_order:\n    - \"stage:individuals_processing\"\n    - \"stage:merge_and_sifting\"\n    - \"stage:population_analysis\"\n\n  cross_reference:\n    task_to_stage:\n      \"task:individuals\": \"stage:individuals_processing\"\n      \"task:individuals_merge\": \"stage:merge_and_sifting\"\n      \"task:sifting\": \"stage:merge_and_sifting\"\n      \"task:mutation_overlap\": \"stage:population_analysis\"\n      \"task:frequency\": \"stage:population_analysis\"\n    data_to_producer:\n      \"data:chromosome_vcf\": null\n      \"data:columns_file\": null\n      \"data:annotation_vcf\": null\n      \"data:population_file\": null\n      \"data:individual_chr_tar\": \"task:individuals\"\n      \"data:merged_chr_tar\": \"task:individuals_merge\"\n      \"data:sifted_chr_file\": \"task:sifting\"\n      \"data:mutation_overlap_results\": \"task:mutation_overlap\"\n      \"data:frequency_results\": \"task:frequency\"\n    data_to_consumers:\n      \"data:chromosome_vcf\":\n        - \"task:individuals\"\n      \"data:columns_file\":\n        - \"task:individuals\"\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:annotation_vcf\":\n        - \"task:sifting\"\n      \"data:population_file\":\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:individual_chr_tar\":\n        - \"task:individuals_merge\"\n      \"data:merged_chr_tar\":\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:sifted_chr_file\":\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:mutation_overlap_results\": []\n      \"data:frequency_results\": []\n\nworkflow_patterns:\n  primary_pattern: \"scatter_gather\"\n  secondary_patterns:\n    - \"broadcast\"\n  classification_rationale: >\n    The dominant pattern is scatter_gather at two levels: (1) task:individuals scatters\n    across N chromosome-range pairs (n_chromosomes x ind_jobs), then task:individuals_merge\n    gathers per chromosome (n_to_1 fan-in); (2) task:individuals_merge and task:sifting\n    each scatter per-chromosome outputs to up to 7 population-specific analysis jobs\n    (1_to_n fan-out). The broadcast secondary pattern captures that data:merged_chr_tar\n    and data:sifted_chr_file are read identically by multiple downstream consumers\n    (shared read-only inputs). The DAG is fully acyclic with no iteration loops.\n    P-C edge summary: 1 n_to_1 edge (individuals->merge) and 4 1_to_n edges (merge and\n    sifting each fan out to mutation_overlap and frequency).\n  pattern_table_row: \"1000genome | 3 stages | 5 task types (up to 70+ instances) | n_to_1, 1_to_n | scatter-gather with shared-read broadcast\"\n\nio_behavioral_hints:\n  - hint_id: \"hint:small_file_overhead_individuals\"\n    description: >\n      task:individuals creates up to 2,504 individual text files within each job before\n      compressing them into a tar.gz. On a shared filesystem, creating thousands of small\n      files per chromosome-chunk job causes metadata-intensive I/O. With ind_jobs > 1,\n      multiple concurrent jobs each create 2,504 files simultaneously, amplifying metadata\n      server load. The tar.gz compression step reduces final file count but cannot eliminate\n      the creation-phase overhead.\n    affected_tasks:\n      - \"task:individuals\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"small_file_overhead\"\n\n  - hint_id: \"hint:data_reuse_merged_chr_tar\"\n    description: >\n      data:merged_chr_tar is fully extracted independently by each of up to 7\n      task:mutation_overlap and 7 task:frequency instances per chromosome (up to 14\n      extractions per chromosome). Each consumer extracts the same multi-hundred-MB archive\n      to a temporary directory, causing redundant I/O. A shared pre-extracted directory or\n      in-memory broadcast would eliminate repeat extraction overhead.\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:merged_chr_tar\"\n    potential_concern: \"data_reuse\"\n\n  - hint_id: \"hint:data_reuse_sifted_chr_file\"\n    description: >\n      data:sifted_chr_file is read independently by each of up to 7 task:mutation_overlap\n      and 7 task:frequency instances per chromosome (up to 14 reads). The file is small\n      (~1-10 MB), but redundant reads occur across all analysis jobs, potentially causing\n      repeated metadata lookups if filesystem caching is not active.\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:sifted_chr_file\"\n    potential_concern: \"data_reuse\"\n\n  - hint_id: \"hint:small_file_overhead_frequency\"\n    description: >\n      task:frequency generates approximately 4,000 small output files per chromosome-population\n      pair (3 text files + 1 PNG plot per Monte Carlo run x 1000 runs) before compressing into\n      a single tar.gz. On metadata-sensitive filesystems (e.g., Lustre), this creates\n      significant inode pressure during the write phase. With up to 70 concurrent frequency\n      jobs (10 chromosomes x 7 populations), total concurrent small-file creation can approach\n      280,000 files, causing metadata storms.\n    affected_tasks:\n      - \"task:frequency\"\n    affected_data:\n      - \"data:frequency_results\"\n    potential_concern: \"small_file_overhead\"\n\n  - hint_id: \"hint:unnecessary_serialization_individuals\"\n    description: >\n      In the default (non-Decaf) execution path, task:individuals writes per-individual files\n      then compresses to tar.gz, which task:individuals_merge immediately extracts to read the\n      same files again. This double serialization (write -> compress -> extract -> read)\n      exists only to pass data between tasks. The Decaf in-memory dataflow mode\n      (daxgen.py --decaf flag) eliminates this disk round-trip but is not the default.\n    affected_tasks:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"unnecessary_serialization\"\n\nexecution_profiles:\n  - profile_name: \"overlap_analysis_only\"\n    terminal_task_id: \"task:mutation_overlap\"\n    description: >\n      Runs genotype extraction, merging, sifting, and pairwise mutation overlap analysis\n      but skips the Monte Carlo frequency analysis. Produces pairwise overlap matrices and\n      visualizations per chromosome-population pair. Useful when only the overlap null\n      distribution is needed without the computationally intensive random-sampling frequency\n      analysis (which generates ~4000 files per job x 70 jobs).\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n      - \"task:mutation_overlap\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:mutation_overlap_results\"\n\n  - profile_name: \"full\"\n    terminal_task_id: \"task:frequency\"\n    description: >\n      Complete workflow execution: genotype extraction, merging, sifting, pairwise mutation\n      overlap analysis, and Monte Carlo frequency analysis across all chromosomes and\n      populations specified in data.csv. Produces both overlap matrices/plots and frequency\n      null distributions. This is the standard scientific execution mode for the 1000 Genomes\n      variant analysis pipeline.\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:mutation_overlap_results\"\n      - \"data:frequency_results\"\n\ntranslation_metadata:\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  translation_tool: \"claude-sonnet-4-6\"\n  translation_timestamp: \"2026-03-04T12:00:00Z\"\n  unmapped_fields:\n    - field_path: \"workflow_graph.integrity_hash\"\n      reason: >\n        [ASSUMPTION] Hash value b3f7a2e1d9c845f60e12a3b7c4d8e9f01a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6\n        is a placeholder. Compute actual SHA-256 with:\n        python3 -c \"import json,hashlib; edges=sorted([\n        {'edge_id':'pc:individuals->individuals_merge:n_to_1','producer':'task:individuals',\n        'consumer':'task:individuals_merge','data_objects':['data:individual_chr_tar'],'pc_pattern':'n_to_1'},\n        {'edge_id':'pc:individuals_merge->frequency:1_to_n','producer':'task:individuals_merge',\n        'consumer':'task:frequency','data_objects':['data:merged_chr_tar'],'pc_pattern':'1_to_n'},\n        {'edge_id':'pc:individuals_merge->mutation_overlap:1_to_n','producer':'task:individuals_merge',\n        'consumer':'task:mutation_overlap','data_objects':['data:merged_chr_tar'],'pc_pattern':'1_to_n'},\n        {'edge_id':'pc:sifting->frequency:1_to_n','producer':'task:sifting','consumer':'task:frequency',\n        'data_objects':['data:sifted_chr_file'],'pc_pattern':'1_to_n'},\n        {'edge_id':'pc:sifting->mutation_overlap:1_to_n','producer':'task:sifting',\n        'consumer':'task:mutation_overlap','data_objects':['data:sifted_chr_file'],'pc_pattern':'1_to_n'}\n        ], key=lambda e: e['edge_id']);\n        print(hashlib.sha256(json.dumps(edges,sort_keys=True,separators=(',',':')).encode()).hexdigest())\"\n    - field_path: \"metadata.source_commit\"\n      reason: \"No git repository found in workflows_repo/1000genome-workflow at analysis time.\"\n  round_trip_gaps:\n    - field_path: \"execution_profiles\"\n      note: \"Execution profiles have no representation in Pegasus DAX; derived from checkpoint task classification.\"\n    - field_path: \"workflow_patterns\"\n      note: \"Pattern taxonomy is inference-based; not encoded in Pegasus DAX format.\"\n    - field_path: \"io_behavioral_hints\"\n      note: \"I/O behavioral hints are static analysis inferences; not representable in Pegasus DAX.\"\n    - field_path: \"tasks[*].behavioral_notes\"\n      note: \"Behavioral notes are prose inferred from code; not present in Pegasus DAX job descriptions.\"\n  quality_warnings: []\n  field_confidence_records:\n    - field_path: \"tasks[*].description\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        Inferred from direct inspection of bin/individuals.py, bin/individuals_merge.py,\n        bin/sifting.py, bin/mutation_overlap.py, bin/frequency.py, daxgen.py, and README.\n      requires_human_review: false\n    - field_path: \"tasks[*].behavioral_notes\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from code-level observation of file open/read/write patterns in each task script.\"\n      requires_human_review: false\n    - field_path: \"tasks[*].io_dominance\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        Inferred from code structure: individuals writes 2504 files sequentially (io_bound);\n        sifting does grep+parse (balanced); mutation_overlap does O(N^2) intersections (balanced);\n        frequency does 1000 random iterations (compute_bound). No profiling data available.\n      requires_human_review: false\n    - field_path: \"tasks[*].io_access_type\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        All task scripts use standard Python file I/O with no imports of mpi4py, h5py, or\n        netCDF4. Confirmed python_serial for all five tasks.\n      requires_human_review: false\n    - field_path: \"tasks[*].restart_model\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        No checkpoint-read logic found at startup in any task script. All tasks overwrite\n        outputs deterministically. Confirmed idempotent for all tasks.\n      requires_human_review: false\n    - field_path: \"pc_edges[*].pc_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        Derived from explicit job-creation loop in daxgen.py: individuals creates N jobs per\n        chromosome, merge creates 1 per chromosome (n_to_1); merge and sifting each feed\n        N_pop analysis jobs (1_to_n). Pattern is unambiguous from DAG structure.\n      requires_human_review: false\n    - field_path: \"pc_edges[*].coupling\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        Pegasus DAX explicit dependency edges require full completion before downstream jobs\n        start. All edges are tight coupling by construction.\n      requires_human_review: false\n    - field_path: \"pc_edges[*].communication_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        individuals->merge uses file_per_producer (each job writes its own tar.gz).\n        All other edges use shared_file (one file read by multiple consumers).\n      requires_human_review: false\n    - field_path: \"workflow_patterns.primary_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        DAG in daxgen.py clearly shows scatter across chromosome-range pairs, gather in merge\n        (n_to_1), then fan-out to population analysis (1_to_n). Scatter-gather is definitive.\n      requires_human_review: false\n    - field_path: \"workflow_patterns.secondary_patterns\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        Broadcast pattern inferred from merged_chr_tar and sifted_chr_file being read identically\n        by all population-specific jobs. Could also be described as 1_to_n fan-out.\n      requires_human_review: false\n    - field_path: \"io_behavioral_hints\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        Small-file and data-reuse hints from direct code inspection. Unnecessary serialization\n        confirmed by --decaf flag existence. Magnitude depends on filesystem type and job count.\n      requires_human_review: false\n    - field_path: \"execution_profiles\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        Profiles proposed from checkpoint tasks (mutation_overlap, frequency). Full profile is\n        definitive. overlap_analysis_only requires scientist confirmation.\n      requires_human_review: true\n    - field_path: \"data_objects[*].estimated_size_hint\"\n      confidence_level: \"low\"\n      confidence_reason: >\n        Estimated from README benchmark data and code structure. No explicit file size metadata\n        in repository. Actual sizes are runtime-determined by mutation density.\n      requires_human_review: false\n"}},{"tool_name":"Bash","tool_use_id":"toolu_01MUXFTqkhA6Vd9PGnHxRtFK","tool_input":{"command":"cat > /home/mtang11/scripts/workflow-representation-description/workflow_wdd/1000genome-wdd-claude-trial3.yaml << 'YAML_EOF'\nmetadata:\n  workflow_lineage_id: \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\"\n  version: \"1.0.0\"\n  version_notes: \"Initial WDD compiled from daxgen.py (Pegasus workflow generator for 1000 Genomes analysis).\"\n  deprecated: false\n  workflow_name: \"1000genome\"\n  workflow_description: >\n    The 1000 Genomes workflow performs population-scale genomic variant analysis using Phase 3\n    data from the 1000 Genomes Project, which catalogued genetic variation across 2,504 individuals\n    representing 26 populations. The workflow parses VCF files to extract per-individual SNP\n    mutation data, cross-references mutations with SIFT (Sorting Intolerant From Tolerant)\n    pathogenicity scores derived from VEP (Variant Effect Predictor) annotations, and performs\n    pairwise mutation overlap analysis and frequency measurements across seven population groups\n    (ALL, AFR, AMR, EAS, EUR, GBR, SAS). Final outputs include pairwise overlap matrices,\n    histograms, heatmaps, and Monte Carlo frequency distributions, providing a null distribution\n    for statistically rigorous evaluation of disease-related mutations.\n  source_repository: \"/home/mtang11/scripts/workflow-representation-description/workflows_repo/1000genome-workflow\"\n  source_commit: null\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  schema_version: \"wrd-7.0\"\n  generated_by: \"claude-sonnet-4-6\"\n  generated_at: \"2026-03-04T12:00:00Z\"\n  last_modified_at: \"2026-03-04T12:00:00Z\"\nstages:\n  - stage_id: \"stage:individuals_processing\"\n    name: \"Individuals Processing\"\n    order: 1\n    description: Parses chromosome VCF files to extract per-individual SNP mutation data. Each chromosome is processed independently in parallel, and optionally split into sub-ranges to reduce per-job memory usage.\n    tasks:\n      - \"task:individuals\"\n  - stage_id: \"stage:merge_and_sifting\"\n    name: \"Merge and Sifting\"\n    order: 2\n    description: Merges per-chunk individual data archives into per-chromosome consolidated archives (individuals_merge), and independently extracts SIFT pathogenicity scores from VEP annotation VCF files (sifting). Both tasks run concurrently but must both complete before population analysis begins.\n    tasks:\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n  - stage_id: \"stage:population_analysis\"\n    name: \"Population Analysis\"\n    order: 3\n    description: Performs two independent analyses per chromosome-population pair (pairwise mutation overlap and Monte Carlo frequency analysis), running embarrassingly parallel across up to 70 jobs (10 chromosomes x 7 populations).\n    tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\ntasks:\n  - task_id: \"task:individuals\"\n    name: \"Individuals\"\n    stage: \"stage:individuals_processing\"\n    executable: \"bin/individuals.py\"\n    description: Parses a range of lines from a chromosome VCF file to extract per-individual SNP mutation records. For each of 2,504 individuals (columns 10+ of the VCF), it applies an allele-frequency filter and writes per-individual text files recording rs-number, position, ref, alt, and AF. All per-individual files for the chunk are compressed into a tar.gz archive. Multiple parallel instances cover different line ranges within the same chromosome when ind_jobs > 1.\n    behavioral_notes: Reads VCF file sequentially line-by-line over a specified range [counter, stop). Opens and writes one file per individual (up to 2504) within that range, creating a small-file write storm before compression. Compresses all individual files into a single tar.gz at completion. Memory scales with number of lines processed; full file is never loaded at once. columns.txt is read in full at startup to build individual-ID list.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: One instance per chromosome-range pair. With ind_jobs=N, each chromosome produces N independent jobs processing non-overlapping line ranges. All instances across chromosomes and ranges are fully independent.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: true\n      execution_alternatives:\n        - path_id: \"standard_python\"\n          condition: \"daxgen.py: --decaf not set AND --pmc not set\"\n          description: Standard Python script execution using bin/individuals.py with POSIX file I/O and no MPI.\n          io_dominance_hint: \"io_bound\"\n        - path_id: \"mpi_decaf\"\n          condition: \"daxgen.py: --decaf flag set\"\n          description: Uses bin/individuals.mpi.py with Decaf in-memory dataflow to pass data directly to individuals_merge without writing intermediate tar.gz to disk.\n          io_dominance_hint: \"balanced\"\n        - path_id: \"pegasus_mpi_cluster\"\n          condition: \"daxgen.py: --pmc flag set\"\n          description: Uses Pegasus MPI Cluster mode with bin/individuals.mpi.py to cluster multiple jobs into one MPI job and reduce scheduler overhead.\n          io_dominance_hint: \"io_bound\"\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:chromosome_vcf\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:individual_chr_tar\"\n  - task_id: \"task:individuals_merge\"\n    name: \"Individuals Merge\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/individuals_merge.py\"\n    description: Merges multiple per-chunk tar.gz archives produced by task:individuals for the same chromosome into a single consolidated tar.gz archive. Extracts all input archives, concatenates per-individual files across chunks so each individual has a complete mutation list for the full chromosome, then compresses the merged result. One merge job per chromosome.\n    behavioral_notes: Reads all input tar.gz files sequentially, extracting to a temporary directory. Per-individual files from different chunks are appended and concatenated. Writes merged per-individual files then re-compresses entire directory to tar.gz. Full extract-then-write pattern with no streaming.\n    parallelism_model:\n      type: \"serial\"\n      description: One serial merge job per chromosome consuming all ind_jobs chunk archives for that chromosome. Across chromosomes, merge jobs run in parallel.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: true\n      execution_alternatives:\n        - path_id: \"standard_python\"\n          condition: \"daxgen.py: --decaf not set AND --pmc not set\"\n          description: Standard Python script reads tar archives from disk and writes merged tar.\n          io_dominance_hint: \"io_bound\"\n        - path_id: \"mpi_decaf\"\n          condition: \"daxgen.py: --decaf flag set\"\n          description: Uses bin/individuals_merge_mpi.py; receives data in-memory via Decaf from individuals task, bypassing intermediate tar.gz writes.\n          io_dominance_hint: \"balanced\"\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:individual_chr_tar\"\n    outputs:\n      - \"data:merged_chr_tar\"\n  - task_id: \"task:sifting\"\n    name: \"Sifting\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/sifting.py\"\n    description: Filters SNP variants from VEP annotation VCF files to extract SIFT pathogenicity predictions. Scans the annotation VCF for lines containing deleterious or tolerated SIFT scores with a valid rs ID, parses the VEP INFO field to extract ENSG gene ID and SIFT score, and writes a compact text file per chromosome listing line-number, rs-ID, ENSG-ID, SIFT prediction, and phenotype.\n    behavioral_notes: Uses subprocess grep to pre-filter annotation VCF lines, then parses remaining lines with Python regex. Reads entire annotation VCF sequentially. Output is written incrementally line-by-line. Memory footprint is small as only filtered lines are retained. Fully stateless; output is deterministic for fixed input.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: One sifting job per chromosome, processing each chromosome annotation VCF independently. No dependencies between chromosome instances.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:annotation_vcf\"\n    outputs:\n      - \"data:sifted_chr_file\"\n  - task_id: \"task:mutation_overlap\"\n    name: \"Mutation Overlap\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/mutation_overlap.py\"\n    description: Performs pairwise mutation overlap analysis for all individuals in a specified population for one chromosome. Extracts merged individual data, filters to population members, intersects mutation sets between all pairs of individuals (O(N^2)), and computes overlap statistics. Generates text output matrices (pairwise overlap counts, half-matrix, gene-pair counts) and PNG visualizations (histograms, colormaps). Results are compressed into a tar.gz archive per chromosome-population pair.\n    behavioral_notes: Extracts merged tar.gz to temp directory, reads population file and columns.txt to determine individual subset, reads per-individual mutation files, performs O(N^2) pairwise set intersections where N is population size (up to 2504). Generates matplotlib plots. Heavy compute phase for pairwise comparisons; significant I/O at both extract and result write stages.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: One job per chromosome-population pair. With 10 chromosomes and 7 populations, up to 70 concurrent instances; each processes a distinct (chr, pop) tuple independently.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"checkpoint\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:mutation_overlap_results\"\n  - task_id: \"task:frequency\"\n    name: \"Frequency\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/frequency.py\"\n    description: Performs Monte Carlo frequency analysis of mutation overlap for one chromosome-population pair. Reads all individual mutation data, then conducts 1000 independent random-sampling runs, each selecting 52 individuals at random and computing mutation frequency histograms. Produces a null distribution of mutation overlap frequencies for statistical testing of disease-related variants.\n    behavioral_notes: Extracts merged tar.gz, reads all individual mutation files for the population, then performs 1000 independent Monte Carlo iterations using Python Counter. Each iteration writes 3 text files (overlap counts, histogram, random individuals) and one PNG plot, totaling ~4000 small files per job before final tar compression.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: One job per chromosome-population pair, identical fan-out structure as mutation_overlap. The 1000 Monte Carlo runs within each job execute serially.\n    io_dominance: \"compute_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"checkpoint\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:frequency_results\"\ndata_objects:\n  - data_id: \"data:chromosome_vcf\"\n    name: \"Chromosome VCF File\"\n    description: Phase 3 VCF files from the 1000 Genomes Project containing SNP variant calls for a single chromosome across 2,504 individuals. Each file contains 250,000 SNP records with 8 fixed VCF columns plus FORMAT and 2,504 individual genotype columns. Named ALL.chrN.250000.vcf and enumerated in data.csv. Primary genomic input for per-individual SNP extraction.\n    category: \"input\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"dataset\"\n      config_file: \"data.csv\"\n      possible_values: \"1-10 chromosomes as listed in data.csv (one VCF per row)\"\n    estimated_size_hint: \"~80-150 MB per chromosome (250k lines x 2504+ columns)\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:individuals\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:individuals\"\n      retention_window: \"from workflow start to task:individuals completion\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n  - data_id: \"data:columns_file\"\n    name: \"Columns File\"\n    description: Tab-separated header file derived from the VCF listing the 2,504 individual sample identifiers (HapMap/1KG IDs). Used by task:individuals to associate genotype columns with individual IDs, and by task:mutation_overlap and task:frequency to map population member IDs to individual data files within the merged chromosome archive.\n    category: \"config\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"fixed\"\n    cardinality_source:\n      type: \"fixed\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"n/a\"\n    estimated_size_hint: \"< 1 KB (single header row with 2504 tab-separated IDs)\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:individuals\"\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"entire workflow\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 3\n  - data_id: \"data:annotation_vcf\"\n    name: \"VEP Annotation VCF\"\n    description: Per-chromosome VEP annotation VCF files containing SIFT pathogenicity scores and consequence predictions for SNP variants in the 1000 Genomes dataset. Named ALL.chrN.phase3_shapeit2_mvncall_integrated_v5.20130502.sites.annotation.vcf. Each record INFO field contains pipe-delimited VEP annotations from which SIFT predictions (deleterious/tolerated) and ENSEMBL gene IDs are extracted by task:sifting.\n    category: \"input\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"dataset\"\n      config_file: \"data.csv\"\n      possible_values: \"1-10 chromosomes (column 3 of data.csv, one annotation VCF per chromosome)\"\n    estimated_size_hint: \"~20-100 MB per chromosome\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:sifting\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:sifting\"\n      retention_window: \"from workflow start to task:sifting completion\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n  - data_id: \"data:population_file\"\n    name: \"Population File\"\n    description: Text files listing individual identifiers for each of seven population groups: ALL (2504 individuals), AFR (661), AMR (347), EAS (504), EUR (503), GBR (91), SAS (489). Located in data/populations/. Each file has one individual ID per line, used by task:mutation_overlap and task:frequency to filter the merged individuals archive to a specific ancestral population.\n    category: \"input\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"fixed\"\n    cardinality_source:\n      type: \"fixed\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"7 files (ALL, AFR, AMR, EAS, EUR, GBR, SAS)\"\n    estimated_size_hint: \"< 100 KB per population file\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"entire workflow\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 2\n  - data_id: \"data:individual_chr_tar\"\n    name: \"Individual Chromosome Tarball\"\n    description: Gzip-compressed tar archive containing per-individual SNP mutation text files for a single line-range chunk of one chromosome. Each individual file records rs-number, position, ref allele, alt allele, and allele frequency for positions where that individual carries the filtered variant. One tar per (chromosome, chunk) pair; total count equals n_chromosomes x ind_jobs.\n    category: \"intermediate\"\n    persistence: \"stage_scoped\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"ind_jobs\"\n      config_file: \"daxgen.py\"\n      possible_values: \"ind_jobs per chromosome (default 1; must evenly divide 250000)\"\n    estimated_size_hint: \"~1-50 MB per tarball depending on mutation density and chunk size\"\n    producer_task: \"task:individuals\"\n    consumer_tasks:\n      - \"task:individuals_merge\"\n    lifecycle:\n      creation_phase: \"task:individuals\"\n      last_consumer_phase: \"task:individuals_merge\"\n      retention_window: \"from task:individuals completion to task:individuals_merge completion\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n  - data_id: \"data:merged_chr_tar\"\n    name: \"Merged Chromosome Tarball\"\n    description: Gzip-compressed tar archive containing complete per-individual SNP mutation files for all 2,504 individuals across an entire chromosome, merged from all ind_jobs chunk tarballs. This archive is the primary input for both task:mutation_overlap and task:frequency, which extract it to access individual mutation profiles for population-level analysis. One archive per chromosome.\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (one per chromosome listed in data.csv)\"\n    estimated_size_hint: \"~50-200 MB per chromosome\"\n    producer_task: \"task:individuals_merge\"\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: \"task:individuals_merge\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:individuals_merge completion to task:frequency completion\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 2\n  - data_id: \"data:sifted_chr_file\"\n    name: \"Sifted Chromosome File\"\n    description: Plain-text file containing SIFT-filtered SNP records for one chromosome, extracted from the VEP annotation VCF. Each line records source VCF line number, rs-ID, ENSEMBL gene ID (ENSG), SIFT prediction (deleterious or tolerated), and phenotype annotation. Used by task:mutation_overlap to restrict pairwise analysis to SIFT-scored variants, and by task:frequency to define the SNP universe for random sampling. One file per chromosome.\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (one per chromosome listed in data.csv)\"\n    estimated_size_hint: \"~1-10 MB per chromosome (filtered subset of annotation VCF)\"\n    producer_task: \"task:sifting\"\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: \"task:sifting\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:sifting completion to task:frequency completion\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 2\n  - data_id: \"data:mutation_overlap_results\"\n    name: \"Mutation Overlap Results\"\n    description: Gzip-compressed tar archive containing pairwise mutation overlap analysis results for one chromosome-population pair. Contents include pairwise overlap count matrices (half and full), total pairs overlap matrix, random pairs overlap baseline, gene-pair co-occurrence counts, total mutations per individual, mutation index arrays, variation maps, and PNG heatmap/histogram visualizations. Primary scientific output for variant overlap analysis.\n    category: \"checkpoint\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (n_chromosomes x n_populations, up to 70)\"\n    estimated_size_hint: \"~1-50 MB per chromosome-population pair\"\n    producer_task: \"task:mutation_overlap\"\n    consumer_tasks: []\n    lifecycle:\n      creation_phase: \"task:mutation_overlap\"\n      last_consumer_phase: \"task:mutation_overlap\"\n      retention_window: \"from task:mutation_overlap completion (final output, retained indefinitely)\"\n      access_frequency_class: \"once\"\n      consumer_count: 0\n  - data_id: \"data:frequency_results\"\n    name: \"Frequency Analysis Results\"\n    description: Gzip-compressed tar archive containing Monte Carlo frequency analysis results for one chromosome-population pair. Contains 1000 indexed sets of output files (overlap counts, frequency histograms, random individual selections, and PNG plots per run), plus mutation index arrays and variation maps. Used to build a null distribution of mutation overlap frequencies for statistical evaluation of disease-related variants.\n    category: \"checkpoint\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"runtime-determined (n_chromosomes x n_populations, up to 70)\"\n    estimated_size_hint: \"~5-50 MB per chromosome-population pair (1000 Monte Carlo runs)\"\n    producer_task: \"task:frequency\"\n    consumer_tasks: []\n    lifecycle:\n      creation_phase: \"task:frequency\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:frequency completion (final output, retained indefinitely)\"\n      access_frequency_class: \"once\"\n      consumer_count: 0\npc_edges:\n  - edge_id: \"pc:individuals->individuals_merge:n_to_1\"\n    producer: \"task:individuals\"\n    consumer: \"task:individuals_merge\"\n    data_objects:\n      - \"data:individual_chr_tar\"\n    pc_pattern: \"n_to_1\"\n    pc_pattern_rationale: With ind_jobs=N (default 1, configurable in daxgen.py), N parallel task:individuals instances each produce one chunk tarball for the same chromosome. A single task:individuals_merge instance per chromosome consumes all N chunk tarballs. Classic fan-in (n_to_1) pattern.\n    data_flow_description: Each task:individuals instance writes one tar.gz archive containing per-individual mutation files for its line range. task:individuals_merge reads all N archives, extracts them, concatenates matching individual files, and produces a single merged archive. Full archives are read; no partial access.\n    coupling: \"tight\"\n    coupling_rationale: task:individuals_merge opens input tarballs only after all producing task:individuals instances complete (enforced by Pegasus dependency edges). No streaming or polling.\n    communication_pattern: \"file_per_producer\"\n    data_volume_class: \"medium\"\n  - edge_id: \"pc:individuals_merge->frequency:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: One task:individuals_merge produces one merged tarball per chromosome. Up to 7 task:frequency instances (one per population) each independently read and extract this same merged tarball. Fan-out (1_to_n) pattern.\n    data_flow_description: task:individuals_merge writes a single merged tar.gz per chromosome. Each of up to 7 task:frequency instances independently extracts the full archive to a temporary directory and reads all per-individual mutation files for its population subset. Full archive read per consumer; data_reuse concern applies.\n    coupling: \"tight\"\n    coupling_rationale: Each task:frequency job opens the merged tarball only after task:individuals_merge completes (Pegasus dependency). No streaming.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"medium\"\n  - edge_id: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: Same fan-out structure as merge->frequency. One task:individuals_merge per chromosome produces a single merged tarball consumed by up to 7 parallel task:mutation_overlap instances (one per population). The same merged archive is shared read-only.\n    data_flow_description: task:individuals_merge writes a single merged tar.gz per chromosome. Each task:mutation_overlap instance independently extracts the full archive and reads individual mutation files for its assigned population before pairwise comparison.\n    coupling: \"tight\"\n    coupling_rationale: task:mutation_overlap jobs depend on task:individuals_merge completion (Pegasus dependency). Archives must be fully written before consumers open them.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"medium\"\n  - edge_id: \"pc:sifting->frequency:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: One task:sifting per chromosome produces a single sifted_chr_file. Up to 7 task:frequency instances (one per population) each read this same file to obtain the SNP rs-number universe for random sampling. Fan-out (1_to_n) sharing of a small text file.\n    data_flow_description: task:sifting writes a plain-text sifted file per chromosome. Each task:frequency instance reads the full sifted file to extract all rs-IDs as the frequency sampling universe. File is small (~1-10 MB) and read fully by each consumer.\n    coupling: \"tight\"\n    coupling_rationale: Each task:frequency job depends on task:sifting completion for its chromosome (Pegasus dependency). File is read from disk after sifting completes.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"small\"\n  - edge_id: \"pc:sifting->mutation_overlap:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: Same fan-out structure as sifting->frequency. One task:sifting per chromosome feeds up to 7 task:mutation_overlap instances. Each reads the full sifted file to restrict pairwise overlap analysis to SIFT-scored variants.\n    data_flow_description: task:sifting writes a plain-text sifted file per chromosome. Each task:mutation_overlap instance reads the full sifted file to extract the SIFT-annotated rs-ID set, filtering individual mutations before pairwise comparison.\n    coupling: \"tight\"\n    coupling_rationale: Each task:mutation_overlap job depends on task:sifting for its chromosome (Pegasus dependency). File must be fully written before consumers read it.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"small\"\nworkflow_graph:\n  integrity_hash: \"b3f7a2e1d9c845f60e12a3b7c4d8e9f01a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6\"\n  last_generated: \"2026-03-04T12:00:00Z\"\n  dag_edges:\n    - from: \"task:individuals\"\n      to: \"task:individuals_merge\"\n      via: \"pc:individuals->individuals_merge:n_to_1\"\n    - from: \"task:individuals_merge\"\n      to: \"task:frequency\"\n      via: \"pc:individuals_merge->frequency:1_to_n\"\n    - from: \"task:individuals_merge\"\n      to: \"task:mutation_overlap\"\n      via: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    - from: \"task:sifting\"\n      to: \"task:frequency\"\n      via: \"pc:sifting->frequency:1_to_n\"\n    - from: \"task:sifting\"\n      to: \"task:mutation_overlap\"\n      via: \"pc:sifting->mutation_overlap:1_to_n\"\n  loop_groups: []\n  critical_path_hint: \"task:individuals (~82% of walltime per benchmark) -> task:individuals_merge -> task:mutation_overlap (or task:frequency in parallel). task:sifting is off the critical path (<1% of walltime).\"\n  control_flow:\n    has_iteration: false\n    iteration_description: null\n    has_conditional_branches: false\n    conditional_description: null\n  stage_execution_order:\n    - \"stage:individuals_processing\"\n    - \"stage:merge_and_sifting\"\n    - \"stage:population_analysis\"\n  cross_reference:\n    task_to_stage:\n      \"task:individuals\": \"stage:individuals_processing\"\n      \"task:individuals_merge\": \"stage:merge_and_sifting\"\n      \"task:sifting\": \"stage:merge_and_sifting\"\n      \"task:mutation_overlap\": \"stage:population_analysis\"\n      \"task:frequency\": \"stage:population_analysis\"\n    data_to_producer:\n      \"data:chromosome_vcf\": null\n      \"data:columns_file\": null\n      \"data:annotation_vcf\": null\n      \"data:population_file\": null\n      \"data:individual_chr_tar\": \"task:individuals\"\n      \"data:merged_chr_tar\": \"task:individuals_merge\"\n      \"data:sifted_chr_file\": \"task:sifting\"\n      \"data:mutation_overlap_results\": \"task:mutation_overlap\"\n      \"data:frequency_results\": \"task:frequency\"\n    data_to_consumers:\n      \"data:chromosome_vcf\":\n        - \"task:individuals\"\n      \"data:columns_file\":\n        - \"task:individuals\"\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:annotation_vcf\":\n        - \"task:sifting\"\n      \"data:population_file\":\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:individual_chr_tar\":\n        - \"task:individuals_merge\"\n      \"data:merged_chr_tar\":\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:sifted_chr_file\":\n        - \"task:mutation_overlap\"\n        - \"task:frequency\"\n      \"data:mutation_overlap_results\": []\n      \"data:frequency_results\": []\nworkflow_patterns:\n  primary_pattern: \"scatter_gather\"\n  secondary_patterns:\n    - \"broadcast\"\n  classification_rationale: The dominant pattern is scatter_gather at two levels. (1) task:individuals scatters across N chromosome-range pairs (n_chromosomes x ind_jobs), then task:individuals_merge gathers per chromosome (n_to_1 fan-in). (2) task:individuals_merge and task:sifting each scatter per-chromosome outputs to up to 7 population-specific analysis jobs (1_to_n fan-out). The broadcast secondary pattern captures that data:merged_chr_tar and data:sifted_chr_file are read identically by multiple downstream consumers (shared read-only inputs). The DAG is fully acyclic with no iteration loops. P-C edge summary -- 1 n_to_1 edge (individuals->merge) and 4 1_to_n edges (merge and sifting each fan out to mutation_overlap and frequency).\n  pattern_table_row: \"1000genome | 3 stages | 5 task types (up to 70+ instances) | n_to_1, 1_to_n | scatter-gather with shared-read broadcast\"\nio_behavioral_hints:\n  - hint_id: \"hint:small_file_overhead_individuals\"\n    description: task:individuals creates up to 2,504 individual text files within each job before compressing them into a tar.gz. On a shared filesystem, creating thousands of small files per chromosome-chunk job causes metadata-intensive I/O. With ind_jobs > 1, multiple concurrent jobs each create 2,504 files simultaneously, amplifying metadata server load.\n    affected_tasks:\n      - \"task:individuals\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"small_file_overhead\"\n  - hint_id: \"hint:data_reuse_merged_chr_tar\"\n    description: data:merged_chr_tar is fully extracted independently by each of up to 7 task:mutation_overlap and 7 task:frequency instances per chromosome (up to 14 extractions per chromosome). Each consumer extracts the same multi-hundred-MB archive to a temporary directory, causing redundant I/O. A shared pre-extracted directory or in-memory broadcast would eliminate repeat extraction overhead.\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:merged_chr_tar\"\n    potential_concern: \"data_reuse\"\n  - hint_id: \"hint:data_reuse_sifted_chr_file\"\n    description: data:sifted_chr_file is read independently by each of up to 7 task:mutation_overlap and 7 task:frequency instances per chromosome (up to 14 reads). The file is small (~1-10 MB), but redundant reads occur across all analysis jobs, potentially causing repeated metadata lookups if filesystem caching is not active.\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:sifted_chr_file\"\n    potential_concern: \"data_reuse\"\n  - hint_id: \"hint:small_file_overhead_frequency\"\n    description: task:frequency generates approximately 4,000 small output files per chromosome-population pair (3 text files + 1 PNG plot per Monte Carlo run x 1000 runs) before compressing into a single tar.gz. On metadata-sensitive filesystems (e.g., Lustre), this creates significant inode pressure. With up to 70 concurrent frequency jobs (10 chromosomes x 7 populations), total concurrent small-file creation can approach 280,000 files.\n    affected_tasks:\n      - \"task:frequency\"\n    affected_data:\n      - \"data:frequency_results\"\n    potential_concern: \"small_file_overhead\"\n  - hint_id: \"hint:unnecessary_serialization_individuals\"\n    description: In the default (non-Decaf) execution path, task:individuals writes per-individual files then compresses to tar.gz, which task:individuals_merge immediately extracts to read the same files again. This double serialization (write -> compress -> extract -> read) exists only to pass data between tasks. The Decaf in-memory dataflow mode (daxgen.py --decaf flag) eliminates this disk round-trip but is not the default.\n    affected_tasks:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"unnecessary_serialization\"\nexecution_profiles:\n  - profile_name: \"overlap_analysis_only\"\n    terminal_task_id: \"task:mutation_overlap\"\n    description: Runs genotype extraction, merging, sifting, and pairwise mutation overlap analysis but skips the Monte Carlo frequency analysis. Produces pairwise overlap matrices and visualizations per chromosome-population pair. Useful when only the overlap null distribution is needed without the computationally intensive random-sampling frequency analysis.\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n      - \"task:mutation_overlap\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:mutation_overlap_results\"\n  - profile_name: \"full\"\n    terminal_task_id: \"task:frequency\"\n    description: Complete workflow execution including genotype extraction, merging, sifting, pairwise mutation overlap analysis, and Monte Carlo frequency analysis across all chromosomes and populations specified in data.csv. Produces both overlap matrices/plots and frequency null distributions. Standard scientific execution mode for the 1000 Genomes variant analysis pipeline.\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:mutation_overlap_results\"\n      - \"data:frequency_results\"\ntranslation_metadata:\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  translation_tool: \"claude-sonnet-4-6\"\n  translation_timestamp: \"2026-03-04T12:00:00Z\"\n  unmapped_fields:\n    - field_path: \"workflow_graph.integrity_hash\"\n      reason: \"[ASSUMPTION] Hash b3f7a2e1d9c845f60e12a3b7c4d8e9f01a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6 is a placeholder. Compute actual SHA-256 with: python3 -c \\\"import json,hashlib; edges=sorted([{'edge_id':'pc:individuals->individuals_merge:n_to_1','producer':'task:individuals','consumer':'task:individuals_merge','data_objects':['data:individual_chr_tar'],'pc_pattern':'n_to_1'},{'edge_id':'pc:individuals_merge->frequency:1_to_n','producer':'task:individuals_merge','consumer':'task:frequency','data_objects':['data:merged_chr_tar'],'pc_pattern':'1_to_n'},{'edge_id':'pc:individuals_merge->mutation_overlap:1_to_n','producer':'task:individuals_merge','consumer':'task:mutation_overlap','data_objects':['data:merged_chr_tar'],'pc_pattern':'1_to_n'},{'edge_id':'pc:sifting->frequency:1_to_n','producer':'task:sifting','consumer':'task:frequency','data_objects':['data:sifted_chr_file'],'pc_pattern':'1_to_n'},{'edge_id':'pc:sifting->mutation_overlap:1_to_n','producer':'task:sifting','consumer':'task:mutation_overlap','data_objects':['data:sifted_chr_file'],'pc_pattern':'1_to_n'}],key=lambda e:e['edge_id']); print(hashlib.sha256(json.dumps(edges,sort_keys=True,separators=(',',':')).encode()).hexdigest())\\\"\"\n    - field_path: \"metadata.source_commit\"\n      reason: \"No git repository found in workflows_repo/1000genome-workflow at analysis time.\"\n  round_trip_gaps:\n    - field_path: \"execution_profiles\"\n      note: \"Execution profiles have no representation in Pegasus DAX; derived from checkpoint task classification.\"\n    - field_path: \"workflow_patterns\"\n      note: \"Pattern taxonomy is inference-based; not encoded in Pegasus DAX format.\"\n    - field_path: \"io_behavioral_hints\"\n      note: \"I/O behavioral hints are static analysis inferences; not representable in Pegasus DAX.\"\n    - field_path: \"tasks[*].behavioral_notes\"\n      note: \"Behavioral notes are prose inferred from code; not present in Pegasus DAX job descriptions.\"\n  quality_warnings: []\n  field_confidence_records:\n    - field_path: \"tasks[*].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Inferred from direct inspection of bin/individuals.py, bin/individuals_merge.py, bin/sifting.py, bin/mutation_overlap.py, bin/frequency.py, daxgen.py, and README.\"\n      requires_human_review: false\n    - field_path: \"tasks[*].behavioral_notes\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from code-level observation of file open/read/write patterns in each task script.\"\n      requires_human_review: false\n    - field_path: \"tasks[*].io_dominance\"\n      confidence_level: \"medium\"\n      confidence_reason: \"Inferred from code structure: individuals writes 2504 files sequentially (io_bound); sifting does grep+parse (balanced); mutation_overlap does O(N^2) intersections (balanced); frequency does 1000 random iterations (compute_bound). No profiling data available.\"\n      requires_human_review: false\n    - field_path: \"tasks[*].io_access_type\"\n      confidence_level: \"high\"\n      confidence_reason: \"All task scripts use standard Python file I/O with no imports of mpi4py, h5py, or netCDF4. Confirmed python_serial for all five tasks.\"\n      requires_human_review: false\n    - field_path: \"tasks[*].restart_model\"\n      confidence_level: \"high\"\n      confidence_reason: \"No checkpoint-read logic found at startup in any task script. All tasks overwrite outputs deterministically. Confirmed idempotent for all tasks.\"\n      requires_human_review: false\n    - field_path: \"pc_edges[*].pc_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from explicit job-creation loop in daxgen.py: individuals creates N jobs per chromosome, merge creates 1 per chromosome (n_to_1); merge and sifting each feed N_pop analysis jobs (1_to_n).\"\n      requires_human_review: false\n    - field_path: \"pc_edges[*].coupling\"\n      confidence_level: \"high\"\n      confidence_reason: \"Pegasus DAX explicit dependency edges require full completion before downstream jobs start. All edges are tight coupling by construction.\"\n      requires_human_review: false\n    - field_path: \"pc_edges[*].communication_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: \"individuals->merge uses file_per_producer (each job writes its own tar.gz). All other edges use shared_file (one file read by multiple consumers).\"\n      requires_human_review: false\n    - field_path: \"workflow_patterns.primary_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: \"DAG in daxgen.py clearly shows scatter across chromosome-range pairs, gather in merge (n_to_1), then fan-out to population analysis (1_to_n). Scatter-gather is definitive.\"\n      requires_human_review: false\n    - field_path: \"workflow_patterns.secondary_patterns\"\n      confidence_level: \"medium\"\n      confidence_reason: \"Broadcast pattern inferred from merged_chr_tar and sifted_chr_file being read identically by all population-specific jobs. Could also be described as 1_to_n fan-out.\"\n      requires_human_review: false\n    - field_path: \"io_behavioral_hints\"\n      confidence_level: \"medium\"\n      confidence_reason: \"Small-file and data-reuse hints from direct code inspection. Unnecessary serialization confirmed by --decaf flag existence. Magnitude depends on filesystem type and job count.\"\n      requires_human_review: false\n    - field_path: \"execution_profiles\"\n      confidence_level: \"medium\"\n      confidence_reason: \"Profiles proposed from checkpoint tasks (mutation_overlap, frequency). Full profile is definitive. overlap_analysis_only requires scientist confirmation.\"\n      requires_human_review: true\n    - field_path: \"data_objects[*].estimated_size_hint\"\n      confidence_level: \"low\"\n      confidence_reason: \"Estimated from README benchmark data and code structure. No explicit file size metadata in repository. Actual sizes are runtime-determined by mutation density.\"\n      requires_human_review: false\nYAML_EOF\necho \"exit_code: $?\"","description":"Write WDD YAML file using heredoc"}},{"tool_name":"Bash","tool_use_id":"toolu_014mNxHYt3YfEqoGWHLeExAT","tool_input":{"command":"python3 -c \"\nimport json, hashlib\n\npc_edges = [\n    {\n        'edge_id': 'pc:individuals->individuals_merge:n_to_1',\n        'producer': 'task:individuals',\n        'consumer': 'task:individuals_merge',\n        'data_objects': ['data:individual_chr_tar'],\n        'pc_pattern': 'n_to_1'\n    },\n    {\n        'edge_id': 'pc:individuals_merge->frequency:1_to_n',\n        'producer': 'task:individuals_merge',\n        'consumer': 'task:frequency',\n        'data_objects': ['data:merged_chr_tar'],\n        'pc_pattern': '1_to_n'\n    },\n    {\n        'edge_id': 'pc:individuals_merge->mutation_overlap:1_to_n',\n        'producer': 'task:individuals_merge',\n        'consumer': 'task:mutation_overlap',\n        'data_objects': ['data:merged_chr_tar'],\n        'pc_pattern': '1_to_n'\n    },\n    {\n        'edge_id': 'pc:sifting->frequency:1_to_n',\n        'producer': 'task:sifting',\n        'consumer': 'task:frequency',\n        'data_objects': ['data:sifted_chr_file'],\n        'pc_pattern': '1_to_n'\n    },\n    {\n        'edge_id': 'pc:sifting->mutation_overlap:1_to_n',\n        'producer': 'task:sifting',\n        'consumer': 'task:mutation_overlap',\n        'data_objects': ['data:sifted_chr_file'],\n        'pc_pattern': '1_to_n'\n    }\n]\n\n# Sort by edge_id\npc_edges_sorted = sorted(pc_edges, key=lambda e: e['edge_id'])\ncanonical = json.dumps(pc_edges_sorted, sort_keys=True, separators=(',', ':'))\nh = hashlib.sha256(canonical.encode('utf-8')).hexdigest()\nprint(h)\nprint(len(h))\n\"\n","description":"Compute SHA-256 integrity hash for pc_edges"}},{"tool_name":"Bash","tool_use_id":"toolu_01AtwbDwrq3TGbRiuHV3eHqF","tool_input":{"command":"python3 -c \"\nimport json, hashlib\n\npc_edges = [\n    {\n        'edge_id': 'pc:individuals->individuals_merge:n_to_1',\n        'producer': 'task:individuals',\n        'consumer': 'task:individuals_merge',\n        'data_objects': ['data:individual_chr_tar'],\n        'pc_pattern': 'n_to_1'\n    },\n    {\n        'edge_id': 'pc:individuals_merge->frequency:1_to_n',\n        'producer': 'task:individuals_merge',\n        'consumer': 'task:frequency',\n        'data_objects': ['data:merged_chr_tar'],\n        'pc_pattern': '1_to_n'\n    },\n    {\n        'edge_id': 'pc:individuals_merge->mutation_overlap:1_to_n',\n        'producer': 'task:individuals_merge',\n        'consumer': 'task:mutation_overlap',\n        'data_objects': ['data:merged_chr_tar'],\n        'pc_pattern': '1_to_n'\n    },\n    {\n        'edge_id': 'pc:sifting->frequency:1_to_n',\n        'producer': 'task:sifting',\n        'consumer': 'task:frequency',\n        'data_objects': ['data:sifted_chr_file'],\n        'pc_pattern': '1_to_n'\n    },\n    {\n        'edge_id': 'pc:sifting->mutation_overlap:1_to_n',\n        'producer': 'task:sifting',\n        'consumer': 'task:mutation_overlap',\n        'data_objects': ['data:sifted_chr_file'],\n        'pc_pattern': '1_to_n'\n    }\n]\n\npc_edges_sorted = sorted(pc_edges, key=lambda e: e['edge_id'])\ncanonical = json.dumps(pc_edges_sorted, sort_keys=True, separators=(',', ':'))\nh = hashlib.sha256(canonical.encode('utf-8')).hexdigest()\nprint('HASH:', h)\nprint('LENGTH:', len(h))\nprint('CANONICAL:', canonical)\n\"\n","description":"Compute SHA-256 hash of canonical JSON of pc_edges"}},{"tool_name":"Bash","tool_use_id":"toolu_01Ec8Lyth1bjvNBCTF6eQA5B","tool_input":{"command":"python3 << 'EOF'\nimport json, hashlib\n\npc_edges = [\n    {\n        'edge_id': 'pc:individuals->individuals_merge:n_to_1',\n        'producer': 'task:individuals',\n        'consumer': 'task:individuals_merge',\n        'data_objects': ['data:individual_chr_tar'],\n        'pc_pattern': 'n_to_1'\n    },\n    {\n        'edge_id': 'pc:individuals_merge->frequency:1_to_n',\n        'producer': 'task:individuals_merge',\n        'consumer': 'task:frequency',\n        'data_objects': ['data:merged_chr_tar'],\n        'pc_pattern': '1_to_n'\n    },\n    {\n        'edge_id': 'pc:individuals_merge->mutation_overlap:1_to_n',\n        'producer': 'task:individuals_merge',\n        'consumer': 'task:mutation_overlap',\n        'data_objects': ['data:merged_chr_tar'],\n        'pc_pattern': '1_to_n'\n    },\n    {\n        'edge_id': 'pc:sifting->frequency:1_to_n',\n        'producer': 'task:sifting',\n        'consumer': 'task:frequency',\n        'data_objects': ['data:sifted_chr_file'],\n        'pc_pattern': '1_to_n'\n    },\n    {\n        'edge_id': 'pc:sifting->mutation_overlap:1_to_n',\n        'producer': 'task:sifting',\n        'consumer': 'task:mutation_overlap',\n        'data_objects': ['data:sifted_chr_file'],\n        'pc_pattern': '1_to_n'\n    }\n]\n\npc_edges_sorted = sorted(pc_edges, key=lambda e: e['edge_id'])\ncanonical = json.dumps(pc_edges_sorted, sort_keys=True, separators=(',', ':'))\nh = hashlib.sha256(canonical.encode('utf-8')).hexdigest()\nprint('HASH:', h)\nprint('LENGTH:', len(h))\nprint('CANONICAL:', canonical)\nEOF\n","description":"Compute SHA-256 hash of canonical JSON of pc_edges using heredoc"}},{"tool_name":"Write","tool_use_id":"toolu_01RxsBEdgpqdhCyowhqiaYyj","tool_input":{"file_path":"/home/mtang11/scripts/workflow-representation-description/workflow_wdd/1000genome-wdd-claude-trial3.yaml","content":"schema_version: \"wrd-7.0\"\n\nmetadata:\n  workflow_lineage_id: \"wrd:1000genome\"\n  version: \"1.0.0\"\n  workflow_name: \"1000genome\"\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  generated_by: \"claude-sonnet-4-6\"\n  generation_date: \"2026-03-04\"\n  workflow_description: >\n    Population genomics workflow processing VCF files from the 1000 Genomes Project.\n    Extracts per-individual mutations per chromosome chunk, merges chunks into per-chromosome\n    archives, annotates variants with SIFT pathogenicity scores from VEP annotation VCFs,\n    then performs pairwise mutation overlap analysis and Monte Carlo allele frequency analysis\n    across 2504 individuals spanning 26 populations.\n  source_repository: \"workflows_repo/1000genome-workflow\"\n  source_commit: \"unknown\"\n  notes: >\n    Static analysis of Pegasus DAX generator (daxgen.py) and five Python task scripts\n    in bin/. Decaf in-memory MPI dataflow alternative (lib/ C++ code) identified but not\n    analyzed in depth; Pegasus path used as primary. Chunk count per chromosome is a\n    runtime parameter in daxgen.py and is not captured here.\n\nstages:\n  - stage_id: \"stage:individuals_processing\"\n    stage_name: \"Individuals Processing\"\n    order: 1\n    description: >\n      Parse VCF files per chromosome chunk and extract per-individual mutation data,\n      producing per-chunk tar.gz archives containing one file per individual.\n    tasks:\n      - \"task:individuals\"\n\n  - stage_id: \"stage:merge_and_sifting\"\n    stage_name: \"Merge and Sifting\"\n    order: 2\n    description: >\n      Merge chunked individual archives into per-chromosome tarballs (fan-in), and\n      concurrently extract SIFT pathogenicity scores from VEP annotation VCFs.\n      Both sub-tasks are independent and run in parallel within this stage.\n    tasks:\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n\n  - stage_id: \"stage:population_analysis\"\n    stage_name: \"Population Analysis\"\n    order: 3\n    description: >\n      Consume merged archives and sifted score files to perform pairwise mutation\n      overlap analysis and Monte Carlo allele frequency analysis across populations.\n    tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n\ntasks:\n  - task_id: \"task:individuals\"\n    task_name: \"individuals\"\n    stage_id: \"stage:individuals_processing\"\n    description: >\n      Parses a VCF file line-by-line for a chromosome chunk (a non-overlapping line range),\n      extracts allele calls for all 2504 individuals using a columns mapping file, writes\n      one text file per individual, then compresses all individual files into a tar.gz archive.\n    script: \"bin/individuals.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        One Pegasus job per (chromosome, chunk) pair; chunks are non-overlapping line ranges\n        defined by daxgen.py. Typically 10 chromosomes with N chunks each (N is a runtime\n        parameter). All chunk jobs are independent.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:chromosome_vcf\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:individual_chr_tar\"\n    output_class: \"intermediate\"\n    behavioral_notes: >\n      Writes 2504 individual text files to a temporary directory per chunk before\n      compressing to tar.gz. This creates significant small-file I/O pressure on\n      shared filesystems (metadata operations dominate). The compress-then-merge\n      pattern results in double serialization before downstream consumption.\n\n  - task_id: \"task:individuals_merge\"\n    task_name: \"individuals_merge\"\n    stage_id: \"stage:merge_and_sifting\"\n    description: >\n      Merges all chunked per-chromosome tar.gz archives (fan-in) into a single\n      per-chromosome tarball containing complete per-individual mutation lists\n      across all line ranges for that chromosome.\n    script: \"bin/individuals_merge.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        One Pegasus job per chromosome; all chunk archives for a chromosome must be\n        complete (via Pegasus dependency) before the merge job for that chromosome starts.\n        Independent across chromosomes.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:individual_chr_tar\"\n    outputs:\n      - \"data:merged_chr_tar\"\n    output_class: \"intermediate\"\n    behavioral_notes: >\n      Extracts all chunk tarballs and re-compresses into a single per-chromosome archive.\n      Intermediate decompressed state can temporarily exceed the final output size on disk.\n      The re-compression step is I/O intensive and could be avoided with streaming approaches.\n\n  - task_id: \"task:sifting\"\n    task_name: \"sifting\"\n    stage_id: \"stage:merge_and_sifting\"\n    description: >\n      Extracts SIFT pathogenicity scores from VEP-annotated VCF files using subprocess\n      grep for fast line filtering followed by Python regex parsing. Produces one text\n      file per chromosome with SIFT-scored variant records.\n    script: \"bin/sifting.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        One Pegasus job per chromosome annotation VCF; entirely independent of the\n        individuals processing path. Runs concurrently with task:individuals_merge\n        within stage:merge_and_sifting.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:annotation_vcf\"\n    outputs:\n      - \"data:sifted_chr_file\"\n    output_class: \"intermediate\"\n    behavioral_notes: >\n      Uses subprocess grep for fast line pre-filtering before Python regex; the grep\n      subprocess call introduces a process-spawn overhead per VCF line batch. Output\n      is a structured text file of SIFT-scored variants per chromosome.\n\n  - task_id: \"task:mutation_overlap\"\n    task_name: \"mutation_overlap\"\n    stage_id: \"stage:population_analysis\"\n    description: >\n      Performs O(N^2) pairwise mutation set intersection analysis across all individuals\n      and population groups. Reads merged chromosome archives and sifted score files,\n      computes overlap statistics, and generates matplotlib plots.\n    script: \"bin/mutation_overlap.py\"\n    parallelism_model:\n      type: \"serial\"\n      notes: >\n        Single Pegasus job consuming all 10 merged chromosome archives and 10 sifted\n        chromosome files; O(N^2) over 2504 individuals (approximately 3.1 million pairs).\n        No internal parallelism observed in static analysis.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n    outputs:\n      - \"data:mutation_overlap_results\"\n    output_class: \"checkpoint\"\n    behavioral_notes: >\n      Reads all 10 merged archives into memory for pairwise comparison; memory footprint\n      scales with number_of_individuals * chromosomes * average_mutation_set_size.\n      Matplotlib plot generation adds a CPU+I/O tail to the compute phase.\n\n  - task_id: \"task:frequency\"\n    task_name: \"frequency\"\n    stage_id: \"stage:population_analysis\"\n    description: >\n      Performs 1000 Monte Carlo iterations, sampling 52 random individuals per run\n      to estimate allele frequency distributions across populations using merged\n      chromosome archives and SIFT score files.\n    script: \"bin/frequency.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        1000 independent Monte Carlo runs are logically parallelizable, but the reference\n        implementation in bin/frequency.py runs them serially. Pegasus submits this as a\n        single job. Could be split into 1000 independent tasks for HPC scheduling.\n    io_dominance: \"compute_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n    outputs:\n      - \"data:frequency_results\"\n    output_class: \"checkpoint\"\n    behavioral_notes: >\n      CPU-dominant due to 1000 Monte Carlo iterations with random sampling; reads data\n      once at startup then operates primarily in-memory per iteration. The 1000-run\n      loop dominates wall time over I/O activity.\n\ndata_objects:\n  - data_id: \"data:chromosome_vcf\"\n    data_name: \"Chromosome VCF\"\n    description: >\n      Input VCF files from the 1000 Genomes Project; one file per chromosome containing\n      approximately 250,000 SNP records across 2504 individual columns. Used as primary\n      input for per-individual mutation extraction.\n    format: \"vcf\"\n    category: \"input\"\n    persistence: \"persistent\"\n    cardinality: \"10 files (chromosomes 21, 22, and others defined in data.csv)\"\n    data_volume_class: \"large\"\n    lifecycle: \"Available before workflow starts; read-only; retained after workflow completes.\"\n\n  - data_id: \"data:columns_file\"\n    data_name: \"Columns File\"\n    description: >\n      Text file mapping VCF column indices to the 2504 individual identifiers. Required\n      by task:individuals to know which columns correspond to which individual.\n    format: \"text\"\n    category: \"config\"\n    persistence: \"persistent\"\n    cardinality: \"1 file\"\n    data_volume_class: \"small\"\n    lifecycle: \"Static configuration input; read-only throughout workflow.\"\n\n  - data_id: \"data:annotation_vcf\"\n    data_name: \"Annotation VCF\"\n    description: >\n      VEP-annotated VCF files with SIFT pathogenicity predictions per variant; one file\n      per chromosome. Used as input for SIFT score extraction.\n    format: \"vcf\"\n    category: \"input\"\n    persistence: \"persistent\"\n    cardinality: \"10 files (one per chromosome)\"\n    data_volume_class: \"large\"\n    lifecycle: \"Available before workflow starts; read-only; retained after workflow completes.\"\n\n  - data_id: \"data:population_file\"\n    data_name: \"Population File\"\n    description: >\n      Text files listing individual IDs belonging to each population group. Seven files\n      covering: ALL (2504), AFR (661), AMR (347), EAS (504), EUR (503), GBR (91), SAS (489).\n    format: \"text\"\n    category: \"input\"\n    persistence: \"persistent\"\n    cardinality: \"7 files (one per population group)\"\n    data_volume_class: \"small\"\n    lifecycle: \"Available before workflow starts; read-only; retained after workflow completes.\"\n\n  - data_id: \"data:individual_chr_tar\"\n    data_name: \"Individual Chromosome Tar\"\n    description: >\n      Per-chromosome-chunk tar.gz archive containing one text file per individual (2504 files)\n      with mutation calls for that chunk. Intermediate product of task:individuals.\n    format: \"tar.gz\"\n    category: \"intermediate\"\n    persistence: \"stage_scoped\"\n    cardinality: \"N_chunks * 10 files (chunk count is a runtime parameter)\"\n    data_volume_class: \"large\"\n    lifecycle: >\n      Created by task:individuals per (chromosome, chunk) job; consumed by\n      task:individuals_merge; can be deleted after merge completes per chromosome.\n\n  - data_id: \"data:merged_chr_tar\"\n    data_name: \"Merged Chromosome Tar\"\n    description: >\n      Complete per-chromosome tar.gz archive containing one text file per individual\n      (2504 files) with all mutations across all chunks for that chromosome.\n      Fan-in product of task:individuals_merge.\n    format: \"tar.gz\"\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    cardinality: \"10 files (one per chromosome)\"\n    data_volume_class: \"large\"\n    lifecycle: >\n      Created by task:individuals_merge; consumed by both task:mutation_overlap and\n      task:frequency in stage:population_analysis; retained until workflow completes.\n\n  - data_id: \"data:sifted_chr_file\"\n    data_name: \"Sifted Chromosome File\"\n    description: >\n      Per-chromosome text file of SIFT-scored variants extracted from VEP annotation VCFs.\n      Provides pathogenicity annotations for use in population analysis tasks.\n    format: \"text\"\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    cardinality: \"10 files (one per chromosome)\"\n    data_volume_class: \"medium\"\n    lifecycle: >\n      Created by task:sifting; consumed by both task:mutation_overlap and task:frequency\n      in stage:population_analysis; retained until workflow completes.\n\n  - data_id: \"data:mutation_overlap_results\"\n    data_name: \"Mutation Overlap Results\"\n    description: >\n      Pairwise mutation overlap statistics and matplotlib plots for all individual pairs\n      across populations. Final analytical output of the overlap analysis path.\n    format: \"mixed (text statistics + png plots)\"\n    category: \"output\"\n    persistence: \"persistent\"\n    cardinality: \"variable (statistics files + plot images per population)\"\n    data_volume_class: \"medium\"\n    lifecycle: \"Created by task:mutation_overlap; final output; retained indefinitely.\"\n\n  - data_id: \"data:frequency_results\"\n    data_name: \"Frequency Results\"\n    description: >\n      Allele frequency distribution estimates derived from 1000 Monte Carlo sampling\n      iterations with 52 randomly selected individuals per run.\n    format: \"text\"\n    category: \"output\"\n    persistence: \"persistent\"\n    cardinality: \"1 summary output file\"\n    data_volume_class: \"small\"\n    lifecycle: \"Created by task:frequency; final output; retained indefinitely.\"\n\npc_edges:\n  - edge_id: \"pc:individuals->individuals_merge:n_to_1\"\n    producer: \"task:individuals\"\n    consumer: \"task:individuals_merge\"\n    data_objects:\n      - \"data:individual_chr_tar\"\n    pc_pattern: \"n_to_1\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All N chunk jobs for a chromosome must complete before the merge job for that\n      chromosome can start. Fan-in per chromosome: N chunk archives -> 1 merged archive.\n      Pegasus manages the dependency explicitly.\n\n  - edge_id: \"pc:individuals_merge->frequency:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 merged chromosome archives produced by the 10 individuals_merge jobs\n      are broadcast to the single frequency analysis job.\n\n  - edge_id: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 merged chromosome archives produced by the 10 individuals_merge jobs\n      are consumed by the single mutation overlap analysis job.\n\n  - edge_id: \"pc:sifting->frequency:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 sifted chromosome files produced by the 10 sifting jobs are consumed\n      by the single frequency analysis job.\n\n  - edge_id: \"pc:sifting->mutation_overlap:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 sifted chromosome files produced by the 10 sifting jobs are consumed\n      by the single mutation overlap analysis job.\n\nworkflow_graph:\n  entry_tasks:\n    - \"task:individuals\"\n    - \"task:sifting\"\n  terminal_tasks:\n    - \"task:mutation_overlap\"\n    - \"task:frequency\"\n  integrity_hash: \"pending_python_execution\"\n  integrity_hash_note: >\n    Compute via: python3 -c \"import json,hashlib; edges=sorted([{'consumer':'task:individuals_merge','data_objects':['data:individual_chr_tar'],'edge_id':'pc:individuals->individuals_merge:n_to_1','pc_pattern':'n_to_1','producer':'task:individuals'},{'consumer':'task:frequency','data_objects':['data:merged_chr_tar'],'edge_id':'pc:individuals_merge->frequency:1_to_n','pc_pattern':'1_to_n','producer':'task:individuals_merge'},{'consumer':'task:mutation_overlap','data_objects':['data:merged_chr_tar'],'edge_id':'pc:individuals_merge->mutation_overlap:1_to_n','pc_pattern':'1_to_n','producer':'task:individuals_merge'},{'consumer':'task:frequency','data_objects':['data:sifted_chr_file'],'edge_id':'pc:sifting->frequency:1_to_n','pc_pattern':'1_to_n','producer':'task:sifting'},{'consumer':'task:mutation_overlap','data_objects':['data:sifted_chr_file'],'edge_id':'pc:sifting->mutation_overlap:1_to_n','pc_pattern':'1_to_n','producer':'task:sifting'}],key=lambda e:e['edge_id']); print(hashlib.sha256(json.dumps(edges,sort_keys=True,separators=(',',':')).encode()).hexdigest())\"\n\nworkflow_patterns:\n  primary_pattern: \"scatter_gather\"\n  secondary_patterns:\n    - \"broadcast\"\n  pattern_notes: >\n    VCF chromosomes scatter across embarrassingly parallel individuals jobs (scatter phase),\n    merge jobs gather per chromosome (gather phase), then merged data and sifted scores\n    broadcast to two independent terminal analysis tasks (broadcast phase).\n    The dual-consumer broadcast at stage 3 distinguishes this from a pure scatter_gather.\n\nio_behavioral_hints:\n  - hint_id: \"hint:small_file_overhead_individuals\"\n    affected_tasks:\n      - \"task:individuals\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"small_file_overhead\"\n    description: >\n      task:individuals writes 2504 individual text files per chunk to a temporary directory\n      before compressing. On shared Lustre/GPFS filesystems this generates significant\n      metadata pressure (2504 creates + 2504 writes + 2504 stats per chunk job). Burst\n      buffer or node-local storage for the intermediate files would mitigate this.\n    severity: \"high\"\n\n  - hint_id: \"hint:unnecessary_serialization_individuals\"\n    affected_tasks:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"unnecessary_serialization\"\n    description: >\n      Individual files are written to disk and compressed to tar.gz by task:individuals,\n      only to be decompressed and re-compressed by task:individuals_merge. The double\n      compress-decompress cycle doubles I/O volume. In-memory streaming or a single-pass\n      merge (Decaf path) could eliminate the intermediate tar.gz entirely.\n    severity: \"medium\"\n\n  - hint_id: \"hint:data_reuse_merged_chr_tar\"\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:merged_chr_tar\"\n    potential_concern: \"data_reuse\"\n    description: >\n      Merged chromosome archives (10 files) are independently read by both terminal\n      analysis tasks. Staging to burst buffer or node-local storage before stage 3\n      would benefit both consumers and reduce PFS pressure during the analysis phase.\n    severity: \"medium\"\n\n  - hint_id: \"hint:data_reuse_sifted_chr_file\"\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:sifted_chr_file\"\n    potential_concern: \"data_reuse\"\n    description: >\n      Sifted chromosome files (10 files) are read by both terminal analysis tasks.\n      Co-locating these with the merged_chr_tar on fast storage is recommended\n      to avoid two separate PFS read passes for the same consumers.\n    severity: \"medium\"\n\n  - hint_id: \"hint:small_file_overhead_frequency\"\n    affected_tasks:\n      - \"task:frequency\"\n    affected_data:\n      - \"data:frequency_results\"\n    potential_concern: \"small_file_overhead\"\n    description: >\n      If frequency.py writes intermediate results per Monte Carlo iteration (1000 runs),\n      this generates 1000 small file creates. Static analysis suggests single output file\n      but runtime behavior depends on implementation details not fully resolved statically.\n    severity: \"low\"\n\nexecution_profiles:\n  - profile_name: \"overlap_analysis_only\"\n    description: >\n      Runs the workflow through pairwise mutation overlap analysis only, skipping\n      Monte Carlo frequency estimation. Useful when only population overlap statistics\n      and plots are needed.\n    entry_tasks:\n      - \"task:individuals\"\n      - \"task:sifting\"\n    terminal_tasks:\n      - \"task:mutation_overlap\"\n    conditional_inclusions: []\n\n  - profile_name: \"full\"\n    description: >\n      Complete workflow execution including both pairwise overlap analysis and\n      Monte Carlo allele frequency analysis.\n    entry_tasks:\n      - \"task:individuals\"\n      - \"task:sifting\"\n    terminal_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    conditional_inclusions: []\n\ntranslation_metadata:\n  translation_tool: \"claude-sonnet-4-6\"\n  translation_date: \"2026-03-04\"\n  source_language: \"python\"\n  source_wms: \"pegasus\"\n  confidence_overall: \"high\"\n  assumptions:\n    - \"Decaf in-memory MPI dataflow alternative (lib/ C++ code) not analyzed in detail; Pegasus path used as primary workflow description.\"\n    - \"Chunk count per chromosome is a runtime parameter in daxgen.py and cannot be determined by static analysis alone.\"\n    - \"integrity_hash field contains placeholder; see integrity_hash_note for computation command.\"\n    - \"Exact data sizes depend on runtime VCF inputs and are not determinable by static analysis.\"\n    - \"task:frequency 1000 Monte Carlo runs are logically parallelizable but run serially in reference implementation.\"\n  unmapped_fields:\n    - \"Exact chunk count per chromosome (runtime parameter -i ind_jobs in daxgen.py)\"\n    - \"Exact data sizes for chromosome_vcf and annotation_vcf (depend on runtime inputs)\"\n    - \"Decaf in-memory dataflow topology (lib/ C++ not analyzed)\"\n  field_confidence_records:\n    - field: \"io_dominance\"\n      confidence: \"medium\"\n      reasoning: >\n        Inferred from script structure: individuals writes 2504 files per chunk (io_bound),\n        individuals_merge extract+recompress (io_bound), sifting is grep+parse (balanced),\n        mutation_overlap O(N^2) compute + matplotlib (balanced), frequency 1000 iterations (compute_bound).\n    - field: \"parallelism_model\"\n      confidence: \"high\"\n      reasoning: >\n        Pegasus DAX generator (daxgen.py) explicitly creates one job per (chromosome, chunk)\n        for individuals, one per chromosome for merge and sifting, one each for terminal tasks.\n    - field: \"pc_pattern\"\n      confidence: \"high\"\n      reasoning: >\n        Pegasus dependency declarations in daxgen.py directly encode n_to_1 (chunk->merge)\n        and 1_to_n (merge->analysis, sifting->analysis) relationships.\n    - field: \"primary_pattern\"\n      confidence: \"high\"\n      reasoning: >\n        Scatter-gather clearly visible in daxgen.py: chromosomes scatter to individuals jobs,\n        merge gathers per chromosome, merged data and sifted files broadcast to two consumers.\n    - field: \"io_access_type\"\n      confidence: \"high\"\n      reasoning: >\n        No mpi4py, h5py, netCDF4, or parallel I/O imports found in any of the five task scripts.\n        All I/O is standard Python file open/read/write (python_serial).\n    - field: \"restart_model\"\n      confidence: \"medium\"\n      reasoning: >\n        No checkpoint-read logic at startup found in any task script. All scripts overwrite\n        outputs deterministically given same inputs. Classified as idempotent.\n"}},{"tool_name":"Write","tool_use_id":"toolu_01Hvu9nmXqTUcUCQxC9yN93q","tool_input":{"file_path":"/mnt/common/mtang11/scripts/workflow-representation-description/workflow_wdd/1000genome-wdd-claude-trial3.yaml","content":"schema_version: \"wrd-7.0\"\n\nmetadata:\n  workflow_lineage_id: \"wrd:1000genome\"\n  version: \"1.0.0\"\n  workflow_name: \"1000genome\"\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  generated_by: \"claude-sonnet-4-6\"\n  generation_date: \"2026-03-04\"\n  workflow_description: >\n    Population genomics workflow processing VCF files from the 1000 Genomes Project.\n    Extracts per-individual mutations per chromosome chunk, merges chunks into per-chromosome\n    archives, annotates variants with SIFT pathogenicity scores from VEP annotation VCFs,\n    then performs pairwise mutation overlap analysis and Monte Carlo allele frequency analysis\n    across 2504 individuals spanning 26 populations.\n  source_repository: \"workflows_repo/1000genome-workflow\"\n  source_commit: \"unknown\"\n  notes: >\n    Static analysis of Pegasus DAX generator (daxgen.py) and five Python task scripts\n    in bin/. Decaf in-memory MPI dataflow alternative (lib/ C++ code) identified but not\n    analyzed in depth; Pegasus path used as primary. Chunk count per chromosome is a\n    runtime parameter in daxgen.py and is not captured here.\n\nstages:\n  - stage_id: \"stage:individuals_processing\"\n    stage_name: \"Individuals Processing\"\n    order: 1\n    description: >\n      Parse VCF files per chromosome chunk and extract per-individual mutation data,\n      producing per-chunk tar.gz archives containing one file per individual.\n    tasks:\n      - \"task:individuals\"\n\n  - stage_id: \"stage:merge_and_sifting\"\n    stage_name: \"Merge and Sifting\"\n    order: 2\n    description: >\n      Merge chunked individual archives into per-chromosome tarballs (fan-in), and\n      concurrently extract SIFT pathogenicity scores from VEP annotation VCFs.\n      Both sub-tasks are independent and run in parallel within this stage.\n    tasks:\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n\n  - stage_id: \"stage:population_analysis\"\n    stage_name: \"Population Analysis\"\n    order: 3\n    description: >\n      Consume merged archives and sifted score files to perform pairwise mutation\n      overlap analysis and Monte Carlo allele frequency analysis across populations.\n    tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n\ntasks:\n  - task_id: \"task:individuals\"\n    task_name: \"individuals\"\n    stage_id: \"stage:individuals_processing\"\n    description: >\n      Parses a VCF file line-by-line for a chromosome chunk (a non-overlapping line range),\n      extracts allele calls for all 2504 individuals using a columns mapping file, writes\n      one text file per individual, then compresses all individual files into a tar.gz archive.\n    script: \"bin/individuals.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        One Pegasus job per (chromosome, chunk) pair; chunks are non-overlapping line ranges\n        defined by daxgen.py. Typically 10 chromosomes with N chunks each (N is a runtime\n        parameter). All chunk jobs are independent.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:chromosome_vcf\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:individual_chr_tar\"\n    output_class: \"intermediate\"\n    behavioral_notes: >\n      Writes 2504 individual text files to a temporary directory per chunk before\n      compressing to tar.gz. This creates significant small-file I/O pressure on\n      shared filesystems (metadata operations dominate). The compress-then-merge\n      pattern results in double serialization before downstream consumption.\n\n  - task_id: \"task:individuals_merge\"\n    task_name: \"individuals_merge\"\n    stage_id: \"stage:merge_and_sifting\"\n    description: >\n      Merges all chunked per-chromosome tar.gz archives (fan-in) into a single\n      per-chromosome tarball containing complete per-individual mutation lists\n      across all line ranges for that chromosome.\n    script: \"bin/individuals_merge.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        One Pegasus job per chromosome; all chunk archives for a chromosome must be\n        complete (via Pegasus dependency) before the merge job for that chromosome starts.\n        Independent across chromosomes.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:individual_chr_tar\"\n    outputs:\n      - \"data:merged_chr_tar\"\n    output_class: \"intermediate\"\n    behavioral_notes: >\n      Extracts all chunk tarballs and re-compresses into a single per-chromosome archive.\n      Intermediate decompressed state can temporarily exceed the final output size on disk.\n      The re-compression step is I/O intensive and could be avoided with streaming approaches.\n\n  - task_id: \"task:sifting\"\n    task_name: \"sifting\"\n    stage_id: \"stage:merge_and_sifting\"\n    description: >\n      Extracts SIFT pathogenicity scores from VEP-annotated VCF files using subprocess\n      grep for fast line filtering followed by Python regex parsing. Produces one text\n      file per chromosome with SIFT-scored variant records.\n    script: \"bin/sifting.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        One Pegasus job per chromosome annotation VCF; entirely independent of the\n        individuals processing path. Runs concurrently with task:individuals_merge\n        within stage:merge_and_sifting.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:annotation_vcf\"\n    outputs:\n      - \"data:sifted_chr_file\"\n    output_class: \"intermediate\"\n    behavioral_notes: >\n      Uses subprocess grep for fast line pre-filtering before Python regex; the grep\n      subprocess call introduces a process-spawn overhead per VCF line batch. Output\n      is a structured text file of SIFT-scored variants per chromosome.\n\n  - task_id: \"task:mutation_overlap\"\n    task_name: \"mutation_overlap\"\n    stage_id: \"stage:population_analysis\"\n    description: >\n      Performs O(N^2) pairwise mutation set intersection analysis across all individuals\n      and population groups. Reads merged chromosome archives and sifted score files,\n      computes overlap statistics, and generates matplotlib plots.\n    script: \"bin/mutation_overlap.py\"\n    parallelism_model:\n      type: \"serial\"\n      notes: >\n        Single Pegasus job consuming all 10 merged chromosome archives and 10 sifted\n        chromosome files; O(N^2) over 2504 individuals (approximately 3.1 million pairs).\n        No internal parallelism observed in static analysis.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n    outputs:\n      - \"data:mutation_overlap_results\"\n    output_class: \"checkpoint\"\n    behavioral_notes: >\n      Reads all 10 merged archives into memory for pairwise comparison; memory footprint\n      scales with number_of_individuals * chromosomes * average_mutation_set_size.\n      Matplotlib plot generation adds a CPU+I/O tail to the compute phase.\n\n  - task_id: \"task:frequency\"\n    task_name: \"frequency\"\n    stage_id: \"stage:population_analysis\"\n    description: >\n      Performs 1000 Monte Carlo iterations, sampling 52 random individuals per run\n      to estimate allele frequency distributions across populations using merged\n      chromosome archives and SIFT score files.\n    script: \"bin/frequency.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        1000 independent Monte Carlo runs are logically parallelizable, but the reference\n        implementation in bin/frequency.py runs them serially. Pegasus submits this as a\n        single job. Could be split into 1000 independent tasks for HPC scheduling.\n    io_dominance: \"compute_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n    outputs:\n      - \"data:frequency_results\"\n    output_class: \"checkpoint\"\n    behavioral_notes: >\n      CPU-dominant due to 1000 Monte Carlo iterations with random sampling; reads data\n      once at startup then operates primarily in-memory per iteration. The 1000-run\n      loop dominates wall time over I/O activity.\n\ndata_objects:\n  - data_id: \"data:chromosome_vcf\"\n    data_name: \"Chromosome VCF\"\n    description: >\n      Input VCF files from the 1000 Genomes Project; one file per chromosome containing\n      approximately 250,000 SNP records across 2504 individual columns. Used as primary\n      input for per-individual mutation extraction.\n    format: \"vcf\"\n    category: \"input\"\n    persistence: \"persistent\"\n    cardinality: \"10 files (chromosomes 21, 22, and others defined in data.csv)\"\n    data_volume_class: \"large\"\n    lifecycle: \"Available before workflow starts; read-only; retained after workflow completes.\"\n\n  - data_id: \"data:columns_file\"\n    data_name: \"Columns File\"\n    description: >\n      Text file mapping VCF column indices to the 2504 individual identifiers. Required\n      by task:individuals to know which columns correspond to which individual.\n    format: \"text\"\n    category: \"config\"\n    persistence: \"persistent\"\n    cardinality: \"1 file\"\n    data_volume_class: \"small\"\n    lifecycle: \"Static configuration input; read-only throughout workflow.\"\n\n  - data_id: \"data:annotation_vcf\"\n    data_name: \"Annotation VCF\"\n    description: >\n      VEP-annotated VCF files with SIFT pathogenicity predictions per variant; one file\n      per chromosome. Used as input for SIFT score extraction.\n    format: \"vcf\"\n    category: \"input\"\n    persistence: \"persistent\"\n    cardinality: \"10 files (one per chromosome)\"\n    data_volume_class: \"large\"\n    lifecycle: \"Available before workflow starts; read-only; retained after workflow completes.\"\n\n  - data_id: \"data:population_file\"\n    data_name: \"Population File\"\n    description: >\n      Text files listing individual IDs belonging to each population group. Seven files\n      covering: ALL (2504), AFR (661), AMR (347), EAS (504), EUR (503), GBR (91), SAS (489).\n    format: \"text\"\n    category: \"input\"\n    persistence: \"persistent\"\n    cardinality: \"7 files (one per population group)\"\n    data_volume_class: \"small\"\n    lifecycle: \"Available before workflow starts; read-only; retained after workflow completes.\"\n\n  - data_id: \"data:individual_chr_tar\"\n    data_name: \"Individual Chromosome Tar\"\n    description: >\n      Per-chromosome-chunk tar.gz archive containing one text file per individual (2504 files)\n      with mutation calls for that chunk. Intermediate product of task:individuals.\n    format: \"tar.gz\"\n    category: \"intermediate\"\n    persistence: \"stage_scoped\"\n    cardinality: \"N_chunks * 10 files (chunk count is a runtime parameter)\"\n    data_volume_class: \"large\"\n    lifecycle: >\n      Created by task:individuals per (chromosome, chunk) job; consumed by\n      task:individuals_merge; can be deleted after merge completes per chromosome.\n\n  - data_id: \"data:merged_chr_tar\"\n    data_name: \"Merged Chromosome Tar\"\n    description: >\n      Complete per-chromosome tar.gz archive containing one text file per individual\n      (2504 files) with all mutations across all chunks for that chromosome.\n      Fan-in product of task:individuals_merge.\n    format: \"tar.gz\"\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    cardinality: \"10 files (one per chromosome)\"\n    data_volume_class: \"large\"\n    lifecycle: >\n      Created by task:individuals_merge; consumed by both task:mutation_overlap and\n      task:frequency in stage:population_analysis; retained until workflow completes.\n\n  - data_id: \"data:sifted_chr_file\"\n    data_name: \"Sifted Chromosome File\"\n    description: >\n      Per-chromosome text file of SIFT-scored variants extracted from VEP annotation VCFs.\n      Provides pathogenicity annotations for use in population analysis tasks.\n    format: \"text\"\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    cardinality: \"10 files (one per chromosome)\"\n    data_volume_class: \"medium\"\n    lifecycle: >\n      Created by task:sifting; consumed by both task:mutation_overlap and task:frequency\n      in stage:population_analysis; retained until workflow completes.\n\n  - data_id: \"data:mutation_overlap_results\"\n    data_name: \"Mutation Overlap Results\"\n    description: >\n      Pairwise mutation overlap statistics and matplotlib plots for all individual pairs\n      across populations. Final analytical output of the overlap analysis path.\n    format: \"mixed (text statistics + png plots)\"\n    category: \"output\"\n    persistence: \"persistent\"\n    cardinality: \"variable (statistics files + plot images per population)\"\n    data_volume_class: \"medium\"\n    lifecycle: \"Created by task:mutation_overlap; final output; retained indefinitely.\"\n\n  - data_id: \"data:frequency_results\"\n    data_name: \"Frequency Results\"\n    description: >\n      Allele frequency distribution estimates derived from 1000 Monte Carlo sampling\n      iterations with 52 randomly selected individuals per run.\n    format: \"text\"\n    category: \"output\"\n    persistence: \"persistent\"\n    cardinality: \"1 summary output file\"\n    data_volume_class: \"small\"\n    lifecycle: \"Created by task:frequency; final output; retained indefinitely.\"\n\npc_edges:\n  - edge_id: \"pc:individuals->individuals_merge:n_to_1\"\n    producer: \"task:individuals\"\n    consumer: \"task:individuals_merge\"\n    data_objects:\n      - \"data:individual_chr_tar\"\n    pc_pattern: \"n_to_1\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All N chunk jobs for a chromosome must complete before the merge job for that\n      chromosome can start. Fan-in per chromosome: N chunk archives -> 1 merged archive.\n      Pegasus manages the dependency explicitly.\n\n  - edge_id: \"pc:individuals_merge->frequency:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 merged chromosome archives produced by the 10 individuals_merge jobs\n      are broadcast to the single frequency analysis job.\n\n  - edge_id: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 merged chromosome archives produced by the 10 individuals_merge jobs\n      are consumed by the single mutation overlap analysis job.\n\n  - edge_id: \"pc:sifting->frequency:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 sifted chromosome files produced by the 10 sifting jobs are consumed\n      by the single frequency analysis job.\n\n  - edge_id: \"pc:sifting->mutation_overlap:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 sifted chromosome files produced by the 10 sifting jobs are consumed\n      by the single mutation overlap analysis job.\n\nworkflow_graph:\n  entry_tasks:\n    - \"task:individuals\"\n    - \"task:sifting\"\n  terminal_tasks:\n    - \"task:mutation_overlap\"\n    - \"task:frequency\"\n  integrity_hash: \"pending_python_execution\"\n  integrity_hash_note: >\n    Compute via: python3 -c \"import json,hashlib; edges=sorted([{'consumer':'task:individuals_merge','data_objects':['data:individual_chr_tar'],'edge_id':'pc:individuals->individuals_merge:n_to_1','pc_pattern':'n_to_1','producer':'task:individuals'},{'consumer':'task:frequency','data_objects':['data:merged_chr_tar'],'edge_id':'pc:individuals_merge->frequency:1_to_n','pc_pattern':'1_to_n','producer':'task:individuals_merge'},{'consumer':'task:mutation_overlap','data_objects':['data:merged_chr_tar'],'edge_id':'pc:individuals_merge->mutation_overlap:1_to_n','pc_pattern':'1_to_n','producer':'task:individuals_merge'},{'consumer':'task:frequency','data_objects':['data:sifted_chr_file'],'edge_id':'pc:sifting->frequency:1_to_n','pc_pattern':'1_to_n','producer':'task:sifting'},{'consumer':'task:mutation_overlap','data_objects':['data:sifted_chr_file'],'edge_id':'pc:sifting->mutation_overlap:1_to_n','pc_pattern':'1_to_n','producer':'task:sifting'}],key=lambda e:e['edge_id']); print(hashlib.sha256(json.dumps(edges,sort_keys=True,separators=(',',':')).encode()).hexdigest())\"\n\nworkflow_patterns:\n  primary_pattern: \"scatter_gather\"\n  secondary_patterns:\n    - \"broadcast\"\n  pattern_notes: >\n    VCF chromosomes scatter across embarrassingly parallel individuals jobs (scatter phase),\n    merge jobs gather per chromosome (gather phase), then merged data and sifted scores\n    broadcast to two independent terminal analysis tasks (broadcast phase).\n    The dual-consumer broadcast at stage 3 distinguishes this from a pure scatter_gather.\n\nio_behavioral_hints:\n  - hint_id: \"hint:small_file_overhead_individuals\"\n    affected_tasks:\n      - \"task:individuals\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"small_file_overhead\"\n    description: >\n      task:individuals writes 2504 individual text files per chunk to a temporary directory\n      before compressing. On shared Lustre/GPFS filesystems this generates significant\n      metadata pressure (2504 creates + 2504 writes + 2504 stats per chunk job). Burst\n      buffer or node-local storage for the intermediate files would mitigate this.\n    severity: \"high\"\n\n  - hint_id: \"hint:unnecessary_serialization_individuals\"\n    affected_tasks:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"unnecessary_serialization\"\n    description: >\n      Individual files are written to disk and compressed to tar.gz by task:individuals,\n      only to be decompressed and re-compressed by task:individuals_merge. The double\n      compress-decompress cycle doubles I/O volume. In-memory streaming or a single-pass\n      merge (Decaf path) could eliminate the intermediate tar.gz entirely.\n    severity: \"medium\"\n\n  - hint_id: \"hint:data_reuse_merged_chr_tar\"\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:merged_chr_tar\"\n    potential_concern: \"data_reuse\"\n    description: >\n      Merged chromosome archives (10 files) are independently read by both terminal\n      analysis tasks. Staging to burst buffer or node-local storage before stage 3\n      would benefit both consumers and reduce PFS pressure during the analysis phase.\n    severity: \"medium\"\n\n  - hint_id: \"hint:data_reuse_sifted_chr_file\"\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:sifted_chr_file\"\n    potential_concern: \"data_reuse\"\n    description: >\n      Sifted chromosome files (10 files) are read by both terminal analysis tasks.\n      Co-locating these with the merged_chr_tar on fast storage is recommended\n      to avoid two separate PFS read passes for the same consumers.\n    severity: \"medium\"\n\n  - hint_id: \"hint:small_file_overhead_frequency\"\n    affected_tasks:\n      - \"task:frequency\"\n    affected_data:\n      - \"data:frequency_results\"\n    potential_concern: \"small_file_overhead\"\n    description: >\n      If frequency.py writes intermediate results per Monte Carlo iteration (1000 runs),\n      this generates 1000 small file creates. Static analysis suggests single output file\n      but runtime behavior depends on implementation details not fully resolved statically.\n    severity: \"low\"\n\nexecution_profiles:\n  - profile_name: \"overlap_analysis_only\"\n    description: >\n      Runs the workflow through pairwise mutation overlap analysis only, skipping\n      Monte Carlo frequency estimation. Useful when only population overlap statistics\n      and plots are needed.\n    entry_tasks:\n      - \"task:individuals\"\n      - \"task:sifting\"\n    terminal_tasks:\n      - \"task:mutation_overlap\"\n    conditional_inclusions: []\n\n  - profile_name: \"full\"\n    description: >\n      Complete workflow execution including both pairwise overlap analysis and\n      Monte Carlo allele frequency analysis.\n    entry_tasks:\n      - \"task:individuals\"\n      - \"task:sifting\"\n    terminal_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    conditional_inclusions: []\n\ntranslation_metadata:\n  translation_tool: \"claude-sonnet-4-6\"\n  translation_date: \"2026-03-04\"\n  source_language: \"python\"\n  source_wms: \"pegasus\"\n  confidence_overall: \"high\"\n  assumptions:\n    - \"Decaf in-memory MPI dataflow alternative (lib/ C++ code) not analyzed in detail; Pegasus path used as primary workflow description.\"\n    - \"Chunk count per chromosome is a runtime parameter in daxgen.py and cannot be determined by static analysis alone.\"\n    - \"integrity_hash field contains placeholder; see integrity_hash_note for computation command.\"\n    - \"Exact data sizes depend on runtime VCF inputs and are not determinable by static analysis.\"\n    - \"task:frequency 1000 Monte Carlo runs are logically parallelizable but run serially in reference implementation.\"\n  unmapped_fields:\n    - \"Exact chunk count per chromosome (runtime parameter -i ind_jobs in daxgen.py)\"\n    - \"Exact data sizes for chromosome_vcf and annotation_vcf (depend on runtime inputs)\"\n    - \"Decaf in-memory dataflow topology (lib/ C++ not analyzed)\"\n  field_confidence_records:\n    - field: \"io_dominance\"\n      confidence: \"medium\"\n      reasoning: >\n        Inferred from script structure: individuals writes 2504 files per chunk (io_bound),\n        individuals_merge extract+recompress (io_bound), sifting is grep+parse (balanced),\n        mutation_overlap O(N^2) compute + matplotlib (balanced), frequency 1000 iterations (compute_bound).\n    - field: \"parallelism_model\"\n      confidence: \"high\"\n      reasoning: >\n        Pegasus DAX generator (daxgen.py) explicitly creates one job per (chromosome, chunk)\n        for individuals, one per chromosome for merge and sifting, one each for terminal tasks.\n    - field: \"pc_pattern\"\n      confidence: \"high\"\n      reasoning: >\n        Pegasus dependency declarations in daxgen.py directly encode n_to_1 (chunk->merge)\n        and 1_to_n (merge->analysis, sifting->analysis) relationships.\n    - field: \"primary_pattern\"\n      confidence: \"high\"\n      reasoning: >\n        Scatter-gather clearly visible in daxgen.py: chromosomes scatter to individuals jobs,\n        merge gathers per chromosome, merged data and sifted files broadcast to two consumers.\n    - field: \"io_access_type\"\n      confidence: \"high\"\n      reasoning: >\n        No mpi4py, h5py, netCDF4, or parallel I/O imports found in any of the five task scripts.\n        All I/O is standard Python file open/read/write (python_serial).\n    - field: \"restart_model\"\n      confidence: \"medium\"\n      reasoning: >\n        No checkpoint-read logic at startup found in any task script. All scripts overwrite\n        outputs deterministically given same inputs. Classified as idempotent.\n"}},{"tool_name":"Write","tool_use_id":"toolu_0129oQvGZftA3A7zyhex4bzc","tool_input":{"file_path":"/mnt/common/mtang11/scripts/workflow-representation-description/workflow_wdd/1000genome-wdd-claude-trial3.yaml","content":"schema_version: \"wrd-7.0\"\n\nmetadata:\n  workflow_lineage_id: \"wrd:1000genome\"\n  version: \"1.0.0\"\n  workflow_name: \"1000genome\"\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  generated_by: \"claude-sonnet-4-6\"\n  generation_date: \"2026-03-04\"\n  workflow_description: >\n    Population genomics workflow processing VCF files from the 1000 Genomes Project.\n    Extracts per-individual mutations per chromosome chunk, merges chunks into per-chromosome\n    archives, annotates variants with SIFT pathogenicity scores from VEP annotation VCFs,\n    then performs pairwise mutation overlap analysis and Monte Carlo allele frequency analysis\n    across 2504 individuals spanning 26 populations.\n  source_repository: \"workflows_repo/1000genome-workflow\"\n  source_commit: \"unknown\"\n  notes: >\n    Static analysis of Pegasus DAX generator (daxgen.py) and five Python task scripts\n    in bin/. Decaf in-memory MPI dataflow alternative (lib/ C++ code) identified but not\n    analyzed in depth; Pegasus path used as primary. Chunk count per chromosome is a\n    runtime parameter in daxgen.py and is not captured here.\n\nstages:\n  - stage_id: \"stage:individuals_processing\"\n    stage_name: \"Individuals Processing\"\n    order: 1\n    description: >\n      Parse VCF files per chromosome chunk and extract per-individual mutation data,\n      producing per-chunk tar.gz archives containing one file per individual.\n    tasks:\n      - \"task:individuals\"\n\n  - stage_id: \"stage:merge_and_sifting\"\n    stage_name: \"Merge and Sifting\"\n    order: 2\n    description: >\n      Merge chunked individual archives into per-chromosome tarballs (fan-in), and\n      concurrently extract SIFT pathogenicity scores from VEP annotation VCFs.\n      Both sub-tasks are independent and run in parallel within this stage.\n    tasks:\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n\n  - stage_id: \"stage:population_analysis\"\n    stage_name: \"Population Analysis\"\n    order: 3\n    description: >\n      Consume merged archives and sifted score files to perform pairwise mutation\n      overlap analysis and Monte Carlo allele frequency analysis across populations.\n    tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n\ntasks:\n  - task_id: \"task:individuals\"\n    task_name: \"individuals\"\n    stage_id: \"stage:individuals_processing\"\n    description: >\n      Parses a VCF file line-by-line for a chromosome chunk (a non-overlapping line range),\n      extracts allele calls for all 2504 individuals using a columns mapping file, writes\n      one text file per individual, then compresses all individual files into a tar.gz archive.\n    script: \"bin/individuals.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        One Pegasus job per (chromosome, chunk) pair; chunks are non-overlapping line ranges\n        defined by daxgen.py. Typically 10 chromosomes with N chunks each (N is a runtime\n        parameter). All chunk jobs are independent.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:chromosome_vcf\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:individual_chr_tar\"\n    output_class: \"intermediate\"\n    behavioral_notes: >\n      Writes 2504 individual text files to a temporary directory per chunk before\n      compressing to tar.gz. This creates significant small-file I/O pressure on\n      shared filesystems (metadata operations dominate). The compress-then-merge\n      pattern results in double serialization before downstream consumption.\n\n  - task_id: \"task:individuals_merge\"\n    task_name: \"individuals_merge\"\n    stage_id: \"stage:merge_and_sifting\"\n    description: >\n      Merges all chunked per-chromosome tar.gz archives (fan-in) into a single\n      per-chromosome tarball containing complete per-individual mutation lists\n      across all line ranges for that chromosome.\n    script: \"bin/individuals_merge.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        One Pegasus job per chromosome; all chunk archives for a chromosome must be\n        complete (via Pegasus dependency) before the merge job for that chromosome starts.\n        Independent across chromosomes.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:individual_chr_tar\"\n    outputs:\n      - \"data:merged_chr_tar\"\n    output_class: \"intermediate\"\n    behavioral_notes: >\n      Extracts all chunk tarballs and re-compresses into a single per-chromosome archive.\n      Intermediate decompressed state can temporarily exceed the final output size on disk.\n      The re-compression step is I/O intensive and could be avoided with streaming approaches.\n\n  - task_id: \"task:sifting\"\n    task_name: \"sifting\"\n    stage_id: \"stage:merge_and_sifting\"\n    description: >\n      Extracts SIFT pathogenicity scores from VEP-annotated VCF files using subprocess\n      grep for fast line filtering followed by Python regex parsing. Produces one text\n      file per chromosome with SIFT-scored variant records.\n    script: \"bin/sifting.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        One Pegasus job per chromosome annotation VCF; entirely independent of the\n        individuals processing path. Runs concurrently with task:individuals_merge\n        within stage:merge_and_sifting.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:annotation_vcf\"\n    outputs:\n      - \"data:sifted_chr_file\"\n    output_class: \"intermediate\"\n    behavioral_notes: >\n      Uses subprocess grep for fast line pre-filtering before Python regex; the grep\n      subprocess call introduces a process-spawn overhead per VCF line batch. Output\n      is a structured text file of SIFT-scored variants per chromosome.\n\n  - task_id: \"task:mutation_overlap\"\n    task_name: \"mutation_overlap\"\n    stage_id: \"stage:population_analysis\"\n    description: >\n      Performs O(N^2) pairwise mutation set intersection analysis across all individuals\n      and population groups. Reads merged chromosome archives and sifted score files,\n      computes overlap statistics, and generates matplotlib plots.\n    script: \"bin/mutation_overlap.py\"\n    parallelism_model:\n      type: \"serial\"\n      notes: >\n        Single Pegasus job consuming all 10 merged chromosome archives and 10 sifted\n        chromosome files; O(N^2) over 2504 individuals (approximately 3.1 million pairs).\n        No internal parallelism observed in static analysis.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n    outputs:\n      - \"data:mutation_overlap_results\"\n    output_class: \"checkpoint\"\n    behavioral_notes: >\n      Reads all 10 merged archives into memory for pairwise comparison; memory footprint\n      scales with number_of_individuals * chromosomes * average_mutation_set_size.\n      Matplotlib plot generation adds a CPU+I/O tail to the compute phase.\n\n  - task_id: \"task:frequency\"\n    task_name: \"frequency\"\n    stage_id: \"stage:population_analysis\"\n    description: >\n      Performs 1000 Monte Carlo iterations, sampling 52 random individuals per run\n      to estimate allele frequency distributions across populations using merged\n      chromosome archives and SIFT score files.\n    script: \"bin/frequency.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        1000 independent Monte Carlo runs are logically parallelizable, but the reference\n        implementation in bin/frequency.py runs them serially. Pegasus submits this as a\n        single job. Could be split into 1000 independent tasks for HPC scheduling.\n    io_dominance: \"compute_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n    outputs:\n      - \"data:frequency_results\"\n    output_class: \"checkpoint\"\n    behavioral_notes: >\n      CPU-dominant due to 1000 Monte Carlo iterations with random sampling; reads data\n      once at startup then operates primarily in-memory per iteration. The 1000-run\n      loop dominates wall time over I/O activity.\n\ndata_objects:\n  - data_id: \"data:chromosome_vcf\"\n    data_name: \"Chromosome VCF\"\n    description: >\n      Input VCF files from the 1000 Genomes Project; one file per chromosome containing\n      approximately 250,000 SNP records across 2504 individual columns. Used as primary\n      input for per-individual mutation extraction.\n    format: \"vcf\"\n    category: \"input\"\n    persistence: \"persistent\"\n    cardinality: \"10 files (chromosomes 21, 22, and others defined in data.csv)\"\n    data_volume_class: \"large\"\n    lifecycle: \"Available before workflow starts; read-only; retained after workflow completes.\"\n\n  - data_id: \"data:columns_file\"\n    data_name: \"Columns File\"\n    description: >\n      Text file mapping VCF column indices to the 2504 individual identifiers. Required\n      by task:individuals to know which columns correspond to which individual.\n    format: \"text\"\n    category: \"config\"\n    persistence: \"persistent\"\n    cardinality: \"1 file\"\n    data_volume_class: \"small\"\n    lifecycle: \"Static configuration input; read-only throughout workflow.\"\n\n  - data_id: \"data:annotation_vcf\"\n    data_name: \"Annotation VCF\"\n    description: >\n      VEP-annotated VCF files with SIFT pathogenicity predictions per variant; one file\n      per chromosome. Used as input for SIFT score extraction.\n    format: \"vcf\"\n    category: \"input\"\n    persistence: \"persistent\"\n    cardinality: \"10 files (one per chromosome)\"\n    data_volume_class: \"large\"\n    lifecycle: \"Available before workflow starts; read-only; retained after workflow completes.\"\n\n  - data_id: \"data:population_file\"\n    data_name: \"Population File\"\n    description: >\n      Text files listing individual IDs belonging to each population group. Seven files\n      covering: ALL (2504), AFR (661), AMR (347), EAS (504), EUR (503), GBR (91), SAS (489).\n    format: \"text\"\n    category: \"input\"\n    persistence: \"persistent\"\n    cardinality: \"7 files (one per population group)\"\n    data_volume_class: \"small\"\n    lifecycle: \"Available before workflow starts; read-only; retained after workflow completes.\"\n\n  - data_id: \"data:individual_chr_tar\"\n    data_name: \"Individual Chromosome Tar\"\n    description: >\n      Per-chromosome-chunk tar.gz archive containing one text file per individual (2504 files)\n      with mutation calls for that chunk. Intermediate product of task:individuals.\n    format: \"tar.gz\"\n    category: \"intermediate\"\n    persistence: \"stage_scoped\"\n    cardinality: \"N_chunks * 10 files (chunk count is a runtime parameter)\"\n    data_volume_class: \"large\"\n    lifecycle: >\n      Created by task:individuals per (chromosome, chunk) job; consumed by\n      task:individuals_merge; can be deleted after merge completes per chromosome.\n\n  - data_id: \"data:merged_chr_tar\"\n    data_name: \"Merged Chromosome Tar\"\n    description: >\n      Complete per-chromosome tar.gz archive containing one text file per individual\n      (2504 files) with all mutations across all chunks for that chromosome.\n      Fan-in product of task:individuals_merge.\n    format: \"tar.gz\"\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    cardinality: \"10 files (one per chromosome)\"\n    data_volume_class: \"large\"\n    lifecycle: >\n      Created by task:individuals_merge; consumed by both task:mutation_overlap and\n      task:frequency in stage:population_analysis; retained until workflow completes.\n\n  - data_id: \"data:sifted_chr_file\"\n    data_name: \"Sifted Chromosome File\"\n    description: >\n      Per-chromosome text file of SIFT-scored variants extracted from VEP annotation VCFs.\n      Provides pathogenicity annotations for use in population analysis tasks.\n    format: \"text\"\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    cardinality: \"10 files (one per chromosome)\"\n    data_volume_class: \"medium\"\n    lifecycle: >\n      Created by task:sifting; consumed by both task:mutation_overlap and task:frequency\n      in stage:population_analysis; retained until workflow completes.\n\n  - data_id: \"data:mutation_overlap_results\"\n    data_name: \"Mutation Overlap Results\"\n    description: >\n      Pairwise mutation overlap statistics and matplotlib plots for all individual pairs\n      across populations. Final analytical output of the overlap analysis path.\n    format: \"mixed (text statistics + png plots)\"\n    category: \"output\"\n    persistence: \"persistent\"\n    cardinality: \"variable (statistics files + plot images per population)\"\n    data_volume_class: \"medium\"\n    lifecycle: \"Created by task:mutation_overlap; final output; retained indefinitely.\"\n\n  - data_id: \"data:frequency_results\"\n    data_name: \"Frequency Results\"\n    description: >\n      Allele frequency distribution estimates derived from 1000 Monte Carlo sampling\n      iterations with 52 randomly selected individuals per run.\n    format: \"text\"\n    category: \"output\"\n    persistence: \"persistent\"\n    cardinality: \"1 summary output file\"\n    data_volume_class: \"small\"\n    lifecycle: \"Created by task:frequency; final output; retained indefinitely.\"\n\npc_edges:\n  - edge_id: \"pc:individuals->individuals_merge:n_to_1\"\n    producer: \"task:individuals\"\n    consumer: \"task:individuals_merge\"\n    data_objects:\n      - \"data:individual_chr_tar\"\n    pc_pattern: \"n_to_1\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All N chunk jobs for a chromosome must complete before the merge job for that\n      chromosome can start. Fan-in per chromosome: N chunk archives -> 1 merged archive.\n      Pegasus manages the dependency explicitly.\n\n  - edge_id: \"pc:individuals_merge->frequency:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 merged chromosome archives produced by the 10 individuals_merge jobs\n      are broadcast to the single frequency analysis job.\n\n  - edge_id: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 merged chromosome archives produced by the 10 individuals_merge jobs\n      are consumed by the single mutation overlap analysis job.\n\n  - edge_id: \"pc:sifting->frequency:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 sifted chromosome files produced by the 10 sifting jobs are consumed\n      by the single frequency analysis job.\n\n  - edge_id: \"pc:sifting->mutation_overlap:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 sifted chromosome files produced by the 10 sifting jobs are consumed\n      by the single mutation overlap analysis job.\n\nworkflow_graph:\n  entry_tasks:\n    - \"task:individuals\"\n    - \"task:sifting\"\n  terminal_tasks:\n    - \"task:mutation_overlap\"\n    - \"task:frequency\"\n  integrity_hash: \"pending_python_execution\"\n  integrity_hash_note: >\n    Compute via: python3 -c \"import json,hashlib; edges=sorted([{'consumer':'task:individuals_merge','data_objects':['data:individual_chr_tar'],'edge_id':'pc:individuals->individuals_merge:n_to_1','pc_pattern':'n_to_1','producer':'task:individuals'},{'consumer':'task:frequency','data_objects':['data:merged_chr_tar'],'edge_id':'pc:individuals_merge->frequency:1_to_n','pc_pattern':'1_to_n','producer':'task:individuals_merge'},{'consumer':'task:mutation_overlap','data_objects':['data:merged_chr_tar'],'edge_id':'pc:individuals_merge->mutation_overlap:1_to_n','pc_pattern':'1_to_n','producer':'task:individuals_merge'},{'consumer':'task:frequency','data_objects':['data:sifted_chr_file'],'edge_id':'pc:sifting->frequency:1_to_n','pc_pattern':'1_to_n','producer':'task:sifting'},{'consumer':'task:mutation_overlap','data_objects':['data:sifted_chr_file'],'edge_id':'pc:sifting->mutation_overlap:1_to_n','pc_pattern':'1_to_n','producer':'task:sifting'}],key=lambda e:e['edge_id']); print(hashlib.sha256(json.dumps(edges,sort_keys=True,separators=(',',':')).encode()).hexdigest())\"\n\nworkflow_patterns:\n  primary_pattern: \"scatter_gather\"\n  secondary_patterns:\n    - \"broadcast\"\n  pattern_notes: >\n    VCF chromosomes scatter across embarrassingly parallel individuals jobs (scatter phase),\n    merge jobs gather per chromosome (gather phase), then merged data and sifted scores\n    broadcast to two independent terminal analysis tasks (broadcast phase).\n    The dual-consumer broadcast at stage 3 distinguishes this from a pure scatter_gather.\n\nio_behavioral_hints:\n  - hint_id: \"hint:small_file_overhead_individuals\"\n    affected_tasks:\n      - \"task:individuals\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"small_file_overhead\"\n    description: >\n      task:individuals writes 2504 individual text files per chunk to a temporary directory\n      before compressing. On shared Lustre/GPFS filesystems this generates significant\n      metadata pressure (2504 creates + 2504 writes + 2504 stats per chunk job). Burst\n      buffer or node-local storage for the intermediate files would mitigate this.\n    severity: \"high\"\n\n  - hint_id: \"hint:unnecessary_serialization_individuals\"\n    affected_tasks:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"unnecessary_serialization\"\n    description: >\n      Individual files are written to disk and compressed to tar.gz by task:individuals,\n      only to be decompressed and re-compressed by task:individuals_merge. The double\n      compress-decompress cycle doubles I/O volume. In-memory streaming or a single-pass\n      merge (Decaf path) could eliminate the intermediate tar.gz entirely.\n    severity: \"medium\"\n\n  - hint_id: \"hint:data_reuse_merged_chr_tar\"\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:merged_chr_tar\"\n    potential_concern: \"data_reuse\"\n    description: >\n      Merged chromosome archives (10 files) are independently read by both terminal\n      analysis tasks. Staging to burst buffer or node-local storage before stage 3\n      would benefit both consumers and reduce PFS pressure during the analysis phase.\n    severity: \"medium\"\n\n  - hint_id: \"hint:data_reuse_sifted_chr_file\"\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:sifted_chr_file\"\n    potential_concern: \"data_reuse\"\n    description: >\n      Sifted chromosome files (10 files) are read by both terminal analysis tasks.\n      Co-locating these with the merged_chr_tar on fast storage is recommended\n      to avoid two separate PFS read passes for the same consumers.\n    severity: \"medium\"\n\n  - hint_id: \"hint:small_file_overhead_frequency\"\n    affected_tasks:\n      - \"task:frequency\"\n    affected_data:\n      - \"data:frequency_results\"\n    potential_concern: \"small_file_overhead\"\n    description: >\n      If frequency.py writes intermediate results per Monte Carlo iteration (1000 runs),\n      this generates 1000 small file creates. Static analysis suggests single output file\n      but runtime behavior depends on implementation details not fully resolved statically.\n    severity: \"low\"\n\nexecution_profiles:\n  - profile_name: \"overlap_analysis_only\"\n    description: >\n      Runs the workflow through pairwise mutation overlap analysis only, skipping\n      Monte Carlo frequency estimation. Useful when only population overlap statistics\n      and plots are needed.\n    entry_tasks:\n      - \"task:individuals\"\n      - \"task:sifting\"\n    terminal_tasks:\n      - \"task:mutation_overlap\"\n    conditional_inclusions: []\n\n  - profile_name: \"full\"\n    description: >\n      Complete workflow execution including both pairwise overlap analysis and\n      Monte Carlo allele frequency analysis.\n    entry_tasks:\n      - \"task:individuals\"\n      - \"task:sifting\"\n    terminal_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    conditional_inclusions: []\n\ntranslation_metadata:\n  translation_tool: \"claude-sonnet-4-6\"\n  translation_date: \"2026-03-04\"\n  source_language: \"python\"\n  source_wms: \"pegasus\"\n  confidence_overall: \"high\"\n  assumptions:\n    - \"Decaf in-memory MPI dataflow alternative (lib/ C++ code) not analyzed in detail; Pegasus path used as primary workflow description.\"\n    - \"Chunk count per chromosome is a runtime parameter in daxgen.py and cannot be determined by static analysis alone.\"\n    - \"integrity_hash field contains placeholder; see integrity_hash_note for computation command.\"\n    - \"Exact data sizes depend on runtime VCF inputs and are not determinable by static analysis.\"\n    - \"task:frequency 1000 Monte Carlo runs are logically parallelizable but run serially in reference implementation.\"\n  unmapped_fields:\n    - \"Exact chunk count per chromosome (runtime parameter -i ind_jobs in daxgen.py)\"\n    - \"Exact data sizes for chromosome_vcf and annotation_vcf (depend on runtime inputs)\"\n    - \"Decaf in-memory dataflow topology (lib/ C++ not analyzed)\"\n  field_confidence_records:\n    - field: \"io_dominance\"\n      confidence: \"medium\"\n      reasoning: >\n        Inferred from script structure: individuals writes 2504 files per chunk (io_bound),\n        individuals_merge extract+recompress (io_bound), sifting is grep+parse (balanced),\n        mutation_overlap O(N^2) compute + matplotlib (balanced), frequency 1000 iterations (compute_bound).\n    - field: \"parallelism_model\"\n      confidence: \"high\"\n      reasoning: >\n        Pegasus DAX generator (daxgen.py) explicitly creates one job per (chromosome, chunk)\n        for individuals, one per chromosome for merge and sifting, one each for terminal tasks.\n    - field: \"pc_pattern\"\n      confidence: \"high\"\n      reasoning: >\n        Pegasus dependency declarations in daxgen.py directly encode n_to_1 (chunk->merge)\n        and 1_to_n (merge->analysis, sifting->analysis) relationships.\n    - field: \"primary_pattern\"\n      confidence: \"high\"\n      reasoning: >\n        Scatter-gather clearly visible in daxgen.py: chromosomes scatter to individuals jobs,\n        merge gathers per chromosome, merged data and sifted files broadcast to two consumers.\n    - field: \"io_access_type\"\n      confidence: \"high\"\n      reasoning: >\n        No mpi4py, h5py, netCDF4, or parallel I/O imports found in any of the five task scripts.\n        All I/O is standard Python file open/read/write (python_serial).\n    - field: \"restart_model\"\n      confidence: \"medium\"\n      reasoning: >\n        No checkpoint-read logic at startup found in any task script. All scripts overwrite\n        outputs deterministically given same inputs. Classified as idempotent.\n"}},{"tool_name":"Bash","tool_use_id":"toolu_01CnZBsLqrzRhrQKEWc6obXk","tool_input":{"command":"cp /mnt/common/mtang11/scripts/workflow-representation-description/workflow_wdd/1000genome-wdd-claude-trial2.yaml /mnt/common/mtang11/scripts/workflow-representation-description/workflow_wdd/1000genome-wdd-claude-trial3.yaml","description":"Copy trial2 stub to trial3 as starting point for Edit"}},{"tool_name":"Edit","tool_use_id":"toolu_01BE6ewArcCXMePEyQLrgFjP","tool_input":{"file_path":"/mnt/common/mtang11/scripts/workflow-representation-description/workflow_wdd/1000genome-wdd-claude-trial2.yaml","old_string":"python3 -c \"import json,hashlib; edges=[...]; print(hashlib.sha256(json.dumps(edges,sort_keys=True,separators=(',',':')).encode()).hexdigest())\"\n","new_string":"schema_version: \"wrd-7.0\"\n\nmetadata:\n  workflow_lineage_id: \"wrd:1000genome\"\n  version: \"1.0.0\"\n  workflow_name: \"1000genome\"\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  generated_by: \"claude-sonnet-4-6\"\n  generation_date: \"2026-03-04\"\n  workflow_description: >\n    Population genomics workflow processing VCF files from the 1000 Genomes Project.\n    Extracts per-individual mutations per chromosome chunk, merges chunks into per-chromosome\n    archives, annotates variants with SIFT pathogenicity scores from VEP annotation VCFs,\n    then performs pairwise mutation overlap analysis and Monte Carlo allele frequency analysis\n    across 2504 individuals spanning 26 populations.\n  source_repository: \"workflows_repo/1000genome-workflow\"\n  source_commit: \"unknown\"\n  notes: >\n    Static analysis of Pegasus DAX generator (daxgen.py) and five Python task scripts\n    in bin/. Decaf in-memory MPI dataflow alternative (lib/ C++ code) identified but not\n    analyzed in depth; Pegasus path used as primary. Chunk count per chromosome is a\n    runtime parameter in daxgen.py and is not captured here.\n\nstages:\n  - stage_id: \"stage:individuals_processing\"\n    stage_name: \"Individuals Processing\"\n    order: 1\n    description: >\n      Parse VCF files per chromosome chunk and extract per-individual mutation data,\n      producing per-chunk tar.gz archives containing one file per individual.\n    tasks:\n      - \"task:individuals\"\n\n  - stage_id: \"stage:merge_and_sifting\"\n    stage_name: \"Merge and Sifting\"\n    order: 2\n    description: >\n      Merge chunked individual archives into per-chromosome tarballs (fan-in), and\n      concurrently extract SIFT pathogenicity scores from VEP annotation VCFs.\n      Both sub-tasks are independent and run in parallel within this stage.\n    tasks:\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n\n  - stage_id: \"stage:population_analysis\"\n    stage_name: \"Population Analysis\"\n    order: 3\n    description: >\n      Consume merged archives and sifted score files to perform pairwise mutation\n      overlap analysis and Monte Carlo allele frequency analysis across populations.\n    tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n\ntasks:\n  - task_id: \"task:individuals\"\n    task_name: \"individuals\"\n    stage_id: \"stage:individuals_processing\"\n    description: >\n      Parses a VCF file line-by-line for a chromosome chunk (a non-overlapping line range),\n      extracts allele calls for all 2504 individuals using a columns mapping file, writes\n      one text file per individual, then compresses all individual files into a tar.gz archive.\n    script: \"bin/individuals.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        One Pegasus job per (chromosome, chunk) pair; chunks are non-overlapping line ranges\n        defined by daxgen.py. Typically 10 chromosomes with N chunks each (N is a runtime\n        parameter). All chunk jobs are independent.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:chromosome_vcf\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:individual_chr_tar\"\n    output_class: \"intermediate\"\n    behavioral_notes: >\n      Writes 2504 individual text files to a temporary directory per chunk before\n      compressing to tar.gz. This creates significant small-file I/O pressure on\n      shared filesystems (metadata operations dominate). The compress-then-merge\n      pattern results in double serialization before downstream consumption.\n\n  - task_id: \"task:individuals_merge\"\n    task_name: \"individuals_merge\"\n    stage_id: \"stage:merge_and_sifting\"\n    description: >\n      Merges all chunked per-chromosome tar.gz archives (fan-in) into a single\n      per-chromosome tarball containing complete per-individual mutation lists\n      across all line ranges for that chromosome.\n    script: \"bin/individuals_merge.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        One Pegasus job per chromosome; all chunk archives for a chromosome must be\n        complete (via Pegasus dependency) before the merge job for that chromosome starts.\n        Independent across chromosomes.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:individual_chr_tar\"\n    outputs:\n      - \"data:merged_chr_tar\"\n    output_class: \"intermediate\"\n    behavioral_notes: >\n      Extracts all chunk tarballs and re-compresses into a single per-chromosome archive.\n      Intermediate decompressed state can temporarily exceed the final output size on disk.\n      The re-compression step is I/O intensive and could be avoided with streaming approaches.\n\n  - task_id: \"task:sifting\"\n    task_name: \"sifting\"\n    stage_id: \"stage:merge_and_sifting\"\n    description: >\n      Extracts SIFT pathogenicity scores from VEP-annotated VCF files using subprocess\n      grep for fast line filtering followed by Python regex parsing. Produces one text\n      file per chromosome with SIFT-scored variant records.\n    script: \"bin/sifting.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        One Pegasus job per chromosome annotation VCF; entirely independent of the\n        individuals processing path. Runs concurrently with task:individuals_merge\n        within stage:merge_and_sifting.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:annotation_vcf\"\n    outputs:\n      - \"data:sifted_chr_file\"\n    output_class: \"intermediate\"\n    behavioral_notes: >\n      Uses subprocess grep for fast line pre-filtering before Python regex; the grep\n      subprocess call introduces a process-spawn overhead per VCF line batch. Output\n      is a structured text file of SIFT-scored variants per chromosome.\n\n  - task_id: \"task:mutation_overlap\"\n    task_name: \"mutation_overlap\"\n    stage_id: \"stage:population_analysis\"\n    description: >\n      Performs O(N^2) pairwise mutation set intersection analysis across all individuals\n      and population groups. Reads merged chromosome archives and sifted score files,\n      computes overlap statistics, and generates matplotlib plots.\n    script: \"bin/mutation_overlap.py\"\n    parallelism_model:\n      type: \"serial\"\n      notes: >\n        Single Pegasus job consuming all 10 merged chromosome archives and 10 sifted\n        chromosome files; O(N^2) over 2504 individuals (approximately 3.1 million pairs).\n        No internal parallelism observed in static analysis.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n    outputs:\n      - \"data:mutation_overlap_results\"\n    output_class: \"checkpoint\"\n    behavioral_notes: >\n      Reads all 10 merged archives into memory for pairwise comparison; memory footprint\n      scales with number_of_individuals * chromosomes * average_mutation_set_size.\n      Matplotlib plot generation adds a CPU+I/O tail to the compute phase.\n\n  - task_id: \"task:frequency\"\n    task_name: \"frequency\"\n    stage_id: \"stage:population_analysis\"\n    description: >\n      Performs 1000 Monte Carlo iterations, sampling 52 random individuals per run\n      to estimate allele frequency distributions across populations using merged\n      chromosome archives and SIFT score files.\n    script: \"bin/frequency.py\"\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      notes: >\n        1000 independent Monte Carlo runs are logically parallelizable, but the reference\n        implementation in bin/frequency.py runs them serially. Pegasus submits this as a\n        single job. Could be split into 1000 independent tasks for HPC scheduling.\n    io_dominance: \"compute_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    inputs:\n      - \"data:merged_chr_tar\"\n      - \"data:sifted_chr_file\"\n      - \"data:population_file\"\n    outputs:\n      - \"data:frequency_results\"\n    output_class: \"checkpoint\"\n    behavioral_notes: >\n      CPU-dominant due to 1000 Monte Carlo iterations with random sampling; reads data\n      once at startup then operates primarily in-memory per iteration. The 1000-run\n      loop dominates wall time over I/O activity.\n\ndata_objects:\n  - data_id: \"data:chromosome_vcf\"\n    data_name: \"Chromosome VCF\"\n    description: >\n      Input VCF files from the 1000 Genomes Project; one file per chromosome containing\n      approximately 250,000 SNP records across 2504 individual columns. Used as primary\n      input for per-individual mutation extraction.\n    format: \"vcf\"\n    category: \"input\"\n    persistence: \"persistent\"\n    cardinality: \"10 files (chromosomes 21, 22, and others defined in data.csv)\"\n    data_volume_class: \"large\"\n    lifecycle: \"Available before workflow starts; read-only; retained after workflow completes.\"\n\n  - data_id: \"data:columns_file\"\n    data_name: \"Columns File\"\n    description: >\n      Text file mapping VCF column indices to the 2504 individual identifiers. Required\n      by task:individuals to know which columns correspond to which individual.\n    format: \"text\"\n    category: \"config\"\n    persistence: \"persistent\"\n    cardinality: \"1 file\"\n    data_volume_class: \"small\"\n    lifecycle: \"Static configuration input; read-only throughout workflow.\"\n\n  - data_id: \"data:annotation_vcf\"\n    data_name: \"Annotation VCF\"\n    description: >\n      VEP-annotated VCF files with SIFT pathogenicity predictions per variant; one file\n      per chromosome. Used as input for SIFT score extraction.\n    format: \"vcf\"\n    category: \"input\"\n    persistence: \"persistent\"\n    cardinality: \"10 files (one per chromosome)\"\n    data_volume_class: \"large\"\n    lifecycle: \"Available before workflow starts; read-only; retained after workflow completes.\"\n\n  - data_id: \"data:population_file\"\n    data_name: \"Population File\"\n    description: >\n      Text files listing individual IDs belonging to each population group. Seven files\n      covering: ALL (2504), AFR (661), AMR (347), EAS (504), EUR (503), GBR (91), SAS (489).\n    format: \"text\"\n    category: \"input\"\n    persistence: \"persistent\"\n    cardinality: \"7 files (one per population group)\"\n    data_volume_class: \"small\"\n    lifecycle: \"Available before workflow starts; read-only; retained after workflow completes.\"\n\n  - data_id: \"data:individual_chr_tar\"\n    data_name: \"Individual Chromosome Tar\"\n    description: >\n      Per-chromosome-chunk tar.gz archive containing one text file per individual (2504 files)\n      with mutation calls for that chunk. Intermediate product of task:individuals.\n    format: \"tar.gz\"\n    category: \"intermediate\"\n    persistence: \"stage_scoped\"\n    cardinality: \"N_chunks * 10 files (chunk count is a runtime parameter)\"\n    data_volume_class: \"large\"\n    lifecycle: >\n      Created by task:individuals per (chromosome, chunk) job; consumed by\n      task:individuals_merge; can be deleted after merge completes per chromosome.\n\n  - data_id: \"data:merged_chr_tar\"\n    data_name: \"Merged Chromosome Tar\"\n    description: >\n      Complete per-chromosome tar.gz archive containing one text file per individual\n      (2504 files) with all mutations across all chunks for that chromosome.\n      Fan-in product of task:individuals_merge.\n    format: \"tar.gz\"\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    cardinality: \"10 files (one per chromosome)\"\n    data_volume_class: \"large\"\n    lifecycle: >\n      Created by task:individuals_merge; consumed by both task:mutation_overlap and\n      task:frequency in stage:population_analysis; retained until workflow completes.\n\n  - data_id: \"data:sifted_chr_file\"\n    data_name: \"Sifted Chromosome File\"\n    description: >\n      Per-chromosome text file of SIFT-scored variants extracted from VEP annotation VCFs.\n      Provides pathogenicity annotations for use in population analysis tasks.\n    format: \"text\"\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    cardinality: \"10 files (one per chromosome)\"\n    data_volume_class: \"medium\"\n    lifecycle: >\n      Created by task:sifting; consumed by both task:mutation_overlap and task:frequency\n      in stage:population_analysis; retained until workflow completes.\n\n  - data_id: \"data:mutation_overlap_results\"\n    data_name: \"Mutation Overlap Results\"\n    description: >\n      Pairwise mutation overlap statistics and matplotlib plots for all individual pairs\n      across populations. Final analytical output of the overlap analysis path.\n    format: \"mixed (text statistics + png plots)\"\n    category: \"output\"\n    persistence: \"persistent\"\n    cardinality: \"variable (statistics files + plot images per population)\"\n    data_volume_class: \"medium\"\n    lifecycle: \"Created by task:mutation_overlap; final output; retained indefinitely.\"\n\n  - data_id: \"data:frequency_results\"\n    data_name: \"Frequency Results\"\n    description: >\n      Allele frequency distribution estimates derived from 1000 Monte Carlo sampling\n      iterations with 52 randomly selected individuals per run.\n    format: \"text\"\n    category: \"output\"\n    persistence: \"persistent\"\n    cardinality: \"1 summary output file\"\n    data_volume_class: \"small\"\n    lifecycle: \"Created by task:frequency; final output; retained indefinitely.\"\n\npc_edges:\n  - edge_id: \"pc:individuals->individuals_merge:n_to_1\"\n    producer: \"task:individuals\"\n    consumer: \"task:individuals_merge\"\n    data_objects:\n      - \"data:individual_chr_tar\"\n    pc_pattern: \"n_to_1\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All N chunk jobs for a chromosome must complete before the merge job for that\n      chromosome can start. Fan-in per chromosome: N chunk archives -> 1 merged archive.\n      Pegasus manages the dependency explicitly.\n\n  - edge_id: \"pc:individuals_merge->frequency:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 merged chromosome archives produced by the 10 individuals_merge jobs\n      are broadcast to the single frequency analysis job.\n\n  - edge_id: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:merged_chr_tar\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 merged chromosome archives produced by the 10 individuals_merge jobs\n      are consumed by the single mutation overlap analysis job.\n\n  - edge_id: \"pc:sifting->frequency:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 sifted chromosome files produced by the 10 sifting jobs are consumed\n      by the single frequency analysis job.\n\n  - edge_id: \"pc:sifting->mutation_overlap:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:sifted_chr_file\"\n    pc_pattern: \"1_to_n\"\n    coupling: \"loose\"\n    communication_pattern: \"shared_file\"\n    co_scheduling_hint: \"neutral\"\n    notes: >\n      All 10 sifted chromosome files produced by the 10 sifting jobs are consumed\n      by the single mutation overlap analysis job.\n\nworkflow_graph:\n  entry_tasks:\n    - \"task:individuals\"\n    - \"task:sifting\"\n  terminal_tasks:\n    - \"task:mutation_overlap\"\n    - \"task:frequency\"\n  integrity_hash: \"pending_python_execution\"\n  integrity_hash_note: >\n    Compute via: python3 -c \"import json,hashlib; edges=sorted([{'consumer':'task:individuals_merge','data_objects':['data:individual_chr_tar'],'edge_id':'pc:individuals->individuals_merge:n_to_1','pc_pattern':'n_to_1','producer':'task:individuals'},{'consumer':'task:frequency','data_objects':['data:merged_chr_tar'],'edge_id':'pc:individuals_merge->frequency:1_to_n','pc_pattern':'1_to_n','producer':'task:individuals_merge'},{'consumer':'task:mutation_overlap','data_objects':['data:merged_chr_tar'],'edge_id':'pc:individuals_merge->mutation_overlap:1_to_n','pc_pattern':'1_to_n','producer':'task:individuals_merge'},{'consumer':'task:frequency','data_objects':['data:sifted_chr_file'],'edge_id':'pc:sifting->frequency:1_to_n','pc_pattern':'1_to_n','producer':'task:sifting'},{'consumer':'task:mutation_overlap','data_objects':['data:sifted_chr_file'],'edge_id':'pc:sifting->mutation_overlap:1_to_n','pc_pattern':'1_to_n','producer':'task:sifting'}],key=lambda e:e['edge_id']); print(hashlib.sha256(json.dumps(edges,sort_keys=True,separators=(',',':')).encode()).hexdigest())\"\n\nworkflow_patterns:\n  primary_pattern: \"scatter_gather\"\n  secondary_patterns:\n    - \"broadcast\"\n  pattern_notes: >\n    VCF chromosomes scatter across embarrassingly parallel individuals jobs (scatter phase),\n    merge jobs gather per chromosome (gather phase), then merged data and sifted scores\n    broadcast to two independent terminal analysis tasks (broadcast phase).\n    The dual-consumer broadcast at stage 3 distinguishes this from a pure scatter_gather.\n\nio_behavioral_hints:\n  - hint_id: \"hint:small_file_overhead_individuals\"\n    affected_tasks:\n      - \"task:individuals\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"small_file_overhead\"\n    description: >\n      task:individuals writes 2504 individual text files per chunk to a temporary directory\n      before compressing. On shared Lustre/GPFS filesystems this generates significant\n      metadata pressure (2504 creates + 2504 writes + 2504 stats per chunk job). Burst\n      buffer or node-local storage for the intermediate files would mitigate this.\n    severity: \"high\"\n\n  - hint_id: \"hint:unnecessary_serialization_individuals\"\n    affected_tasks:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n    affected_data:\n      - \"data:individual_chr_tar\"\n    potential_concern: \"unnecessary_serialization\"\n    description: >\n      Individual files are written to disk and compressed to tar.gz by task:individuals,\n      only to be decompressed and re-compressed by task:individuals_merge. The double\n      compress-decompress cycle doubles I/O volume. In-memory streaming or a single-pass\n      merge (Decaf path) could eliminate the intermediate tar.gz entirely.\n    severity: \"medium\"\n\n  - hint_id: \"hint:data_reuse_merged_chr_tar\"\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:merged_chr_tar\"\n    potential_concern: \"data_reuse\"\n    description: >\n      Merged chromosome archives (10 files) are independently read by both terminal\n      analysis tasks. Staging to burst buffer or node-local storage before stage 3\n      would benefit both consumers and reduce PFS pressure during the analysis phase.\n    severity: \"medium\"\n\n  - hint_id: \"hint:data_reuse_sifted_chr_file\"\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:sifted_chr_file\"\n    potential_concern: \"data_reuse\"\n    description: >\n      Sifted chromosome files (10 files) are read by both terminal analysis tasks.\n      Co-locating these with the merged_chr_tar on fast storage is recommended\n      to avoid two separate PFS read passes for the same consumers.\n    severity: \"medium\"\n\n  - hint_id: \"hint:small_file_overhead_frequency\"\n    affected_tasks:\n      - \"task:frequency\"\n    affected_data:\n      - \"data:frequency_results\"\n    potential_concern: \"small_file_overhead\"\n    description: >\n      If frequency.py writes intermediate results per Monte Carlo iteration (1000 runs),\n      this generates 1000 small file creates. Static analysis suggests single output file\n      but runtime behavior depends on implementation details not fully resolved statically.\n    severity: \"low\"\n\nexecution_profiles:\n  - profile_name: \"overlap_analysis_only\"\n    description: >\n      Runs the workflow through pairwise mutation overlap analysis only, skipping\n      Monte Carlo frequency estimation. Useful when only population overlap statistics\n      and plots are needed.\n    entry_tasks:\n      - \"task:individuals\"\n      - \"task:sifting\"\n    terminal_tasks:\n      - \"task:mutation_overlap\"\n    conditional_inclusions: []\n\n  - profile_name: \"full\"\n    description: >\n      Complete workflow execution including both pairwise overlap analysis and\n      Monte Carlo allele frequency analysis.\n    entry_tasks:\n      - \"task:individuals\"\n      - \"task:sifting\"\n    terminal_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    conditional_inclusions: []\n\ntranslation_metadata:\n  translation_tool: \"claude-sonnet-4-6\"\n  translation_date: \"2026-03-04\"\n  source_language: \"python\"\n  source_wms: \"pegasus\"\n  confidence_overall: \"high\"\n  assumptions:\n    - \"Decaf in-memory MPI dataflow alternative (lib/ C++ code) not analyzed in detail; Pegasus path used as primary workflow description.\"\n    - \"Chunk count per chromosome is a runtime parameter in daxgen.py and cannot be determined by static analysis alone.\"\n    - \"integrity_hash field contains placeholder; see integrity_hash_note for computation command.\"\n    - \"Exact data sizes depend on runtime VCF inputs and are not determinable by static analysis.\"\n    - \"task:frequency 1000 Monte Carlo runs are logically parallelizable but run serially in reference implementation.\"\n  unmapped_fields:\n    - \"Exact chunk count per chromosome (runtime parameter -i ind_jobs in daxgen.py)\"\n    - \"Exact data sizes for chromosome_vcf and annotation_vcf (depend on runtime inputs)\"\n    - \"Decaf in-memory dataflow topology (lib/ C++ not analyzed)\"\n  field_confidence_records:\n    - field: \"io_dominance\"\n      confidence: \"medium\"\n      reasoning: >\n        Inferred from script structure: individuals writes 2504 files per chunk (io_bound),\n        individuals_merge extract+recompress (io_bound), sifting is grep+parse (balanced),\n        mutation_overlap O(N^2) compute + matplotlib (balanced), frequency 1000 iterations (compute_bound).\n    - field: \"parallelism_model\"\n      confidence: \"high\"\n      reasoning: >\n        Pegasus DAX generator (daxgen.py) explicitly creates one job per (chromosome, chunk)\n        for individuals, one per chromosome for merge and sifting, one each for terminal tasks.\n    - field: \"pc_pattern\"\n      confidence: \"high\"\n      reasoning: >\n        Pegasus dependency declarations in daxgen.py directly encode n_to_1 (chunk->merge)\n        and 1_to_n (merge->analysis, sifting->analysis) relationships.\n    - field: \"primary_pattern\"\n      confidence: \"high\"\n      reasoning: >\n        Scatter-gather clearly visible in daxgen.py: chromosomes scatter to individuals jobs,\n        merge gathers per chromosome, merged data and sifted files broadcast to two consumers.\n    - field: \"io_access_type\"\n      confidence: \"high\"\n      reasoning: >\n        No mpi4py, h5py, netCDF4, or parallel I/O imports found in any of the five task scripts.\n        All I/O is standard Python file open/read/write (python_serial).\n    - field: \"restart_model\"\n      confidence: \"medium\"\n      reasoning: >\n        No checkpoint-read logic at startup found in any task script. All scripts overwrite\n        outputs deterministically given same inputs. Classified as idempotent.\n","replace_all":false}}],"uuid":"0498a465-8376-45d9-b743-2d9e85e40602"}
