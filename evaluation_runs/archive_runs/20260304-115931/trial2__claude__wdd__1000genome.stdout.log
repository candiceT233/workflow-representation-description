ression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"7 files (one per population: ALL, EUR, EAS, AFR, AMR, SAS, GBR)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data/populations/\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"small; each file contains 91-2504 sample IDs, likely less than 100 KB each\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"external input; retained across workflow\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 2\n\n  - data_id: \"data:individual_chunk_tar\"\n    name: \"Individual Chunk Tar Archive\"\n    description: >\n      Per-(chromosome, chunk) tar.gz archive produced by task:individuals, containing one\n      text file per individual (2504 files) with mutation records for the SNP positions in\n      the assigned chunk line range. Each individual file lists rs number, position,\n      reference and alternate alleles, and allele frequency for SNPs where the individual\n      carries the minor allele. Consumed exclusively by task:individuals_merge to build\n      the complete per-chromosome individual mutation archive.\n    category: \"intermediate\"\n    persistence: \"stage_scoped\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"ind_jobs\"\n      config_file: \"daxgen.py\"\n      possible_values: \"any positive integer dividing the chromosome row count (default 1 per chromosome)\"\n    estimated_size_hint: \"un