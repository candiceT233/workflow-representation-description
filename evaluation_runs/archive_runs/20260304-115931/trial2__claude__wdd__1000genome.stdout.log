on_overlap\",\n        \"data_objects\": [\"data:sifted_sift_txt\"],\n        \"edge_id\": \"pc:sifting->mutation_overlap:1_to_n\",\n        \"pc_pattern\": \"1_to_n\",\n        \"producer\": \"task:sifting\"\n    }\n]\n\n# Sort by edge_id\npc_edges_sorted = sorted(pc_edges, key=lambda x: x[\"edge_id\"])\ncanonical = json.dumps(pc_edges_sorted, sort_keys=True, separators=(',', ':'))\nprint(\"Canonical JSON:\", canonical[:200])\nh = hashlib.sha256(canonical.encode('utf-8')).hexdigest()\nprint(\"SHA-256 hash:\", h)\nEOF\n"}},{"tool_name":"Bash","tool_use_id":"toolu_01JR5PVsFUdEQ5aEScYGYpUW","tool_input":{"command":"python3 -c \"\nimport json, hashlib\npc_edges = [\n    {'consumer': 'task:individuals_merge', 'data_objects': ['data:chr_chunk_tarball'], 'edge_id': 'pc:individuals->individuals_merge:n_to_1', 'pc_pattern': 'n_to_1', 'producer': 'task:individuals'},\n    {'consumer': 'task:frequency', 'data_objects': ['data:merged_chr_tarball'], 'edge_id': 'pc:individuals_merge->frequency:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:individuals_merge'},\n    {'consumer': 'task:mutation_overlap', 'data_objects': ['data:merged_chr_tarball'], 'edge_id': 'pc:individuals_merge->mutation_overlap:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:individuals_merge'},\n    {'consumer': 'task:frequency', 'data_objects': ['data:sifted_sift_txt'], 'edge_id': 'pc:sifting->frequency:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:sifting'},\n    {'consumer': 'task:mutation_overlap', 'data_objects': ['data:sifted_sift_txt'], 'edge_id': 'pc:sifting->mutation_overlap:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:sifting'}\n]\npc_edges_sorted = sorted(pc_edges, key=lambda x: x['edge_id'])\ncanonical = json.dumps(pc_edges_sorted, sort_keys=True, separators=(',', ':'))\nh = hashlib.sha256(canonical.encode('utf-8')).hexdigest()\nprint('hash:', h)\n\"\n"}},{"tool_name":"Write","tool_use_id":"toolu_01JutwxDAeHoKEuiz1AuMaJW","tool_input":{"file_path":"/tmp/compute_hash.py","content":"import json, hashlib\npc_edges = [\n    {'consumer': 'task:individuals_merge', 'data_objects': ['data:chr_chunk_tarball'], 'edge_id': 'pc:individuals->individuals_merge:n_to_1', 'pc_pattern': 'n_to_1', 'producer': 'task:individuals'},\n    {'consumer': 'task:frequency', 'data_objects': ['data:merged_chr_tarball'], 'edge_id': 'pc:individuals_merge->frequency:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:individuals_merge'},\n    {'consumer': 'task:mutation_overlap', 'data_objects': ['data:merged_chr_tarball'], 'edge_id': 'pc:individuals_merge->mutation_overlap:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:individuals_merge'},\n    {'consumer': 'task:frequency', 'data_objects': ['data:sifted_sift_txt'], 'edge_id': 'pc:sifting->frequency:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:sifting'},\n    {'consumer': 'task:mutation_overlap', 'data_objects': ['data:sifted_sift_txt'], 'edge_id': 'pc:sifting->mutation_overlap:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:sifting'}\n]\npc_edges_sorted = sorted(pc_edges, key=lambda x: x['edge_id'])\ncanonical = json.dumps(pc_edges_sorted, sort_keys=True, separators=(',', ':'))\nh = hashlib.sha256(canonical.encode('utf-8')).hexdigest()\nprint(h)\n"}},{"tool_name":"Write","tool_use_id":"toolu_01QFMj1nd9sJtrUp5rb9XJBf","tool_input":{"file_path":"/home/mtang11/scripts/workflow-representation-description/workflow_wdd/compute_hash_tmp.py","content":"import json, hashlib\npc_edges = [\n    {'consumer': 'task:individuals_merge', 'data_objects': ['data:chr_chunk_tarball'], 'edge_id': 'pc:individuals->individuals_merge:n_to_1', 'pc_pattern': 'n_to_1', 'producer': 'task:individuals'},\n    {'consumer': 'task:frequency', 'data_objects': ['data:merged_chr_tarball'], 'edge_id': 'pc:individuals_merge->frequency:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:individuals_merge'},\n    {'consumer': 'task:mutation_overlap', 'data_objects': ['data:merged_chr_tarball'], 'edge_id': 'pc:individuals_merge->mutation_overlap:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:individuals_merge'},\n    {'consumer': 'task:frequency', 'data_objects': ['data:sifted_sift_txt'], 'edge_id': 'pc:sifting->frequency:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:sifting'},\n    {'consumer': 'task:mutation_overlap', 'data_objects': ['data:sifted_sift_txt'], 'edge_id': 'pc:sifting->mutation_overlap:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:sifting'}\n]\npc_edges_sorted = sorted(pc_edges, key=lambda x: x['edge_id'])\ncanonical = json.dumps(pc_edges_sorted, sort_keys=True, separators=(',', ':'))\nh = hashlib.sha256(canonical.encode('utf-8')).hexdigest()\nprint(h)\n"}},{"tool_name":"Write","tool_use_id":"toolu_01WY6s5ccgF1XDNrqyXJfXEK","tool_input":{"file_path":"/mnt/common/mtang11/scripts/workflow-representation-description/workflow_wdd/compute_hash_tmp.py","content":"import json, hashlib\npc_edges = [\n    {'consumer': 'task:individuals_merge', 'data_objects': ['data:chr_chunk_tarball'], 'edge_id': 'pc:individuals->individuals_merge:n_to_1', 'pc_pattern': 'n_to_1', 'producer': 'task:individuals'},\n    {'consumer': 'task:frequency', 'data_objects': ['data:merged_chr_tarball'], 'edge_id': 'pc:individuals_merge->frequency:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:individuals_merge'},\n    {'consumer': 'task:mutation_overlap', 'data_objects': ['data:merged_chr_tarball'], 'edge_id': 'pc:individuals_merge->mutation_overlap:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:individuals_merge'},\n    {'consumer': 'task:frequency', 'data_objects': ['data:sifted_sift_txt'], 'edge_id': 'pc:sifting->frequency:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:sifting'},\n    {'consumer': 'task:mutation_overlap', 'data_objects': ['data:sifted_sift_txt'], 'edge_id': 'pc:sifting->mutation_overlap:1_to_n', 'pc_pattern': '1_to_n', 'producer': 'task:sifting'}\n]\npc_edges_sorted = sorted(pc_edges, key=lambda x: x['edge_id'])\ncanonical = json.dumps(pc_edges_sorted, sort_keys=True, separators=(',', ':'))\nh = hashlib.sha256(canonical.encode('utf-8')).hexdigest()\nprint(h)\n"}},{"tool_name":"Write","tool_use_id":"toolu_01BpedJaRkhKvG4EiqD9KEWs","tool_input":{"file_path":"/home/mtang11/scripts/workflow-representation-description/workflow_wdd/1000genome-wdd-claude-trial2.yaml","content":"schema_version: \"wrd-7.0\"\n\nmetadata:\n  workflow_lineage_id: \"wrd:1000genome\"\n  version: \"1.0.0\"\n  version_notes: \"Initial WDD compiled from daxgen.py and bin/ task scripts via static analysis.\"\n  deprecated: false\n  workflow_name: \"1000genome\"\n  workflow_description: >\n    The 1000 Genomes workflow identifies mutational overlaps in human genomic data from the\n    1000 Genomes Project, processing VCF files for up to 22 chromosomes across 2504 individuals\n    from 26 global populations. It parses per-chromosome SNP variant files to extract\n    individual-level mutation records, annotates variants with SIFT pathogenicity scores from\n    VEP-annotated VCF files, merges parallel per-chunk outputs into per-chromosome archives,\n    and performs both pairwise mutation overlap analysis and Monte Carlo-based allele frequency\n    analysis across user-specified population groups. Final outputs are statistical tables and\n    matplotlib visualizations of population-level mutation overlap distributions.\n  source_repository: \"workflows_repo/1000genome-workflow\"\n  source_commit: \"unknown\"\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  generated_by: \"claude-sonnet-4-6\"\n  generated_at: \"2026-03-04T00:00:00Z\"\n  last_modified_at: \"2026-03-04T00:00:00Z\"\n\n\nstages:\n  - stage_id: \"stage:individuals_extraction\"\n    name: \"Individuals Extraction\"\n    order: 1\n    description: >\n      Parallel extraction of per-individual mutation records from chromosome VCF files.\n      Each job processes a non-overlapping line-range chunk of a VCF file, writing one\n      text file per individual and compressing the results into a tar.gz archive.\n    tasks:\n      - \"task:individuals\"\n\n  - stage_id: \"stage:merge_and_sifting\"\n    name: \"Merge and Sifting\"\n    order: 2\n    description: >\n      Two independent sub-operations run concurrently: (1) individuals_merge fans in\n      all per-chunk archives into a single per-chromosome tarball; (2) sifting extracts\n      SIFT pathogenicity scores from VEP-annotated VCF files per chromosome.\n    tasks:\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n\n  - stage_id: \"stage:population_analysis\"\n    name: \"Population Analysis\"\n    order: 3\n    description: >\n      Two independent terminal analysis tasks consume merged individual archives and sifted\n      score files: mutation_overlap performs pairwise O(N^2) overlap analysis, and frequency\n      runs 1000 Monte Carlo iterations to estimate allele frequency distributions.\n    tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n\n\ntasks:\n  - task_id: \"task:individuals\"\n    name: \"Individuals\"\n    stage: \"stage:individuals_extraction\"\n    executable: \"bin/individuals.py\"\n    description: >\n      Parses a chunk of a chromosome VCF file (defined by start and stop line indices)\n      and extracts allele calls for all 2504 individuals using a columns mapping file.\n      For each individual it selects SNP records where the allele frequency criterion\n      is met, writes one text file per individual to a temporary directory, then compresses\n      all individual files into a tar.gz archive named chr{C}n-{start}-{stop}.tar.gz.\n      This task exists to produce per-individual mutation sets that downstream analysis\n      tasks compare across populations.\n    behavioral_notes: >\n      Reads the entire VCF chunk (up to 250000 lines) into memory via readfile() before\n      processing. Writes 2504 individual text files to a local directory (significant\n      metadata pressure on shared filesystems), then calls tarfile.open() to compress\n      the directory. The temporary per-individual directory is removed after compression.\n      Access pattern: sequential read of VCF lines, one-pass write per individual file,\n      then single-pass tar+gzip compression.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One Pegasus job per (chromosome, chunk) pair. Chunks are non-overlapping line\n        ranges computed by daxgen.py from the total row count and ind_jobs parameter.\n        All chunk jobs are fully independent across chromosomes and across chunks of the\n        same chromosome.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:chromosome_vcf\"\n      - \"data:columns_txt\"\n    outputs:\n      - \"data:individual_chunk_tar\"\n\n  - task_id: \"task:individuals_merge\"\n    name: \"Individuals Merge\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/individuals_merge.py\"\n    description: >\n      Merges all per-chunk individual mutation archives for a single chromosome into\n      one unified per-chromosome tar.gz archive (chr{C}n.tar.gz). It sequentially\n      extracts each chunk tarball into a temporary directory, accumulates individual\n      file contents across chunks, writes merged files to a merged_chr{C}/ directory,\n      then compresses the result. This task exists to reunify chromosome data that was\n      split across parallel individuals jobs for downstream consumption by analysis tasks.\n    behavioral_notes: >\n      Processes chunk tarballs one at a time in sequence; uses tempfile.TemporaryDirectory\n      for intermediate extraction state. Appends content of same-named individual files\n      across chunks in memory (data dict), then writes merged files sequentially.\n      Extract-then-recompress pattern causes transient disk amplification: merged_chr{C}/\n      can equal the uncompressed size of all input chunks before recompression.\n      Access pattern: sequential read of each chunk tarball, full-file append in memory,\n      sequential write of merged files, then single-pass tar+gzip.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One Pegasus job per chromosome. Each merge job is independent of other chromosomes.\n        Pegasus dependency enforces completion of all chunk jobs for a chromosome before\n        the corresponding merge job starts.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:individual_chunk_tar\"\n    outputs:\n      - \"data:merged_chromosome_tar\"\n\n  - task_id: \"task:sifting\"\n    name: \"Sifting\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/sifting.py\"\n    description: >\n      Extracts SIFT pathogenicity scores from a per-chromosome VEP-annotated VCF file.\n      Uses subprocess grep to pre-filter lines containing 'deleterious' or 'tolerated'\n      annotations, then Python regex to retain only SNP records with rs IDs.\n      Parses line number, rs number, ENSEMBL gene ID, SIFT score, and phenotype\n      into a compact text file sifted.SIFT.chr{C}.txt. This task provides the\n      variant-level SIFT annotations required by both downstream analysis tasks to\n      filter mutations by pathogenicity.\n    behavioral_notes: >\n      Reads the full VEP annotation VCF into memory, then launches a subprocess grep\n      (shell=True) for fast line pre-filtering; writes grep output to a temporary\n      SIFT.chr{C}.vcf before reading it back into Python. Deletes the temporary file\n      after processing. Two full-file reads (original VCF for header count, grep output)\n      and one write of the compact sifted result. Grep subprocess introduces one\n      process-spawn overhead per chromosome; grep operates on the full file sequentially.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One Pegasus job per chromosome annotation VCF. Fully independent of the\n        individuals processing path; runs concurrently with task:individuals_merge\n        within stage:merge_and_sifting.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:annotation_vcf\"\n    outputs:\n      - \"data:sifted_chr_txt\"\n\n  - task_id: \"task:mutation_overlap\"\n    name: \"Mutation Overlap\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/mutation_overlap.py\"\n    description: >\n      Performs exhaustive pairwise mutation set intersection analysis over all individuals\n      in a specified population for a given chromosome. Reads merged individual mutation\n      archives, intersects each individual's SNP set against the SIFT-scored variant list,\n      then computes all O(N^2) pairwise overlaps plus half-matrix and random-pair variants.\n      Generates text statistics files and matplotlib colormap and histogram plots.\n      Outputs are packaged in chr{C}-{POP}.tar.gz. This task provides population-level\n      mutation overlap distributions for rigorous statistical evaluation of disease-related\n      mutations.\n    behavioral_notes: >\n      Untars the merged chromosome archive into memory at startup. Reads population ID\n      list from population file and columns.txt to intersect individual identifiers.\n      Builds mutation_index_array in memory (one list of rs numbers per individual);\n      all O(N^2) pair comparisons run in Python loops with set intersection.\n      Memory footprint scales with n_individuals * avg_mutations_per_individual.\n      Matplotlib plot generation at the end adds a CPU+disk tail. Writes multiple\n      text files per run before packaging all into a tar.gz. Access pattern: full\n      archive read at start, compute-heavy in-memory phase, then sequential write\n      of multiple output files, final tar.gz creation.\n    parallelism_model:\n      type: \"serial\"\n      description: >\n        One Pegasus job per (chromosome, population) pair. Internal computation is\n        single-threaded Python. No MPI or GPU parallelism observed in static analysis.\n        The O(N^2) pairwise loop is not parallelized within the script.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"checkpoint\"\n    inputs:\n      - \"data:merged_chromosome_tar\"\n      - \"data:sifted_chr_txt\"\n      - \"data:population_file\"\n      - \"data:columns_txt\"\n    outputs:\n      - \"data:mutation_overlap_output\"\n\n  - task_id: \"task:frequency\"\n    name: \"Frequency\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/frequency.py\"\n    description: >\n      Estimates allele frequency distributions using 1000 Monte Carlo iterations over\n      merged individual mutation archives and SIFT score files for a given chromosome\n      and population. Each iteration samples n_indiv=52 random individuals and counts\n      mutation overlap frequencies using Counter-based multiset accumulation.\n      Writes per-iteration text histogram files and random-individual lists, generates\n      histogram bar plots per iteration, and packages results in chr{C}-{POP}-freq.tar.gz.\n      This task provides the null distribution for statistical evaluation of mutation\n      overlap patterns compared to task:mutation_overlap results.\n    behavioral_notes: >\n      Untars merged chromosome archive at module-level import time (before class definitions),\n      then reads population and SIFT files. All 1000 Monte Carlo iterations run serially\n      in a single Python process; random sampling uses Python's built-in random module.\n      Writes 1000 histogram files and 1000 random-individual files to output directories;\n      this creates significant small-file I/O pressure (2000+ file creates per job).\n      Matplotlib plot generation runs per iteration (1000 plt.savefig() calls).\n      Access pattern: single full-archive read at startup, compute-dominant loop,\n      many sequential writes of small files.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One Pegasus job per (chromosome, population) pair. Internally the 1000 Monte\n        Carlo runs execute serially; they are logically embarrassingly parallel but not\n        split by the reference implementation. Could be parallelized externally.\n    io_dominance: \"compute_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"checkpoint\"\n    inputs:\n      - \"data:merged_chromosome_tar\"\n      - \"data:sifted_chr_txt\"\n      - \"data:population_file\"\n      - \"data:columns_txt\"\n    outputs:\n      - \"data:frequency_output\"\n\n\ndata_objects:\n  - data_id: \"data:chromosome_vcf\"\n    name: \"Chromosome VCF\"\n    description: >\n      Per-chromosome input VCF file from the 1000 Genomes Project Phase 3 dataset\n      (e.g., ALL.chr1.250000.vcf). Contains approximately 250000 SNP variant records\n      with genotype calls for all 2504 individuals across 26 populations.\n      Each row encodes one SNP position; columns 9 onward hold individual genotype\n      fields (0|0, 0|1, 1|0, 1|1 allele encodings). Used by task:individuals to\n      extract per-individual mutation sets per chromosome chunk.\n    category: \"input\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"unknown; 250000-line VCF with 2504 individual columns is likely ~500 MB-2 GB per chromosome\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:individuals\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:individuals\"\n      retention_window: \"external input; retained across workflow\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 1\n\n  - data_id: \"data:columns_txt\"\n    name: \"Columns Text File\"\n    description: >\n      Single tab-delimited text file (columns.txt) mapping VCF column indices to 2504\n      individual sample identifiers. Contains one header row listing sample IDs starting\n      at column index 9. Used by task:individuals to derive per-individual output filenames\n      and by task:mutation_overlap and task:frequency to intersect population lists with\n      genome column identifiers. This config file is read-only throughout the workflow.\n    category: \"config\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"1 file (single global config)\"\n    cardinality_source:\n      type: \"fixed\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"n/a\"\n    estimated_size_hint: \"small; one row of 2504 tab-separated sample IDs, likely ~50-100 KB\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:individuals\"\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"external config; retained across workflow\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 3\n\n  - data_id: \"data:annotation_vcf\"\n    name: \"VEP Annotation VCF\"\n    description: >\n      Per-chromosome VEP-annotated VCF file (e.g., ALL.chr1.phase3_shapeit2_mvncall\n      _integrated_v5.20130502.sites.annotation.vcf) containing functional consequence\n      predictions for all Phase 3 SNP variants. INFO field column 8 contains pipe-delimited\n      VEP annotations including SIFT scores and ENSEMBL gene IDs.\n      Used exclusively by task:sifting to extract variant-level SIFT pathogenicity data.\n    category: \"input\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"unknown; VEP annotation VCFs are typically larger than base VCFs due to INFO field expansion, likely ~1-10 GB per chromosome\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:sifting\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:sifting\"\n      retention_window: \"external input; retained across workflow\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:population_file\"\n    name: \"Population File\"\n    description: >\n      Per-population text files (e.g., AFR, AMR, EAS, EUR, GBR, SAS, ALL) listing\n      the sample IDs belonging to each of the 7 population groups in the 1000 Genomes\n      Project. Each file contains one sample ID per line. Used by task:mutation_overlap\n      and task:frequency to filter the analysis to individuals belonging to a specific\n      population before computing mutation overlap statistics and frequency distributions.\n    category: \"input\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"7 files (one per population: ALL, EUR, EAS, AFR, AMR, SAS, GBR)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data/populations/\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"small; each file contains 91-2504 sample IDs, likely less than 100 KB each\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"external input; retained across workflow\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 2\n\n  - data_id: \"data:individual_chunk_tar\"\n    name: \"Individual Chunk Tar Archive\"\n    description: >\n      Per-(chromosome, chunk) tar.gz archive (chr{C}n-{start}-{stop}.tar.gz) produced by\n      task:individuals, containing one text file per individual (2504 files) with mutation\n      records for the SNP positions in the assigned chunk line range. Each individual file\n      lists rs number, position, reference/alternate alleles, and allele frequency for\n      SNPs where the individual carries the minor allele. Consumed exclusively by\n      task:individuals_merge to build the complete per-chromosome individual mutation archive.\n    category: \"intermediate\"\n    persistence: \"stage_scoped\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"ind_jobs\"\n      config_file: \"daxgen.py\"\n      possible_values: \"any positive integer dividing the chromosome row count (default 1 per chromosome)\"\n    estimated_size_hint: \"unknown; size per chunk scales with chunk size / total VCF rows; likely tens to hundreds of MB per chunk\"\n    producer_task: \"task:individuals\"\n    consumer_tasks:\n      - \"task:individuals_merge\"\n    lifecycle:\n      creation_phase: \"task:individuals\"\n      last_consumer_phase: \"task:individuals_merge\"\n      retention_window: \"from task:individuals completion to task:individuals_merge completion (per chromosome)\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:merged_chromosome_tar\"\n    name: \"Merged Chromosome Tar Archive\"\n    description: >\n      Complete per-chromosome tar.gz archive (chr{C}n.tar.gz) produced by task:individuals_merge\n      by merging all per-chunk individual mutation archives for chromosome C. Contains 2504\n      individual text files with complete mutation records across all SNP positions in that\n      chromosome. Consumed by both task:mutation_overlap and task:frequency as the primary\n      source of individual-level mutation data for downstream analyses across all populations.\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"unknown; contains all mutations across all chunks for one chromosome; likely hundreds of MB to several GB per chromosome\"\n    producer_task: \"task:individuals_merge\"\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: \"task:individuals_merge\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:individuals_merge completion to task:frequency completion (full workflow duration)\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 2\n\n  - data_id: \"data:sifted_chr_txt\"\n    name: \"Sifted Chromosome SIFT Text File\"\n    description: >\n      Per-chromosome text file (sifted.SIFT.chr{C}.txt) produced by task:sifting, containing\n      space-delimited records for all SNP variants with SIFT pathogenicity annotations.\n      Each row encodes: line number, rs ID, ENSEMBL gene ID, SIFT score, and phenotype.\n      Only variants with both rs IDs and SIFT annotations are retained. Consumed by both\n      task:mutation_overlap and task:frequency to filter individual mutations to SIFT-annotated\n      variants for population-level overlap analysis.\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"medium; subset of VEP annotation VCF with 5 extracted fields per variant; likely tens of MB per chromosome\"\n    producer_task: \"task:sifting\"\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: \"task:sifting\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:sifting completion to task:frequency completion (full workflow duration)\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 2\n\n  - data_id: \"data:mutation_overlap_output\"\n    name: \"Mutation Overlap Output Archive\"\n    description: >\n      Per-(chromosome, population) tar.gz archive (chr{C}-{POP}.tar.gz) produced by\n      task:mutation_overlap, containing text statistics files (pairwise overlap counts,\n      half-matrix overlaps, gene pair counts, random pair overlaps, per-individual total\n      mutations, map of variant-to-ENSEMBL-ID) and matplotlib PNG plots (colormap,\n      half-distribution, total-distribution, random-distribution). Represents the\n      primary scientific result of mutation set overlap analysis for a chromosome-population\n      combination used for statistical evaluation of disease-related mutations.\n    category: \"output\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"medium; multiple text statistics files plus PNG plots per chromosome-population pair; likely tens to hundreds of MB\"\n    producer_task: \"task:mutation_overlap\"\n    consumer_tasks: []\n    lifecycle:\n      creation_phase: \"task:mutation_overlap\"\n      last_consumer_phase: \"task:mutation_overlap\"\n      retention_window: \"created at task:mutation_overlap completion; final output retained indefinitely\"\n      access_frequency_class: \"once\"\n      consumer_count: 0\n\n  - data_id: \"data:frequency_output\"\n    name: \"Frequency Analysis Output Archive\"\n    description: >\n      Per-(chromosome, population) tar.gz archive (chr{C}-{POP}-freq.tar.gz) produced by\n      task:frequency, containing 1000 per-iteration text files of mutation overlap histograms,\n      1000 per-iteration files of mutation overlap counts, 1000 random individual selection\n      files, 1000 histogram bar plot PNGs, and a map of variation-to-ENSEMBL-ID and\n      mutation index arrays. Represents the Monte Carlo frequency null distribution output\n      for statistical evaluation of mutation overlap significance.\n    category: \"output\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"medium; 3000+ small text files and 1000 PNG plots per chromosome-population pair; likely hundreds of MB\"\n    producer_task: \"task:frequency\"\n    consumer_tasks: []\n    lifecycle:\n      creation_phase: \"task:frequency\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"created at task:frequency completion; final output retained indefinitely\"\n      access_frequency_class: \"once\"\n      consumer_count: 0\n\n\npc_edges:\n  - edge_id: \"pc:individuals->individuals_merge:n_to_1\"\n    producer: \"task:individuals\"\n    consumer: \"task:individuals_merge\"\n    data_objects:\n      - \"data:individual_chunk_tar\"\n    pc_pattern: \"n_to_1\"\n    pc_pattern_rationale: >\n      Multiple parallel individuals jobs (one per chunk) each produce one chunk tar.gz;\n      a single individuals_merge job per chromosome consumes all chunk archives for that\n      chromosome. Fan-in per chromosome: N chunk producers to 1 merge consumer.\n    data_flow_description: >\n      Each individuals job writes one tar.gz archive (chr{C}n-{start}-{stop}.tar.gz)\n      to shared scratch. The merge job receives all N chunk filenames as CLI arguments\n      and reads each archive sequentially (full read, no partial access).\n    coupling: \"tight\"\n    coupling_rationale: >\n      The individuals_merge script opens chunk tarballs via tarfile.open() only after\n      Pegasus dependency enforcement ensures all producers have completed. No streaming\n      or polling behavior; merge waits for all chunk archives to be fully written.\n    communication_pattern: \"file_per_producer\"\n    data_volume_class: \"large\"\n\n  - edge_id: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:merged_chromosome_tar\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One individuals_merge job per chromosome produces one merged tar.gz. Multiple\n      mutation_overlap jobs (one per chromosome-population pair) each consume the\n      merged archive for their chromosome. One producer to N consumer instances (across\n      all populations for that chromosome).\n    data_flow_description: >\n      mutation_overlap opens the merged chromosome tar.gz via tarfile.open().extractall()\n      at startup, extracting all 2504 individual files into a local directory. Full archive\n      read at task start; no partial or streaming access. One merged archive per chromosome\n      is broadcast to all population-analysis jobs for that chromosome.\n    coupling: \"tight\"\n    coupling_rationale: >\n      mutation_overlap reads merged archives after Pegasus dependency ensures completion\n      of individuals_merge. tarfile.open() call at script top-level confirms full-file\n      dependency before any computation begins.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"large\"\n\n  - edge_id: \"pc:individuals_merge->frequency:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:merged_chromosome_tar\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One individuals_merge job per chromosome produces one merged tar.gz. Multiple\n      frequency jobs (one per chromosome-population pair) each consume the merged archive\n      for their chromosome. Same broadcast structure as the mutation_overlap consumers.\n    data_flow_description: >\n      frequency.py opens the merged chromosome tar.gz via tarfile.open().extractall()\n      at module-level (before class definitions), extracting all 2504 individual files.\n      Full archive read at task start before any Monte Carlo iterations begin.\n    coupling: \"tight\"\n    coupling_rationale: >\n      The tarfile.open() call at module-level in frequency.py executes before any\n      function definitions, enforcing full-archive availability. Pegasus dependency\n      ensures individuals_merge completion before frequency starts.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"large\"\n\n  - edge_id: \"pc:sifting->mutation_overlap:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:sifted_chr_txt\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One sifting job per chromosome produces one sifted.SIFT.chr{C}.txt file. Multiple\n      mutation_overlap jobs (one per chromosome-population pair) each consume the sifted\n      file for their chromosome. One producer to N consumer instances.\n    data_flow_description: >\n      mutation_overlap.read_rs_numbers() opens sifted_chr_txt sequentially and reads\n      all records into memory (rs_numbers list and map_variations dict). Full sequential\n      read; no partial access or random seeks observed.\n    coupling: \"tight\"\n    coupling_rationale: >\n      mutation_overlap reads the sifted file via open(siftfile,'r') after Pegasus\n      dependency ensures sifting completion. File is consumed in full at task startup.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"small\"\n\n  - edge_id: \"pc:sifting->frequency:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:sifted_chr_txt\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One sifting job per chromosome produces one sifted.SIFT.chr{C}.txt file. Multiple\n      frequency jobs (one per chromosome-population pair) each consume the sifted file\n      for their chromosome. Mirror of the sifting->mutation_overlap edge.\n    data_flow_description: >\n      frequency.read_rs_numbers() opens sifted_chr_txt sequentially and reads all records\n      into rs_numbers list and map_variations dict. Full file read at task startup before\n      Monte Carlo iterations begin.\n    coupling: \"tight\"\n    coupling_rationale: >\n      frequency.py reads the sifted file via open(siftfile,'r') at startup before any\n      iteration logic. Pegasus dependency ensures sifting completion before frequency starts.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"small\"\n\n\nworkflow_graph:\n  integrity_hash: \"PENDING\"\n  last_generated: \"2026-03-04T00:00:00Z\"\n  dag_edges:\n    - from: \"task:individuals\"\n      to: \"task:individuals_merge\"\n      via: \"pc:individuals->individuals_merge:n_to_1\"\n    - from: \"task:individuals_merge\"\n      to: \"task:mutation_overlap\"\n      via: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    - from: \"task:individuals_merge\"\n      to: \"task:frequency\"\n      via: \"pc:individuals_merge->frequency:1_to_n\"\n    - from: \"task:sifting\"\n      to: \"task:mutation_overlap\"\n      via: \"pc:sifting->mutation_overlap:1_to_n\"\n    - from: \"task:sifting\"\n      to: \"task:frequency\"\n      via: \"pc:sifting->frequency:1_to_n\"\n  loop_groups: []\n  critical_path_hint: >\n    Longest sequential chain: task:individuals (parallel, ~81% of wall time per README)\n    -> task:individuals_merge -> task:mutation_overlap. Sifting is short (~6s per README)\n    and off the critical path. Critical path length is runtime-determined by chromosome\n    count and chunk count.\n  control_flow:\n    has_iteration: false\n    iteration_description: null\n    has_conditional_branches: true\n    conditional_description: >\n      daxgen.py selects different execution paths via CLI flags: --decaf enables Decaf\n      in-memory MPI dataflow (uses individuals_mpi.py and individuals_merge_mpi.py);\n      --pmc enables Pegasus MPI Cluster mode. These are deployment-mode switches, not\n      workflow-logic branches. The core DAG topology is unchanged between modes.\n      [ASSUMPTION] Treating default Pegasus path (no --decaf, no --pmc) as canonical WDD.\n  stage_execution_order:\n    - \"stage:individuals_extraction\"\n    - \"stage:merge_and_sifting\"\n    - \"stage:population_analysis\"\n  cross_reference:\n    task_to_stage:\n      \"task:individuals\": \"stage:individuals_extraction\"\n      \"task:individuals_merge\": \"stage:merge_and_sifting\"\n      \"task:sifting\": \"stage:merge_and_sifting\"\n      \"task:mutation_overlap\": \"stage:population_analysis\"\n      \"task:frequency\": \"stage:population_analysis\"\n    data_to_producer:\n      \"data:chromosome_vcf\": null\n      \"data:columns_txt\": null\n      \"data:annotation_vcf\": null\n      \"data:population_file\": null\n      \"data:individual_chunk_tar\": \"task:individuals\"\n      \"data:merged_chromosome_tar\": \"task:individuals_merge\"\n      \"data:sifted_chr_txt\": \"task:sifting\"\n      \"data:mutation_overlap_output\": \"task:mutation_overlap\"\n      \"data:frequency_output\": \"task:frequency\"\n    data_to_consumers:\n      \"data:chromosome_vcf\": [\"task:individuals\"]\n      \"data:columns_txt\": [\"task:individuals\", \"task:mutation_overlap\", \"task:frequency\"]\n      \"data:annotation_vcf\": [\"task:sifting\"]\n      \"data:population_file\": [\"task:mutation_overlap\", \"task:frequency\"]\n      \"data:individual_chunk_tar\": [\"task:individuals_merge\"]\n      \"data:merged_chromosome_tar\": [\"task:mutation_overlap\", \"task:frequency\"]\n      \"data:sifted_chr_txt\": [\"task:mutation_overlap\", \"task:frequency\"]\n      \"data:mutation_overlap_output\": []\n      \"data:frequency_output\": []\n\n\nworkflow_patterns:\n  primary_pattern: \"scatter_gather\"\n  secondary_patterns:\n    - \"broadcast\"\n  classification_rationale: >\n    The dominant structural pattern is scatter-gather: per-chromosome VCF input is scattered\n    across embarrassingly parallel individuals jobs (one per chunk), then gathered by\n    individuals_merge (fan-in, n_to_1 edge). The sifting path is an independent parallel\n    branch producing per-chromosome SIFT data. After gather, merged archives and sifted files\n    are broadcast (1_to_n) to two independent terminal analysis tasks (mutation_overlap and\n    frequency) for each chromosome-population pair. No iteration or feedback loops are present;\n    the DAG is strictly acyclic. The broadcast secondary pattern reflects shared consumption\n    of merged archives and sifted files by both analysis tasks. Out-degree of\n    individuals_merge = 2 (to mutation_overlap and to frequency); out-degree of sifting = 2.\n  pattern_table_row: >\n    1000genome | 3 stages | task:individuals:N*C + task:individuals_merge:C + task:sifting:C +\n    task:mutation_overlap:C*P + task:frequency:C*P | n_to_1 (chunk->merge), 1_to_n\n    (merge->analysis, sifting->analysis) | scatter_gather + broadcast\n\n\nio_behavioral_hints:\n  - hint_id: \"hint:small_file_overhead_individuals\"\n    description: >\n      task:individuals writes 2504 individual text files to a local directory per\n      (chromosome, chunk) job before compressing them into a tar.gz archive.\n      On shared POSIX filesystems this generates 2504 file-create metadata operations\n      per job; at 10 chromosomes * N chunks this scales to 2504 * 10 * N metadata\n      operations total across the individuals stage. This is a classic small-file\n      overhead pattern on HPC parallel filesystems (Lustre, GPFS) where metadata\n      server operations are the bottleneck. Node-local storage or burst buffer staging\n      for the temporary individual files would significantly reduce metadata pressure.\n    affected_tasks:\n      - \"task:individuals\"\n    affected_data:\n      - \"data:individual_chunk_tar\"\n    potential_concern: \"small_file_overhead\"\n\n  - hint_id: \"hint:unnecessary_serialization_chunk_merge\"\n    description: >\n      task:individuals compresses per-individual files into a tar.gz archive,\n      which task:individuals_merge immediately decompresses, accumulates in memory,\n      then recompresses into a merged tar.gz. This extract-then-recompress cycle is\n      unnecessary serialization: intermediate chunk tarballs exist solely to transport\n      data from parallel individuals jobs to the merge job, and content is fully\n      decompressed in memory during merging. The Decaf in-memory MPI path in the\n      repository demonstrates awareness of this issue. Eliminating the intermediate\n      tar.gz would remove two compression/decompression passes per chunk.\n    affected_tasks:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n    affected_data:\n      - \"data:individual_chunk_tar\"\n    potential_concern: \"unnecessary_serialization\"\n\n  - hint_id: \"hint:data_reuse_merged_chromosome_tar\"\n    description: >\n      data:merged_chromosome_tar is consumed by both task:mutation_overlap and\n      task:frequency for each chromosome, requiring each downstream task to independently\n      extract the same tar.gz archive. This is a data reuse pattern: the same large\n      archive (potentially hundreds of MB to several GB) is read and decompressed twice\n      per chromosome. Pre-staging merged archives on fast storage (burst buffer, node-local\n      SSD) before stage:population_analysis would benefit both consumers.\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:merged_chromosome_tar\"\n    potential_concern: \"data_reuse\"\n\n  - hint_id: \"hint:data_reuse_sifted_chr_txt\"\n    description: >\n      data:sifted_chr_txt is consumed by both task:mutation_overlap and task:frequency\n      for each chromosome, resulting in two independent sequential reads of the same\n      file per chromosome. While sifted files are smaller than merged archives, co-locating\n      them with merged archives on fast storage eliminates redundant remote reads for\n      both consumers.\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:sifted_chr_txt\"\n    potential_concern: \"data_reuse\"\n\n  - hint_id: \"hint:small_file_overhead_frequency_output\"\n    description: >\n      task:frequency writes 1000 histogram text files, 1000 mutation overlap text files,\n      and 1000 random-individual text files per (chromosome, population) job before\n      packaging into a tar.gz. Additionally 1000 matplotlib PNG plots are saved via\n      plt.savefig(). Total: approximately 3000+ file creates per chromosome-population job.\n      Aggregating iteration results in memory and writing fewer, larger files would\n      reduce metadata overhead substantially on parallel filesystems.\n    affected_tasks:\n      - \"task:frequency\"\n    affected_data:\n      - \"data:frequency_output\"\n    potential_concern: \"small_file_overhead\"\n\n  - hint_id: \"hint:unnecessary_serialization_sifting_temp_file\"\n    description: >\n      task:sifting uses subprocess.run(shell=True) to invoke grep on the full VEP\n      annotation VCF, writing intermediate output to SIFT.chr{C}.vcf before reading\n      it back into Python. This introduces one full-file write plus one full-file read\n      of the intermediate file per chromosome. The intermediate file is deleted after\n      use (os.remove()). The grep output could be piped directly to Python via\n      subprocess.PIPE, eliminating the temporary file and one write-then-read cycle.\n    affected_tasks:\n      - \"task:sifting\"\n    affected_data:\n      - \"data:sifted_chr_txt\"\n    potential_concern: \"unnecessary_serialization\"\n\n\nexecution_profiles:\n  - profile_name: \"sifting_only\"\n    terminal_task_id: \"task:sifting\"\n    description: >\n      Run only the VEP annotation extraction path to produce SIFT score files per\n      chromosome. Useful for pre-computing sifted files that can be reused across\n      multiple population analysis runs without re-executing the individuals extraction\n      and merge pipeline.\n    required_task_set:\n      - \"task:sifting\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:sifted_chr_txt\"\n\n  - profile_name: \"individuals_only\"\n    terminal_task_id: \"task:individuals_merge\"\n    description: >\n      Run through the individuals extraction and merge stages to produce complete\n      per-chromosome merged individual mutation archives. Useful for pre-computing\n      merged archives that can be reused across multiple analysis runs targeting\n      different population subsets.\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n    conditional_inclusions:\n      - task_id: \"task:individuals_merge\"\n        condition: \"param:ind_jobs > 1\"\n    output_dataset_ids: []\n\n  - profile_name: \"mutation_overlap_only\"\n    terminal_task_id: \"task:mutation_overlap\"\n    description: >\n      Run the complete pipeline through pairwise mutation overlap analysis, producing\n      overlap statistics and plots for each chromosome-population pair. Skips Monte Carlo\n      frequency analysis. Suitable for initial exploration of population-level mutation\n      overlap patterns before committing to the more compute-intensive frequency runs.\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n      - \"task:mutation_overlap\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:mutation_overlap_output\"\n\n  - profile_name: \"full\"\n    terminal_task_id: \"task:frequency\"\n    description: >\n      Complete workflow execution including both pairwise mutation overlap analysis\n      and Monte Carlo allele frequency analysis. Produces all scientific outputs\n      for downstream statistical evaluation of disease-related mutation patterns.\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:mutation_overlap_output\"\n      - \"data:frequency_output\"\n\n\ntranslation_metadata:\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  translation_tool: \"claude-sonnet-4-6\"\n  translation_timestamp: \"2026-03-04T00:00:00Z\"\n  unmapped_fields:\n    - field_path: \"workflow_graph.integrity_hash\"\n      reason: >\n        SHA-256 computation requires Python execution environment unavailable at compile time.\n        Marked PENDING. To compute: python3 -c \"import json,hashlib;\n        edges=sorted([{'consumer':'task:individuals_merge','data_objects':['data:individual_chunk_tar'],'edge_id':'pc:individuals->individuals_merge:n_to_1','pc_pattern':'n_to_1','producer':'task:individuals'},\n        {'consumer':'task:frequency','data_objects':['data:merged_chromosome_tar'],'edge_id':'pc:individuals_merge->frequency:1_to_n','pc_pattern':'1_to_n','producer':'task:individuals_merge'},\n        {'consumer':'task:mutation_overlap','data_objects':['data:merged_chromosome_tar'],'edge_id':'pc:individuals_merge->mutation_overlap:1_to_n','pc_pattern':'1_to_n','producer':'task:individuals_merge'},\n        {'consumer':'task:frequency','data_objects':['data:sifted_chr_txt'],'edge_id':'pc:sifting->frequency:1_to_n','pc_pattern':'1_to_n','producer':'task:sifting'},\n        {'consumer':'task:mutation_overlap','data_objects':['data:sifted_chr_txt'],'edge_id':'pc:sifting->mutation_overlap:1_to_n','pc_pattern':'1_to_n','producer':'task:sifting'}],\n        key=lambda e:e['edge_id']); print(hashlib.sha256(json.dumps(edges,sort_keys=True,separators=(',',':')).encode()).hexdigest())\"\n    - field_path: \"metadata.source_commit\"\n      reason: \"Git commit hash unavailable without direct git access to the workflow repository directory.\"\n    - field_path: \"data_objects[*].estimated_size_hint\"\n      reason: \"VCF and tar.gz sizes depend on runtime input content; only order-of-magnitude estimates provided.\"\n  round_trip_gaps:\n    - field_path: \"tasks[*].description\"\n      note: \"Pegasus DAX (daxgen.py) has no per-job description field; descriptions are agent-inferred from source scripts.\"\n    - field_path: \"data_objects[*].description\"\n      note: \"Pegasus DAX has no data object description field; all descriptions are agent-inferred.\"\n    - field_path: \"execution_profiles\"\n      note: \"Pegasus DAX has no native execution profile concept; profiles are agent-proposed.\"\n    - field_path: \"io_behavioral_hints\"\n      note: \"Pegasus DAX has no I/O hint representation; all hints are agent-inferred from task script inspection.\"\n    - field_path: \"workflow_patterns\"\n      note: \"Pegasus DAX encodes dependencies but not pattern classification; patterns are agent-inferred from DAG topology.\"\n  quality_warnings:\n    - field_path: \"workflow_graph.integrity_hash\"\n      warning: \"Marked PENDING; must be computed and replaced before WDD is used by downstream agents.\"\n    - field_path: \"data_objects[data:individual_chunk_tar].estimated_size_hint\"\n      warning: \"Size estimate is vague; depends on number of SNP variants per chunk and compression ratio.\"\n  field_confidence_records:\n    - field_path: \"tasks[task:individuals].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of bin/individuals.py and daxgen.py job construction; all I/O paths and processing logic are explicitly coded.\"\n      requires_human_review: false\n    - field_path: \"tasks[task:individuals_merge].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of bin/individuals_merge.py; extract-accumulate-recompress pattern is explicit.\"\n      requires_human_review: false\n    - field_path: \"tasks[task:sifting].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of bin/sifting.py; grep+regex filtering pipeline is explicit.\"\n      requires_human_review: false\n    - field_path: \"tasks[task:mutation_overlap].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of bin/mutation_overlap.py; O(N^2) pairwise loop and matplotlib output explicit.\"\n      requires_human_review: false\n    - field_path: \"tasks[task:frequency].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of bin/frequency.py; n_runs=1000, n_indiv=52, Counter-based accumulation explicit.\"\n      requires_human_review: false\n    - field_path: \"tasks[*].io_dominance\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        Inferred from I/O call density vs compute in each script:\n        individuals=io_bound (2504 file writes per chunk before compression);\n        individuals_merge=io_bound (extract + recompress cycle dominates);\n        sifting=balanced (grep I/O + Python regex parse roughly balanced);\n        mutation_overlap=balanced (O(N^2) compute + matplotlib output roughly balanced);\n        frequency=compute_bound (1000 Monte Carlo iterations dominate wall time over single read).\n      requires_human_review: false\n    - field_path: \"tasks[*].io_access_type\"\n      confidence_level: \"high\"\n      confidence_reason: \"All task scripts import only Python standard library (open, tarfile, subprocess, numpy). No mpi4py, h5py, or netCDF4 imports found in any script under bin/. Classified as python_serial.\"\n      requires_human_review: false\n    - field_path: \"tasks[*].restart_model\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        No checkpoint-read logic at task startup found in any script.\n        No --resume/--restart/--continue CLI flags in any argparse definition.\n        No skip-if-output-exists guards. All scripts overwrite outputs deterministically\n        given identical inputs. Classified as idempotent. Cannot rule out partial-write\n        corruption on kill without runtime testing.\n      requires_human_review: false\n    - field_path: \"tasks[*].behavioral_notes\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of task source code, observing call sequences, data structure allocation, and file access patterns.\"\n      requires_human_review: false\n    - field_path: \"pc_edges[*].pc_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        Derived from daxgen.py job construction logic: chunk loop creates N individuals jobs per\n        chromosome (scatter), one merge job per chromosome consumes all chunk archives (n_to_1),\n        then analysis jobs indexed by (chromosome, population) consume all merged and sifted\n        files (1_to_n broadcast from merge and sifting to both terminal tasks).\n      requires_human_review: false\n    - field_path: \"workflow_patterns.primary_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        DAG topology clearly shows scatter (parallel individuals jobs) + gather (individuals_merge\n        fan-in) + broadcast to two terminal analysis tasks. No iteration or feedback loops present.\n        Scatter-gather is unambiguous from Pegasus job construction in daxgen.py.\n      requires_human_review: false\n    - field_path: \"io_behavioral_hints[*]\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        All hints derived from static code inspection: small-file patterns from explicit file-create\n        counts in task scripts; unnecessary serialization from compress-decompress sequences;\n        data reuse from two consumer tasks opening the same file per chromosome.\n      requires_human_review: false\n    - field_path: \"execution_profiles\"\n      confidence_level: \"medium\"\n      confidence_reason: \"[ASSUMPTION] Profile proposals based on task output_class classification and natural workflow stopping points visible in the DAG. Scientist confirmation required for scientific relevance of proposed stopping points.\"\n      requires_human_review: true\n"}},{"tool_name":"Write","tool_use_id":"toolu_01Tn6XKeezET9CCCvCFtYQxJ","tool_input":{"file_path":"/mnt/common/mtang11/scripts/workflow-representation-description/workflow_wdd/1000genome-wdd-claude-trial2.yaml","content":"schema_version: \"wrd-7.0\"\n\nmetadata:\n  workflow_lineage_id: \"wrd:1000genome\"\n  version: \"1.0.0\"\n  version_notes: \"Initial WDD compiled from daxgen.py and bin/ task scripts via static analysis.\"\n  deprecated: false\n  workflow_name: \"1000genome\"\n  workflow_description: >\n    The 1000 Genomes workflow identifies mutational overlaps in human genomic data from the\n    1000 Genomes Project, processing VCF files for up to 22 chromosomes across 2504 individuals\n    from 26 global populations. It parses per-chromosome SNP variant files to extract\n    individual-level mutation records, annotates variants with SIFT pathogenicity scores from\n    VEP-annotated VCF files, merges parallel per-chunk outputs into per-chromosome archives,\n    and performs both pairwise mutation overlap analysis and Monte Carlo-based allele frequency\n    analysis across user-specified population groups. Final outputs are statistical tables and\n    matplotlib visualizations of population-level mutation overlap distributions.\n  source_repository: \"workflows_repo/1000genome-workflow\"\n  source_commit: \"unknown\"\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  generated_by: \"claude-sonnet-4-6\"\n  generated_at: \"2026-03-04T00:00:00Z\"\n  last_modified_at: \"2026-03-04T00:00:00Z\"\n\n\nstages:\n  - stage_id: \"stage:individuals_extraction\"\n    name: \"Individuals Extraction\"\n    order: 1\n    description: >\n      Parallel extraction of per-individual mutation records from chromosome VCF files.\n      Each job processes a non-overlapping line-range chunk of a VCF file, writing one\n      text file per individual and compressing the results into a tar.gz archive.\n    tasks:\n      - \"task:individuals\"\n\n  - stage_id: \"stage:merge_and_sifting\"\n    name: \"Merge and Sifting\"\n    order: 2\n    description: >\n      Two independent sub-operations run concurrently: (1) individuals_merge fans in\n      all per-chunk archives into a single per-chromosome tarball; (2) sifting extracts\n      SIFT pathogenicity scores from VEP-annotated VCF files per chromosome.\n    tasks:\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n\n  - stage_id: \"stage:population_analysis\"\n    name: \"Population Analysis\"\n    order: 3\n    description: >\n      Two independent terminal analysis tasks consume merged individual archives and sifted\n      score files: mutation_overlap performs pairwise O(N^2) overlap analysis, and frequency\n      runs 1000 Monte Carlo iterations to estimate allele frequency distributions.\n    tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n\n\ntasks:\n  - task_id: \"task:individuals\"\n    name: \"Individuals\"\n    stage: \"stage:individuals_extraction\"\n    executable: \"bin/individuals.py\"\n    description: >\n      Parses a chunk of a chromosome VCF file (defined by start and stop line indices)\n      and extracts allele calls for all 2504 individuals using a columns mapping file.\n      For each individual it selects SNP records where the allele frequency criterion\n      is met, writes one text file per individual to a temporary directory, then compresses\n      all individual files into a tar.gz archive named chr{C}n-{start}-{stop}.tar.gz.\n      This task exists to produce per-individual mutation sets that downstream analysis\n      tasks compare across populations.\n    behavioral_notes: >\n      Reads the entire VCF chunk (up to 250000 lines) into memory via readfile() before\n      processing. Writes 2504 individual text files to a local directory (significant\n      metadata pressure on shared filesystems), then calls tarfile.open() to compress\n      the directory. The temporary per-individual directory is removed after compression.\n      Access pattern: sequential read of VCF lines, one-pass write per individual file,\n      then single-pass tar+gzip compression.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One Pegasus job per (chromosome, chunk) pair. Chunks are non-overlapping line\n        ranges computed by daxgen.py from the total row count and ind_jobs parameter.\n        All chunk jobs are fully independent across chromosomes and across chunks of the\n        same chromosome.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:chromosome_vcf\"\n      - \"data:columns_txt\"\n    outputs:\n      - \"data:individual_chunk_tar\"\n\n  - task_id: \"task:individuals_merge\"\n    name: \"Individuals Merge\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/individuals_merge.py\"\n    description: >\n      Merges all per-chunk individual mutation archives for a single chromosome into\n      one unified per-chromosome tar.gz archive (chr{C}n.tar.gz). It sequentially\n      extracts each chunk tarball into a temporary directory, accumulates individual\n      file contents across chunks, writes merged files to a merged_chr{C}/ directory,\n      then compresses the result. This task exists to reunify chromosome data that was\n      split across parallel individuals jobs for downstream consumption by analysis tasks.\n    behavioral_notes: >\n      Processes chunk tarballs one at a time in sequence; uses tempfile.TemporaryDirectory\n      for intermediate extraction state. Appends content of same-named individual files\n      across chunks in memory (data dict), then writes merged files sequentially.\n      Extract-then-recompress pattern causes transient disk amplification: merged_chr{C}/\n      can equal the uncompressed size of all input chunks before recompression.\n      Access pattern: sequential read of each chunk tarball, full-file append in memory,\n      sequential write of merged files, then single-pass tar+gzip.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One Pegasus job per chromosome. Each merge job is independent of other chromosomes.\n        Pegasus dependency enforces completion of all chunk jobs for a chromosome before\n        the corresponding merge job starts.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:individual_chunk_tar\"\n    outputs:\n      - \"data:merged_chromosome_tar\"\n\n  - task_id: \"task:sifting\"\n    name: \"Sifting\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/sifting.py\"\n    description: >\n      Extracts SIFT pathogenicity scores from a per-chromosome VEP-annotated VCF file.\n      Uses subprocess grep to pre-filter lines containing deleterious or tolerated\n      annotations, then Python regex to retain only SNP records with rs IDs.\n      Parses line number, rs number, ENSEMBL gene ID, SIFT score, and phenotype\n      into a compact text file sifted.SIFT.chr{C}.txt. This task provides the\n      variant-level SIFT annotations required by both downstream analysis tasks to\n      filter mutations by pathogenicity.\n    behavioral_notes: >\n      Reads the full VEP annotation VCF into memory, then launches a subprocess grep\n      (shell=True) for fast line pre-filtering; writes grep output to a temporary\n      SIFT.chr{C}.vcf before reading it back into Python. Deletes the temporary file\n      after processing. Two full-file reads (original VCF for header count, grep output)\n      and one write of the compact sifted result. Grep subprocess introduces one\n      process-spawn overhead per chromosome; grep operates on the full file sequentially.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One Pegasus job per chromosome annotation VCF. Fully independent of the\n        individuals processing path; runs concurrently with task:individuals_merge\n        within stage:merge_and_sifting.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:annotation_vcf\"\n    outputs:\n      - \"data:sifted_chr_txt\"\n\n  - task_id: \"task:mutation_overlap\"\n    name: \"Mutation Overlap\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/mutation_overlap.py\"\n    description: >\n      Performs exhaustive pairwise mutation set intersection analysis over all individuals\n      in a specified population for a given chromosome. Reads merged individual mutation\n      archives, intersects each individual's SNP set against the SIFT-scored variant list,\n      then computes all O(N^2) pairwise overlaps plus half-matrix and random-pair variants.\n      Generates text statistics files and matplotlib colormap and histogram plots.\n      Outputs are packaged in chr{C}-{POP}.tar.gz. This task provides population-level\n      mutation overlap distributions for rigorous statistical evaluation of disease-related\n      mutations.\n    behavioral_notes: >\n      Untars the merged chromosome archive into memory at startup. Reads population ID\n      list from population file and columns.txt to intersect individual identifiers.\n      Builds mutation_index_array in memory (one list of rs numbers per individual);\n      all O(N^2) pair comparisons run in Python loops with set intersection.\n      Memory footprint scales with n_individuals * avg_mutations_per_individual.\n      Matplotlib plot generation at the end adds a CPU+disk tail. Writes multiple\n      text files per run before packaging all into a tar.gz. Access pattern: full\n      archive read at start, compute-heavy in-memory phase, then sequential write\n      of multiple output files, final tar.gz creation.\n    parallelism_model:\n      type: \"serial\"\n      description: >\n        One Pegasus job per (chromosome, population) pair. Internal computation is\n        single-threaded Python. No MPI or GPU parallelism observed in static analysis.\n        The O(N^2) pairwise loop is not parallelized within the script.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"checkpoint\"\n    inputs:\n      - \"data:merged_chromosome_tar\"\n      - \"data:sifted_chr_txt\"\n      - \"data:population_file\"\n      - \"data:columns_txt\"\n    outputs:\n      - \"data:mutation_overlap_output\"\n\n  - task_id: \"task:frequency\"\n    name: \"Frequency\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/frequency.py\"\n    description: >\n      Estimates allele frequency distributions using 1000 Monte Carlo iterations over\n      merged individual mutation archives and SIFT score files for a given chromosome\n      and population. Each iteration samples n_indiv=52 random individuals and counts\n      mutation overlap frequencies using Counter-based multiset accumulation.\n      Writes per-iteration text histogram files and random-individual lists, generates\n      histogram bar plots per iteration, and packages results in chr{C}-{POP}-freq.tar.gz.\n      This task provides the null distribution for statistical evaluation of mutation\n      overlap patterns compared to task:mutation_overlap results.\n    behavioral_notes: >\n      Untars merged chromosome archive at module-level import time (before class definitions),\n      then reads population and SIFT files. All 1000 Monte Carlo iterations run serially\n      in a single Python process; random sampling uses Python's built-in random module.\n      Writes 1000 histogram files and 1000 random-individual files to output directories;\n      this creates significant small-file I/O pressure (2000+ file creates per job).\n      Matplotlib plot generation runs per iteration (1000 plt.savefig() calls).\n      Access pattern: single full-archive read at startup, compute-dominant loop,\n      many sequential writes of small files.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One Pegasus job per (chromosome, population) pair. Internally the 1000 Monte\n        Carlo runs execute serially; they are logically embarrassingly parallel but not\n        split by the reference implementation. Could be parallelized externally.\n    io_dominance: \"compute_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"checkpoint\"\n    inputs:\n      - \"data:merged_chromosome_tar\"\n      - \"data:sifted_chr_txt\"\n      - \"data:population_file\"\n      - \"data:columns_txt\"\n    outputs:\n      - \"data:frequency_output\"\n\n\ndata_objects:\n  - data_id: \"data:chromosome_vcf\"\n    name: \"Chromosome VCF\"\n    description: >\n      Per-chromosome input VCF file from the 1000 Genomes Project Phase 3 dataset\n      (e.g., ALL.chr1.250000.vcf). Contains approximately 250000 SNP variant records\n      with genotype calls for all 2504 individuals across 26 populations.\n      Each row encodes one SNP position; columns 9 onward hold individual genotype\n      fields encoding allele calls. Used by task:individuals to extract per-individual\n      mutation sets per chromosome chunk.\n    category: \"input\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"unknown; 250000-line VCF with 2504 individual columns is likely ~500 MB-2 GB per chromosome\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:individuals\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:individuals\"\n      retention_window: \"external input; retained across workflow\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 1\n\n  - data_id: \"data:columns_txt\"\n    name: \"Columns Text File\"\n    description: >\n      Single tab-delimited text file (columns.txt) mapping VCF column indices to 2504\n      individual sample identifiers. Contains one header row listing sample IDs starting\n      at column index 9. Used by task:individuals to derive per-individual output filenames\n      and by task:mutation_overlap and task:frequency to intersect population lists with\n      genome column identifiers. This config file is read-only throughout the workflow.\n    category: \"config\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"1 file (single global config)\"\n    cardinality_source:\n      type: \"fixed\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"n/a\"\n    estimated_size_hint: \"small; one row of 2504 tab-separated sample IDs, likely ~50-100 KB\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:individuals\"\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"external config; retained across workflow\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 3\n\n  - data_id: \"data:annotation_vcf\"\n    name: \"VEP Annotation VCF\"\n    description: >\n      Per-chromosome VEP-annotated VCF file containing functional consequence predictions\n      for all Phase 3 SNP variants. INFO field column 8 contains pipe-delimited VEP\n      annotations including SIFT scores and ENSEMBL gene IDs.\n      Used exclusively by task:sifting to extract variant-level SIFT pathogenicity data.\n    category: \"input\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"unknown; VEP annotation VCFs are larger than base VCFs due to INFO field expansion, likely ~1-10 GB per chromosome\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:sifting\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:sifting\"\n      retention_window: \"external input; retained across workflow\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:population_file\"\n    name: \"Population File\"\n    description: >\n      Per-population text files listing the sample IDs belonging to each of the 7 population\n      groups in the 1000 Genomes Project (ALL, EUR, EAS, AFR, AMR, SAS, GBR). Each file\n      contains one sample ID per line. Used by task:mutation_overlap and task:frequency to\n      filter the analysis to individuals belonging to a specific population before computing\n      mutation overlap statistics and frequency distributions.\n    category: \"input\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"7 files (one per population: ALL, EUR, EAS, AFR, AMR, SAS, GBR)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data/populations/\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"small; each file contains 91-2504 sample IDs, likely less than 100 KB each\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"external input; retained across workflow\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 2\n\n  - data_id: \"data:individual_chunk_tar\"\n    name: \"Individual Chunk Tar Archive\"\n    description: >\n      Per-(chromosome, chunk) tar.gz archive produced by task:individuals, containing one\n      text file per individual (2504 files) with mutation records for the SNP positions in\n      the assigned chunk line range. Each individual file lists rs number, position,\n      reference and alternate alleles, and allele frequency for SNPs where the individual\n      carries the minor allele. Consumed exclusively by task:individuals_merge to build\n      the complete per-chromosome individual mutation archive.\n    category: \"intermediate\"\n    persistence: \"stage_scoped\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"ind_jobs\"\n      config_file: \"daxgen.py\"\n      possible_values: \"any positive integer dividing the chromosome row count (default 1 per chromosome)\"\n    estimated_size_hint: \"unknown; size per chunk scales with chunk size divided by total VCF rows; likely tens to hundreds of MB per chunk\"\n    producer_task: \"task:individuals\"\n    consumer_tasks:\n      - \"task:individuals_merge\"\n    lifecycle:\n      creation_phase: \"task:individuals\"\n      last_consumer_phase: \"task:individuals_merge\"\n      retention_window: \"from task:individuals completion to task:individuals_merge completion (per chromosome)\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:merged_chromosome_tar\"\n    name: \"Merged Chromosome Tar Archive\"\n    description: >\n      Complete per-chromosome tar.gz archive produced by task:individuals_merge by merging\n      all per-chunk individual mutation archives for one chromosome. Contains 2504 individual\n      text files with complete mutation records across all SNP positions in that chromosome.\n      Consumed by both task:mutation_overlap and task:frequency as the primary source of\n      individual-level mutation data for downstream analyses across all populations.\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"unknown; contains all mutations across all chunks for one chromosome; likely hundreds of MB to several GB per chromosome\"\n    producer_task: \"task:individuals_merge\"\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: \"task:individuals_merge\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:individuals_merge completion to task:frequency completion (full workflow duration)\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 2\n\n  - data_id: \"data:sifted_chr_txt\"\n    name: \"Sifted Chromosome SIFT Text File\"\n    description: >\n      Per-chromosome text file produced by task:sifting, containing space-delimited records\n      for all SNP variants with SIFT pathogenicity annotations. Each row encodes line number,\n      rs ID, ENSEMBL gene ID, SIFT score, and phenotype. Only variants with both rs IDs and\n      SIFT annotations are retained. Consumed by both task:mutation_overlap and task:frequency\n      to filter individual mutations to SIFT-annotated variants for population-level overlap\n      analysis.\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"medium; subset of VEP annotation VCF with 5 extracted fields per variant; likely tens of MB per chromosome\"\n    producer_task: \"task:sifting\"\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: \"task:sifting\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:sifting completion to task:frequency completion (full workflow duration)\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 2\n\n  - data_id: \"data:mutation_overlap_output\"\n    name: \"Mutation Overlap Output Archive\"\n    description: >\n      Per-(chromosome, population) tar.gz archive produced by task:mutation_overlap, containing\n      text statistics files (pairwise overlap counts, half-matrix overlaps, gene pair counts,\n      random pair overlaps, per-individual total mutations, variant-to-ENSEMBL-ID map) and\n      matplotlib PNG plots (colormap, half-distribution, total-distribution, random-distribution).\n      Represents the primary scientific result of mutation set overlap analysis for a\n      chromosome-population combination.\n    category: \"output\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"medium; multiple text statistics files plus PNG plots per chromosome-population pair; likely tens to hundreds of MB\"\n    producer_task: \"task:mutation_overlap\"\n    consumer_tasks: []\n    lifecycle:\n      creation_phase: \"task:mutation_overlap\"\n      last_consumer_phase: \"task:mutation_overlap\"\n      retention_window: \"created at task:mutation_overlap completion; final output retained indefinitely\"\n      access_frequency_class: \"once\"\n      consumer_count: 0\n\n  - data_id: \"data:frequency_output\"\n    name: \"Frequency Analysis Output Archive\"\n    description: >\n      Per-(chromosome, population) tar.gz archive produced by task:frequency, containing 1000\n      per-iteration text files of mutation overlap histograms, 1000 mutation overlap count files,\n      1000 random individual selection files, 1000 histogram bar plot PNGs, and variation-to-ENSEMBL-ID\n      and mutation index array files. Represents the Monte Carlo frequency null distribution output\n      for statistical evaluation of mutation overlap significance.\n    category: \"output\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"medium; 3000+ small text files and 1000 PNG plots per chromosome-population pair; likely hundreds of MB\"\n    producer_task: \"task:frequency\"\n    consumer_tasks: []\n    lifecycle:\n      creation_phase: \"task:frequency\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"created at task:frequency completion; final output retained indefinitely\"\n      access_frequency_class: \"once\"\n      consumer_count: 0\n\n\npc_edges:\n  - edge_id: \"pc:individuals->individuals_merge:n_to_1\"\n    producer: \"task:individuals\"\n    consumer: \"task:individuals_merge\"\n    data_objects:\n      - \"data:individual_chunk_tar\"\n    pc_pattern: \"n_to_1\"\n    pc_pattern_rationale: >\n      Multiple parallel individuals jobs (one per chunk) each produce one chunk tar.gz;\n      a single individuals_merge job per chromosome consumes all chunk archives for that\n      chromosome. Fan-in per chromosome: N chunk producers to 1 merge consumer.\n    data_flow_description: >\n      Each individuals job writes one tar.gz archive to shared scratch. The merge job\n      receives all N chunk filenames as CLI arguments and reads each archive sequentially\n      (full read, no partial access).\n    coupling: \"tight\"\n    coupling_rationale: >\n      The individuals_merge script opens chunk tarballs via tarfile.open() only after\n      Pegasus dependency enforcement ensures all producers have completed. No streaming\n      or polling behavior; merge waits for all chunk archives to be fully written.\n    communication_pattern: \"file_per_producer\"\n    data_volume_class: \"large\"\n\n  - edge_id: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:merged_chromosome_tar\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One individuals_merge job per chromosome produces one merged tar.gz. Multiple\n      mutation_overlap jobs (one per chromosome-population pair) each consume the merged\n      archive for their chromosome. One producer to N consumer instances across all\n      populations for that chromosome.\n    data_flow_description: >\n      mutation_overlap opens the merged chromosome tar.gz via tarfile.open().extractall()\n      at startup, extracting all 2504 individual files into a local directory. Full archive\n      read at task start; no partial or streaming access.\n    coupling: \"tight\"\n    coupling_rationale: >\n      mutation_overlap reads merged archives after Pegasus dependency ensures completion\n      of individuals_merge. tarfile.open() call at script top-level confirms full-file\n      dependency before any computation begins.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"large\"\n\n  - edge_id: \"pc:individuals_merge->frequency:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:merged_chromosome_tar\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One individuals_merge job per chromosome produces one merged tar.gz. Multiple\n      frequency jobs (one per chromosome-population pair) each consume the merged archive\n      for their chromosome. Same broadcast structure as the mutation_overlap consumers.\n    data_flow_description: >\n      frequency.py opens the merged chromosome tar.gz via tarfile.open().extractall()\n      at module-level (before class definitions), extracting all 2504 individual files.\n      Full archive read at task start before any Monte Carlo iterations begin.\n    coupling: \"tight\"\n    coupling_rationale: >\n      The tarfile.open() call at module-level in frequency.py executes before any\n      function definitions, enforcing full-archive availability. Pegasus dependency\n      ensures individuals_merge completion before frequency starts.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"large\"\n\n  - edge_id: \"pc:sifting->mutation_overlap:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:sifted_chr_txt\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One sifting job per chromosome produces one sifted SIFT text file. Multiple\n      mutation_overlap jobs (one per chromosome-population pair) each consume the sifted\n      file for their chromosome. One producer to N consumer instances.\n    data_flow_description: >\n      mutation_overlap.read_rs_numbers() opens sifted_chr_txt sequentially and reads all\n      records into memory (rs_numbers list and map_variations dict). Full sequential read;\n      no partial access or random seeks observed.\n    coupling: \"tight\"\n    coupling_rationale: >\n      mutation_overlap reads the sifted file via open() after Pegasus dependency ensures\n      sifting completion. File is consumed in full at task startup.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"small\"\n\n  - edge_id: \"pc:sifting->frequency:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:sifted_chr_txt\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One sifting job per chromosome produces one sifted SIFT text file. Multiple\n      frequency jobs (one per chromosome-population pair) each consume the sifted file\n      for their chromosome. Mirror of the sifting->mutation_overlap edge.\n    data_flow_description: >\n      frequency.read_rs_numbers() opens sifted_chr_txt sequentially and reads all records\n      into rs_numbers list and map_variations dict. Full file read at task startup before\n      Monte Carlo iterations begin.\n    coupling: \"tight\"\n    coupling_rationale: >\n      frequency.py reads the sifted file via open() at startup before any iteration logic.\n      Pegasus dependency ensures sifting completion before frequency starts.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"small\"\n\n\nworkflow_graph:\n  integrity_hash: \"PENDING\"\n  last_generated: \"2026-03-04T00:00:00Z\"\n  dag_edges:\n    - from: \"task:individuals\"\n      to: \"task:individuals_merge\"\n      via: \"pc:individuals->individuals_merge:n_to_1\"\n    - from: \"task:individuals_merge\"\n      to: \"task:mutation_overlap\"\n      via: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    - from: \"task:individuals_merge\"\n      to: \"task:frequency\"\n      via: \"pc:individuals_merge->frequency:1_to_n\"\n    - from: \"task:sifting\"\n      to: \"task:mutation_overlap\"\n      via: \"pc:sifting->mutation_overlap:1_to_n\"\n    - from: \"task:sifting\"\n      to: \"task:frequency\"\n      via: \"pc:sifting->frequency:1_to_n\"\n  loop_groups: []\n  critical_path_hint: >\n    Longest sequential chain: task:individuals (parallel, approximately 81% of wall time per README)\n    -> task:individuals_merge -> task:mutation_overlap. Sifting is short (approximately 6 seconds per\n    README) and off the critical path. Critical path length is runtime-determined by chromosome count\n    and chunk count.\n  control_flow:\n    has_iteration: false\n    iteration_description: null\n    has_conditional_branches: true\n    conditional_description: >\n      daxgen.py selects different execution paths via CLI flags: --decaf enables Decaf in-memory MPI\n      dataflow (uses individuals_mpi.py and individuals_merge_mpi.py); --pmc enables Pegasus MPI\n      Cluster mode. These are deployment-mode switches not workflow-logic branches. The core DAG\n      topology is unchanged between modes. [ASSUMPTION] Treating default Pegasus path as canonical WDD.\n  stage_execution_order:\n    - \"stage:individuals_extraction\"\n    - \"stage:merge_and_sifting\"\n    - \"stage:population_analysis\"\n  cross_reference:\n    task_to_stage:\n      \"task:individuals\": \"stage:individuals_extraction\"\n      \"task:individuals_merge\": \"stage:merge_and_sifting\"\n      \"task:sifting\": \"stage:merge_and_sifting\"\n      \"task:mutation_overlap\": \"stage:population_analysis\"\n      \"task:frequency\": \"stage:population_analysis\"\n    data_to_producer:\n      \"data:chromosome_vcf\": null\n      \"data:columns_txt\": null\n      \"data:annotation_vcf\": null\n      \"data:population_file\": null\n      \"data:individual_chunk_tar\": \"task:individuals\"\n      \"data:merged_chromosome_tar\": \"task:individuals_merge\"\n      \"data:sifted_chr_txt\": \"task:sifting\"\n      \"data:mutation_overlap_output\": \"task:mutation_overlap\"\n      \"data:frequency_output\": \"task:frequency\"\n    data_to_consumers:\n      \"data:chromosome_vcf\": [\"task:individuals\"]\n      \"data:columns_txt\": [\"task:individuals\", \"task:mutation_overlap\", \"task:frequency\"]\n      \"data:annotation_vcf\": [\"task:sifting\"]\n      \"data:population_file\": [\"task:mutation_overlap\", \"task:frequency\"]\n      \"data:individual_chunk_tar\": [\"task:individuals_merge\"]\n      \"data:merged_chromosome_tar\": [\"task:mutation_overlap\", \"task:frequency\"]\n      \"data:sifted_chr_txt\": [\"task:mutation_overlap\", \"task:frequency\"]\n      \"data:mutation_overlap_output\": []\n      \"data:frequency_output\": []\n\n\nworkflow_patterns:\n  primary_pattern: \"scatter_gather\"\n  secondary_patterns:\n    - \"broadcast\"\n  classification_rationale: >\n    The dominant structural pattern is scatter-gather: per-chromosome VCF input is scattered\n    across embarrassingly parallel individuals jobs (one per chunk), then gathered by\n    individuals_merge (fan-in, n_to_1 edge). The sifting path is an independent parallel\n    branch producing per-chromosome SIFT data. After gather, merged archives and sifted files\n    are broadcast (1_to_n) to two independent terminal analysis tasks (mutation_overlap and\n    frequency) for each chromosome-population pair. No iteration or feedback loops present;\n    the DAG is strictly acyclic. The broadcast secondary pattern reflects shared consumption\n    of merged archives and sifted files by both analysis tasks.\n  pattern_table_row: >\n    1000genome | 3 stages | task:individuals:N*C + task:individuals_merge:C + task:sifting:C +\n    task:mutation_overlap:C*P + task:frequency:C*P | n_to_1 (chunk->merge), 1_to_n\n    (merge->analysis, sifting->analysis) | scatter_gather + broadcast\n\n\nio_behavioral_hints:\n  - hint_id: \"hint:small_file_overhead_individuals\"\n    description: >\n      task:individuals writes 2504 individual text files to a local directory per\n      (chromosome, chunk) job before compressing them into a tar.gz archive.\n      On shared POSIX filesystems this generates 2504 file-create metadata operations\n      per job; at 10 chromosomes times N chunks this scales to many thousands of metadata\n      operations total. This is a classic small-file overhead pattern on HPC parallel\n      filesystems (Lustre, GPFS) where metadata server operations are the bottleneck.\n      Node-local storage or burst buffer staging for the temporary individual files\n      would significantly reduce metadata pressure.\n    affected_tasks:\n      - \"task:individuals\"\n    affected_data:\n      - \"data:individual_chunk_tar\"\n    potential_concern: \"small_file_overhead\"\n\n  - hint_id: \"hint:unnecessary_serialization_chunk_merge\"\n    description: >\n      task:individuals compresses per-individual files into a tar.gz archive,\n      which task:individuals_merge immediately decompresses, accumulates in memory,\n      then recompresses into a merged tar.gz. This extract-then-recompress cycle is\n      unnecessary serialization: intermediate chunk tarballs exist solely to transport\n      data from parallel individuals jobs to the merge job, and content is fully\n      decompressed in memory during merging. The Decaf in-memory MPI path in the\n      repository demonstrates awareness of this issue. Eliminating the intermediate\n      tar.gz would remove two compression and decompression passes per chunk.\n    affected_tasks:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n    affected_data:\n      - \"data:individual_chunk_tar\"\n    potential_concern: \"unnecessary_serialization\"\n\n  - hint_id: \"hint:data_reuse_merged_chromosome_tar\"\n    description: >\n      data:merged_chromosome_tar is consumed by both task:mutation_overlap and\n      task:frequency for each chromosome, requiring each downstream task to independently\n      extract the same tar.gz archive. The same large archive (potentially hundreds of MB\n      to several GB) is read and decompressed twice per chromosome. Pre-staging merged\n      archives on fast storage (burst buffer, node-local SSD) before stage:population_analysis\n      would benefit both consumers.\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:merged_chromosome_tar\"\n    potential_concern: \"data_reuse\"\n\n  - hint_id: \"hint:data_reuse_sifted_chr_txt\"\n    description: >\n      data:sifted_chr_txt is consumed by both task:mutation_overlap and task:frequency\n      for each chromosome, resulting in two independent sequential reads of the same file\n      per chromosome. Co-locating sifted files with merged archives on fast storage\n      eliminates redundant remote reads for both consumers.\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:sifted_chr_txt\"\n    potential_concern: \"data_reuse\"\n\n  - hint_id: \"hint:small_file_overhead_frequency_output\"\n    description: >\n      task:frequency writes 1000 histogram text files, 1000 mutation overlap text files,\n      and 1000 random-individual text files per (chromosome, population) job before\n      packaging into a tar.gz. Additionally 1000 matplotlib PNG plots are saved via\n      plt.savefig(). Total approximately 3000 file creates per chromosome-population job.\n      Aggregating iteration results in memory and writing fewer larger files would reduce\n      metadata overhead substantially on parallel filesystems.\n    affected_tasks:\n      - \"task:frequency\"\n    affected_data:\n      - \"data:frequency_output\"\n    potential_concern: \"small_file_overhead\"\n\n  - hint_id: \"hint:unnecessary_serialization_sifting_temp_file\"\n    description: >\n      task:sifting uses subprocess.run(shell=True) to invoke grep on the full VEP annotation\n      VCF, writing intermediate output to SIFT.chr{C}.vcf before reading it back into Python.\n      This introduces one full-file write plus one full-file read of the intermediate file per\n      chromosome. The intermediate file is deleted after use via os.remove(). The grep output\n      could be piped directly to Python via subprocess.PIPE, eliminating the temporary file\n      and one write-then-read cycle.\n    affected_tasks:\n      - \"task:sifting\"\n    affected_data:\n      - \"data:sifted_chr_txt\"\n    potential_concern: \"unnecessary_serialization\"\n\n\nexecution_profiles:\n  - profile_name: \"sifting_only\"\n    terminal_task_id: \"task:sifting\"\n    description: >\n      Run only the VEP annotation extraction path to produce SIFT score files per chromosome.\n      Useful for pre-computing sifted files that can be reused across multiple population\n      analysis runs without re-executing the individuals extraction and merge pipeline.\n    required_task_set:\n      - \"task:sifting\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:sifted_chr_txt\"\n\n  - profile_name: \"individuals_only\"\n    terminal_task_id: \"task:individuals_merge\"\n    description: >\n      Run through the individuals extraction and merge stages to produce complete per-chromosome\n      merged individual mutation archives. Useful for pre-computing merged archives that can be\n      reused across multiple analysis runs targeting different population subsets.\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n    conditional_inclusions:\n      - task_id: \"task:individuals_merge\"\n        condition: \"param:ind_jobs > 1\"\n    output_dataset_ids: []\n\n  - profile_name: \"mutation_overlap_only\"\n    terminal_task_id: \"task:mutation_overlap\"\n    description: >\n      Run the complete pipeline through pairwise mutation overlap analysis, producing\n      overlap statistics and plots for each chromosome-population pair. Skips Monte Carlo\n      frequency analysis. Suitable for initial exploration of population-level mutation\n      overlap patterns before committing to the more compute-intensive frequency runs.\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n      - \"task:mutation_overlap\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:mutation_overlap_output\"\n\n  - profile_name: \"full\"\n    terminal_task_id: \"task:frequency\"\n    description: >\n      Complete workflow execution including both pairwise mutation overlap analysis and Monte\n      Carlo allele frequency analysis. Produces all scientific outputs for downstream statistical\n      evaluation of disease-related mutation patterns.\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:mutation_overlap_output\"\n      - \"data:frequency_output\"\n\n\ntranslation_metadata:\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  translation_tool: \"claude-sonnet-4-6\"\n  translation_timestamp: \"2026-03-04T00:00:00Z\"\n  unmapped_fields:\n    - field_path: \"workflow_graph.integrity_hash\"\n      reason: >\n        SHA-256 computation requires Python execution. Marked PENDING. To compute, run the following\n        Python command: import json,hashlib; edges=sorted([edge_dicts],key=lambda e:e['edge_id']);\n        print(hashlib.sha256(json.dumps(edges,sort_keys=True,separators=(',',':')).encode()).hexdigest())\n        where edge_dicts are the five pc_edges entries with keys consumer, data_objects, edge_id,\n        pc_pattern, producer (values as defined in the pc_edges section of this document).\n    - field_path: \"metadata.source_commit\"\n      reason: \"Git commit hash unavailable without direct git access to the workflow repository directory.\"\n    - field_path: \"data_objects[*].estimated_size_hint\"\n      reason: \"VCF and tar.gz sizes depend on runtime input content; only order-of-magnitude estimates provided.\"\n  round_trip_gaps:\n    - field_path: \"tasks[*].description\"\n      note: \"Pegasus DAX (daxgen.py) has no per-job description field; descriptions are agent-inferred from source scripts.\"\n    - field_path: \"data_objects[*].description\"\n      note: \"Pegasus DAX has no data object description field; all descriptions are agent-inferred.\"\n    - field_path: \"execution_profiles\"\n      note: \"Pegasus DAX has no native execution profile concept; profiles are agent-proposed.\"\n    - field_path: \"io_behavioral_hints\"\n      note: \"Pegasus DAX has no I/O hint representation; all hints are agent-inferred from task script inspection.\"\n    - field_path: \"workflow_patterns\"\n      note: \"Pegasus DAX encodes dependencies but not pattern classification; patterns are agent-inferred from DAG topology.\"\n  quality_warnings:\n    - field_path: \"workflow_graph.integrity_hash\"\n      warning: \"Marked PENDING; must be computed and replaced before WDD is used by downstream agents.\"\n    - field_path: \"data_objects[data:individual_chunk_tar].estimated_size_hint\"\n      warning: \"Size estimate is vague; depends on number of SNP variants per chunk and compression ratio.\"\n  field_confidence_records:\n    - field_path: \"tasks[task:individuals].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of bin/individuals.py and daxgen.py job construction.\"\n      requires_human_review: false\n    - field_path: \"tasks[task:individuals_merge].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of bin/individuals_merge.py; extract-accumulate-recompress pattern is explicit.\"\n      requires_human_review: false\n    - field_path: \"tasks[task:sifting].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of bin/sifting.py; grep and regex filtering pipeline is explicit.\"\n      requires_human_review: false\n    - field_path: \"tasks[task:mutation_overlap].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of bin/mutation_overlap.py; O(N^2) pairwise loop and matplotlib output explicit.\"\n      requires_human_review: false\n    - field_path: \"tasks[task:frequency].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of bin/frequency.py; n_runs=1000, n_indiv=52, Counter-based accumulation explicit.\"\n      requires_human_review: false\n    - field_path: \"tasks[*].io_dominance\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        Inferred from I/O call density vs compute: individuals=io_bound (2504 file writes per chunk\n        before compression); individuals_merge=io_bound (extract and recompress cycle dominates);\n        sifting=balanced (grep I/O plus Python regex parse roughly balanced); mutation_overlap=balanced\n        (O(N^2) compute plus matplotlib output roughly balanced); frequency=compute_bound (1000 Monte\n        Carlo iterations dominate wall time over single archive read).\n      requires_human_review: false\n    - field_path: \"tasks[*].io_access_type\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        All task scripts import only Python standard library (open, tarfile, subprocess, numpy).\n        No mpi4py, h5py, or netCDF4 imports found in any script under bin/. Classified as python_serial.\n      requires_human_review: false\n    - field_path: \"tasks[*].restart_model\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        No checkpoint-read logic at task startup found in any script. No --resume or --restart flags\n        in any argparse definition. No skip-if-output-exists guards. All scripts overwrite outputs\n        deterministically given identical inputs. Classified as idempotent.\n      requires_human_review: false\n    - field_path: \"tasks[*].behavioral_notes\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of task source code, observing call sequences, data structure allocation, and file access patterns.\"\n      requires_human_review: false\n    - field_path: \"pc_edges[*].pc_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        Derived from daxgen.py job construction: chunk loop creates N individuals jobs per chromosome\n        (scatter), one merge job per chromosome consumes all chunk archives (n_to_1), then analysis\n        jobs indexed by (chromosome, population) consume all merged and sifted files (1_to_n broadcast).\n      requires_human_review: false\n    - field_path: \"workflow_patterns.primary_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        DAG topology clearly shows scatter (parallel individuals jobs) plus gather (individuals_merge\n        fan-in) plus broadcast to two terminal analysis tasks. No iteration or feedback loops present.\n      requires_human_review: false\n    - field_path: \"io_behavioral_hints[*]\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        All hints derived from static code inspection: small-file patterns from explicit file-create\n        counts; unnecessary serialization from compress-decompress sequences; data reuse from two\n        consumer tasks opening the same file per chromosome.\n      requires_human_review: false\n    - field_path: \"execution_profiles\"\n      confidence_level: \"medium\"\n      confidence_reason: \"[ASSUMPTION] Profile proposals based on task output_class and DAG stopping points. Scientist confirmation required for scientific relevance.\"\n      requires_human_review: true\n"}},{"tool_name":"Edit","tool_use_id":"toolu_011G5FqeGa7upUHoaf7DzgzF","tool_input":{"file_path":"/mnt/common/mtang11/scripts/workflow-representation-description/workflow_wdd/1000genome-wdd-claude-trial2.yaml","old_string":"python3 -c \"import json,hashlib; edges=[...]; print(hashlib.sha256(json.dumps(edges,sort_keys=True,separators=(',',':')).encode()).hexdigest())\"","new_string":"schema_version: \"wrd-7.0\"\n\nmetadata:\n  workflow_lineage_id: \"wrd:1000genome\"\n  version: \"1.0.0\"\n  version_notes: \"Initial WDD compiled from daxgen.py and bin/ task scripts via static analysis.\"\n  deprecated: false\n  workflow_name: \"1000genome\"\n  workflow_description: >\n    The 1000 Genomes workflow identifies mutational overlaps in human genomic data from the\n    1000 Genomes Project, processing VCF files for up to 22 chromosomes across 2504 individuals\n    from 26 global populations. It parses per-chromosome SNP variant files to extract\n    individual-level mutation records, annotates variants with SIFT pathogenicity scores from\n    VEP-annotated VCF files, merges parallel per-chunk outputs into per-chromosome archives,\n    and performs both pairwise mutation overlap analysis and Monte Carlo-based allele frequency\n    analysis across user-specified population groups. Final outputs are statistical tables and\n    matplotlib visualizations of population-level mutation overlap distributions.\n  source_repository: \"workflows_repo/1000genome-workflow\"\n  source_commit: \"unknown\"\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  generated_by: \"claude-sonnet-4-6\"\n  generated_at: \"2026-03-04T00:00:00Z\"\n  last_modified_at: \"2026-03-04T00:00:00Z\"\n\n\nstages:\n  - stage_id: \"stage:individuals_extraction\"\n    name: \"Individuals Extraction\"\n    order: 1\n    description: >\n      Parallel extraction of per-individual mutation records from chromosome VCF files.\n      Each job processes a non-overlapping line-range chunk of a VCF file, writing one\n      text file per individual and compressing the results into a tar.gz archive.\n    tasks:\n      - \"task:individuals\"\n\n  - stage_id: \"stage:merge_and_sifting\"\n    name: \"Merge and Sifting\"\n    order: 2\n    description: >\n      Two independent sub-operations run concurrently: (1) individuals_merge fans in\n      all per-chunk archives into a single per-chromosome tarball; (2) sifting extracts\n      SIFT pathogenicity scores from VEP-annotated VCF files per chromosome.\n    tasks:\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n\n  - stage_id: \"stage:population_analysis\"\n    name: \"Population Analysis\"\n    order: 3\n    description: >\n      Two independent terminal analysis tasks consume merged individual archives and sifted\n      score files: mutation_overlap performs pairwise O(N^2) overlap analysis, and frequency\n      runs 1000 Monte Carlo iterations to estimate allele frequency distributions.\n    tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n\n\ntasks:\n  - task_id: \"task:individuals\"\n    name: \"Individuals\"\n    stage: \"stage:individuals_extraction\"\n    executable: \"bin/individuals.py\"\n    description: >\n      Parses a chunk of a chromosome VCF file (defined by start and stop line indices)\n      and extracts allele calls for all 2504 individuals using a columns mapping file.\n      For each individual it selects SNP records where the allele frequency criterion\n      is met, writes one text file per individual to a temporary directory, then compresses\n      all individual files into a tar.gz archive named chr{C}n-{start}-{stop}.tar.gz.\n      This task exists to produce per-individual mutation sets that downstream analysis\n      tasks compare across populations.\n    behavioral_notes: >\n      Reads the entire VCF chunk (up to 250000 lines) into memory via readfile() before\n      processing. Writes 2504 individual text files to a local directory (significant\n      metadata pressure on shared filesystems), then calls tarfile.open() to compress\n      the directory. The temporary per-individual directory is removed after compression.\n      Access pattern: sequential read of VCF lines, one-pass write per individual file,\n      then single-pass tar+gzip compression.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One Pegasus job per (chromosome, chunk) pair. Chunks are non-overlapping line\n        ranges computed by daxgen.py from the total row count and ind_jobs parameter.\n        All chunk jobs are fully independent across chromosomes and across chunks of the\n        same chromosome.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:chromosome_vcf\"\n      - \"data:columns_txt\"\n    outputs:\n      - \"data:individual_chunk_tar\"\n\n  - task_id: \"task:individuals_merge\"\n    name: \"Individuals Merge\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/individuals_merge.py\"\n    description: >\n      Merges all per-chunk individual mutation archives for a single chromosome into\n      one unified per-chromosome tar.gz archive (chr{C}n.tar.gz). It sequentially\n      extracts each chunk tarball into a temporary directory, accumulates individual\n      file contents across chunks, writes merged files to a merged_chr{C}/ directory,\n      then compresses the result. This task exists to reunify chromosome data that was\n      split across parallel individuals jobs for downstream consumption by analysis tasks.\n    behavioral_notes: >\n      Processes chunk tarballs one at a time in sequence; uses tempfile.TemporaryDirectory\n      for intermediate extraction state. Appends content of same-named individual files\n      across chunks in memory (data dict), then writes merged files sequentially.\n      Extract-then-recompress pattern causes transient disk amplification: merged_chr{C}/\n      can equal the uncompressed size of all input chunks before recompression.\n      Access pattern: sequential read of each chunk tarball, full-file append in memory,\n      sequential write of merged files, then single-pass tar+gzip.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One Pegasus job per chromosome. Each merge job is independent of other chromosomes.\n        Pegasus dependency enforces completion of all chunk jobs for a chromosome before\n        the corresponding merge job starts.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:individual_chunk_tar\"\n    outputs:\n      - \"data:merged_chromosome_tar\"\n\n  - task_id: \"task:sifting\"\n    name: \"Sifting\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/sifting.py\"\n    description: >\n      Extracts SIFT pathogenicity scores from a per-chromosome VEP-annotated VCF file.\n      Uses subprocess grep to pre-filter lines containing deleterious or tolerated\n      annotations, then Python regex to retain only SNP records with rs IDs.\n      Parses line number, rs number, ENSEMBL gene ID, SIFT score, and phenotype\n      into a compact text file sifted.SIFT.chr{C}.txt. This task provides the\n      variant-level SIFT annotations required by both downstream analysis tasks to\n      filter mutations by pathogenicity.\n    behavioral_notes: >\n      Reads the full VEP annotation VCF into memory, then launches a subprocess grep\n      (shell=True) for fast line pre-filtering; writes grep output to a temporary\n      SIFT.chr{C}.vcf before reading it back into Python. Deletes the temporary file\n      after processing. Two full-file reads (original VCF for header count, grep output)\n      and one write of the compact sifted result. Grep subprocess introduces one\n      process-spawn overhead per chromosome; grep operates on the full file sequentially.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One Pegasus job per chromosome annotation VCF. Fully independent of the\n        individuals processing path; runs concurrently with task:individuals_merge\n        within stage:merge_and_sifting.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:annotation_vcf\"\n    outputs:\n      - \"data:sifted_chr_txt\"\n\n  - task_id: \"task:mutation_overlap\"\n    name: \"Mutation Overlap\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/mutation_overlap.py\"\n    description: >\n      Performs exhaustive pairwise mutation set intersection analysis over all individuals\n      in a specified population for a given chromosome. Reads merged individual mutation\n      archives, intersects each individual's SNP set against the SIFT-scored variant list,\n      then computes all O(N^2) pairwise overlaps plus half-matrix and random-pair variants.\n      Generates text statistics files and matplotlib colormap and histogram plots.\n      Outputs are packaged in chr{C}-{POP}.tar.gz. This task provides population-level\n      mutation overlap distributions for rigorous statistical evaluation of disease-related\n      mutations.\n    behavioral_notes: >\n      Untars the merged chromosome archive into memory at startup. Reads population ID\n      list from population file and columns.txt to intersect individual identifiers.\n      Builds mutation_index_array in memory (one list of rs numbers per individual);\n      all O(N^2) pair comparisons run in Python loops with set intersection.\n      Memory footprint scales with n_individuals times avg_mutations_per_individual.\n      Matplotlib plot generation at the end adds a CPU and disk tail. Writes multiple\n      text files per run before packaging all into a tar.gz. Access pattern: full\n      archive read at start, compute-heavy in-memory phase, then sequential write\n      of multiple output files, final tar.gz creation.\n    parallelism_model:\n      type: \"serial\"\n      description: >\n        One Pegasus job per (chromosome, population) pair. Internal computation is\n        single-threaded Python. No MPI or GPU parallelism observed in static analysis.\n        The O(N^2) pairwise loop is not parallelized within the script.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"checkpoint\"\n    inputs:\n      - \"data:merged_chromosome_tar\"\n      - \"data:sifted_chr_txt\"\n      - \"data:population_file\"\n      - \"data:columns_txt\"\n    outputs:\n      - \"data:mutation_overlap_output\"\n\n  - task_id: \"task:frequency\"\n    name: \"Frequency\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/frequency.py\"\n    description: >\n      Estimates allele frequency distributions using 1000 Monte Carlo iterations over\n      merged individual mutation archives and SIFT score files for a given chromosome\n      and population. Each iteration samples n_indiv=52 random individuals and counts\n      mutation overlap frequencies using Counter-based multiset accumulation.\n      Writes per-iteration text histogram files and random-individual lists, generates\n      histogram bar plots per iteration, and packages results in chr{C}-{POP}-freq.tar.gz.\n      This task provides the null distribution for statistical evaluation of mutation\n      overlap patterns compared to task:mutation_overlap results.\n    behavioral_notes: >\n      Untars merged chromosome archive at module-level import time (before class definitions),\n      then reads population and SIFT files. All 1000 Monte Carlo iterations run serially\n      in a single Python process; random sampling uses Python's built-in random module.\n      Writes 1000 histogram files and 1000 random-individual files to output directories;\n      this creates significant small-file I/O pressure (2000+ file creates per job).\n      Matplotlib plot generation runs per iteration (1000 plt.savefig() calls).\n      Access pattern: single full-archive read at startup, compute-dominant loop,\n      many sequential writes of small files.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One Pegasus job per (chromosome, population) pair. Internally the 1000 Monte\n        Carlo runs execute serially; they are logically embarrassingly parallel but not\n        split by the reference implementation. Could be parallelized externally.\n    io_dominance: \"compute_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"checkpoint\"\n    inputs:\n      - \"data:merged_chromosome_tar\"\n      - \"data:sifted_chr_txt\"\n      - \"data:population_file\"\n      - \"data:columns_txt\"\n    outputs:\n      - \"data:frequency_output\"\n\n\ndata_objects:\n  - data_id: \"data:chromosome_vcf\"\n    name: \"Chromosome VCF\"\n    description: >\n      Per-chromosome input VCF file from the 1000 Genomes Project Phase 3 dataset\n      (e.g., ALL.chr1.250000.vcf). Contains approximately 250000 SNP variant records\n      with genotype calls for all 2504 individuals across 26 populations.\n      Each row encodes one SNP position; columns 9 onward hold individual genotype\n      fields encoding allele calls. Used by task:individuals to extract per-individual\n      mutation sets per chromosome chunk.\n    category: \"input\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"unknown; 250000-line VCF with 2504 individual columns is likely ~500 MB-2 GB per chromosome\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:individuals\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:individuals\"\n      retention_window: \"external input; retained across workflow\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 1\n\n  - data_id: \"data:columns_txt\"\n    name: \"Columns Text File\"\n    description: >\n      Single tab-delimited text file (columns.txt) mapping VCF column indices to 2504\n      individual sample identifiers. Contains one header row listing sample IDs starting\n      at column index 9. Used by task:individuals to derive per-individual output filenames\n      and by task:mutation_overlap and task:frequency to intersect population lists with\n      genome column identifiers. This config file is read-only throughout the workflow.\n    category: \"config\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"1 file (single global config)\"\n    cardinality_source:\n      type: \"fixed\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"n/a\"\n    estimated_size_hint: \"small; one row of 2504 tab-separated sample IDs, likely ~50-100 KB\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:individuals\"\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"external config; retained across workflow\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 3\n\n  - data_id: \"data:annotation_vcf\"\n    name: \"VEP Annotation VCF\"\n    description: >\n      Per-chromosome VEP-annotated VCF file containing functional consequence predictions\n      for all Phase 3 SNP variants. INFO field column 8 contains pipe-delimited VEP\n      annotations including SIFT scores and ENSEMBL gene IDs.\n      Used exclusively by task:sifting to extract variant-level SIFT pathogenicity data.\n    category: \"input\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"unknown; VEP annotation VCFs are larger than base VCFs due to INFO field expansion, likely ~1-10 GB per chromosome\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:sifting\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:sifting\"\n      retention_window: \"external input; retained across workflow\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:population_file\"\n    name: \"Population File\"\n    description: >\n      Per-population text files listing the sample IDs belonging to each of the 7 population\n      groups in the 1000 Genomes Project (ALL, EUR, EAS, AFR, AMR, SAS, GBR). Each file\n      contains one sample ID per line. Used by task:mutation_overlap and task:frequency to\n      filter the analysis to individuals belonging to a specific population before computing\n      mutation overlap statistics and frequency distributions.\n    category: \"input\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"7 files (one per population: ALL, EUR, EAS, AFR, AMR, SAS, GBR)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data/populations/\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"small; each file contains 91-2504 sample IDs, likely less than 100 KB each\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"external input; retained across workflow\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 2\n\n  - data_id: \"data:individual_chunk_tar\"\n    name: \"Individual Chunk Tar Archive\"\n    description: >\n      Per-(chromosome, chunk) tar.gz archive produced by task:individuals, containing one\n      text file per individual (2504 files) with mutation records for the SNP positions in\n      the assigned chunk line range. Each individual file lists rs number, position,\n      reference and alternate alleles, and allele frequency for SNPs where the individual\n      carries the minor allele. Consumed exclusively by task:individuals_merge to build\n      the complete per-chromosome individual mutation archive.\n    category: \"intermediate\"\n    persistence: \"stage_scoped\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"config-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"ind_jobs\"\n      config_file: \"daxgen.py\"\n      possible_values: \"any positive integer dividing the chromosome row count (default 1 per chromosome)\"\n    estimated_size_hint: \"unknown; size per chunk scales with chunk size divided by total VCF rows; likely tens to hundreds of MB per chunk\"\n    producer_task: \"task:individuals\"\n    consumer_tasks:\n      - \"task:individuals_merge\"\n    lifecycle:\n      creation_phase: \"task:individuals\"\n      last_consumer_phase: \"task:individuals_merge\"\n      retention_window: \"from task:individuals completion to task:individuals_merge completion (per chromosome)\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:merged_chromosome_tar\"\n    name: \"Merged Chromosome Tar Archive\"\n    description: >\n      Complete per-chromosome tar.gz archive produced by task:individuals_merge by merging\n      all per-chunk individual mutation archives for one chromosome. Contains 2504 individual\n      text files with complete mutation records across all SNP positions in that chromosome.\n      Consumed by both task:mutation_overlap and task:frequency as the primary source of\n      individual-level mutation data for downstream analyses across all populations.\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"unknown; contains all mutations across all chunks for one chromosome; likely hundreds of MB to several GB per chromosome\"\n    producer_task: \"task:individuals_merge\"\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: \"task:individuals_merge\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:individuals_merge completion to task:frequency completion (full workflow duration)\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 2\n\n  - data_id: \"data:sifted_chr_txt\"\n    name: \"Sifted Chromosome SIFT Text File\"\n    description: >\n      Per-chromosome text file produced by task:sifting, containing space-delimited records\n      for all SNP variants with SIFT pathogenicity annotations. Each row encodes line number,\n      rs ID, ENSEMBL gene ID, SIFT score, and phenotype. Only variants with both rs IDs and\n      SIFT annotations are retained. Consumed by both task:mutation_overlap and task:frequency\n      to filter individual mutations to SIFT-annotated variants for population-level overlap\n      analysis.\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"medium; subset of VEP annotation VCF with 5 extracted fields per variant; likely tens of MB per chromosome\"\n    producer_task: \"task:sifting\"\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: \"task:sifting\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:sifting completion to task:frequency completion (full workflow duration)\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 2\n\n  - data_id: \"data:mutation_overlap_output\"\n    name: \"Mutation Overlap Output Archive\"\n    description: >\n      Per-(chromosome, population) tar.gz archive produced by task:mutation_overlap, containing\n      text statistics files (pairwise overlap counts, half-matrix overlaps, gene pair counts,\n      random pair overlaps, per-individual total mutations, variant-to-ENSEMBL-ID map) and\n      matplotlib PNG plots (colormap, half-distribution, total-distribution, random-distribution).\n      Represents the primary scientific result of mutation set overlap analysis for a\n      chromosome-population combination.\n    category: \"output\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"medium; multiple text statistics files plus PNG plots per chromosome-population pair; likely tens to hundreds of MB\"\n    producer_task: \"task:mutation_overlap\"\n    consumer_tasks: []\n    lifecycle:\n      creation_phase: \"task:mutation_overlap\"\n      last_consumer_phase: \"task:mutation_overlap\"\n      retention_window: \"created at task:mutation_overlap completion; final output retained indefinitely\"\n      access_frequency_class: \"once\"\n      consumer_count: 0\n\n  - data_id: \"data:frequency_output\"\n    name: \"Frequency Analysis Output Archive\"\n    description: >\n      Per-(chromosome, population) tar.gz archive produced by task:frequency, containing 1000\n      per-iteration text files of mutation overlap histograms, 1000 mutation overlap count files,\n      1000 random individual selection files, 1000 histogram bar plot PNGs, and variation-to-ENSEMBL-ID\n      and mutation index array files. Represents the Monte Carlo frequency null distribution output\n      for statistical evaluation of mutation overlap significance.\n    category: \"output\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"tar\"\n      datasets: []\n      compression: \"gzip\"\n      layout_hint: \"unknown\"\n      typical_request_size_kb: null\n    cardinality: \"runtime-determined (see cardinality_source)\"\n    cardinality_source:\n      type: \"runtime_determined\"\n      controlling_parameter: null\n      config_file: \"data.csv\"\n      possible_values: \"runtime-determined\"\n    estimated_size_hint: \"medium; 3000+ small text files and 1000 PNG plots per chromosome-population pair; likely hundreds of MB\"\n    producer_task: \"task:frequency\"\n    consumer_tasks: []\n    lifecycle:\n      creation_phase: \"task:frequency\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"created at task:frequency completion; final output retained indefinitely\"\n      access_frequency_class: \"once\"\n      consumer_count: 0\n\n\npc_edges:\n  - edge_id: \"pc:individuals->individuals_merge:n_to_1\"\n    producer: \"task:individuals\"\n    consumer: \"task:individuals_merge\"\n    data_objects:\n      - \"data:individual_chunk_tar\"\n    pc_pattern: \"n_to_1\"\n    pc_pattern_rationale: >\n      Multiple parallel individuals jobs (one per chunk) each produce one chunk tar.gz;\n      a single individuals_merge job per chromosome consumes all chunk archives for that\n      chromosome. Fan-in per chromosome: N chunk producers to 1 merge consumer.\n    data_flow_description: >\n      Each individuals job writes one tar.gz archive to shared scratch. The merge job\n      receives all N chunk filenames as CLI arguments and reads each archive sequentially\n      (full read, no partial access).\n    coupling: \"tight\"\n    coupling_rationale: >\n      The individuals_merge script opens chunk tarballs via tarfile.open() only after\n      Pegasus dependency enforcement ensures all producers have completed. No streaming\n      or polling behavior; merge waits for all chunk archives to be fully written.\n    communication_pattern: \"file_per_producer\"\n    data_volume_class: \"large\"\n\n  - edge_id: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:merged_chromosome_tar\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One individuals_merge job per chromosome produces one merged tar.gz. Multiple\n      mutation_overlap jobs (one per chromosome-population pair) each consume the merged\n      archive for their chromosome. One producer to N consumer instances across all\n      populations for that chromosome.\n    data_flow_description: >\n      mutation_overlap opens the merged chromosome tar.gz via tarfile.open().extractall()\n      at startup, extracting all 2504 individual files into a local directory. Full archive\n      read at task start; no partial or streaming access.\n    coupling: \"tight\"\n    coupling_rationale: >\n      mutation_overlap reads merged archives after Pegasus dependency ensures completion\n      of individuals_merge. tarfile.open() call at script top-level confirms full-file\n      dependency before any computation begins.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"large\"\n\n  - edge_id: \"pc:individuals_merge->frequency:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:merged_chromosome_tar\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One individuals_merge job per chromosome produces one merged tar.gz. Multiple\n      frequency jobs (one per chromosome-population pair) each consume the merged archive\n      for their chromosome. Same broadcast structure as the mutation_overlap consumers.\n    data_flow_description: >\n      frequency.py opens the merged chromosome tar.gz via tarfile.open().extractall()\n      at module-level (before class definitions), extracting all 2504 individual files.\n      Full archive read at task start before any Monte Carlo iterations begin.\n    coupling: \"tight\"\n    coupling_rationale: >\n      The tarfile.open() call at module-level in frequency.py executes before any\n      function definitions, enforcing full-archive availability. Pegasus dependency\n      ensures individuals_merge completion before frequency starts.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"large\"\n\n  - edge_id: \"pc:sifting->mutation_overlap:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:mutation_overlap\"\n    data_objects:\n      - \"data:sifted_chr_txt\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One sifting job per chromosome produces one sifted SIFT text file. Multiple\n      mutation_overlap jobs (one per chromosome-population pair) each consume the sifted\n      file for their chromosome. One producer to N consumer instances.\n    data_flow_description: >\n      mutation_overlap.read_rs_numbers() opens sifted_chr_txt sequentially and reads all\n      records into memory (rs_numbers list and map_variations dict). Full sequential read;\n      no partial access or random seeks observed.\n    coupling: \"tight\"\n    coupling_rationale: >\n      mutation_overlap reads the sifted file via open() after Pegasus dependency ensures\n      sifting completion. File is consumed in full at task startup.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"small\"\n\n  - edge_id: \"pc:sifting->frequency:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:frequency\"\n    data_objects:\n      - \"data:sifted_chr_txt\"\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: >\n      One sifting job per chromosome produces one sifted SIFT text file. Multiple\n      frequency jobs (one per chromosome-population pair) each consume the sifted file\n      for their chromosome. Mirror of the sifting->mutation_overlap edge.\n    data_flow_description: >\n      frequency.read_rs_numbers() opens sifted_chr_txt sequentially and reads all records\n      into rs_numbers list and map_variations dict. Full file read at task startup before\n      Monte Carlo iterations begin.\n    coupling: \"tight\"\n    coupling_rationale: >\n      frequency.py reads the sifted file via open() at startup before any iteration logic.\n      Pegasus dependency ensures sifting completion before frequency starts.\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"small\"\n\n\nworkflow_graph:\n  integrity_hash: \"PENDING\"\n  last_generated: \"2026-03-04T00:00:00Z\"\n  dag_edges:\n    - from: \"task:individuals\"\n      to: \"task:individuals_merge\"\n      via: \"pc:individuals->individuals_merge:n_to_1\"\n    - from: \"task:individuals_merge\"\n      to: \"task:mutation_overlap\"\n      via: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    - from: \"task:individuals_merge\"\n      to: \"task:frequency\"\n      via: \"pc:individuals_merge->frequency:1_to_n\"\n    - from: \"task:sifting\"\n      to: \"task:mutation_overlap\"\n      via: \"pc:sifting->mutation_overlap:1_to_n\"\n    - from: \"task:sifting\"\n      to: \"task:frequency\"\n      via: \"pc:sifting->frequency:1_to_n\"\n  loop_groups: []\n  critical_path_hint: >\n    Longest sequential chain: task:individuals (parallel, approximately 81% of wall time per README)\n    -> task:individuals_merge -> task:mutation_overlap. Sifting is short (approximately 6 seconds per\n    README) and off the critical path. Critical path length is runtime-determined by chromosome count\n    and chunk count.\n  control_flow:\n    has_iteration: false\n    iteration_description: null\n    has_conditional_branches: true\n    conditional_description: >\n      daxgen.py selects different execution paths via CLI flags: --decaf enables Decaf in-memory MPI\n      dataflow (uses individuals_mpi.py and individuals_merge_mpi.py); --pmc enables Pegasus MPI\n      Cluster mode. These are deployment-mode switches not workflow-logic branches. The core DAG\n      topology is unchanged between modes. [ASSUMPTION] Treating default Pegasus path as canonical WDD.\n  stage_execution_order:\n    - \"stage:individuals_extraction\"\n    - \"stage:merge_and_sifting\"\n    - \"stage:population_analysis\"\n  cross_reference:\n    task_to_stage:\n      \"task:individuals\": \"stage:individuals_extraction\"\n      \"task:individuals_merge\": \"stage:merge_and_sifting\"\n      \"task:sifting\": \"stage:merge_and_sifting\"\n      \"task:mutation_overlap\": \"stage:population_analysis\"\n      \"task:frequency\": \"stage:population_analysis\"\n    data_to_producer:\n      \"data:chromosome_vcf\": null\n      \"data:columns_txt\": null\n      \"data:annotation_vcf\": null\n      \"data:population_file\": null\n      \"data:individual_chunk_tar\": \"task:individuals\"\n      \"data:merged_chromosome_tar\": \"task:individuals_merge\"\n      \"data:sifted_chr_txt\": \"task:sifting\"\n      \"data:mutation_overlap_output\": \"task:mutation_overlap\"\n      \"data:frequency_output\": \"task:frequency\"\n    data_to_consumers:\n      \"data:chromosome_vcf\": [\"task:individuals\"]\n      \"data:columns_txt\": [\"task:individuals\", \"task:mutation_overlap\", \"task:frequency\"]\n      \"data:annotation_vcf\": [\"task:sifting\"]\n      \"data:population_file\": [\"task:mutation_overlap\", \"task:frequency\"]\n      \"data:individual_chunk_tar\": [\"task:individuals_merge\"]\n      \"data:merged_chromosome_tar\": [\"task:mutation_overlap\", \"task:frequency\"]\n      \"data:sifted_chr_txt\": [\"task:mutation_overlap\", \"task:frequency\"]\n      \"data:mutation_overlap_output\": []\n      \"data:frequency_output\": []\n\n\nworkflow_patterns:\n  primary_pattern: \"scatter_gather\"\n  secondary_patterns:\n    - \"broadcast\"\n  classification_rationale: >\n    The dominant structural pattern is scatter-gather: per-chromosome VCF input is scattered\n    across embarrassingly parallel individuals jobs (one per chunk), then gathered by\n    individuals_merge (fan-in, n_to_1 edge). The sifting path is an independent parallel\n    branch producing per-chromosome SIFT data. After gather, merged archives and sifted files\n    are broadcast (1_to_n) to two independent terminal analysis tasks (mutation_overlap and\n    frequency) for each chromosome-population pair. No iteration or feedback loops present;\n    the DAG is strictly acyclic. The broadcast secondary pattern reflects shared consumption\n    of merged archives and sifted files by both analysis tasks.\n  pattern_table_row: >\n    1000genome | 3 stages | task:individuals:N*C + task:individuals_merge:C + task:sifting:C +\n    task:mutation_overlap:C*P + task:frequency:C*P | n_to_1 (chunk->merge), 1_to_n\n    (merge->analysis, sifting->analysis) | scatter_gather + broadcast\n\n\nio_behavioral_hints:\n  - hint_id: \"hint:small_file_overhead_individuals\"\n    description: >\n      task:individuals writes 2504 individual text files to a local directory per\n      (chromosome, chunk) job before compressing them into a tar.gz archive.\n      On shared POSIX filesystems this generates 2504 file-create metadata operations\n      per job; at 10 chromosomes times N chunks this scales to many thousands of metadata\n      operations total. This is a classic small-file overhead pattern on HPC parallel\n      filesystems (Lustre, GPFS) where metadata server operations are the bottleneck.\n      Node-local storage or burst buffer staging for the temporary individual files\n      would significantly reduce metadata pressure.\n    affected_tasks:\n      - \"task:individuals\"\n    affected_data:\n      - \"data:individual_chunk_tar\"\n    potential_concern: \"small_file_overhead\"\n\n  - hint_id: \"hint:unnecessary_serialization_chunk_merge\"\n    description: >\n      task:individuals compresses per-individual files into a tar.gz archive,\n      which task:individuals_merge immediately decompresses, accumulates in memory,\n      then recompresses into a merged tar.gz. This extract-then-recompress cycle is\n      unnecessary serialization: intermediate chunk tarballs exist solely to transport\n      data from parallel individuals jobs to the merge job, and content is fully\n      decompressed in memory during merging. The Decaf in-memory MPI path in the\n      repository demonstrates awareness of this issue. Eliminating the intermediate\n      tar.gz would remove two compression and decompression passes per chunk.\n    affected_tasks:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n    affected_data:\n      - \"data:individual_chunk_tar\"\n    potential_concern: \"unnecessary_serialization\"\n\n  - hint_id: \"hint:data_reuse_merged_chromosome_tar\"\n    description: >\n      data:merged_chromosome_tar is consumed by both task:mutation_overlap and\n      task:frequency for each chromosome, requiring each downstream task to independently\n      extract the same tar.gz archive. The same large archive (potentially hundreds of MB\n      to several GB) is read and decompressed twice per chromosome. Pre-staging merged\n      archives on fast storage (burst buffer, node-local SSD) before stage:population_analysis\n      would benefit both consumers.\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:merged_chromosome_tar\"\n    potential_concern: \"data_reuse\"\n\n  - hint_id: \"hint:data_reuse_sifted_chr_txt\"\n    description: >\n      data:sifted_chr_txt is consumed by both task:mutation_overlap and task:frequency\n      for each chromosome, resulting in two independent sequential reads of the same file\n      per chromosome. Co-locating sifted files with merged archives on fast storage\n      eliminates redundant remote reads for both consumers.\n    affected_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    affected_data:\n      - \"data:sifted_chr_txt\"\n    potential_concern: \"data_reuse\"\n\n  - hint_id: \"hint:small_file_overhead_frequency_output\"\n    description: >\n      task:frequency writes 1000 histogram text files, 1000 mutation overlap text files,\n      and 1000 random-individual text files per (chromosome, population) job before\n      packaging into a tar.gz. Additionally 1000 matplotlib PNG plots are saved via\n      plt.savefig(). Total approximately 3000 file creates per chromosome-population job.\n      Aggregating iteration results in memory and writing fewer larger files would reduce\n      metadata overhead substantially on parallel filesystems.\n    affected_tasks:\n      - \"task:frequency\"\n    affected_data:\n      - \"data:frequency_output\"\n    potential_concern: \"small_file_overhead\"\n\n  - hint_id: \"hint:unnecessary_serialization_sifting_temp_file\"\n    description: >\n      task:sifting uses subprocess.run(shell=True) to invoke grep on the full VEP annotation\n      VCF, writing intermediate output to SIFT.chr{C}.vcf before reading it back into Python.\n      This introduces one full-file write plus one full-file read of the intermediate file per\n      chromosome. The intermediate file is deleted after use via os.remove(). The grep output\n      could be piped directly to Python via subprocess.PIPE, eliminating the temporary file\n      and one write-then-read cycle.\n    affected_tasks:\n      - \"task:sifting\"\n    affected_data:\n      - \"data:sifted_chr_txt\"\n    potential_concern: \"unnecessary_serialization\"\n\n\nexecution_profiles:\n  - profile_name: \"sifting_only\"\n    terminal_task_id: \"task:sifting\"\n    description: >\n      Run only the VEP annotation extraction path to produce SIFT score files per chromosome.\n      Useful for pre-computing sifted files that can be reused across multiple population\n      analysis runs without re-executing the individuals extraction and merge pipeline.\n    required_task_set:\n      - \"task:sifting\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:sifted_chr_txt\"\n\n  - profile_name: \"individuals_only\"\n    terminal_task_id: \"task:individuals_merge\"\n    description: >\n      Run through the individuals extraction and merge stages to produce complete per-chromosome\n      merged individual mutation archives. Useful for pre-computing merged archives that can be\n      reused across multiple analysis runs targeting different population subsets.\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n    conditional_inclusions:\n      - task_id: \"task:individuals_merge\"\n        condition: \"param:ind_jobs > 1\"\n    output_dataset_ids: []\n\n  - profile_name: \"mutation_overlap_only\"\n    terminal_task_id: \"task:mutation_overlap\"\n    description: >\n      Run the complete pipeline through pairwise mutation overlap analysis, producing\n      overlap statistics and plots for each chromosome-population pair. Skips Monte Carlo\n      frequency analysis. Suitable for initial exploration of population-level mutation\n      overlap patterns before committing to the more compute-intensive frequency runs.\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n      - \"task:mutation_overlap\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:mutation_overlap_output\"\n\n  - profile_name: \"full\"\n    terminal_task_id: \"task:frequency\"\n    description: >\n      Complete workflow execution including both pairwise mutation overlap analysis and Monte\n      Carlo allele frequency analysis. Produces all scientific outputs for downstream statistical\n      evaluation of disease-related mutation patterns.\n    required_task_set:\n      - \"task:individuals\"\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    conditional_inclusions: []\n    output_dataset_ids:\n      - \"data:mutation_overlap_output\"\n      - \"data:frequency_output\"\n\n\ntranslation_metadata:\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  translation_tool: \"claude-sonnet-4-6\"\n  translation_timestamp: \"2026-03-04T00:00:00Z\"\n  unmapped_fields:\n    - field_path: \"workflow_graph.integrity_hash\"\n      reason: >\n        SHA-256 computation requires Python execution. Marked PENDING. To compute, run:\n        python3 -c \"import json,hashlib; edges=sorted([{'consumer':'task:individuals_merge','data_objects':['data:individual_chunk_tar'],'edge_id':'pc:individuals->individuals_merge:n_to_1','pc_pattern':'n_to_1','producer':'task:individuals'},{'consumer':'task:frequency','data_objects':['data:merged_chromosome_tar'],'edge_id':'pc:individuals_merge->frequency:1_to_n','pc_pattern':'1_to_n','producer':'task:individuals_merge'},{'consumer':'task:mutation_overlap','data_objects':['data:merged_chromosome_tar'],'edge_id':'pc:individuals_merge->mutation_overlap:1_to_n','pc_pattern':'1_to_n','producer':'task:individuals_merge'},{'consumer':'task:frequency','data_objects':['data:sifted_chr_txt'],'edge_id':'pc:sifting->frequency:1_to_n','pc_pattern':'1_to_n','producer':'task:sifting'},{'consumer':'task:mutation_overlap','data_objects':['data:sifted_chr_txt'],'edge_id':'pc:sifting->mutation_overlap:1_to_n','pc_pattern':'1_to_n','producer':'task:sifting'}],key=lambda e:e['edge_id']); print(hashlib.sha256(json.dumps(edges,sort_keys=True,separators=(',',':')).encode()).hexdigest())\"\n    - field_path: \"metadata.source_commit\"\n      reason: \"Git commit hash unavailable without direct git access to the workflow repository directory.\"\n    - field_path: \"data_objects[*].estimated_size_hint\"\n      reason: \"VCF and tar.gz sizes depend on runtime input content; only order-of-magnitude estimates provided.\"\n  round_trip_gaps:\n    - field_path: \"tasks[*].description\"\n      note: \"Pegasus DAX (daxgen.py) has no per-job description field; descriptions are agent-inferred from source scripts.\"\n    - field_path: \"data_objects[*].description\"\n      note: \"Pegasus DAX has no data object description field; all descriptions are agent-inferred.\"\n    - field_path: \"execution_profiles\"\n      note: \"Pegasus DAX has no native execution profile concept; profiles are agent-proposed.\"\n    - field_path: \"io_behavioral_hints\"\n      note: \"Pegasus DAX has no I/O hint representation; all hints are agent-inferred from task script inspection.\"\n    - field_path: \"workflow_patterns\"\n      note: \"Pegasus DAX encodes dependencies but not pattern classification; patterns are agent-inferred from DAG topology.\"\n  quality_warnings:\n    - field_path: \"workflow_graph.integrity_hash\"\n      warning: \"Marked PENDING; must be computed and replaced before WDD is used by downstream agents.\"\n    - field_path: \"data_objects[data:individual_chunk_tar].estimated_size_hint\"\n      warning: \"Size estimate is vague; depends on number of SNP variants per chunk and compression ratio.\"\n  field_confidence_records:\n    - field_path: \"tasks[task:individuals].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of bin/individuals.py and daxgen.py job construction.\"\n      requires_human_review: false\n    - field_path: \"tasks[task:individuals_merge].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of bin/individuals_merge.py; extract-accumulate-recompress pattern is explicit.\"\n      requires_human_review: false\n    - field_path: \"tasks[task:sifting].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of bin/sifting.py; grep and regex filtering pipeline is explicit.\"\n      requires_human_review: false\n    - field_path: \"tasks[task:mutation_overlap].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of bin/mutation_overlap.py; O(N^2) pairwise loop and matplotlib output explicit.\"\n      requires_human_review: false\n    - field_path: \"tasks[task:frequency].description\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of bin/frequency.py; n_runs=1000, n_indiv=52, Counter-based accumulation explicit.\"\n      requires_human_review: false\n    - field_path: \"tasks[*].io_dominance\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        Inferred from I/O call density vs compute: individuals=io_bound (2504 file writes per chunk\n        before compression); individuals_merge=io_bound (extract and recompress cycle dominates);\n        sifting=balanced (grep I/O plus Python regex parse roughly balanced); mutation_overlap=balanced\n        (O(N^2) compute plus matplotlib output roughly balanced); frequency=compute_bound (1000 Monte\n        Carlo iterations dominate wall time over single archive read).\n      requires_human_review: false\n    - field_path: \"tasks[*].io_access_type\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        All task scripts import only Python standard library (open, tarfile, subprocess, numpy).\n        No mpi4py, h5py, or netCDF4 imports found in any script under bin/. Classified as python_serial.\n      requires_human_review: false\n    - field_path: \"tasks[*].restart_model\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        No checkpoint-read logic at task startup found in any script. No --resume or --restart flags\n        in any argparse definition. No skip-if-output-exists guards. All scripts overwrite outputs\n        deterministically given identical inputs. Classified as idempotent.\n      requires_human_review: false\n    - field_path: \"tasks[*].behavioral_notes\"\n      confidence_level: \"high\"\n      confidence_reason: \"Derived from direct reading of task source code, observing call sequences, data structure allocation, and file access patterns.\"\n      requires_human_review: false\n    - field_path: \"pc_edges[*].pc_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        Derived from daxgen.py job construction: chunk loop creates N individuals jobs per chromosome\n        (scatter), one merge job per chromosome consumes all chunk archives (n_to_1), then analysis\n        jobs indexed by (chromosome, population) consume all merged and sifted files (1_to_n broadcast).\n      requires_human_review: false\n    - field_path: \"workflow_patterns.primary_pattern\"\n      confidence_level: \"high\"\n      confidence_reason: >\n        DAG topology clearly shows scatter (parallel individuals jobs) plus gather (individuals_merge\n        fan-in) plus broadcast to two terminal analysis tasks. No iteration or feedback loops present.\n      requires_human_review: false\n    - field_path: \"io_behavioral_hints[*]\"\n      confidence_level: \"medium\"\n      confidence_reason: >\n        All hints derived from static code inspection: small-file patterns from explicit file-create\n        counts; unnecessary serialization from compress-decompress sequences; data reuse from two\n        consumer tasks opening the same file per chromosome.\n      requires_human_review: false\n    - field_path: \"execution_profiles\"\n      confidence_level: \"medium\"\n      confidence_reason: \"[ASSUMPTION] Profile proposals based on task output_class and DAG stopping points. Scientist confirmation required for scientific relevance.\"\n      requires_human_review: true","replace_all":false}},{"tool_name":"Edit","tool_use_id":"toolu_01KK8DpnPC4HZWJrZJWLAu6s","tool_input":{"file_path":"/mnt/common/mtang11/scripts/workflow-representation-description/workflow_wdd/1000genome-wdd-claude-trial2.yaml","old_string":"python3 -c \"import json,hashlib; edges=[...]; print(hashlib.sha256(json.dumps(edges,sort_keys=True,separators=(',',':')).encode()).hexdigest())\"\n","new_string":"schema_version: \"wrd-7.0\"\n\nmetadata:\n  workflow_lineage_id: \"wrd:1000genome\"\n  version: \"1.0.0\"\n  version_notes: \"Initial WDD compiled from daxgen.py and bin/ task scripts via static analysis.\"\n  deprecated: false\n  workflow_name: \"1000genome\"\n  workflow_description: >\n    The 1000 Genomes workflow identifies mutational overlaps in human genomic data from the\n    1000 Genomes Project, processing VCF files for up to 22 chromosomes across 2504 individuals\n    from 26 global populations. It parses per-chromosome SNP variant files to extract\n    individual-level mutation records, annotates variants with SIFT pathogenicity scores from\n    VEP-annotated VCF files, merges parallel per-chunk outputs into per-chromosome archives,\n    and performs both pairwise mutation overlap analysis and Monte Carlo-based allele frequency\n    analysis across user-specified population groups. Final outputs are statistical tables and\n    matplotlib visualizations of population-level mutation overlap distributions.\n  source_repository: \"workflows_repo/1000genome-workflow\"\n  source_commit: \"unknown\"\n  source_format: \"compiled_from_pegasus_dax\"\n  source_file: \"daxgen.py\"\n  generated_by: \"claude-sonnet-4-6\"\n  generated_at: \"2026-03-04T00:00:00Z\"\n  last_modified_at: \"2026-03-04T00:00:00Z\"\n\n\nstages:\n  - stage_id: \"stage:individuals_extraction\"\n    name: \"Individuals Extraction\"\n    order: 1\n    description: >\n      Parallel extraction of per-individual mutation records from chromosome VCF files.\n      Each job processes a non-overlapping line-range chunk of a VCF file, writing one\n      text file per individual and compressing the results into a tar.gz archive.\n    tasks:\n      - \"task:individuals\"\n\n  - stage_id: \"stage:merge_and_sifting\"\n    name: \"Merge and Sifting\"\n    order: 2\n    description: >\n      Two independent sub-operations run concurrently: (1) individuals_merge fans in\n      all per-chunk archives into a single per-chromosome tarball; (2) sifting extracts\n      SIFT pathogenicity scores from VEP-annotated VCF files per chromosome.\n    tasks:\n      - \"task:individuals_merge\"\n      - \"task:sifting\"\n\n  - stage_id: \"stage:population_analysis\"\n    name: \"Population Analysis\"\n    order: 3\n    description: >\n      Two independent terminal analysis tasks consume merged individual archives and sifted\n      score files: mutation_overlap performs pairwise O(N^2) overlap analysis, and frequency\n      runs 1000 Monte Carlo iterations to estimate allele frequency distributions.\n    tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n\n\ntasks:\n  - task_id: \"task:individuals\"\n    name: \"Individuals\"\n    stage: \"stage:individuals_extraction\"\n    executable: \"bin/individuals.py\"\n    description: >\n      Parses a chunk of a chromosome VCF file (defined by start and stop line indices)\n      and extracts allele calls for all 2504 individuals using a columns mapping file.\n      For each individual it selects SNP records where the allele frequency criterion\n      is met, writes one text file per individual to a temporary directory, then compresses\n      all individual files into a tar.gz archive named chr{C}n-{start}-{stop}.tar.gz.\n      This task exists to produce per-individual mutation sets that downstream analysis\n      tasks compare across populations.\n    behavioral_notes: >\n      Reads the entire VCF chunk (up to 250000 lines) into memory via readfile() before\n      processing. Writes 2504 individual text files to a local directory (significant\n      metadata pressure on shared filesystems), then calls tarfile.open() to compress\n      the directory. The temporary per-individual directory is removed after compression.\n      Access pattern: sequential read of VCF lines, one-pass write per individual file,\n      then single-pass tar+gzip compression.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One Pegasus job per (chromosome, chunk) pair. Chunks are non-overlapping line\n        ranges computed by daxgen.py from the total row count and ind_jobs parameter.\n        All chunk jobs are fully independent across chromosomes and across chunks of the\n        same chromosome.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:chromosome_vcf\"\n      - \"data:columns_txt\"\n    outputs:\n      - \"data:individual_chunk_tar\"\n\n  - task_id: \"task:individuals_merge\"\n    name: \"Individuals Merge\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/individuals_merge.py\"\n    description: >\n      Merges all per-chunk individual mutation archives for a single chromosome into\n      one unified per-chromosome tar.gz archive (chr{C}n.tar.gz). It sequentially\n      extracts each chunk tarball into a temporary directory, accumulates individual\n      file contents across chunks, writes merged files to a merged_chr{C}/ directory,\n      then compresses the result. This task exists to reunify chromosome data that was\n      split across parallel individuals jobs for downstream consumption by analysis tasks.\n    behavioral_notes: >\n      Processes chunk tarballs one at a time in sequence; uses tempfile.TemporaryDirectory\n      for intermediate extraction state. Appends content of same-named individual files\n      across chunks in memory (data dict), then writes merged files sequentially.\n      Extract-then-recompress pattern causes transient disk amplification: merged_chr{C}/\n      can equal the uncompressed size of all input chunks before recompression.\n      Access pattern: sequential read of each chunk tarball, full-file append in memory,\n      sequential write of merged files, then single-pass tar+gzip.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One Pegasus job per chromosome. Each merge job is independent of other chromosomes.\n        Pegasus dependency enforces completion of all chunk jobs for a chromosome before\n        the corresponding merge job starts.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:individual_chunk_tar\"\n    outputs:\n      - \"data:merged_chromosome_tar\"\n\n  - task_id: \"task:sifting\"\n    name: \"Sifting\"\n    stage: \"stage:merge_and_sifting\"\n    executable: \"bin/sifting.py\"\n    description: >\n      Extracts SIFT pathogenicity scores from a per-chromosome VEP-annotated VCF file.\n      Uses subprocess grep to pre-filter lines containing deleterious or tolerated\n      annotations, then Python regex to retain only SNP records with rs IDs.\n      Parses line number, rs number, ENSEMBL gene ID, SIFT score, and phenotype\n      into a compact text file sifted.SIFT.chr{C}.txt. This task provides the\n      variant-level SIFT annotations required by both downstream analysis tasks to\n      filter mutations by pathogenicity.\n    behavioral_notes: >\n      Reads the full VEP annotation VCF into memory, then launches a subprocess grep\n      (shell=True) for fast line pre-filtering; writes grep output to a temporary\n      SIFT.chr{C}.vcf before reading it back into Python. Deletes the temporary file\n      after processing. Two full-file reads (original VCF for header count, grep output)\n      and one write of the compact sifted result. Grep subprocess introduces one\n      process-spawn overhead per chromosome; grep operates on the full file sequentially.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        One Pegasus job per chromosome annotation VCF. Fully independent of the\n        individuals processing path; runs concurrently with task:individuals_merge\n        within stage:merge_and_sifting.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:annotation_vcf\"\n    outputs:\n      - \"data:sifted_chr_txt\"\n\n  - task_id: \"task:mutation_overlap\"\n    name: \"Mutation Overlap\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/mutation_overlap.py\"\n    description: >\n      Performs exhaustive pairwise mutation set intersection analysis over all individuals\n      in a specified population for a given chromosome. Reads merged individual mutation\n      archives, intersects each individual's SNP set against the SIFT-scored variant list,\n      then computes all O(N^2) pairwise overlaps plus half-matrix and random-pair variants.\n      Generates text statistics files and matplotlib colormap and histogram plots.\n      Outputs are packaged in chr{C}-{POP}.tar.gz. This task provides population-level\n      mutation overlap distributions for rigorous statistical evaluation of disease-related\n      mutations.\n    behavioral_notes: >\n      Untars the merged chromosome archive into memory at startup. Reads population ID\n      list from population file and columns.txt to intersect individual identifiers.\n      Builds mutation_index_array in memory (one list of rs numbers per individual);\n      all O(N^2) pair comparisons run in Python loops with set intersection.\n      Memory footprint scales with n_individuals times avg_mutations_per_individual.\n      Matplotlib plot generation at the end adds a CPU and disk tail. Writes multiple\n      text files per run before packaging all into a tar.gz. Access pattern: full\n      archive read at start, compute-heavy in-memory phase, then sequential write\n      of multiple output files, final tar.gz creation.\n    parallelism_model:\n      type: \"serial\"\n      description: >\n        One Pegasus job per (chromosome, population) pair. Internal computation is\n        single-threaded Python. No MPI or GPU parallelism observed in static analysis.\n        The O(N^2) pairwise loop is not parallelized within the script.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"checkpoint\"\n    inputs:\n      - \"data:merged_chromosome_tar\"\n      - \"data:sifted_chr_txt\"\n      - \"data:population_file\"\n      - \"data:columns_txt\"\n    outputs:\n      - \"data:mutation_overlap_output\"\n\n  - task_id: \"task:frequency\"\n    name: \"Frequency\"\n    stage: \"stage:population_analysis\"\n    executable: \"bin/frequency.py\"\n    description: >\n      Estimates allele frequency distributions using 1000 Monte Carlo iterations over\n      merged individual mutation archives and SIFT score files for a given chromosome\n      and population. Each iteration samples n_indiv=52 random individuals and counts\n      mutation overlap frequencies using Counter-based multiset accumulation.\n      Writes per-iteration text histogram files and random-individual lists, generates\n      histogram bar plots per iteration, and packages results in chr{C}-{POP}-freq.tar.gz.\n      This task provides the null distribution for statistical evaluation of mutation\n      overlap patterns compared to task:mutation_overlap results.\n    behavioral_notes: >\n      Untars merged chromosome archive at module-level import time (before class definitions),\n      then reads population and SIFT files. All 1000 Monte Carlo iterations run serially\n      in a single Python process; random sampling uses Python's built-in random module.\n      Writes 1000 histogram files and 1000 random-individual files to output directories;\n      this creates significant