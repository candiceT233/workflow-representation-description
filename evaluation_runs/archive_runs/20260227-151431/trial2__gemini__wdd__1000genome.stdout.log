stages:
  - stage_id: "stage:data_preprocessing"
    name: "Data Preprocessing"
    order: 1
    description: "This stage fetches, parses, and processes raw 1000 Genomes VCF data into individual-specific mutation data for each chromosome segment."
    tasks: ["task:individuals"]
  - stage_id: "stage:data_aggregation_and_sifting"
    name: "Data Aggregation and Sifting"
    order: 2
    description: "This stage merges the individual-specific mutation data for each chromosome and sifts through annotated VCF files to extract SIFT scores for variants."
    tasks: ["task:individuals_merge", "task:sifting"]
  - stage_id: "stage:mutation_analysis_and_frequency"
    name: "Mutation Analysis and Frequency"
    order: 3
    description: "This stage analyzes mutation overlaps between individuals, computes overlap frequencies, and generates visualizations for both analysis types."
    tasks: ["task:mutation_overlap", "task:frequency"]

tasks:
  - task_id: "task:individuals"
    name: "Individuals"
    stage: "stage:data_preprocessing"
    executable: "individuals.py"
    description: "This task processes a segment of a chromosome's VCF (Variant Call Format) data. It reads lines from a VCF file, filters out comment lines, and then iterates through genetic variants to extract information for each individual. It performs filtering based on allele frequency (AF) and genotype. The extracted data for each individual is written to separate files within a temporary directory, which is then compressed into a tar.gz archive. This task aims to identify which individuals have specific mutations based on given criteria."
    behavioral_notes: "Reads a large VCF file segment, processes data in-memory, writes multiple small files per individual, and compresses them into a tar.gz archive. Deletes temporary files. Involves sequential reading and many small writes which are then aggregated."
    parallelism_model:
      type: "embarrassingly_parallel"
      description: "Each instance processes a distinct segment of a chromosome's VCF file independently and produces a separate compressed archive."
    io_dominance: "io_bound"
    io_access_type: "python_serial"
    restart_model: "idempotent"
    restart_checkpoint_dataset: null
    hardware_path:
      has_conditional_execution: false
      execution_alternatives: []
      minimum_resource_assertions: []
    output_class: "intermediate"
    inputs: ["data:raw_chromosome_vcf_segment", "data:columns_file"]
    outputs: ["data:individual_mutation_data_tar_gz_segment"]

  - task_id: "task:individuals_merge"
    name: "Individuals Merge"
    stage: "stage:data_aggregation_and_sifting"
    executable: "individuals_merge.py"
    description: "This task merges the tar.gz archive outputs from multiple 'individuals' tasks for a single chromosome. It extracts the contents of each input archive into a temporary directory, aggregates the individual-specific data across all segments, writes the merged data to new individual files, and then compresses these merged files into a new tar.gz archive for the entire chromosome. This aggregates all individual mutation data for a given chromosome."
    behavioral_notes: "Reads multiple tar.gz archives, extracts them, processes data in-memory, writes merged individual files, and compresses them into a single tar.gz file. Deletes temporary directories. This is a 'gather' operation, collecting results from many parallel 'individuals' tasks."
    parallelism_model:
      type: "serial"
      description: "Processes inputs for a single chromosome. It aggregates the outputs of multiple parallel 'individuals' tasks for that chromosome."
    io_dominance: "io_bound"
    io_access_type: "python_serial"
    restart_model: "idempotent"
    restart_checkpoint_dataset: null
    hardware_path:
      has_conditional_execution: false
      execution_alternatives: []
      minimum_resource_assertions: []
    output_class: "intermediate"
    inputs: ["data:individual_mutation_data_tar_gz_segment"]
    outputs: ["data:merged_individual_mutation_data_tar_gz"]

  - task_id: "task:sifting"
    name: "Sifting"
    stage: "stage:data_aggregation_and_sifting"
    executable: "sifting.py"
    description: "This task processes an annotated VCF file containing SIFT scores for a given chromosome. It filters lines that contain 'deleterious' or 'tolerated' annotations and also an 'rs' identifier. It then extracts specific fields (line number, rs ID, ENSG ID, SIFT score, and phenotype) and writes them to a tab-separated text file. This task extracts and formats the SIFT-related information for a chromosome."
    behavioral_notes: "Reads a large VCF file. Uses `subprocess.run` with `grep` for efficient filtering. Performs string parsing and manipulation. Writes a text file. Deletes intermediate files. Reads sequentially."
    parallelism_model:
      type: "embarrassingly_parallel"
      description: "Each instance processes a distinct annotated VCF file for a single chromosome independently."
    io_dominance: "io_bound"
    io_access_type: "python_serial"
    restart_model: "idempotent"
    restart_checkpoint_dataset: null
    hardware_path:
      has_conditional_execution: false
      execution_alternatives: []
      minimum_resource_assertions: []
    output_class: "intermediate"
    inputs: ["data:annotated_chromosome_vcf"]
    outputs: ["data:sifted_data_txt"]

  - task_id: "task:mutation_overlap"
    name: "Mutation Overlap"
    stage: "stage:mutation_analysis_and_frequency"
    executable: "mutation_overlap.py"
    description: "This task calculates and visualizes the overlap of mutations between individuals for a specific chromosome and population. It reads individual mutation data, sifting data, and population information. It performs various analyses, including identifying common mutations, creating overlap matrices, and generating plots (histograms, colormaps). Finally, it archives all generated output data and plots into a single tar.gz file."
    behavioral_notes: "Reads a merged tar.gz file (which is untarred), a SIFT text file, a population file, and a columns file. Uses `numpy` for numerical operations and `matplotlib` for plotting. Generates numerous data files and plot images, then re-archives them into a tar.gz. Heavy computation and I/O for plots and data files."
    parallelism_model:
      type: "embarrassingly_parallel"
      description: "Each instance processes a distinct chromosome's merged individual data and sifting data for a given population independently."
    io_dominance: "balanced"
    io_access_type: "python_serial"
    restart_model: "idempotent"
    restart_checkpoint_dataset: null
    hardware_path:
      has_conditional_execution: false
      execution_alternatives: []
      minimum_resource_assertions: []
    output_class: "output"
    inputs: ["data:merged_individual_mutation_data_tar_gz", "data:sifted_data_txt", "data:population_file", "data:columns_file"]
    outputs: ["data:mutation_overlap_analysis_tar_gz"]

  - task_id: "task:frequency"
    name: "Frequency"
    stage: "stage:mutation_analysis_and_frequency"
    executable: "frequency.py"
    description: "This task analyzes the frequency of overlapping mutations by randomly selecting individuals and counting all SNPs variants without considering SIFT scores. It reads individual mutation data, sifting data, and population information. It performs multiple runs to simulate random selections of individuals, calculates mutation overlaps for these random groups, generates histograms of the overlaps, and finally archives all generated output data and plots into a single tar.gz file."
    behavioral_notes: "Reads a merged tar.gz file (which is untarred), a SIFT text file, a population file, and a columns file. Uses `numpy` and `matplotlib`. Performs `n_runs` (1000 by default) simulations involving random sampling and computations. Generates numerous data files and plot images, then re-archives them into a tar.gz."
    parallelism_model:
      type: "embarrassingly_parallel"
      description: "Each instance processes a distinct chromosome's merged individual data and sifting data for a given population independently, performing 1000 simulations."
    io_dominance: "compute_bound"
    io_access_type: "python_serial"
    restart_model: "idempotent"
    restart_checkpoint_dataset: null
    hardware_path:
      has_conditional_execution: false
      execution_alternatives: []
      minimum_resource_assertions: []
