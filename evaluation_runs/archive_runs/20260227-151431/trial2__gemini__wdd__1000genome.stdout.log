workflow_patterns:
  primary_pattern: "hybrid"
  secondary_patterns: ["scatter_gather", "broadcast"]
  classification_rationale: "The workflow exhibits a hybrid pattern. The 'individuals' tasks operate in an embarrassingly parallel (scatter) fashion, followed by a 'individuals_merge' task that gathers their outputs. The outputs of 'individuals_merge' and 'sifting' are then broadcast to multiple instances of 'mutation_overlap' and 'frequency' tasks, which also operate in an embarrassingly parallel fashion per chromosome-population pair."
  pattern_table_row: "1000Genomes Workflow | 3 | Runtime-determined | N-to-1, 1-to-N | Large VCF reads, Many small file writes, tar/untar."

io_behavioral_hints:
  - hint_id: "hint:small_file_overhead_individuals"
    description: "The 'individuals' task generates many small files (one per individual per segment) which are then archived into a single tar.gz. While tar.gz mitigates the direct overhead, the intermediate creation of many small files can be inefficient for metadata operations on parallel file systems."
    affected_tasks: ["task:individuals"]
    affected_data: ["data:individual_mutation_data_tar_gz_segment"]
    potential_concern: "small_file_overhead"
  - hint_id: "hint:read_untar_overhead"
    description: "The 'individuals_merge', 'mutation_overlap', and 'frequency' tasks all read tar.gz archives and untar them before processing. This adds overhead for extraction and potential temporary storage usage compared to direct access if the data were not archived."
    affected_tasks: ["task:individuals_merge", "task:mutation_overlap", "task:frequency"]
    affected_data: ["data:individual_mutation_data_tar_gz_segment", "data:merged_individual_mutation_data_tar_gz"]
    potential_concern: "metadata_overhead"

execution_profiles:
