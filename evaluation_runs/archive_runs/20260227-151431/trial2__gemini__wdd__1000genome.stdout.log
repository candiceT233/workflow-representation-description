    description: "This profile represents the completion of the data aggregation and sifting stages. It produces merged individual mutation data archives for each chromosome and sifted variant data files, suitable for downstream analysis or as a checkpoint for the next stage."
    required_task_set: ["task:individuals", "task:individuals_merge", "task:sifting"]
    conditional_inclusions: []
    output_dataset_ids: ["data:merged_individual_mutation_data_tar_gz", "data:sifted_data_txt"]

