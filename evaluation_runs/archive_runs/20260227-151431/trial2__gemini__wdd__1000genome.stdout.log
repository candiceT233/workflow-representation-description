  - data_id: "data:mutation_overlap_analysis_tar_gz"
    name: "Mutation Overlap Analysis Archive"
    description: "A compressed tar.gz archive containing the results of the mutation overlap analysis for a specific chromosome and population. This includes various data files (e.g., overlap matrices, counts) and generated plot images (e.g., histograms, heatmaps)."
    category: "output"
