    estimated_size_hint: "~1-10 MB per archive"
    producer_task: "task:frequency"
    consumer_tasks: []

pc_edges:
  - edge_id: "pc:individuals->individuals_merge:n_to_1"
    producer: "task:individuals"
    consumer: "task:individuals_merge"
    data_objects: ["data:individual_mutation_data_tar_gz_segment"]
    pc_pattern: "n_to_1"
    pc_pattern_rationale: "Multiple instances of `task:individuals` (one per chromosome segment) produce `data:individual_mutation_data_tar_gz_segment` files, which are all consumed by a single `task:individuals_merge` instance for that chromosome."
    data_flow_description: "Multiple `tar.gz` archives, each containing individual mutation data for a segment, are passed to `task:individuals_merge` for aggregation."
    coupling: "tight"
    coupling_rationale: "The `task:individuals_merge` cannot begin its processing for a chromosome until all `task:individuals` instances for that chromosome have completed and produced their output archives."
    communication_pattern: "file_per_producer"
    data_volume_class: "medium"

  - edge_id: "pc:individuals_merge->mutation_overlap:1_to_n"
    producer: "task:individuals_merge"
    consumer: "task:mutation_overlap"
    data_objects: ["data:merged_individual_mutation_data_tar_gz"]
    pc_pattern: "1_to_n"
    pc_pattern_rationale: "A single `task:individuals_merge` instance produces `data:merged_individual_mutation_data_tar_gz` for a chromosome, which is then consumed by multiple `task:mutation_overlap` instances (one for each population for that chromosome)."
    data_flow_description: "A single merged archive of individual mutation data for a chromosome is broadcast to multiple `mutation_overlap` tasks."
    coupling: "tight"
    coupling_rationale: "The `task:mutation_overlap` cannot begin until `task:individuals_merge` has completed and produced the full merged archive."
    communication_pattern: "shared_file"
    data_volume_class: "small"

  - edge_id: "pc:individuals_merge->frequency:1_to_n"
    producer: "task:individuals_merge"
    consumer: "task:frequency"
    data_objects: ["data:merged_individual_mutation_data_tar_gz"]
    pc_pattern: "1_to_n"
    pc_pattern_rationale: "A single `task:individuals_merge` instance produces `data:merged_individual_mutation_data_tar_gz` for a chromosome, which is then consumed by multiple `task:frequency` instances (one for each population for that chromosome)."
    data_flow_description: "A single merged archive of individual mutation data for a chromosome is broadcast to multiple `frequency` tasks."
    coupling: "tight"
    coupling_rationale: "The `task:frequency` cannot begin until `task:individuals_merge` has completed and produced the full merged archive."
    communication_pattern: "shared_file"
    data_volume_class: "small"

  - edge_id: "pc:sifting->mutation_overlap:1_to_n"
    producer: "task:sifting"
    consumer: "task:mutation_overlap"
    data_objects: ["data:sifted_data_txt"]
    pc_pattern: "1_to_n"
    pc_pattern_rationale: "A single `task:sifting` instance produces `data:sifted_data_txt` for a chromosome, which is then consumed by multiple `task:mutation_overlap` instances (one for each population for that chromosome)."
    data_flow_description: "A single text file containing sifted data for a chromosome is broadcast to multiple `mutation_overlap` tasks."
    coupling: "tight"
    coupling_rationale: "The `task:mutation_overlap` cannot begin until `task:sifting` has completed and produced the sifted data file."
    communication_pattern: "shared_file"
    data_volume_class: "small"

  - edge_id: "pc:sifting->frequency:1_to_n"
    producer: "task:sifting"
    consumer: "task:frequency"
    data_objects: ["data:sifted_data_txt"]
    pc_pattern: "1_to_n"
    pc_pattern_rationale: "A single `task:sifting` instance produces `data:sifted_data_txt` for a chromosome, which is then consumed by multiple `task:frequency` instances (one for each population for that chromosome)."
    data_flow_description: "A single text file containing sifted data for a chromosome is broadcast to multiple `frequency` tasks."
    coupling: "tight"
    coupling_rationale: "The `task:frequency` cannot begin until `task:sifting` has completed and produced the sifted data file."
    communication_pattern: "shared_file"
    data_volume_class: "small"

