metadata:
  workflow_lineage_id: wrd:1000genome
  version: "1.0.0"
  version_notes: Initial WDD compiled from daxgen.py Pegasus workflow generator.
  deprecated: false
  workflow_name: 1000genome
  workflow_description: The 1000 Genomes workflow analyzes human genomic variation data from the 1000 Genomes Project to identify mutational overlaps and provide null distributions for statistical evaluation of disease-related mutations. It processes Phase3 VCF data, cross-matches extracted mutation data with SIFT scores (predicting amino acid substitution phenotypic effects), and performs population-based overlap analyses.
  source_repository: /home/mtang11/scripts/workflow-representation-description/workflows_repo/1000genome-workflow
  source_commit: "314cd28"
  source_format: compiled_from_pegasus_dax
  source_file: daxgen.py
  schema_version: "wrd-7.0"
  generated_by: opencode
  generated_at: "2026-03-10T00:00:00Z"
  last_modified_at: "2026-03-10T00:00:00Z"

stages:
  - stage_id: stage:data_loading
    name: Data Loading
    order: 1
    description: External input data (VCF files, population files, columns mapping) is prepared and registered in the replica catalog for workflow execution.
    tasks: []

  - stage_id: stage:individuals_extraction
    name: Individuals Extraction
    order: 2
    description: Parses VCF files to extract individual mutation data per chromosome, creating per-individual mutation files filtered by allele frequency criteria.
    tasks:
      - task:individuals
      - task:individuals_merge

  - stage_id: stage:sifting
    name: Sifting
    order: 3
    description: Computes SIFT scores for SNP variants using Variant Effect Predictor annotations, filtering for deleterious or tolerated mutations.
    tasks:
      - task:sifting

  - stage_id: stage:mutation_analysis
    name: Mutation Analysis
    order: 4
    description: Performs mutation overlap analysis and frequency measurements across individuals grouped by population, generating statistical distributions of shared mutations.
    tasks:
      - task:mutation_overlap
      - task:frequency

tasks:
  - task_id: task:individuals
    name: Individuals Extraction
    stage: stage:individuals_extraction
    executable: bin/individuals.py
    description: Parses chromosome VCF files to extract SNP variants for each individual, filtering by allele frequency (>=0.5 with homozygous reference, <0.5 with homozygous alternate). Produces per-individual mutation files containing genomic position, reference/alternate alleles, and SIFT-relevant information.
    behavioral_notes: Reads entire VCF file into memory at startup, processes line by line to extract relevant fields for each individual. Writes output files incrementally as each individual is processed. Creates temporary directory per chromosome chunk, then compresses to tar.gz upon completion.
    parallelism_model:
      type: embarrassingly_parallel
      description: Each task instance processes one chromosome chunk (a range of lines from the VCF file). Multiple individuals jobs can run in parallel for the same or different chromosomes.
    io_dominance: io_bound
    io_access_type: python_serial
    restart_model: idempotent
    restart_checkpoint_dataset: null
    hardware_path:
      has_conditional_execution: false
      execution_alternatives: []
      minimum_resource_assertions: []
    output_class: intermediate
    inputs:
      - data:input_vcf_chr
      - data:columns_txt
    outputs:
      - data:individuals_chunk_tar

  - task_id: task:individuals_merge
    name: Individuals Merge
    stage: stage:individuals_extraction
    executable: bin/individuals_merge.py
    description: Merges the chunked individual mutation files for each chromosome into a single consolidated tar.gz archive. Combines per-individual files from multiple chunks into one unified dataset per chromosome.
    behavioral_notes: Extracts all tar files to temporary directory, reads and concatenates matching individual files across chunks, then recompresses into single tar.gz. Full extraction and re-compression required.
    parallelism_model:
      type: embarrassingly_parallel
      description: One merge task per chromosome, processing all chunks for that chromosome.
    io_dominance: io_bound
    io_access_type: python_serial
    restart_model: idempotent
    restart_checkpoint_dataset: null
    hardware_path:
      has_conditional_execution: false
      execution_alternatives: []
      minimum_resource_assertions: []
    output_class: intermediate
    inputs:
      - data:individuals_chunk_tar
    outputs:
      - data:individuals_merged_tar

  - task_id: task:sifting
    name: Sifting
    stage: stage:sifting
    executable: bin/sifting.py
    description: Filters VEP annotation files to extract SIFT scores for SNP variants, identifying deleterious or tolerated amino acid substitutions. Outputs filtered list with line numbers, rs identifiers, ENSG IDs, SIFT scores, and phenotypes.
    behavioral_notes: Uses subprocess to invoke grep for initial filtering, then parses results to extract relevant fields. Writes output incrementally but final file written at completion.
    parallelism_model:
      type: embarrassingly_parallel
      description: One sifting task per chromosome, processing the annotation VCF file independently.
    io_dominance: balanced
    io_access_type: python_serial
    restart_model: idempotent
    restart_checkpoint_dataset: null
    hardware_path:
      has_conditional_execution: false
      execution_alternatives: []
      minimum_resource_assertions: []
    output_class: intermediate
    inputs:
      - data:annotation_vcf_chr
    outputs:
      - data:sifted_sift_txt

  - task_id: task:mutation_overlap
    name: Mutation Overlap
    stage: stage:mutation_analysis
    executable: bin/mutation_overlap.py
    description: Measures pairwise mutation overlap among individuals within a population for a specific chromosome. Performs cross-matching of SNP variants, generates overlap statistics, creates visualization plots, and produces output archives containing analysis results.
    behavioral_notes: Extracts merged individual tar file to local directory, reads individual mutation files, computes set intersections. Creates multiple output directories and plots. Uses numpy for array operations on mutation overlap matrices. Final output compressed as tar.gz.
    parallelism_model:
      type: embarrassingly_parallel
      description: One mutation_overlap task per chromosome-population combination (e.g., chr1-AFR, chr1-EUR). All combinations run in parallel.
    io_dominance: compute_bound
    io_access_type: python_serial
    restart_model: idempotent
    restart_checkpoint_dataset: null
    hardware_path:
      has_conditional_execution: false
      execution_alternatives: []
      minimum_resource_assertions: []
    output_class: checkpoint
    inputs:
      - data:individuals_merged_tar
      - data:sifted_sift_txt
      - data:population_file
      - data:columns_txt
    outputs:
      - data:mutation_overlap_tar

  - task_id: task:frequency
    name: Frequency Analysis
    stage: stage:mutation_analysis
    executable: bin/frequency.py
    description: Measures frequency of overlapping mutations by selecting random subsets of individuals and computing overlap distributions. Performs 1000 Monte Carlo iterations with 52 individuals per iteration to generate statistical distributions of mutation overlap.
    behavioral_notes: Similar I/O pattern to mutation_overlap - extracts merged tar, reads individual files, performs computations. Uses numpy for random sampling and Counter for overlap counting. Generates 1000 histogram plots (one per run), creating significant file I/O overhead.
    parallelism_model:
      type: embarrassingly_parallel
      description: One frequency task per chromosome-population combination, running independently in parallel with mutation_overlap tasks.
    io_dominance: compute_bound
    io_access_type: python_serial
    restart_model: idempotent
    restart_checkpoint_dataset: null
    hardware_path:
      has_conditional_execution: false
      execution_alternatives: []
      minimum_resource_assertions: []
    output_class: checkpoint
    inputs:
      - data:individuals_merged_tar
      - data:sifted_sift_txt
      - data:population_file
      - data:columns_txt
    outputs:
      - data:frequency_tar

