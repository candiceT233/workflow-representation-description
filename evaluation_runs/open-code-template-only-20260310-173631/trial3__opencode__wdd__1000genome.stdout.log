pc_edges:
  - edge_id: pc:individuals->individuals_merge:n_to_1
    producer: task:individuals
    consumer: task:individuals_merge
    data_objects:
      - data:individuals_chunk_tar
    pc_pattern: n_to_1
    pc_pattern_rationale: Multiple individuals chunk tasks (n chunks per chromosome) produce tar files consumed by a single merge task per chromosome.
    data_flow_description: Each individuals task writes a chunk tarball. The merge task reads all chunks for its chromosome and combines them into a single merged tarball.
    coupling: tight
    coupling_rationale: Merge task cannot begin until all chunk tasks for that chromosome complete and produce their output files.
    communication_pattern: file_per_producer
    data_volume_class: medium

  - edge_id: pc:individuals_merge->mutation_overlap:1_to_n
    producer: task:individuals_merge
    consumer: task:mutation_overlap
    data_objects:
      - data:individuals_merged_tar
    pc_pattern: 1_to_n
    pc_pattern_rationale: One merged individuals tar per chromosome is consumed by multiple mutation_overlap tasks (one per population).
    data_flow_description: For each chromosome-population combination, the merged individuals data is read along with sifted SIFT scores to compute overlap statistics.
    coupling: tight
    coupling_rationale: Each mutation_overlap task waits for its specific chromosome merge to complete before starting.
    communication_pattern: file_per_producer
    data_volume_class: medium

  - edge_id: pc:individuals_merge->frequency:1_to_n
    producer: task:individuals_merge
    consumer: task:frequency
    data_objects:
      - data:individuals_merged_tar
    pc_pattern: 1_to_n
    pc_pattern_rationale: One merged individuals tar per chromosome is consumed by multiple frequency tasks (one per population).
    data_flow_description: Frequency tasks read merged individuals data to perform random sampling overlap analysis.
    coupling: tight
    coupling_rationale: Each frequency task waits for its chromosome merge to complete.
    communication_pattern: file_per_producer
    data_volume_class: medium

  - edge_id: pc:sifting->mutation_overlap:1_to_n
    producer: task:sifting
    consumer: task:mutation_overlap
    data_objects:
      - data:sifted_sift_txt
    pc_pattern: 1_to_n
    pc_pattern_rationale: One sifted SIFT file per chromosome is consumed by multiple mutation_overlap tasks (one per population).
    data_flow_description: Mutation_overlap reads SIFT scores to filter variants and cross-match with individual mutations.
    coupling: tight
    coupling_rationale: Mutation_overlap tasks wait for sifting to complete before reading SIFT files.
    communication_pattern: file_per_producer
    data_volume_class: small

  - edge_id: pc:sifting->frequency:1_to_n
    producer: task:sifting
    consumer: task:frequency
    data_objects:
      - data:sifted_sift_txt
    pc_pattern: 1_to_n
    pc_pattern_rationale: One sifted SIFT file per chromosome is consumed by multiple frequency tasks (one per population).
    data_flow_description: Frequency tasks read SIFT scores to identify variants for overlap analysis.
    coupling: tight
    coupling_rationale: Frequency tasks wait for sifting to complete.
    communication_pattern: file_per_producer
    data_volume_class: small

