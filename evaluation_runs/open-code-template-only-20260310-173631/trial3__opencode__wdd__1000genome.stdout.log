workflow_patterns:
  primary_pattern: scatter_gather
  secondary_patterns: []
  classification_rationale: "Workflow exhibits scatter-gather pattern: individuals tasks scatter VCF processing across parallel chunks, merge gathers them per chromosome, then analysis tasks scatter again across populations and gather results. Clear fan-out (one chromosome -> multiple chunks, one chromosome -> multiple populations) and fan-in (multiple chunks -> merge, multiple analyses -> final results) structure visible in DAG."
  pattern_table_row: "1000genome | 4 stages | ~300 tasks (10 chr x (n_chunks + 1 merge + 1 sifting + 7 pop x 2 analyses)) | n_to_1 (chunk->merge), 1_to_n (chr->pop analyses) | parallel file reads, repeated data access in analysis"

io_behavioral_hints:
  - hint_id: hint:frequency_small_files
    description: "The frequency task generates 1000 PNG plot files per chromosome-population combination (70 total combinations), creating significant small-file overhead. Each plot is written individually rather than batched, causing metadata-heavy I/O patterns."
    affected_tasks:
      - task:frequency
    affected_data:
      - data:frequency_tar
    potential_concern: small_file_overhead

  - hint_id: hint:repeated_tar_extraction
    description: "Both mutation_overlap and frequency tasks extract the same merged individuals tar file independently. For each chromosome-population pair, extraction occurs twice (once per task type), causing redundant I/O operations on the same data."
    affected_tasks:
      - task:mutation_overlap
      - task:frequency
    affected_data:
      - data:individuals_merged_tar
    potential_concern: unnecessary_serialization

  - hint_id: hint:full_vcf_read
    description: "The individuals task reads entire VCF file into memory at startup before processing. With 250,000 lines per chromosome and 2,504 individuals, this creates large memory footprint and prevents streaming processing."
    affected_tasks:
      - task:individuals
    affected_data:
      - data:input_vcf_chr
    potential_concern: unknown

execution_profiles:
  - profile_name: full
    terminal_task_id: task:frequency
    description: "Complete workflow execution producing all mutation overlap and frequency analysis results for all chromosomes and populations."
    required_task_set:
