      consumer_count: 2\n\n  - data_id: \"data:columns_file\"\n    name: \"Column Headers File\"\n    description: \"Tab-separated file containing the complete list of 2504 individual sample identifiers from the 1000 Genomes dataset in the same column order as the VCF files. Used to map VCF column indices to individual names and to match with population membership lists.\"\n    category: \"config\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      compression: null\n      layout_hint: null\n      typical_request_size_kb: null\n      datasets: []\n    cardinality: \"single global file\"\n    cardinality_source:\n      type: \"fixed\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"n/a\"\n    estimated_size_hint: \"~10 KB (2504 individual IDs in tab-separated format)\"\n    producer_task: null\n    consumer_tasks: [\"task:individuals\", \"task:mutation_overlap\", \"task:frequency\"]\n    lifecycle:\n      creation_phase: \"stage:data_extraction\"\n      last_consumer_phase: \"stage:analysis\"\n      retention_window: \"from workflow start to workflow end\"\n      access_frequency_class: \"repeatedly\"\n      consumer_count: 3\n\npc_edges:\n  - edge_id: \"pc:individuals->individuals_merge:n_to_1\"\n    producer: \"task:individuals\"\n    consumer: \"task:individuals_merge\"\n    data_objects: [\"data:individuals_output_chunk\"]\n    pc_pattern: \"n_to_1\"\n    pc_pattern_rationale: \"Multiple individuals jobs process different chunks of the same chromosome in parallel (controlled by -i/--individuals-jobs parameter, default 1 but up to 250). All chunks from one chromosome are consumed by a single individuals_merge job for that chromosome, resulting in fan-in aggregation pattern.\"\n    data_flow_description: \"Each individuals job produces one tar.gz chunk file. The corresponding individuals_merge job reads all chunk files for that chromosome and merges them into one consolidated archive.\"\n    coupling: \"tight\"\n    coupling_rationale: \"individuals_merge explicitly depends on completion of all individuals jobs for its chromosome (via DAG dependency in Pegasus workflow definition). No streaming or partial processing; must wait for all chunks before merging.\"\n    communication_pattern: \"file_per_producer\"\n    data_volume_class: \"medium\"\n\n  - edge_id: \"pc:individuals_merge->mutation_overlap:1_to_n\"\n    producer: \"task:individuals_merge\"\n    consumer: \"task:mutation_overlap\"\n    data_objects: [\"data:individuals_merged\"]\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: \"One individuals_merge job per chromosome produces one merged individuals file. This single file is consumed by multiple mutation_overlap jobs—one for each population (7 populations: ALL, AFR, EUR, EAS, AMR, SAS, GBR). Same individuals data broadcast to N analysis tasks.\"\n    data_flow_description: \"Single merged individuals tar.gz archive is consumed by all mutation_overlap instances for that chromosome. Each mutation_overlap job extracts the archive and uses it to analyze that population's mutation patterns.\"\n    coupling: \"tight\"\n    coupling_rationale: \"mutation_overlap jobs explicitly depend on individuals_merge completion. They open the merged file only after the task completes and signals data ready.\"\n    communication_pattern: \"shared_file\"\n    data_volume_class: \"medium\"\n\n  - edge_id: \"pc:sifting->mutation_overlap:1_to_n\"\n    producer: \"task:sifting\"\n    consumer: \"task:mutation_overlap\"\n    data_objects: [\"data:sifted_variants\"]\n    pc_pattern: \"1_to_n\"\n    pc_pattern_rationale: \"One sifting job per chromosome produces one sifted variants file. This file is consumed by multiple mutation_overlap jobs—one per population. Same SIFT scores broadcast to all analysis tasks for that chromosome.\"\n    data_flow_description: \"Single sifted variants file per chromosome is read by all mutation_overlap instances for that chromoso