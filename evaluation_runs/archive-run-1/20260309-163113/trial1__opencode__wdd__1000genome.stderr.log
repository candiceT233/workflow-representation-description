import hashlib
import json

pc_edges = [
    {'producer': 'task:individuals', 'consumer': 'task:individuals_merge', 'data_objects': ['data:individuals_chunk_output']},
    {'producer': 'task:individuals_merge', 'consumer': 'task:mutation_overlap', 'data_objects': ['data:merged_individuals']},
