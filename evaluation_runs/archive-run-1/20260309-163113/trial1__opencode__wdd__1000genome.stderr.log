    {'producer': 'task:sifting', 'consumer': 'task:frequency', 'data_objects': ['data:sifted_output']}
]

# Sort edges for consistent hashing
sorted_edges = sorted(pc_edges, key=lambda x: (x['producer'], x['consumer']))
hash_input = json.dumps(sorted_edges, sort_keys=True)
hash_value = hashlib.sha256(hash_input.encode()).hexdigest()
print(hash_value)
"
