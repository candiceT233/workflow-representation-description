metadata:
  workflow_lineage_id: wrd:1000genome
  version: "1.0.0"
  version_notes: Initial WDD compiled from daxgen.py Pegasus workflow generator
  deprecated: false
  workflow_name: 1000genome
  workflow_description: The 1000 Genomes Project workflow identifies mutational overlaps using data from the 1000 genomes project to provide a null distribution for rigorous statistical evaluation of potential disease-related mutations. The workflow fetches, parses, and analyzes VCF data from the 1000 genomes Project, cross-matches extracted data with SIFT scores from Variant Effect Predictor, and performs overlap analysis and frequency measurements by population and chromosome.
  source_repository: /home/mtang11/scripts/workflow-representation-description/workflows_repo/1000genome-workflow
  source_commit: null
  source_format: compiled_from_pegasus_dax
  source_file: daxgen.py
  schema_version: "wrd-7.0"
  generated_by: opencode
  generated_at: "2026-03-09T00:00:00Z"
  last_modified_at: "2026-03-09T00:00:00Z"

stages:
  - stage_id: stage:data_ingestion
    name: Data Ingestion
    order: 1
    description: Parses VCF files to extract individual mutation data per chromosome and filters SNPs based on SIFT scores
    tasks:
      - task:individuals
      - task:sifting

  - stage_id: stage:data_aggregation
    name: Data Aggregation
    order: 2
    description: Merges individual mutation files for each chromosome into consolidated tar archives
    tasks:
      - task:individuals_merge

  - stage_id: stage:analysis
    name: Analysis
    order: 3
    description: Performs mutation overlap and frequency analysis by population and chromosome
    tasks:
      - task:mutation_overlap
      - task:frequency

tasks:
  - task_id: task:individuals
    name: Individuals
    stage: stage:data_ingestion
    executable: bin/individuals.py
    description: Parses VCF chromosome files and extracts individual mutation data. Each job processes a subset of lines (configurable chunk) from a chromosome VCF file and outputs per-individual mutation files compressed in a tar archive. Filters SNPs based on allele frequency threshold (AF >= 0.5 or < 0.5) and heterozygosity criteria.
    behavioral_notes: Reads entire VCF file into memory at startup. Writes output files incrementally per individual, then compresses into tar archive at completion. Processes approximately 250000 lines per chromosome in configurable chunks.
    parallelism_model:
      type: embarrassingly_parallel
      description: Multiple individuals jobs process different line ranges of the same chromosome independently. Each job produces a separate output tar file. Job count controlled by ind_jobs parameter.
