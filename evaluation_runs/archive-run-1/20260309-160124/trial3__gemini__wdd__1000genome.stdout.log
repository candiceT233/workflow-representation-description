  consumer_count: 2\n\n  - data_id: \"data:vep_sifting_file\"\n    name: \"VEP Sifting File\"\n    description: >\n      This data object represents the Variant Effect Predictor (VEP) input data,\n      which is used by the 'sifting' task to compute SIFT scores for SNPs. There\n      is one such file per chromosome.\n    category: \"input\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"unknown\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: \"unknown\"\n    cardinality: \"one per chromosome (typically 22-24)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"vep_sifting_file_col\"\n      config_file: \"data.csv\"\n      possible_values: \"unknown (list of VEP sifting files)\"\n    estimated_size_hint: \"tens of MB to GBs per chromosome [ASSUMPTION]\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:sifting\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:sifting\"\n      retention_window: \"from external input to task:sifting completion\"\n      access_frequency_class: \"once\"\n      consumer_count: 1\n\n  - data_id: \"data:sifted_snp_data\"\n    name: \"Sifted SNP Data\"\n    description: >\n      This data object contains Single Nucleotide Polymorphism (SNP) variants that\n      have been processed by the 'sifting' task. It includes SIFT scores and associated\n      SNP variant IDs (rs number, ENSEMBL GEN ID, HGNC ID) for a specific chromosome.\n    category: \"intermediate\"\n    persistence: \"workflow_scoped\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: \"unknown\"\n    cardinality: \"one per chromosome (typically 22-24)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"base_file\"\n      config_file: \"data.csv\"\n      possible_values: \"unknown (list of chromosome SIFT data)\"\n    estimated_size_hint: \"several MBs per chromosome [ASSUMPTION]\"\n    producer_task: \"task:sifting\"\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: \"task:sifting\"\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from task:sifting completion to task:frequency completion\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 2\n\n  - data_id: \"data:population_file\"\n    name: \"Population File\"\n    description: >\n      This data object represents a file containing definitions or lists of individuals\n      belonging to a specific population group (e.g., African, European). These files\n      are used by analysis tasks to categorize and group individuals for statistical evaluation.\n    category: \"input\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"none\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: \"unknown\"\n    cardinality: \"one per population (e.g., AFR, AMR, EAS, EUR, GBR, SAS, ALL)\"\n    cardinality_source:\n      type: \"fixed\"\n      controlling_parameter: null\n      config_file: null\n      possible_values: \"AFR, AMR, EAS, EUR, GBR, SAS, ALL\"\n    estimated_size_hint: \"small text file, <1 MB [ASSUMPTION]\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:mutation_overlap\"\n      - \"task:frequency\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:frequency\"\n      retention_window: \"from external input to task:frequency completion\"\n      access_frequency_class: \"few_times\"\n      consumer_count: 2\n\n  - data_id: \"data:mutation_overlap_results_file\"\n    name: \"Mutation Overlap Results File\"\n    description: >\n      This data object stores the calculated results of mutation overlap analysis\n      among individual