un in parallel, each processing a specific chromosome and\n        population combination to measure mutation frequency independently.\n    io_dominance: \"balanced\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: false\n      execution_alternatives: []\n      minimum_resource_assertions: []\n    output_class: \"output\"\n    inputs:\n      - \"data:merged_chromosome_individuals_file\"\n      - \"data:sifted_snp_data\"\n      - \"data:population_file\"\n      - \"data:columns_file\"\n    outputs:\n      - \"data:frequency_results_file\"\n\ndata_objects:\n  - data_id: \"data:vcf_chromosome_file\"\n    name: \"VCF Chromosome File\"\n    description: >\n      This data object represents the raw Variant Call Format (VCF) data for a\n      specific chromosome from the 1000 Genomes Project. It contains information\n      on Single Nucleotide Polymorphisms (SNPs) and individual genotypes. It serves\n      as a primary input to the 'individuals' task.\n    category: \"input\"\n    persistence: \"persistent\"\n    format_hint:\n      container: \"text\"\n      datasets: []\n      compression: \"unknown\"\n      layout_hint: \"contiguous\"\n      typical_request_size_kb: \"unknown\"\n    cardinality: \"one per chromosome (typically 22-24)\"\n    cardinality_source:\n      type: \"config_determined\"\n      controlling_parameter: \"base_file\"\n      config_file: \"data.csv\"\n      possible_values: \"unknown (list of chromosome VCFs)\"\n    estimated_size_hint: \"~100 MB - several GBs per chromosome (from README: 250k lines)\"\n    producer_task: null\n    consumer_tasks:\n      - \"task:individuals\"\n    lifecycle:\n      creation_phase: null\n      last_consumer_phase: \"task:individuals\"\n      retention_window: \"from external input to task:individuals completion\"\n      access_frequency_class: \"once\"\n      consumer_count: \"unknown\"\n\n  - data_id