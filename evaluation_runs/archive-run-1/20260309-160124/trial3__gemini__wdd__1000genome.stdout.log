utput files containing 'rs numbers' for individuals\n      with mutations on both alleles within that chunk.\n    behavioral_notes: >\n      Reads a subset of a large VCF file (chunked processing). Can be I/O bound\n      due to the size of the input data. Outputs compressed intermediate files\n      for each processed chunk.\n    parallelism_model:\n      type: \"embarrassingly_parallel\"\n      description: >\n        Multiple instances of this task run in parallel, each processing a distinct\n        line range (chunk) of the input VCF file for a given chromosome.\n    io_dominance: \"io_bound\"\n    io_access_type: \"python_serial\"\n    restart_model: \"idempotent\"\n    restart_checkpoint_dataset: null\n    hardware_path:\n      has_conditional_execution: true\n      execution_alternatives:\n        - path_id: \"default_path\"\n          condition: \"use_decaf=false, use_pmc=false\"\n          description: \"Standard execution path using the `bin/individuals` executable.\"\n          io_dominance_hint: \"io_bound\"\n        - path_id: \"decaf_path\"\n          condition: \"use_decaf=true\"\n          description: \"Uses `bin/individuals_mpi` executable with Decaf in-memory dataflow for reduced I/O. Expected to be more balanced between I/O and compute due to memory optimization.\"\n          io_dominance_hint: \"balanced\"\n        - path_id: \"pmc_path\"\n          condition: \"use_pmc=true\"\n          description: \"Uses `bin/individuals_mpi` executable with Pegasus MPI Cluster (PMC), implying MPI-based communication and processing. Expected to be more balanced between I/O and compute.\"\n          io_dominance_hint: \"balanced\"\n      minimum_resource_assertions:\n        - resource: \"host_memory_gb\"\n          condition: \"> 2.93 GB [ASSUMPTION: inferred from README memory table for 16 jobs/chr]\"\n          source_location: \"unknown [ASSUMPTION: not visible in daxgen.py]\"\n    output_class: \"intermediate\"\n    inputs:\n      - \"data:vcf_chromosome